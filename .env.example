# ── CONFIGURACIÓN DEL ENTORNO ──
PROJECT_NAME=nutrigest_dev
NODE_ENV=development
RESTART_POLICY=no

# ── DOCKERFILES ──
BACKEND_DOCKERFILE=Dockerfile.dev
FRONTEND_DOCKERFILE=Dockerfile.dev

# ── RUTAS DE VOLÚMENES LOCALES ──
DB_DATA_PATH=./docker/data/postgres
REDIS_DATA_PATH=./docker/data/redis
MINIO_DATA_PATH=./docker/data/minio
UPLOADS_DATA_PATH=./docker/data/uploads

# ── PUERTOS EXPUESTOS (DEV) ──
DB_PORT_BIND=5477
MINIO_API_PORT=9020
MINIO_CONSOLE_PORT=9001
BACKEND_PORT=3001
FRONTEND_PORT=3050
NGINX_HTTP_PORT=8080

# ── CREDENCIALES BASE DE DATOS ──
POSTGRES_USER=nutrigest_user
POSTGRES_PASSWORD=nutrigest_password
POSTGRES_DB=nutrigest_cloud

# ── CREDENCIALES PGADMIN (Solo DEV) ──
PGADMIN_EMAIL=admin@admin.com
PGADMIN_PASSWORD=root

# ── CREDENCIALES MINIO ──
MINIO_ROOT_USER=nutrigest_minio
MINIO_ROOT_PASSWORD=nutrigest_secret_minio
MINIO_BUCKET=nutrigest-uploads

# ── APLICACIÓN ──
JWT_SECRET=customtokensecret
# ── SECRETS DE SESIÓN Y JWT (mínimo 32 caracteres, obligatorios) ──
SESSION_SECRET=cambiame_por_un_secret_largo_de_minimo_32_caracteres
AT_SECRET=cambiame_access_token_secret
RT_SECRET=cambiame_refresh_token_secret
NEXT_PUBLIC_API_URL=/api
NGINX_CONF_PATH=./docker/nginx.conf
DEFAULT_TRIAL_DAYS=120
DEFAULT_PLAN_ID="Premium"

# ── EMAIL (SMTP) ──
SMTP_USER=
SMTP_PASS=

# ── URL DE LA APP (para links en emails) ──
APP_URL=http://localhost:3001

# ── TELEGRAM ALERTS ──
NEXT_PUBLIC_TELEGRAM_BOT_TOKEN=
NEXT_PUBLIC_TELEGRAM_CHAT_ID=

