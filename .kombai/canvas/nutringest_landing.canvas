  —\n                                </span>\n                            </td>\n                            <td class=\"px-6 py-4 text-center\" data-kid=\"1-14-1-2-1-3-20-4\">\n                                <i aria-hidden=\"true\" class=\"ph ph-check text-[16px] text-[var(--brand)]\" data-kid=\"1-14-1-2-1-3-20-4-1\">\n                                </i>\n                            </td>\n                        </tr>\n                        <tr class=\"border-b border-[var(--border)]\" data-kid=\"1-14-1-2-1-3-21\">\n                            <th class=\"px-6 py-4 text-left text-[13px] font-medium text-[var(--ink-soft)]\" data-kid=\"1-14-1-2-1-3-21-1\" scope=\"row\">\n                                Soporte Prioritario VIP\n                            </th>\n                            <td class=\"px-6 py-4 text-center\" data-kid=\"1-14-1-2-1-3-21-2\">\n                                <span aria-hidden=\"true\" class=\"text-[15px] text-[var(--muted)] opacity-60\" data-kid=\"1-14-1-2-1-3-21-2-1\">\n                                    —\n                                </span>\n                            </td>\n                            <td class=\"bg-[var(--surface-2)] px-6 py-4 text-center\" data-kid=\"1-14-1-2-1-3-21-3\">\n                                <span aria-hidden=\"true\" class=\"text-[15px] text-[var(--muted)] opacity-60\" data-kid=\"1-14-1-2-1-3-21-3-1\">\n                                    —\n                                </span>\n                            </td>\n                            <td class=\"px-6 py-4 text-center\" data-kid=\"1-14-1-2-1-3-21-4\">\n                                <i aria-hidden=\"true\" class=\"ph ph-check text-[16px] text-[var(--brand)]\" data-kid=\"1-14-1-2-1-3-21-4-1\">\n                                </i>\n                            </td>\n                        </tr>\n                        <tr class=\"border-b border-[var(--border)]\" data-kid=\"1-14-1-2-1-3-22\">\n                            <th class=\"px-6 py-4 text-left text-[13px] font-medium text-[var(--ink-soft)]\" data-kid=\"1-14-1-2-1-3-22-1\" scope=\"row\">\n                                Multi-nutricionista\n                            </th>\n                            <td class=\"px-6 py-4 text-center\" data-kid=\"1-14-1-2-1-3-22-2\">\n                                <span aria-hidden=\"true\" class=\"text-[15px] text-[var(--muted)] opacity-60\" data-kid=\"1-14-1-2-1-3-22-2-1\">\n                                    —\n                                </span>\n                            </td>\n                            <td class=\"bg-[var(--surface-2)] px-6 py-4 text-center\" data-kid=\"1-14-1-2-1-3-22-3\">\n                                <span aria-hidden=\"true\" class=\"text-[15px] text-[var(--muted)] opacity-60\" data-kid=\"1-14-1-2-1-3-22-3-1\">\n                                    —\n                                </span>\n                            </td>\n                            <td class=\"px-6 py-4 text-center\" data-kid=\"1-14-1-2-1-3-22-4\">\n                                <i aria-hidden=\"true\" class=\"ph ph-check text-[16px] text-[var(--brand)]\" data-kid=\"1-14-1-2-1-3-22-4-1\">\n                                </i>\n                            </td>\n                        </tr>\n                        <tr data-kid=\"1-14-1-2-1-3-23\">\n                            <th class=\"px-6 py-4 text-left text-[13px] font-medium text-[var(--ink-soft)]\" data-kid=\"1-14-1-2-1-3-23-1\" scope=\"row\">\n                                Analíticas Avanzadas\n                            </th>\n                            <td class=\"px-6 py-4 text-center\" data-kid=\"1-14-1-2-1-3-23-2\">\n                                <span aria-hidden=\"true\" class=\"text-[15px] text-[var(--muted)] opacity-60\" data-kid=\"1-14-1-2-1-3-23-2-1\">\n                                    —\n                                </span>\n                            </td>\n                            <td class=\"bg-[var(--surface-2)] px-6 py-4 text-center\" data-kid=\"1-14-1-2-1-3-23-3\">\n                                <span aria-hidden=\"true\" class=\"text-[15px] text-[var(--muted)] opacity-60\" data-kid=\"1-14-1-2-1-3-23-3-1\">\n                                    —\n                                </span>\n                            </td>\n                            <td class=\"px-6 py-4 text-center\" data-kid=\"1-14-1-2-1-3-23-4\">\n                                <i aria-hidden=\"true\" class=\"ph ph-check text-[16px] text-[var(--brand)]\" data-kid=\"1-14-1-2-1-3-23-4-1\">\n                                </i>\n                            </td>\n                        </tr>\n                    </tbody>\n                </table>\n            </div>\n            <p class=\"mt-8 text-xs text-[var(--muted)]\" data-kid=\"1-14-1-3\">\n                Todos los precios son de preventa por tiempo limitado y se facturan mensualmente. La prueba de 14 días incluye\n          todas las funciones y no pide tarjeta.\n            </p>\n        </div>\n    </section>\n    <!-- ============ CASOS DE USO ============ -->\n    <section class=\"scroll-mt-28 border-y border-[var(--border)] bg-[var(--bg-soft)] py-20 lg:py-28\" data-kid=\"1-15\" id=\"casos\">\n        <div class=\"mx-auto max-w-7xl px-4 sm:px-6 lg:px-8\" data-kid=\"1-15-1\">\n            <div class=\"max-w-2xl\" data-kid=\"1-15-1-1\">\n                <p class=\"flex items-center gap-3 text-[11px] font-bold uppercase tracking-[0.22em] text-[var(--muted)]\" data-kid=\"1-15-1-1-1\">\n                    <span class=\"h-px w-8 bg-[var(--brand)]\" data-kid=\"1-15-1-1-1-1\">\n                    </span>\n                    Casos de uso\n                </p>\n                <h2 class=\"mt-6 text-3xl font-extrabold leading-tight tracking-tight lg:text-[2.6rem]\" data-kid=\"1-15-1-1-2\">\n                    Qué cambia en cada especialidad.\n                </h2>\n                <p class=\"mt-5 text-base leading-relaxed text-[var(--ink-soft)]\" data-kid=\"1-15-1-1-3\">\n                    La base es la misma plataforma; lo que cambia es qué parte del flujo usás todos los días.\n                </p>\n            </div>\n            <div class=\"mt-14 grid gap-6 lg:grid-cols-2 lg:gap-8\" data-kid=\"1-15-1-2\">\n                <article class=\"rounded-2xl border border-[var(--border)] bg-[var(--surface)] p-7 lg:p-8\" data-kid=\"1-15-1-2-1\">\n                    <div class=\"flex items-center gap-3\" data-kid=\"1-15-1-2-1-1\">\n                        <span class=\"flex h-10 w-10 shrink-0 items-center justify-center rounded-full bg-[var(--surface-2)] text-[var(--brand)]\" data-kid=\"1-15-1-2-1-1-1\">\n                            <i class=\"ph ph-stethoscope text-[20px]\" data-kid=\"1-15-1-2-1-1-1-1\">\n                            </i>\n                        </span>\n                        <h3 class=\"text-lg font-bold\" data-kid=\"1-15-1-2-1-1-2\">\n                            Nutrición clínica\n                        </h3>\n                    </div>\n                    <p class=\"mt-4 text-[13px] leading-relaxed text-[var(--muted)]\" data-kid=\"1-15-1-2-1-2\">\n                        Historia clínica digital, cálculo antropométrico y seguimiento en el mismo expediente, con reportes en\n            PDF listos para entregar en consulta sin volver a transcribir nada.\n                    </p>\n                </article>\n                <article class=\"rounded-2xl border border-[var(--border)] bg-[var(--surface)] p-7 lg:p-8\" data-kid=\"1-15-1-2-2\">\n                    <div class=\"flex items-center gap-3\" data-kid=\"1-15-1-2-2-1\">\n                        <span class=\"flex h-10 w-10 shrink-0 items-center justify-center rounded-full bg-[var(--surface-2)] text-[var(--brand)]\" data-kid=\"1-15-1-2-2-1-1\">\n                            <i class=\"ph ph-barbell text-[20px]\" data-kid=\"1-15-1-2-2-1-1-1\">\n                            </i>\n                        </span>\n                        <h3 class=\"text-lg font-bold\" data-kid=\"1-15-1-2-2-1-2\">\n                            Nutrición deportiva\n                        </h3>\n                    </div>\n                    <p class=\"mt-4 text-[13px] leading-relaxed text-[var(--muted)]\" data-kid=\"1-15-1-2-2-2\">\n                        Plantillas de dietas propias y cálculo antropométrico para ajustar menús, listas de intercambio y\n            compras sin rearmar el plan desde cero cada vez que cambia un objetivo.\n                    </p>\n                </article>\n                <article class=\"rounded-2xl border border-[var(--border)] bg-[var(--surface)] p-7 lg:p-8\" data-kid=\"1-15-1-2-3\">\n                    <div class=\"flex items-center gap-3\" data-kid=\"1-15-1-2-3-1\">\n                        <span class=\"flex h-10 w-10 shrink-0 items-center justify-center rounded-full bg-[var(--surface-2)] text-[var(--brand)]\" data-kid=\"1-15-1-2-3-1-1\">\n                            <i class=\"ph ph-baby text-[20px]\" data-kid=\"1-15-1-2-3-1-1-1\">\n                            </i>\n                        </span>\n                        <h3 class=\"text-lg font-bold\" data-kid=\"1-15-1-2-3-1-2\">\n                            Nutrición pediátrica\n                        </h3>\n                    </div>\n                    <p class=\"mt-4 text-[13px] leading-relaxed text-[var(--muted)]\" data-kid=\"1-15-1-2-3-2\">\n                        Personalización de plantillas y listas de intercambio para adaptar el plan a la familia, con el portal\n            del paciente para consultarlo desde el teléfono.\n                    </p>\n                </article>\n                <article class=\"rounded-2xl border border-[var(--border)] bg-[var(--surface)] p-7 lg:p-8\" data-kid=\"1-15-1-2-4\">\n                    <div class=\"flex items-center gap-3\" data-kid=\"1-15-1-2-4-1\">\n                        <span class=\"flex h-10 w-10 shrink-0 items-center justify-center rounded-full bg-[var(--surface-2)] text-[var(--brand-2)]\" data-kid=\"1-15-1-2-4-1-1\">\n                            <i class=\"ph ph-users-three text-[20px]\" data-kid=\"1-15-1-2-4-1-1-1\">\n                            </i>\n                        </span>\n                        <h3 class=\"text-lg font-bold\" data-kid=\"1-15-1-2-4-1-2\">\n                            Grupos y empresas\n                        </h3>\n                    </div>\n                    <p class=\"mt-4 text-[13px] leading-relaxed text-[var(--muted)]\" data-kid=\"1-15-1-2-4-2\">\n                        Atención en grupos, sistema de referidos y gestión de equipo cuando coordinás varios profesionales bajo\n            una misma marca y necesitás una vista compartida del trabajo.\n                    </p>\n                </article>\n            </div>\n        </div>\n    </section>\n    <!-- ============ FAQ ============ -->\n    <section class=\"scroll-mt-28 py-20 lg:py-28\" data-kid=\"1-7\" id=\"faq\">\n        <div class=\"mx-auto max-w-3xl px-4 sm:px-6 lg:px-8\" data-kid=\"1-7-1\">\n            <p class=\"flex items-center gap-3 text-[11px] font-bold uppercase tracking-[0.22em] text-[var(--muted)]\" data-kid=\"1-7-1-1\">\n                <span class=\"h-px w-8 bg-[var(--brand)]\" data-kid=\"1-7-1-1-1\">\n                </span>\n                Preguntas frecuentes\n            </p>\n            <h2 class=\"mt-6 text-3xl font-extrabold leading-tight tracking-tight lg:text-[2.4rem]\" data-kid=\"1-7-1-2\">\n                Lo que suele decidir la compra.\n            </h2>\n            <div class=\"mt-10 border-t border-[var(--border)]\" data-kid=\"1-7-1-3\">\n                <details class=\"ng-faq border-b border-[var(--border)] py-6\" data-dynamic=\"true\" data-kid=\"1-7-1-3-1\" data-name=\"faq question container\" data-reason=\"open attribute toggled by browser native details behavior\" open=\"\">\n                    <summary class=\"ng-sum flex cursor-pointer items-start justify-between gap-6\" data-kid=\"1-7-1-3-1-1\">\n                        <span class=\"text-base font-bold lg:text-lg\" data-kid=\"1-7-1-3-1-1-1\">\n                            ¿Cómo funciona la prueba gratuita de 14 días?\n                        </span>\n                        <i class=\"ph ph-plus ng-plus mt-1 shrink-0 text-[20px] text-[var(--brand)] transition-transform duration-200\" data-kid=\"1-7-1-3-1-1-2\">\n                        </i>\n                    </summary>\n                    <p class=\"mt-4 text-sm leading-relaxed text-[var(--muted)] lg:text-[15px]\" data-kid=\"1-7-1-3-1-2\">\n                        Accedés al 100% de las funciones desde el primer día. No pedimos tarjeta de crédito ni compromiso de\n            permanencia, y podés cancelar cuando quieras.\n                    </p>\n                </details>\n                <details class=\"ng-faq border-b border-[var(--border)] py-6\" data-dynamic=\"true\" data-kid=\"1-7-1-3-2\" data-name=\"faq question container\" data-reason=\"open attribute toggled by browser native details behavior\">\n                    <summary class=\"ng-sum flex cursor-pointer items-start justify-between gap-6\" data-kid=\"1-7-1-3-2-1\">\n                        <span class=\"text-base font-bold lg:text-lg\" data-kid=\"1-7-1-3-2-1-1\">\n                            ¿Mis historias clínicas y datos de pacientes están seguros?\n                        </span>\n                        <i class=\"ph ph-plus ng-plus mt-1 shrink-0 text-[20px] text-[var(--brand)] transition-transform duration-200\" data-kid=\"1-7-1-3-2-1-2\">\n                        </i>\n                    </summary>\n                    <p class=\"mt-4 text-sm leading-relaxed text-[var(--muted)] lg:text-[15px]\" data-kid=\"1-7-1-3-2-2\">\n                        Los datos se almacenan cifrados y con respaldo automático en la nube. Solo vos accedés a la información de\n            tus pacientes desde tu cuenta.\n                    </p>\n                </details>\n                <details class=\"ng-faq border-b border-[var(--border)] py-6\" data-dynamic=\"true\" data-kid=\"1-7-1-3-3\" data-name=\"faq question container\" data-reason=\"open attribute toggled by browser native details behavior\">\n                    <summary class=\"ng-sum flex cursor-pointer items-start justify-between gap-6\" data-kid=\"1-7-1-3-3-1\">\n                        <span class=\"text-base font-bold lg:text-lg\" data-kid=\"1-7-1-3-3-1-1\">\n                            ¿Puedo exportar los planes y reportes en PDF?\n                        </span>\n                        <i class=\"ph ph-plus ng-plus mt-1 shrink-0 text-[20px] text-[var(--brand)] transition-transform duration-200\" data-kid=\"1-7-1-3-3-1-2\">\n                        </i>\n                    </summary>\n                    <p class=\"mt-4 text-sm leading-relaxed text-[var(--muted)] lg:text-[15px]\" data-kid=\"1-7-1-3-3-2\">\n                        Sí. Los reportes antropométricos y los planes alimenticios se generan en PDF listo para imprimir en A4 o\n            para enviar directamente por WhatsApp a tus pacientes.\n                    </p>\n                </details>\n                <details class=\"ng-faq border-b border-[var(--border)] py-6\" data-dynamic=\"true\" data-kid=\"1-7-1-3-4\" data-name=\"faq question container\" data-reason=\"open attribute toggled by browser native details behavior\">\n                    <summary class=\"ng-sum flex cursor-pointer items-start justify-between gap-6\" data-kid=\"1-7-1-3-4-1\">\n                        <span class=\"text-base font-bold lg:text-lg\" data-kid=\"1-7-1-3-4-1-1\">\n                            ¿Qué es Nutringest Campus y quiénes aplican?\n                        </span>\n                        <i class=\"ph ph-plus ng-plus mt-1 shrink-0 text-[20px] text-[var(--brand)] transition-transform duration-200\" data-kid=\"1-7-1-3-4-1-2\">\n                        </i>\n                    </summary>\n                    <p class=\"mt-4 text-sm leading-relaxed text-[var(--muted)] lg:text-[15px]\" data-kid=\"1-7-1-3-4-2\">\n                        Es nuestro programa para la comunidad universitaria. Si estás en el último año de la licenciatura en\n            nutrición o en pasantías profesionales, te damos 120 días de acceso premium sin costo. Se solicita\n            constancia de último año o de pasantía.\n                    </p>\n                </details>\n                <details class=\"ng-faq border-b border-[var(--border)] py-6\" data-dynamic=\"true\" data-kid=\"1-7-1-3-5\" data-name=\"faq question container\" data-reason=\"open attribute toggled by browser native details behavior\">\n                    <summary class=\"ng-sum flex cursor-pointer items-start justify-between gap-6\" data-kid=\"1-7-1-3-5-1\">\n                        <span class=\"text-base font-bold lg:text-lg\" data-kid=\"1-7-1-3-5-1-1\">\n                            ¿Puedo empezar por mi cuenta y después sumar mi equipo?\n                        </span>\n                        <i class=\"ph ph-plus ng-plus mt-1 shrink-0 text-[20px] text-[var(--brand)] transition-transform duration-200\" data-kid=\"1-7-1-3-5-1-2\">\n                        </i>\n                    </summary>\n                    <p class=\"mt-4 text-sm leading-relaxed text-[var(--muted)] lg:text-[15px]\" data-kid=\"1-7-1-3-5-2\">\n                        Sí. Muchas nutricionistas arrancan con PRO o PREMIUM y pasan a Clínica cuando incorporan colegas, porque\n            ese plan agrega multi-nutricionista, gestión de equipo, marca personalizada y analíticas avanzadas.\n                    </p>\n                </details>\n            </div>\n        </div>\n    </section>\n    <!-- ============ CTA FINAL + NEWSLETTER ============ -->\n    <section class=\"scroll-mt-28 py-20 lg:py-28\" data-kid=\"1-17\" id=\"empezar-ahora\">\n        <div class=\"mx-auto max-w-7xl px-4 sm:px-6 lg:px-8\" data-kid=\"1-17-1\">\n            <div class=\"grid overflow-hidden rounded-3xl bg-[linear-gradient(135deg,#5b21b6,#7c3aed)] lg:grid-cols-12\" data-kid=\"1-17-1-1\">\n                <div class=\"p-8 text-white lg:col-span-7 lg:p-14\" data-kid=\"1-17-1-1-1\">\n                    <h2 class=\"text-3xl font-extrabold leading-tight tracking-tight lg:text-[2.6rem]\" data-kid=\"1-17-1-1-1-1\">\n                        Empezá hoy y decidí con los datos de tu propia consulta.\n                    </h2>\n                    <p class=\"mt-5 max-w-xl text-base leading-relaxed text-white/85\" data-kid=\"1-17-1-1-1-2\">\n                        14 días con todas las funciones, sin tarjeta de crédito y sin compromiso de permanencia. Si te queda\n            una duda puntual, el asistente responde al instante o te contesta el equipo por WhatsApp.\n                    </p>\n                    <div class=\"mt-9 flex flex-wrap items-center gap-3\" data-kid=\"1-17-1-1-1-3\">\n                        <a class=\"inline-flex items-center gap-2 rounded-full bg-white px-6 py-3.5 text-sm font-bold text-[#5b21b6] transition-transform hover:-translate-y-0.5\" data-kid=\"1-17-1-1-1-3-1\" href=\"#planes\">\n                            Comenzar prueba de 14 días\n                            <i class=\"ph ph-arrow-right text-[16px]\" data-kid=\"1-17-1-1-1-3-1-1\">\n                            </i>\n                        </a>\n                        <a class=\"inline-flex items-center gap-2 rounded-full border border-white/40 px-6 py-3.5 text-sm font-bold text-white transition-colors hover:border-white\" data-kid=\"1-17-1-1-1-3-2\" href=\"https://wa.me/584243153383?text=Hola,%20quiero%20informaci%C3%B3n%20sobre%20Nutringest\" rel=\"noopener noreferrer\" target=\"_blank\">\n                            <i class=\"ph ph-whatsapp-logo text-[16px]\" data-kid=\"1-17-1-1-1-3-2-1\">\n                            </i>\n                            Hablar con el equipo\n                        </a>\n                    </div>\n                    <p class=\"mt-7 flex items-center gap-2 text-xs text-white/70\" data-kid=\"1-17-1-1-1-4\">\n                        <i class=\"ph ph-sparkle text-[14px]\" data-kid=\"1-17-1-1-1-4-1\">\n                        </i>\n                        Asistente IA y WhatsApp siempre disponibles abajo a la derecha.\n                    </p>\n                </div>\n                <div class=\"border-t border-white/15 bg-white/5 p-8 lg:col-span-5 lg:border-l lg:border-t-0 lg:p-12\" data-kid=\"1-17-1-1-2\">\n                    <p class=\"text-[11px] font-bold uppercase tracking-[0.22em] text-white/70\" data-kid=\"1-17-1-1-2-1\">\n                        Novedades\n                    </p>\n                    <h3 class=\"mt-4 text-xl font-bold text-white\" data-kid=\"1-17-1-1-2-2\">\n                        Guías y novedades para nutricionistas\n                    </h3>\n                    <p class=\"mt-3 text-[13px] leading-relaxed text-white/75\" data-kid=\"1-17-1-1-2-3\">\n                        Dejanos tu correo y te avisamos cuando publiquemos una guía nueva o una función que te sirva.\n                    </p>\n                    <form class=\"mt-6\" data-kid=\"1-17-1-1-2-4\" onsubmit=\"return false\">\n                        <label class=\"sr-only\" data-kid=\"1-17-1-1-2-4-1\" for=\"ngNewsEmail\">\n                            Correo electrónico\n                        </label>\n                        <div class=\"flex flex-col gap-3 sm:flex-row\" data-kid=\"1-17-1-1-2-4-2\">\n                            <input class=\"w-full min-w-0 rounded-full border border-white/25 bg-white/10 px-5 py-3 text-sm text-white outline-none placeholder:text-white/50\" data-kid=\"1-17-1-1-2-4-2-1\" id=\"ngNewsEmail\" name=\"email\" placeholder=\"tu@correo.com\" type=\"email\"/>\n                            <button class=\"shrink-0 rounded-full bg-white px-6 py-3 text-sm font-bold text-[#5b21b6] transition-transform hover:-translate-y-0.5\" data-kid=\"1-17-1-1-2-4-2-2\" type=\"submit\">\n                                Suscribirme\n                            </button>\n                        </div>\n                    </form>\n                    <p class=\"mt-4 text-[11px] text-white/55\" data-kid=\"1-17-1-1-2-5\">\n                        Usamos tu correo solo para esto y no lo compartimos con terceros.\n                    </p>\n                </div>\n            </div>\n        </div>\n    </section>\n    <!-- ============ FOOTER ============ -->\n    <footer class=\"ng-footer\" data-kid=\"1-8\">\n        <div class=\"mx-auto max-w-7xl px-4 py-16 sm:px-6 lg:px-8 lg:py-20\" data-kid=\"1-8-1\">\n            <div class=\"grid gap-12 lg:grid-cols-12 lg:gap-10\" data-kid=\"1-8-1-1\">\n                <div class=\"lg:col-span-5\" data-kid=\"1-8-1-1-1\">\n                    <img alt=\"Nutringest\" class=\"h-7 w-auto\" data-kid=\"1-8-1-1-1-1\" decoding=\"async\" src=\"/api/local/images/webapp/public/png/ImagotipoBlanco.png\"/>\n                    <p class=\"mt-6 max-w-sm text-sm leading-relaxed text-white/55\" data-kid=\"1-8-1-1-1-2\">\n                        Plataforma de gestión integral para consultorios nutricionales. Historia clínica, antropometría,\n            planes alimenticios y seguimiento en un mismo lugar.\n                    </p>\n                    <a class=\"mt-7 inline-flex items-center gap-2.5 rounded-full border border-white/15 px-4 py-2.5 text-xs font-bold text-white transition-colors hover:border-white/40\" data-kid=\"1-8-1-1-1-3\" href=\"https://www.instagram.com/nutringest/\" rel=\"noopener noreferrer\" target=\"_blank\">\n                        <i class=\"ph ph-instagram-logo text-[16px]\" data-kid=\"1-8-1-1-1-3-1\">\n                        </i>\n                        @nutringest\n                    </a>\n                </div>\n                <div class=\"lg:col-span-3\" data-kid=\"1-8-1-1-2\">\n                    <h4 class=\"text-[11px] font-bold uppercase tracking-[0.18em] text-white/45\" data-kid=\"1-8-1-1-2-1\">\n                        Producto\n                    </h4>\n                    <ul class=\"mt-5 space-y-3 text-sm font-semibold\" data-kid=\"1-8-1-1-2-2\">\n                        <li data-kid=\"1-8-1-1-2-2-1\">\n                            <a class=\"text-white/70 transition-colors hover:text-white\" data-kid=\"1-8-1-1-2-2-1-1\" href=\"#alcance\">\n                                Funciones\n                            </a>\n                        </li>\n                        <li data-kid=\"1-8-1-1-2-2-2\">\n                            <a class=\"text-white/70 transition-colors hover:text-white\" data-kid=\"1-8-1-1-2-2-2-1\" href=\"#planes\">\n                                Planes y precios\n                            </a>\n                        </li>\n                        <li data-kid=\"1-8-1-1-2-2-3\">\n                            <a class=\"text-white/70 transition-colors hover:text-white\" data-kid=\"1-8-1-1-2-2-3-1\" href=\"#campus\">\n                                Nutringest Campus\n                            </a>\n                        </li>\n                        <li data-kid=\"1-8-1-1-2-2-4\">\n                            <a class=\"text-white/70 transition-colors hover:text-white\" data-kid=\"1-8-1-1-2-2-4-1\" href=\"#faq\">\n                                Preguntas frecuentes\n                            </a>\n                        </li>\n                    </ul>\n                </div>\n                <div class=\"lg:col-span-4\" data-kid=\"1-8-1-1-3\">\n                    <h4 class=\"text-[11px] font-bold uppercase tracking-[0.18em] text-white/45\" data-kid=\"1-8-1-1-3-1\">\n                        Contacto\n                    </h4>\n                    <ul class=\"mt-5 space-y-3.5 text-sm font-semibold\" data-kid=\"1-8-1-1-3-2\">\n                        <li data-kid=\"1-8-1-1-3-2-1\">\n                            <a class=\"inline-flex items-center gap-2.5 text-white/70 transition-colors hover:text-white\" data-kid=\"1-8-1-1-3-2-1-1\" href=\"mailto:nutringest@gmail.com\">\n                                <i class=\"ph ph-envelope-simple text-[16px]\" data-kid=\"1-8-1-1-3-2-1-1-1\">\n                                </i>\n                                nutringest@gmail.com\n                            </a>\n                        </li>\n                        <li data-kid=\"1-8-1-1-3-2-2\">\n                            <a class=\"inline-flex items-center gap-2.5 text-white/70 transition-colors hover:text-white\" data-kid=\"1-8-1-1-3-2-2-1\" href=\"https://wa.me/584243153383?text=Hola,%20tengo%20una%20consulta%20sobre%20Nutringest\" rel=\"noopener noreferrer\" target=\"_blank\">\n                                <svg aria-hidden=\"true\" class=\"h-4 w-4 shrink-0 fill-current\" data-kid=\"1-8-1-1-3-2-2-1-1\" viewbox=\"0 0 24 24\">\n                                    <path d=\"M.057 24l1.687-6.163c-1.041-1.804-1.588-3.849-1.587-5.946.003-6.556 5.338-11.891 11.893-11.891 3.181.001 6.167 1.24 8.413 3.488 2.245 2.248 3.481 5.236 3.48 8.414-.003 6.557-5.338 11.892-11.893 11.892-1.99-.001-3.951-.5-5.688-1.448l-6.305 1.654zm6.597-3.807c1.676.995 3.276 1.591 5.392 1.592 5.448 0 9.886-4.434 9.889-9.885.002-5.462-4.415-9.89-9.881-9.892-5.452 0-9.887 4.434-9.889 9.884-.001 2.225.651 3.891 1.746 5.634l-.999 3.648 3.742-.981zm11.387-5.464c-.074-.124-.272-.198-.57-.347-.297-.149-1.758-.867-2.03-.967-.272-.099-.47-.149-.669.149-.198.297-.768.967-.941 1.165-.173.198-.347.223-.644.074-.297-.149-1.255-.462-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.297-.347.446-.521.151-.172.2-.296.3-.495.099-.198.05-.372-.025-.521-.075-.148-.669-1.611-.916-2.206-.242-.579-.487-.501-.669-.51l-.57-.01c-.198 0-.52.074-.792.372s-1.04 1.016-1.04 2.479 1.065 2.876 1.213 3.074c.149.198 2.095 3.2 5.076 4.487.709.306 1.263.489 1.694.626.712.226 1.36.194 1.872.118.572-.085 1.758-.719 2.006-1.413.248-.695.248-1.29.173-1.414z\">\n                                    </path>\n                                </svg>\n                                +58 424-3153383\n                            </a>\n                        </li>\n                        <li class=\"flex items-center gap-2.5 text-white/70\" data-kid=\"1-8-1-1-3-2-3\">\n                            <i class=\"ph ph-map-pin text-[16px]\" data-kid=\"1-8-1-1-3-2-3-1\">\n                            </i>\n                            Guárico, Venezuela\n                        </li>\n                    </ul>\n                </div>\n            </div>\n            <div class=\"mt-14 flex flex-col items-center justify-between gap-4 border-t border-white/10 pt-8 text-xs text-white/40 sm:flex-row\" data-kid=\"1-8-1-2\">\n                <p data-kid=\"1-8-1-2-1\">\n                    © 2026 Nutringest. Todos los derechos reservados.\n                </p>\n                <p data-kid=\"1-8-1-2-2\">\n                    De nutricionistas, para nutricionistas.\n                </p>\n            </div>\n        </div>\n    </footer>\n    <!-- ============ BURBUJAS FLOTANTES ============ -->\n    <div class=\"fixed bottom-5 right-5 z-[60] flex flex-col items-end gap-3\" data-kid=\"1-9\">\n        <!-- Panel del agente IA -->\n        <div class=\"hidden w-[300px] overflow-hidden rounded-2xl border border-[var(--border)] bg-[var(--surface)] shadow-[var(--shadow)] sm:w-[350px]\" data-dynamic=\"true\" data-kid=\"1-9-1\" data-name=\"ia chat panel\" data-reason=\"visibility toggled by chat button script\" id=\"ngChat\">\n            <div class=\"flex items-center justify-between gap-3 bg-[linear-gradient(135deg,#5b21b6,#7c3aed)] px-4 py-3.5 text-white\" data-kid=\"1-9-1-1\">\n                <div class=\"flex items-center gap-2.5\" data-kid=\"1-9-1-1-1\">\n                    <span class=\"flex h-8 w-8 items-center justify-center rounded-full bg-white/15\" data-kid=\"1-9-1-1-1-1\">\n                        <i class=\"ph ph-sparkle text-[16px]\" data-kid=\"1-9-1-1-1-1-1\">\n                        </i>\n                    </span>\n                    <div data-kid=\"1-9-1-1-1-2\">\n                        <p class=\"text-[13px] font-bold leading-tight\" data-kid=\"1-9-1-1-1-2-1\">\n                            Asistente Nutringest\n                        </p>\n                        <p class=\"text-[11px] text-white/70\" data-kid=\"1-9-1-1-1-2-2\">\n                            Preguntas sobre funciones y planes\n                        </p>\n                    </div>\n                </div>\n                <button aria-label=\"Cerrar chat\" class=\"flex h-7 w-7 items-center justify-center rounded-full text-white/80 transition-colors hover:bg-white/15 hover:text-white\" data-kid=\"1-9-1-1-2\" id=\"ngChatClose\" type=\"button\">\n                    <i class=\"ph ph-x text-[15px]\" data-kid=\"1-9-1-1-2-1\">\n                    </i>\n                </button>\n            </div>\n            <div class=\"max-h-[260px] space-y-3 overflow-y-auto bg-[var(--bg-soft)] p-4\" data-kid=\"1-9-1-2\">\n                <div class=\"ml-auto max-w-[85%] rounded-2xl rounded-br-sm bg-[var(--btn)] px-3.5 py-2.5 text-[12.5px] leading-relaxed text-white\" data-kid=\"1-9-1-2-1\">\n                    ¿Qué diferencia hay entre PRO y PREMIUM?\n                </div>\n                <div class=\"max-w-[88%] rounded-2xl rounded-bl-sm border border-[var(--border)] bg-[var(--surface)] px-3.5 py-2.5 text-[12.5px] leading-relaxed text-[var(--ink-soft)]\" data-kid=\"1-9-1-2-2\">\n                    PREMIUM incluye todo lo de PRO y suma plantillas de dietas, portafolios digitales, nutrición deportiva y\n          pediátrica, referidos y atención en grupos.\n                </div>\n                <div class=\"ml-auto max-w-[85%] rounded-2xl rounded-br-sm bg-[var(--btn)] px-3.5 py-2.5 text-[12.5px] leading-relaxed text-white\" data-kid=\"1-9-1-2-3\">\n                    ¿Sirve para una clínica con varios nutricionistas?\n                </div>\n                <div class=\"max-w-[88%] rounded-2xl rounded-bl-sm border border-[var(--border)] bg-[var(--surface)] px-3.5 py-2.5 text-[12.5px] leading-relaxed text-[var(--ink-soft)]\" data-kid=\"1-9-1-2-4\">\n                    Sí, el plan Clínica agrega multi-nutricionista, gestión de equipo, marca personalizada y analíticas\n          avanzadas. Son $99.99/mes o $9.99 por nutricionista.\n                </div>\n            </div>\n            <div class=\"flex items-center gap-2 border-t border-[var(--border)] bg-[var(--surface)] p-3\" data-kid=\"1-9-1-3\">\n                <input aria-label=\"Escribí tu pregunta\" class=\"min-w-0 flex-1 rounded-full border border-[var(--border)] bg-[var(--bg-soft)] px-4 py-2.5 text-[12.5px] text-[var(--ink)] outline-none placeholder:text-[var(--muted)]\" data-kid=\"1-9-1-3-1\" placeholder=\"Escribí tu pregunta…\" type=\"text\"/>\n                <button aria-label=\"Enviar mensaje\" class=\"flex h-9 w-9 shrink-0 items-center justify-center rounded-full bg-[var(--btn)] text-white\" data-kid=\"1-9-1-3-2\" type=\"button\">\n                    <i class=\"ph ph-arrow-right text-[15px]\" data-kid=\"1-9-1-3-2-1\">\n                    </i>\n                </button>\n            </div>\n        </div>\n        <!-- Burbuja IA -->\n        <button aria-label=\"Abrir chat con el asistente de IA\" class=\"flex h-14 w-14 items-center justify-center rounded-full bg-[linear-gradient(135deg,#5b21b6,#7c3aed)] text-white shadow-[0_10px_30px_-8px_rgba(91,33,182,.7)] transition-transform hover:scale-105\" data-kid=\"1-9-2\" id=\"ngChatBtn\" type=\"button\">\n            <i class=\"ph ph-sparkle text-[22px]\" data-kid=\"1-9-2-1\">\n            </i>\n        </button>\n        <!-- Burbuja WhatsApp -->\n        <a aria-label=\"Escribir por WhatsApp\" class=\"flex h-14 w-14 items-center justify-center rounded-full bg-[#25D366] text-white shadow-[0_10px_30px_-8px_rgba(37,211,102,.7)] transition-transform hover:scale-105\" data-kid=\"1-9-3\" href=\"https://wa.me/584243153383?text=Hola,%20tengo%20una%20consulta%20sobre%20Nutringest\" rel=\"noopener noreferrer\" target=\"_blank\">\n            <svg aria-hidden=\"true\" class=\"h-6 w-6 fill-white\" data-kid=\"1-9-3-1\" viewbox=\"0 0 24 24\">\n                <path d=\"M.057 24l1.687-6.163c-1.041-1.804-1.588-3.849-1.587-5.946.003-6.556 5.338-11.891 11.893-11.891 3.181.001 6.167 1.24 8.413 3.488 2.245 2.248 3.481 5.236 3.48 8.414-.003 6.557-5.338 11.892-11.893 11.892-1.99-.001-3.951-.5-5.688-1.448l-6.305 1.654zm6.597-3.807c1.676.995 3.276 1.591 5.392 1.592 5.448 0 9.886-4.434 9.889-9.885.002-5.462-4.415-9.89-9.881-9.892-5.452 0-9.887 4.434-9.889 9.884-.001 2.225.651 3.891 1.746 5.634l-.999 3.648 3.742-.981zm11.387-5.464c-.074-.124-.272-.198-.57-.347-.297-.149-1.758-.867-2.03-.967-.272-.099-.47-.149-.669.149-.198.297-.768.967-.941 1.165-.173.198-.347.223-.644.074-.297-.149-1.255-.462-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.297-.347.446-.521.151-.172.2-.296.3-.495.099-.198.05-.372-.025-.521-.075-.148-.669-1.611-.916-2.206-.242-.579-.487-.501-.669-.51l-.57-.01c-.198 0-.52.074-.792.372s-1.04 1.016-1.04 2.479 1.065 2.876 1.213 3.074c.149.198 2.095 3.2 5.076 4.487.709.306 1.263.489 1.694.626.712.226 1.36.194 1.872.118.572-.085 1.758-.719 2.006-1.413.248-.695.248-1.29.173-1.414z\">\n                </path>\n            </svg>\n        </a>\n    </div>\n    <script>\n        (function () {\n      var root = document.getElementById('ng-root');\n      var params = {};\n      try { new URLSearchParams(window.location.search).forEach(function (v, k) { params[k] = v; }); } catch (e) {}\n      var themeBtn = document.getElementById('ngTheme');\n\n      function currentTheme() { return root.getAttribute('data-theme') === 'dark' ? 'dark' : 'light'; }\n\n      function syncThemeBtn() {\n        themeBtn.innerHTML = '<i class=\"ph ' + (currentTheme() === 'dark' ? 'ph-sun' : 'ph-moon') + ' text-[18px]\"></i>';\n      }\n\n      var initial = params.theme;\n      if (initial !== 'dark' && initial !== 'light') {\n        try { initial = localStorage.getItem('ng-theme'); } catch (e) { initial = null; }\n      }\n      if (initial !== 'dark' && initial !== 'light') {\n        initial = (window.matchMedia && window.matchMedia('(prefers-color-scheme: dark)').matches) ? 'dark' : 'light';\n      }\n      root.setAttribute('data-theme', initial);\n      syncThemeBtn();\n\n      themeBtn.addEventListener('click', function () {\n        var next = currentTheme() === 'dark' ? 'light' : 'dark';\n        root.setAttribute('data-theme', next);\n        try { localStorage.setItem('ng-theme', next); } catch (e) {}\n        syncThemeBtn();\n      });\n\n      var navInner = document.getElementById('ngNavInner');\n      function onScroll() {\n        if (window.scrollY > 16) { navInner.classList.add('ng-nav-solid'); }\n        else { navInner.classList.remove('ng-nav-solid'); }\n      }\n      onScroll();\n      window.addEventListener('scroll', onScroll, { passive: true });\n\n      var menuBtn = document.getElementById('ngMenuBtn');\n      var menu = document.getElementById('ngMenu');\n      menuBtn.addEventListener('click', function () { menu.classList.toggle('hidden'); });\n      Array.prototype.forEach.call(menu.querySelectorAll('a'), function (a) {\n        a.addEventListener('click', function () { menu.classList.add('hidden'); });\n      });\n\n      var chatBtn = document.getElementById('ngChatBtn');\n      var chatPanel = document.getElementById('ngChat');\n      var chatClose = document.getElementById('ngChatClose');\n      chatBtn.addEventListener('click', function () { chatPanel.classList.toggle('hidden'); });\n      chatClose.addEventListener('click', function () { chatPanel.classList.add('hidden'); });\n    })();\n    </script>\n</div>\n",
