        "w": 1280,
        "h": 800
      },
      "html": "<style>\n    @import url(\"https://cdn.jsdelivr.net/npm/@phosphor-icons/web@2.1.1/src/regular/style.css\");\n  @import url('https://fonts.googleapis.com/css2?family=Montserrat:wght@300;400;500;600;700;800;900&display=swap');\n\n  #ng-root{\n    font-family:'Montserrat',system-ui,-apple-system,'Segoe UI',sans-serif;\n    --bg:#ffffff; --bg-soft:#f8f7fc; --surface:#ffffff; --surface-2:#f2f1f8;\n    --ink:#14111c; --ink-soft:#443f57; --muted:#6d6885; --border:#e7e5f0;\n    --brand:#5b21b6; --brand-2:#7c3aed; --blue:#0ea5e9; --btn:#5b21b6;\n    --footer-bg:#120e1c; --footer-ink:#efeaff;\n    --shadow:0 1px 2px rgba(20,17,28,.04), 0 14px 36px -14px rgba(20,17,28,.12);\n  }\n  #ng-root[data-theme=\"dark\"]{\n    --bg:#0c0a13; --bg-soft:#100d1a; --surface:#16122a; --surface-2:#1d1832;\n    --ink:#f4f2fa; --ink-soft:#d8d4e8; --muted:#9d97b5; --border:#2b2542;\n    --brand:#a78bfa; --brand-2:#8b5cf6; --blue:#38bdf8; --btn:#7c3aed;\n    --footer-bg:#08060e; --footer-ink:#e9e3ff;\n    --shadow:0 1px 2px rgba(0,0,0,.5), 0 20px 44px -18px rgba(0,0,0,.75);\n  }\n  .ng-logo-light{display:block}\n  .ng-logo-dark{display:none}\n  #ng-root[data-theme=\"dark\"] .ng-logo-light{display:none}\n  #ng-root[data-theme=\"dark\"] .ng-logo-dark{display:block}\n  #ng-root .ng-nav-solid{\n    background-color:color-mix(in oklab, var(--surface) 88%, transparent);\n    border-color:var(--border);\n    -webkit-backdrop-filter:blur(14px);\n    backdrop-filter:blur(14px);\n    box-shadow:var(--shadow);\n  }\n  #ng-root .ng-footer{background-color:var(--footer-bg);color:var(--footer-ink)}\n  #ng-root summary.ng-sum{list-style:none}\n  #ng-root summary.ng-sum::-webkit-details-marker{display:none}\n  #ng-root details[open] .ng-plus{transform:rotate(45deg)}\n</style>\n<div class=\"min-h-screen overflow-x-hidden bg-[var(--bg)] text-[var(--ink)]\" data-kid=\"1\" data-name=\"page layout container\" data-theme=\"light\" id=\"ng-root\">\n    <!-- ============ NAVBAR (fijo) ============ -->\n    <header class=\"fixed inset-x-0 top-0 z-50\" data-kid=\"1-1\" id=\"ngNav\">\n        <div class=\"mx-auto max-w-7xl px-4 sm:px-6 lg:px-8\" data-kid=\"1-1-1\">\n            <div class=\"mt-3 flex items-center justify-between gap-4 rounded-[26px] border border-transparent px-3 py-2.5 transition-all duration-300 lg:px-4\" data-kid=\"1-1-1-1\" id=\"ngNavInner\">\n                <a class=\"flex shrink-0 items-center gap-3\" data-kid=\"1-1-1-1-1\" href=\"#top\">\n                    <img alt=\"Nutringest\" class=\"ng-logo-light h-6 w-auto lg:h-7\" data-kid=\"1-1-1-1-1-1\" decoding=\"async\" src=\"/api/local/images/webapp/public/png/ImagotipoPurpura.png\"/>\n                    <img alt=\"Nutringest\" class=\"ng-logo-dark h-6 w-auto lg:h-7\" data-kid=\"1-1-1-1-1-2\" decoding=\"async\" src=\"/api/local/images/webapp/public/png/ImagotipoBlanco.png\"/>\n                </a>\n                <nav class=\"hidden items-center gap-0.5 lg:flex\" data-kid=\"1-1-1-1-2\">\n                    <a class=\"rounded-full px-3.5 py-2 text-[13px] font-semibold text-[var(--ink-soft)] transition-colors hover:bg-[var(--surface-2)] hover:text-[var(--brand)]\" data-kid=\"1-1-1-1-2-1\" href=\"#alcance\">\n                        Funciones\n                    </a>\n                    <a class=\"rounded-full px-3.5 py-2 text-[13px] font-semibold text-[var(--ink-soft)] transition-colors hover:bg-[var(--surface-2)] hover:text-[var(--brand)]\" data-kid=\"1-1-1-1-2-5\" href=\"#perfiles\">\n                        Para quién\n                    </a>\n                    <a class=\"rounded-full px-3.5 py-2 text-[13px] font-semibold text-[var(--ink-soft)] transition-colors hover:bg-[var(--surface-2)] hover:text-[var(--brand)]\" data-kid=\"1-1-1-1-2-2\" href=\"#campus\">\n                        Campus\n                    </a>\n                    <a class=\"rounded-full px-3.5 py-2 text-[13px] font-semibold text-[var(--ink-soft)] transition-colors hover:bg-[var(--surface-2)] hover:text-[var(--brand)]\" data-kid=\"1-1-1-1-2-3\" href=\"#planes\">\n                        Planes\n                    </a>\n                    <a class=\"rounded-full px-3.5 py-2 text-[13px] font-semibold text-[var(--ink-soft)] transition-colors hover:bg-[var(--surface-2)] hover:text-[var(--brand)]\" data-kid=\"1-1-1-1-2-4\" href=\"#faq\">\n                        FAQ\n                    </a>\n                </nav>\n                <div class=\"flex items-center gap-2\" data-kid=\"1-1-1-1-3\">\n                    <button aria-label=\"Cambiar entre modo claro y oscuro\" class=\"flex h-9 w-9 items-center justify-center rounded-full border border-[var(--border)] bg-[var(--surface)] text-[var(--ink-soft)] transition-colors hover:text-[var(--brand)]\" data-dynamic=\"true\" data-kid=\"1-1-1-1-3-1\" data-name=\"theme toggle button\" data-reason=\"icon replaced on theme change by script\" id=\"ngTheme\" type=\"button\">\n                    </button>\n                    <a class=\"hidden items-center gap-2 rounded-full bg-[var(--btn)] px-4 py-2.5 text-[13px] font-bold text-white transition-opacity hover:opacity-90 sm:inline-flex\" data-kid=\"1-1-1-1-3-2\" href=\"#planes\">\n                        Prueba 14 días\n                        <i class=\"ph ph-arrow-right text-[14px]\" data-kid=\"1-1-1-1-3-2-1\">\n                        </i>\n                    </a>\n                    <button aria-label=\"Abrir menú\" class=\"flex h-9 w-9 items-center justify-center rounded-full border border-[var(--border)] bg-[var(--surface)] text-[var(--ink)] lg:hidden\" data-kid=\"1-1-1-1-3-3\" id=\"ngMenuBtn\" type=\"button\">\n                        <i class=\"ph ph-list text-[18px]\" data-kid=\"1-1-1-1-3-3-1\">\n                        </i>\n                    </button>\n                </div>\n            </div>\n            <div class=\"mt-2 hidden rounded-2xl border border-[var(--border)] bg-[var(--surface)] p-3 shadow-lg lg:hidden\" data-dynamic=\"true\" data-kid=\"1-1-1-2\" data-name=\"mobile navigation menu\" data-reason=\"visibility toggled by menu button script\" id=\"ngMenu\">\n                <a class=\"block rounded-xl px-4 py-3 text-sm font-semibold text-[var(--ink-soft)] hover:bg-[var(--surface-2)]\" data-kid=\"1-1-1-2-1\" href=\"#alcance\">\n                    Funciones\n                </a>\n                <a class=\"block rounded-xl px-4 py-3 text-sm font-semibold text-[var(--ink-soft)] hover:bg-[var(--surface-2)]\" data-kid=\"1-1-1-2-6\" href=\"#perfiles\">\n                    Para quién es\n                </a>\n                <a class=\"block rounded-xl px-4 py-3 text-sm font-semibold text-[var(--ink-soft)] hover:bg-[var(--surface-2)]\" data-kid=\"1-1-1-2-2\" href=\"#campus\">\n                    Campus\n                </a>\n                <a class=\"block rounded-xl px-4 py-3 text-sm font-semibold text-[var(--ink-soft)] hover:bg-[var(--surface-2)]\" data-kid=\"1-1-1-2-3\" href=\"#planes\">\n                    Planes\n                </a>\n                <a class=\"block rounded-xl px-4 py-3 text-sm font-semibold text-[var(--ink-soft)] hover:bg-[var(--surface-2)]\" data-kid=\"1-1-1-2-4\" href=\"#faq\">\n                    Preguntas frecuentes\n                </a>\n                <a class=\"mt-2 block rounded-xl bg-[var(--btn)] px-4 py-3 text-center text-sm font-bold text-white\" data-kid=\"1-1-1-2-5\" href=\"#planes\">\n                    Comenzar prueba de 14 días\n                </a>\n            </div>\n        </div>\n    </header>\n    <!-- ============ HERO ============ -->\n    <section class=\"relative pb-16 pt-28 lg:pb-24 lg:pt-36\" data-kid=\"1-2\" id=\"top\">\n        <div class=\"mx-auto max-w-7xl px-4 sm:px-6 lg:px-8\" data-kid=\"1-2-1\">\n            <div class=\"grid items-center gap-12 lg:grid-cols-12 lg:gap-16\" data-kid=\"1-2-1-1\">\n                <div class=\"lg:col-span-6\" data-kid=\"1-2-1-1-1\">\n                    <p class=\"flex items-center gap-3 text-[11px] font-bold uppercase tracking-[0.22em] text-[var(--muted)]\" data-kid=\"1-2-1-1-1-1\">\n                        <span class=\"h-px w-8 bg-[var(--blue)]\" data-kid=\"1-2-1-1-1-1-1\">\n                        </span>\n                        Software de gestión para nutricionistas\n                    </p>\n                    <h1 class=\"mt-7 text-[2.5rem] font-extrabold leading-[1.04] tracking-tight sm:text-[3.4rem] lg:text-[4.1rem]\" data-kid=\"1-2-1-1-1-2\">\n                        Del primer paciente\n                        <br class=\"hidden sm:block\" data-kid=\"1-2-1-1-1-2-1\"/>\n                        a la clínica completa.\n                    </h1>\n                    <p class=\"mt-7 max-w-xl text-base leading-relaxed text-[var(--ink-soft)] sm:text-lg\" data-kid=\"1-2-1-1-1-3\">\n                        Nutringest reúne historia clínica, antropometría, planes alimenticios y seguimiento\n            en un mismo lugar. Empezá por tu cuenta, sumá especialidades y coordiná a tu equipo cuando lo necesités.\n                    </p>\n                    <div class=\"mt-9 flex flex-wrap items-center gap-3\" data-kid=\"1-2-1-1-1-4\">\n                        <a class=\"inline-flex items-center gap-2 rounded-full bg-[var(--btn)] px-6 py-3.5 text-sm font-bold text-white transition-opacity hover:opacity-90\" data-kid=\"1-2-1-1-1-4-1\" href=\"#planes\">\n                            Comenzar prueba de 14 días\n                            <i class=\"ph ph-arrow-right text-[16px]\" data-kid=\"1-2-1-1-1-4-1-1\">\n                            </i>\n                        </a>\n                        <a class=\"inline-flex items-center gap-2 rounded-full border border-[var(--border)] px-6 py-3.5 text-sm font-bold text-[var(--ink)] transition-colors hover:border-[var(--brand)] hover:text-[var(--brand)]\" data-kid=\"1-2-1-1-1-4-2\" href=\"#alcance\">\n                            Ver qué incluye\n                        </a>\n                    </div>\n                    <p class=\"mt-4 text-[13px] font-medium text-[var(--muted)]\" data-kid=\"1-2-1-1-1-5\">\n                        14 días completos y sin tarjeta de crédito.\n                    </p>\n                </div>\n                <div class=\"lg:col-span-6\" data-kid=\"1-2-1-1-2\">\n                    <figure data-kid=\"1-2-1-1-2-1\">\n                        <img alt=\"Consulta nutricional en un consultorio — Los Muertos Crew en Pexels\" class=\"h-[340px] w-full rounded-2xl border border-[var(--border)] object-cover sm:h-[440px] lg:h-[540px]\" data-kid=\"1-2-1-1-2-1-1\" decoding=\"async\" loading=\"lazy\" src=\"https://images.pexels.com/photos/8460095/pexels-photo-8460095.jpeg?auto=compress&cs=tinysrgb&w=1400\"/>\n                        <figcaption class=\"mt-3 max-w-md text-xs leading-relaxed text-[var(--muted)]\" data-kid=\"1-2-1-1-2-1-2\">\n                            La misma información acompaña la consulta, el plan y el seguimiento: no hay que volver a cargar nada.\n                        </figcaption>\n                    </figure>\n                </div>\n            </div>\n            <!-- Progresión: profesional -> especialidades -> equipo -->\n            <div class=\"mt-16 grid gap-px overflow-hidden rounded-2xl border border-[var(--border)] bg-[var(--border)] sm:grid-cols-3 lg:mt-24\" data-kid=\"1-2-1-2\">\n                <div class=\"bg-[var(--surface)] p-6 lg:p-8\" data-kid=\"1-2-1-2-1\">\n                    <p class=\"text-[11px] font-bold tracking-[0.22em] text-[var(--blue)]\" data-kid=\"1-2-1-2-1-1\">\n                        01\n                    </p>\n                    <h3 class=\"mt-3 text-lg font-bold lg:text-xl\" data-kid=\"1-2-1-2-1-2\">\n                        Consulta individual\n                    </h3>\n                    <p class=\"mt-2 text-[13px] leading-relaxed text-[var(--muted)]\" data-kid=\"1-2-1-2-1-3\">\n                        Historia clínica, antropometría y planes para tu consultorio propio.\n                    </p>\n                </div>\n                <div class=\"bg-[var(--surface)] p-6 lg:p-8\" data-kid=\"1-2-1-2-2\">\n                    <p class=\"text-[11px] font-bold tracking-[0.22em] text-[var(--brand)]\" data-kid=\"1-2-1-2-2-1\">\n                        02\n                    </p>\n                    <h3 class=\"mt-3 text-lg font-bold lg:text-xl\" data-kid=\"1-2-1-2-2-2\">\n                        Especialidades\n                    </h3>\n                    <p class=\"mt-2 text-[13px] leading-relaxed text-[var(--muted)]\" data-kid=\"1-2-1-2-2-3\">\n                        Nutrición deportiva, pediátrica y plantillas propias cuando querés profundizar.\n                    </p>\n                </div>\n                <div class=\"bg-[var(--surface)] p-6 lg:p-8\" data-kid=\"1-2-1-2-3\">\n                    <p class=\"text-[11px] font-bold tracking-[0.22em] text-[var(--brand-2)]\" data-kid=\"1-2-1-2-3-1\">\n                        03\n                    </p>\n                    <h3 class=\"mt-3 text-lg font-bold lg:text-xl\" data-kid=\"1-2-1-2-3-2\">\n                        Equipos y clínicas\n                    </h3>\n                    <p class=\"mt-2 text-[13px] leading-relaxed text-[var(--muted)]\" data-kid=\"1-2-1-2-3-3\">\n                        Multi-nutricionista, gestión de equipo, marca propia y analíticas avanzadas.\n                    </p>\n                </div>\n            </div>\n        </div>\n    </section>\n    <!-- ============ CTA + MÉTRICAS ============ -->\n    <section class=\"border-y border-[var(--border)] bg-[var(--bg-soft)] py-16 lg:py-24\" data-kid=\"1-3\">\n        <div class=\"mx-auto max-w-7xl px-4 sm:px-6 lg:px-8\" data-kid=\"1-3-1\">\n            <div class=\"grid gap-10 lg:grid-cols-12 lg:gap-16\" data-kid=\"1-3-1-1\">\n                <div class=\"lg:col-span-4\" data-kid=\"1-3-1-1-1\">\n                    <h2 class=\"text-3xl font-extrabold leading-tight tracking-tight lg:text-[2.6rem]\" data-kid=\"1-3-1-1-1-1\">\n                        Cifras que sirven para decidir, no para decorar.\n                    </h2>\n                    <p class=\"mt-5 text-base leading-relaxed text-[var(--ink-soft)]\" data-kid=\"1-3-1-1-1-2\">\n                        Cada dato aparece con su condición al lado: qué incluye, quién aplica y sobre qué plan se aplica.\n                    </p>\n                </div>\n                <div class=\"grid gap-x-10 gap-y-9 sm:grid-cols-2 lg:col-span-8\" data-kid=\"1-3-1-1-2\">\n                    <div class=\"border-l border-[var(--border)] pl-6\" data-kid=\"1-3-1-1-2-1\">\n                        <p class=\"text-4xl font-extrabold tracking-tight lg:text-5xl\" data-kid=\"1-3-1-1-2-1-1\">\n                            14 días\n                        </p>\n                        <p class=\"mt-2 text-[13px] leading-relaxed text-[var(--muted)]\" data-kid=\"1-3-1-1-2-1-2\">\n                            De prueba completa, con todas las funciones y sin tarjeta de crédito.\n                        </p>\n                    </div>\n                    <div class=\"border-l border-[var(--border)] pl-6\" data-kid=\"1-3-1-1-2-2\">\n                        <p class=\"text-4xl font-extrabold tracking-tight lg:text-5xl\" data-kid=\"1-3-1-1-2-2-1\">\n                            120 días\n                        </p>\n                        <p class=\"mt-2 text-[13px] leading-relaxed text-[var(--muted)]\" data-kid=\"1-3-1-1-2-2-2\">\n                            Premium gratis para estudiantes de último año o en pasantías, vía Nutringest Campus.\n                        </p>\n                    </div>\n                    <div class=\"border-l border-[var(--border)] pl-6\" data-kid=\"1-3-1-1-2-3\">\n                        <p class=\"text-4xl font-extrabold tracking-tight lg:text-5xl\" data-kid=\"1-3-1-1-2-3-1\">\n                            60%\n                        </p>\n                        <p class=\"mt-2 text-[13px] leading-relaxed text-[var(--muted)]\" data-kid=\"1-3-1-1-2-3-2\">\n                            De ahorro en la preventa del plan PRO: $4.00/mes en lugar de $10.00/mes.\n                        </p>\n                    </div>\n                    <div class=\"border-l border-[var(--border)] pl-6\" data-kid=\"1-3-1-1-2-4\">\n                        <p class=\"text-4xl font-extrabold tracking-tight lg:text-5xl\" data-kid=\"1-3-1-1-2-4-1\">\n                            20%\n                        </p>\n                        <p class=\"mt-2 text-[13px] leading-relaxed text-[var(--muted)]\" data-kid=\"1-3-1-1-2-4-2\">\n                            De ahorro en la preventa del plan PREMIUM: $20.00/mes en lugar de $25.00/mes.\n                        </p>\n                    </div>\n                </div>\n            </div>\n            <div class=\"mt-14 flex flex-col items-start justify-between gap-6 rounded-2xl border border-[var(--border)] bg-[var(--surface)] p-7 lg:mt-16 lg:flex-row lg:items-center lg:p-9\" data-kid=\"1-3-1-2\">\n                <div data-kid=\"1-3-1-2-1\">\n                    <h3 class=\"text-xl font-bold lg:text-2xl\" data-kid=\"1-3-1-2-1-1\">\n                        Empezá con PRO y pasá a PREMIUM o a Clínica cuando tu práctica lo pida.\n                    </h3>\n                    <p class=\"mt-2 text-[13px] text-[var(--muted)]\" data-kid=\"1-3-1-2-1-2\">\n                        Clínica: $99.99/mes o $9.99 por nutricionista al mes. Facturado mensualmente.\n                    </p>\n                </div>\n                <div class=\"flex shrink-0 flex-wrap gap-3\" data-kid=\"1-3-1-2-2\">\n                    <a class=\"inline-flex items-center gap-2 rounded-full bg-[var(--btn)] px-5 py-3 text-sm font-bold text-white transition-opacity hover:opacity-90\" data-kid=\"1-3-1-2-2-1\" href=\"#planes\">\n                        Comenzar prueba de 14 días\n                    </a>\n                    <a class=\"inline-flex items-center gap-2 rounded-full border border-[var(--border)] px-5 py-3 text-sm font-bold text-[var(--ink)] transition-colors hover:border-[var(--brand)] hover:text-[var(--brand)]\" data-kid=\"1-3-1-2-2-2\" href=\"https://wa.me/584243153383?text=Hola,%20quiero%20saber%20cu%C3%A1l%20plan%20me%20conviene\" rel=\"noopener noreferrer\" target=\"_blank\">\n                        Hablar con el equipo\n                    </a>\n                </div>\n            </div>\n        </div>\n    </section>\n    <!-- ============ QUÉ ABARCA EL SOFTWARE ============ -->\n    <section class=\"scroll-mt-28 py-20 lg:py-32\" data-kid=\"1-4\" id=\"alcance\">\n        <div class=\"mx-auto max-w-7xl px-4 sm:px-6 lg:px-8\" data-kid=\"1-4-1\">\n            <div class=\"max-w-2xl\" data-kid=\"1-4-1-1\">\n                <p class=\"flex items-center gap-3 text-[11px] font-bold uppercase tracking-[0.22em] text-[var(--muted)]\" data-kid=\"1-4-1-1-1\">\n                    <span class=\"h-px w-8 bg-[var(--brand)]\" data-kid=\"1-4-1-1-1-1\">\n                    </span>\n                    Qué abarca el software\n                </p>\n                <h2 class=\"mt-6 text-3xl font-extrabold leading-tight tracking-tight lg:text-[2.75rem]\" data-kid=\"1-4-1-1-2\">\n                    Una plataforma que crece con tu práctica, sin cambiar de herramienta.\n                </h2>\n                <p class=\"mt-5 text-base leading-relaxed text-[var(--ink-soft)]\" data-kid=\"1-4-1-1-3\">\n                    Tres momentos distintos del trabajo nutricional. No son seis beneficios intercambiables: son las etapas que\n          van de la consulta a la coordinación.\n                </p>\n            </div>\n            <div class=\"mt-14 grid items-start gap-6 lg:grid-cols-12 lg:gap-8\" data-kid=\"1-4-1-2\">\n                <!-- 01 trabajo con el paciente -->\n                <article class=\"rounded-2xl border border-[var(--border)] bg-[var(--surface)] p-7 lg:col-span-4\" data-kid=\"1-4-1-2-1\">\n                    <div class=\"flex items-center gap-3\" data-kid=\"1-4-1-2-1-1\">\n                        <span class=\"flex h-10 w-10 items-center justify-center rounded-full bg-[var(--surface-2)] text-[var(--brand)]\" data-kid=\"1-4-1-2-1-1-1\">\n                            <i class=\"ph ph-user text-[20px]\" data-kid=\"1-4-1-2-1-1-1-1\">\n                            </i>\n                        </span>\n                        <p class=\"text-[11px] font-bold uppercase tracking-[0.18em] text-[var(--muted)]\" data-kid=\"1-4-1-2-1-1-2\">\n                            01 — Trabajo con el paciente\n                        </p>\n                    </div>\n                    <h3 class=\"mt-6 text-xl font-bold\" data-kid=\"1-4-1-2-1-2\">\n                        Todo lo que pasa en consulta, registrado\n                    </h3>\n                    <p class=\"mt-3 text-[13px] leading-relaxed text-[var(--muted)]\" data-kid=\"1-4-1-2-1-3\">\n                        El expediente se arma mientras atendés, sin transcribir después.\n                    </p>\n                    <ul class=\"mt-6 space-y-3 text-sm\" data-kid=\"1-4-1-2-1-4\">\n                        <li class=\"flex items-start gap-3\" data-kid=\"1-4-1-2-1-4-1\">\n                            <i class=\"ph ph-check mt-0.5 text-[16px] text-[var(--brand)]\" data-kid=\"1-4-1-2-1-4-1-1\">\n                            </i>\n                            <span data-kid=\"1-4-1-2-1-4-1-2\">\n                                Historia clínica digital y antecedentes\n                            </span>\n                        </li>\n                        <li class=\"flex items-start gap-3\" data-kid=\"1-4-1-2-1-4-2\">\n                            <i class=\"ph ph-check mt-0.5 text-[16px] text-[var(--brand)]\" data-kid=\"1-4-1-2-1-4-2-1\">\n                            </i>\n                            <span data-kid=\"1-4-1-2-1-4-2-2\">\n                                Consultas y seguimiento\n                            </span>\n                        </li>\n                        <li class=\"flex items-start gap-3\" data-kid=\"1-4-1-2-1-4-3\">\n                            <i class=\"ph ph-check mt-0.5 text-[16px] text-[var(--brand)]\" data-kid=\"1-4-1-2-1-4-3-1\">\n                            </i>\n                            <span data-kid=\"1-4-1-2-1-4-3-2\">\n                                App y portal para pacientes\n                            </span>\n                        </li>\n                    </ul>\n                    <img alt=\"Nutricionista y paciente durante una consulta — Los Muertos Crew en Pexels\" class=\"mt-7 h-44 w-full rounded-xl object-cover\" data-kid=\"1-4-1-2-1-5\" decoding=\"async\" loading=\"lazy\" src=\"https://images.pexels.com/photos/8460124/pexels-photo-8460124.jpeg?auto=compress&cs=tinysrgb&w=900\"/>\n                </article>\n                <!-- 02 producción del plan (más profundidad) -->\n                <article class=\"rounded-2xl border-2 border-[var(--brand)] bg-[var(--surface)] p-8 lg:col-span-5 lg:p-9\" data-kid=\"1-4-1-2-2\">\n                    <div class=\"flex items-center gap-3\" data-kid=\"1-4-1-2-2-1\">\n                        <span class=\"flex h-10 w-10 items-center justify-center rounded-full bg-[var(--brand)] text-white\" data-kid=\"1-4-1-2-2-1-1\">\n                            <i class=\"ph ph-bowl-food text-[20px]\" data-kid=\"1-4-1-2-2-1-1-1\">\n                            </i>\n                        </span>\n                        <p class=\"text-[11px] font-bold uppercase tracking-[0.18em] text-[var(--brand)]\" data-kid=\"1-4-1-2-2-1-2\">\n                            02 — Producción del plan\n                        </p>\n                    </div>\n                    <h3 class=\"mt-6 text-2xl font-bold leading-snug\" data-kid=\"1-4-1-2-2-2\">\n                        Del cálculo a la lista de compras, en un mismo flujo\n                    </h3>\n                    <p class=\"mt-3 text-sm leading-relaxed text-[var(--ink-soft)]\" data-kid=\"1-4-1-2-2-3\">\n                        Es el momento donde más tiempo se gana: los mismos datos alimentan medidas, menú, intercambios y compras.\n                    </p>\n                    <ul class=\"mt-7 grid gap-3.5 text-sm sm:grid-cols-2\" data-kid=\"1-4-1-2-2-4\">\n                        <li class=\"flex items-start gap-3\" data-kid=\"1-4-1-2-2-4-1\">\n                            <i class=\"ph ph-check mt-0.5 text-[16px] text-[var(--brand)]\" data-kid=\"1-4-1-2-2-4-1-1\">\n                            </i>\n                            <span data-kid=\"1-4-1-2-2-4-1-2\">\n                                Menús y planes de alimentación\n                            </span>\n                        </li>\n                        <li class=\"flex items-start gap-3\" data-kid=\"1-4-1-2-2-4-2\">\n                            <i class=\"ph ph-check mt-0.5 text-[16px] text-[var(--brand)]\" data-kid=\"1-4-1-2-2-4-2-1\">\n                            </i>\n                            <span data-kid=\"1-4-1-2-2-4-2-2\">\n                                Listas de intercambio\n                            </span>\n                        </li>\n                        <li class=\"flex items-start gap-3\" data-kid=\"1-4-1-2-2-4-3\">\n                            <i class=\"ph ph-check mt-0.5 text-[16px] text-[var(--brand)]\" data-kid=\"1-4-1-2-2-4-3-1\">\n                            </i>\n                            <span data-kid=\"1-4-1-2-2-4-3-2\">\n                                Listas de compras automáticas\n                            </span>\n                        </li>\n                        <li class=\"flex items-start gap-3\" data-kid=\"1-4-1-2-2-4-4\">\n                            <i class=\"ph ph-check mt-0.5 text-[16px] text-[var(--brand)]\" data-kid=\"1-4-1-2-2-4-4-1\">\n                            </i>\n                            <span data-kid=\"1-4-1-2-2-4-4-2\">\n                                Cálculo antropométrico\n                            </span>\n                        </li>\n                        <li class=\"flex items-start gap-3 sm:col-span-2\" data-kid=\"1-4-1-2-2-4-5\">\n                            <i class=\"ph ph-check mt-0.5 text-[16px] text-[var(--brand)]\" data-kid=\"1-4-1-2-2-4-5-1\">\n                            </i>\n                            <span data-kid=\"1-4-1-2-2-4-5-2\">\n                                Base de alimentos completa\n                            </span>\n                        </li>\n                    </ul>\n                    <img alt=\"Escritorio de trabajo con material de consulta — Jsme MILA en Pexels\" class=\"mt-7 h-40 w-full rounded-xl object-cover\" data-kid=\"1-4-1-2-2-5\" decoding=\"async\" loading=\"lazy\" src=\"https://images.pexels.com/photos/18459248/pexels-photo-18459248.jpeg?auto=compress&cs=tinysrgb&w=900\"/>\n                </article>\n                <!-- 03 coordinación y crecimiento -->\n                <article class=\"rounded-2xl border border-[var(--border)] bg-[var(--surface)] p-7 lg:col-span-3\" data-kid=\"1-4-1-2-3\">\n                    <div class=\"flex items-center gap-3\" data-kid=\"1-4-1-2-3-1\">\n                        <span class=\"flex h-10 w-10 items-center justify-center rounded-full bg-[var(--surface-2)] text-[var(--brand-2)]\" data-kid=\"1-4-1-2-3-1-1\">\n                            <i class=\"ph ph-users-three text-[20px]\" data-kid=\"1-4-1-2-3-1-1-1\">\n                            </i>\n                        </span>\n                        <p class=\"text-[11px] font-bold uppercase tracking-[0.18em] text-[var(--muted)]\" data-kid=\"1-4-1-2-3-1-2\">\n                            03 — Coordinación y crecimiento\n                        </p>\n                    </div>\n                    <h3 class=\"mt-6 text-xl font-bold\" data-kid=\"1-4-1-2-3-2\">\n                        Crecer sin perder el hilo clínico\n                    </h3>\n                    <p class=\"mt-3 text-[13px] leading-relaxed text-[var(--muted)]\" data-kid=\"1-4-1-2-3-3\">\n                        Recursos que se suman cuando la práctica se especializa o se vuelve equipo.\n                    </p>\n                    <ul class=\"mt-6 space-y-3 text-sm\" data-kid=\"1-4-1-2-3-4\">\n                        <li class=\"flex items-start gap-3\" data-kid=\"1-4-1-2-3-4-1\">\n                            <i class=\"ph ph-check mt-0.5 text-[16px] text-[var(--brand-2)]\" data-kid=\"1-4-1-2-3-4-1-1\">\n                            </i>\n                            <span data-kid=\"1-4-1-2-3-4-1-2\">\n                                Plantillas de dietas\n                            </span>\n                        </li>\n                        <li class=\"flex items-start gap-3\" data-kid=\"1-4-1-2-3-4-2\">\n                            <i class=\"ph ph-check mt-0.5 text-[16px] text-[var(--brand-2)]\" data-kid=\"1-4-1-2-3-4-2-1\">\n                            </i>\n                            <span data-kid=\"1-4-1-2-3-4-2-2\">\n                                Portafolios digitales Bio-Link\n                            </span>\n                        </li>\n                        <li class=\"flex items-start gap-3\" data-kid=\"1-4-1-2-3-4-3\">\n                            <i class=\"ph ph-check mt-0.5 text-[16px] text-[var(--brand-2)]\" data-kid=\"1-4-1-2-3-4-3-1\">\n                            </i>\n                            <span data-kid=\"1-4-1-2-3-4-3-2\">\n                                Nutrición deportiva\n                            </span>\n                        </li>\n                        <li class=\"flex items-start gap-3\" data-kid=\"1-4-1-2-3-4-4\">\n                            <i class=\"ph ph-check mt-0.5 text-[16px] text-[var(--brand-2)]\" data-kid=\"1-4-1-2-3-4-4-1\">\n                            </i>\n                            <span data-kid=\"1-4-1-2-3-4-4-2\">\n                                Nutrición pediátrica\n                            </span>\n                        </li>\n                        <li class=\"flex items-start gap-3\" data-kid=\"1-4-1-2-3-4-5\">\n                            <i class=\"ph ph-check mt-0.5 text-[16px] text-[var(--brand-2)]\" data-kid=\"1-4-1-2-3-4-5-1\">\n                            </i>\n                            <span data-kid=\"1-4-1-2-3-4-5-2\">\n                                Sistema de referidos\n                            </span>\n                        </li>\n                        <li class=\"flex items-start gap-3\" data-kid=\"1-4-1-2-3-4-6\">\n                            <i class=\"ph ph-check mt-0.5 text-[16px] text-[var(--brand-2)]\" data-kid=\"1-4-1-2-3-4-6-1\">\n                            </i>\n                            <span data-kid=\"1-4-1-2-3-4-6-2\">\n                                Atención en grupos\n                            </span>\n                        </li>\n                        <li class=\"flex items-start gap-3\" data-kid=\"1-4-1-2-3-4-7\">\n                            <i class=\"ph ph-check mt-0.5 text-[16px] text-[var(--brand-2)]\" data-kid=\"1-4-1-2-3-4-7-1\">\n                            </i>\n                            <span data-kid=\"1-4-1-2-3-4-7-2\">\n                                Gestión de equipo y analíticas\n                            </span>\n                        </li>\n                    </ul>\n                </article>\n            </div>\n        </div>\n    </section>\n    <!-- ============ PARA QUIÉN ES ============ -->\n    <section class=\"scroll-mt-28 border-y border-[var(--border)] bg-[var(--bg-soft)] py-20 lg:py-28\" data-kid=\"1-10\" id=\"perfiles\">\n        <div class=\"mx-auto max-w-7xl px-4 sm:px-6 lg:px-8\" data-kid=\"1-10-1\">\n            <div class=\"max-w-2xl\" data-kid=\"1-10-1-1\">\n                <p class=\"flex items-center gap-3 text-[11px] font-bold uppercase tracking-[0.22em] text-[var(--muted)]\" data-kid=\"1-10-1-1-1\">\n                    <span class=\"h-px w-8 bg-[var(--brand)]\" data-kid=\"1-10-1-1-1-1\">\n                    </span>\n                    Para quién es\n                </p>\n                <h2 class=\"mt-6 text-3xl font-extrabold leading-tight tracking-tight lg:text-[2.6rem]\" data-kid=\"1-10-1-1-2\">\n                    Empezá donde estás y sumá nivel cuando lo necesités.\n                </h2>\n                <p class=\"mt-5 text-base leading-relaxed text-[var(--ink-soft)]\" data-kid=\"1-10-1-1-3\">\n                    Cuatro puntos de partida distintos sobre la misma plataforma. Ubicá el que se parezca a tu práctica de hoy\n          y mirá qué plan le corresponde.\n                </p>\n            </div>\n            <div class=\"mt-14 grid gap-6 sm:grid-cols-2 lg:grid-cols-4\" data-kid=\"1-10-1-2\">\n                <article class=\"flex flex-col rounded-2xl border border-[var(--border)] bg-[var(--surface)] p-7\" data-kid=\"1-10-1-2-1\">\n                    <p class=\"text-[11px] font-bold tracking-[0.22em] text-[var(--blue)]\" data-kid=\"1-10-1-2-1-1\">\n                        01\n                    </p>\n                    <h3 class=\"mt-4 text-lg font-bold leading-snug\" data-kid=\"1-10-1-2-1-2\">\n                        Estudiante o pasante\n                    </h3>\n                    <p class=\"mt-3 flex-1 text-[13px] leading-relaxed text-[var(--muted)]\" data-kid=\"1-10-1-2-1-3\">\n                        Estás en el último año de la licenciatura o en pasantías y necesitás una herramienta de nivel clínico\n            para tus prácticas.\n                    </p>\n                    <div class=\"mt-6 border-t border-[var(--border)] pt-4\" data-kid=\"1-10-1-2-1-4\">\n                        <p class=\"text-[11px] font-bold uppercase tracking-[0.16em] text-[var(--muted)]\" data-kid=\"1-10-1-2-1-4-1\">\n                            Ruta recomendada\n                        </p>\n                        <p class=\"mt-1.5 text-sm font-bold text-[var(--brand)]\" data-kid=\"1-10-1-2-1-4-2\">\n                            Campus\n                        </p>\n                        <p class=\"text-xs font-semibold text-[var(--muted)]\" data-kid=\"1-10-1-2-1-4-3\">\n                            120 días gratis\n                        </p>\n                    </div>\n                </article>\n                <article class=\"flex flex-col rounded-2xl border border-[var(--border)] bg-[var(--surface)] p-7\" data-kid=\"1-10-1-2-2\">\n                    <p class=\"text-[11px] font-bold tracking-[0.22em] text-[var(--brand)]\" data-kid=\"1-10-1-2-2-1\">\n                        02\n                    </p>\n                    <h3 class=\"mt-4 text-lg font-bold leading-snug\" data-kid=\"1-10-1-2-2-2\">\n                        Consultorio individual\n                    </h3>\n                    <p class=\"mt-3 flex-1 text-[13px] leading-relaxed text-[var(--muted)]\" data-kid=\"1-10-1-2-2-3\">\n                        Atendés por tu cuenta y querés dejar de transcribir: historia clínica, antropometría, menús,\n            intercambios y compras en un mismo lugar.\n                    </p>\n                    <div class=\"mt-6 border-t border-[var(--border)] pt-4\" data-kid=\"1-10-1-2-2-4\">\n                        <p class=\"text-[11px] font-bold uppercase tracking-[0.16em] text-[var(--muted)]\" data-kid=\"1-10-1-2-2-4-1\">\n                            Ruta recomendada\n                        </p>\n                        <p class=\"mt-1.5 text-sm font-bold text-[var(--brand)]\" data-kid=\"1-10-1-2-2-4-2\">\n                            PRO\n                        </p>\n                        <p class=\"text-xs font-semibold text-[var(--muted)]\" data-kid=\"1-10-1-2-2-4-3\">\n                            $4.00/mes en preventa\n                        </p>\n                    </div>\n                </article>\n                <article class=\"flex flex-col rounded-2xl border border-[var(--border)] bg-[var(--surface)] p-7\" data-kid=\"1-10-1-2-3\">\n                    <p class=\"text-[11px] font-bold tracking-[0.22em] text-[var(--brand-2)]\" data-kid=\"1-10-1-2-3-1\">\n                        03\n                    </p>\n                    <h3 class=\"mt-4 text-lg font-bold leading-snug\" data-kid=\"1-10-1-2-3-2\">\n                        Especialista\n                    </h3>\n                    <p class=\"mt-3 flex-1 text-[13px] leading-relaxed text-[var(--muted)]\" data-kid=\"1-10-1-2-3-3\">\n                        Trabajás nutrición deportiva, pediátrica o atención en grupos y necesitás plantillas propias y\n            portafolios para captar pacientes.\n                    </p>\n                    <div class=\"mt-6 border-t border-[var(--border)] pt-4\" data-kid=\"1-10-1-2-3-4\">\n                        <p class=\"text-[11px] font-bold uppercase tracking-[0.16em] text-[var(--muted)]\" data-kid=\"1-10-1-2-3-4-1\">\n                            Ruta recomendada\n                        </p>\n                        <p class=\"mt-1.5 text-sm font-bold text-[var(--brand)]\" data-kid=\"1-10-1-2-3-4-2\">\n                            PREMIUM\n                        </p>\n                        <p class=\"text-xs font-semibold text-[var(--muted)]\" data-kid=\"1-10-1-2-3-4-3\">\n                            $20.00/mes en preventa\n                        </p>\n                    </div>\n                </article>\n                <article class=\"flex flex-col rounded-2xl border border-[var(--border)] bg-[var(--surface)] p-7\" data-kid=\"1-10-1-2-4\">\n                    <p class=\"text-[11px] font-bold tracking-[0.22em] text-[var(--brand-2)]\" data-kid=\"1-10-1-2-4-1\">\n                        04\n                    </p>\n                    <h3 class=\"mt-4 text-lg font-bold leading-snug\" data-kid=\"1-10-1-2-4-2\">\n                        Equipo o clínica\n                    </h3>\n                    <p class=\"mt-3 flex-1 text-[13px] leading-relaxed text-[var(--muted)]\" data-kid=\"1-10-1-2-4-3\">\n                        Varios profesionales atienden bajo una misma marca y necesitan una vista compartida del trabajo,\n            identidad propia y soporte prioritario.\n                    </p>\n                    <div class=\"mt-6 border-t border-[var(--border)] pt-4\" data-kid=\"1-10-1-2-4-4\">\n                        <p class=\"text-[11px] font-bold uppercase tracking-[0.16em] text-[var(--muted)]\" data-kid=\"1-10-1-2-4-4-1\">\n                            Ruta recomendada\n                        </p>\n                        <p class=\"mt-1.5 text-sm font-bold text-[var(--brand)]\" data-kid=\"1-10-1-2-4-4-2\">\n                            Clínica\n                        </p>\n                        <p class=\"text-xs font-semibold text-[var(--muted)]\" data-kid=\"1-10-1-2-4-4-3\">\n                            $99.99/mes o $9.99/nutricionista\n                        </p>\n                    </div>\n                </article>\n            </div>\n            <div class=\"mt-10 flex flex-wrap items-center gap-x-8 gap-y-4\" data-kid=\"1-10-1-3\">\n                <a class=\"inline-flex items-center gap-2 text-sm font-bold text-[var(--brand)] transition-opacity hover:opacity-80\" data-kid=\"1-10-1-3-1\" href=\"#comparativa\">\n                    Ver qué incluye cada plan\n                    <i class=\"ph ph-arrow-right text-[16px]\" data-kid=\"1-10-1-3-1-1\">\n                    </i>\n                </a>\n                <p class=\"text-xs text-[var(--muted)]\" data-kid=\"1-10-1-3-2\">\n                    Todos los precios son de preventa por tiempo limitado y se facturan mensualmente.\n                </p>\n            </div>\n        </div>\n    </section>\n    <!-- ============ CAMPUS ============ -->\n    <section class=\"scroll-mt-28 pb-20 lg:pb-28\" data-kid=\"1-5\" id=\"campus\">\n        <div class=\"mx-auto max-w-7xl px-4 sm:px-6 lg:px-8\" data-kid=\"1-5-1\">\n            <div class=\"grid overflow-hidden rounded-3xl border border-[var(--border)] lg:grid-cols-2\" data-kid=\"1-5-1-1\">\n                <div class=\"flex flex-col justify-center bg-[var(--surf