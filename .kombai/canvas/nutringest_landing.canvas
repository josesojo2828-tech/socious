lass=\"px-6 py-5 text-sm font-black text-[var(--ink)]\" data-kid=\"1-6-1-4-2-1-3-24-1\" scope=\"row\">\n                                    Precio en preventa\n                                </th>\n                                <td class=\"px-6 py-5 text-center\" data-kid=\"1-6-1-4-2-1-3-24-2\">\n                                    <span class=\"text-base font-black\" data-kid=\"1-6-1-4-2-1-3-24-2-1\">\n                                        $4.00\n                                    </span>\n                                    <span class=\"ml-1 text-xs font-semibold text-[var(--muted)]\" data-kid=\"1-6-1-4-2-1-3-24-2-2\">\n                                        /mes\n                                    </span>\n                                </td>\n                                <td class=\"px-6 py-5 text-center\" data-kid=\"1-6-1-4-2-1-3-24-3\">\n                                    <span class=\"text-base font-black text-[var(--brand)]\" data-kid=\"1-6-1-4-2-1-3-24-3-1\">\n                                        $20.00\n                                    </span>\n                                    <span class=\"ml-1 text-xs font-semibold text-[var(--muted)]\" data-kid=\"1-6-1-4-2-1-3-24-3-2\">\n                                        /mes\n                                    </span>\n                                </td>\n                                <td class=\"px-6 py-5 text-center\" data-kid=\"1-6-1-4-2-1-3-24-4\">\n                                    <span class=\"text-base font-black\" data-kid=\"1-6-1-4-2-1-3-24-4-1\">\n                                        $99.99\n                                    </span>\n                                    <span class=\"ml-1 text-xs font-semibold text-[var(--muted)]\" data-kid=\"1-6-1-4-2-1-3-24-4-2\">\n                                        /mes\n                                    </span>\n                                </td>\n                            </tr>\n                        </tbody>\n                    </table>\n                </div>\n                <p class=\"mt-5 text-xs text-[var(--faint)]\" data-kid=\"1-6-1-4-3\">\n                    Todos los planes se facturan mensualmente. En Clínica también podés pagar $9.99 por nutricionista. Precios en USD.\n                </p>\n            </div>\n            <div class=\"mt-8 flex flex-col items-start justify-between gap-6 rounded-[1.5rem] border border-[var(--line)] bg-[var(--bg-soft)] px-8 py-7 lg:flex-row lg:items-center\" data-kid=\"1-6-1-3\">\n                <p class=\"max-w-xl text-sm leading-relaxed text-[var(--muted)]\" data-kid=\"1-6-1-3-1\">\n                    <span class=\"font-bold text-[var(--ink)]\" data-kid=\"1-6-1-3-1-1\">\n                        Todos los planes se facturan mensualmente.\n                    </span>\n                    No pedimos tarjeta para la prueba de 14 días y podés cancelar cuando quieras.\n                </p>\n                <div class=\"flex flex-wrap items-center gap-3\" data-kid=\"1-6-1-3-2\">\n                    <a class=\"inline-flex items-center justify-center gap-2 rounded-xl bg-[var(--brand)] px-7 py-4 text-sm font-bold text-[var(--on-brand)] transition-transform hover:-translate-y-0.5\" data-kid=\"1-6-1-3-2-1\" href=\"#\">\n                        Comenzar prueba de 14 días\n                        <i class=\"ph-bold ph-arrow-right text-base\" data-kid=\"1-6-1-3-2-1-1\">\n                        </i>\n                    </a>\n                    <a class=\"inline-flex items-center justify-center gap-2 rounded-xl border border-[var(--line-strong)] px-7 py-4 text-sm font-bold text-[var(--ink)] transition-colors hover:border-[var(--brand)] hover:text-[var(--brand)]\" data-kid=\"1-6-1-3-2-2\" href=\"https://wa.me/584243153383?text=Hola,%20quiero%20cotizar%20Nutringest%20para%20mi%20cl%C3%ADnica%20o%20equipo\" rel=\"noopener noreferrer\" target=\"_blank\">\n                        <i class=\"ph-bold ph-whatsapp-logo text-base\" data-kid=\"1-6-1-3-2-2-1\">\n                        </i>\n                        Cotizar Clínica\n                    </a>\n                </div>\n            </div>\n        </div>\n    </section>\n    <!-- ================= CASOS DE USO ================= -->\n    <section class=\"scroll-mt-24 px-6 py-24 lg:px-10 lg:py-32\" data-kid=\"1-13\" id=\"casos\">\n        <div class=\"mx-auto max-w-[1200px]\" data-kid=\"1-13-1\">\n            <div class=\"max-w-3xl\" data-kid=\"1-13-1-1\">\n                <p class=\"text-[11px] font-bold uppercase tracking-[0.2em] text-[var(--brand)]\" data-kid=\"1-13-1-1-1\">\n                    Casos de uso\n                </p>\n                <h2 class=\"mt-6 text-3xl font-black leading-[1.08] tracking-tight sm:text-4xl lg:text-[2.9rem]\" data-kid=\"1-13-1-1-2\">\n                    La misma plataforma,\n                    <span class=\"text-[var(--brand)]\" data-kid=\"1-13-1-1-2-1\">\n                        cuatro formas de trabajarla.\n                    </span>\n                </h2>\n                <p class=\"mt-6 text-lg leading-relaxed text-[var(--muted)]\" data-kid=\"1-13-1-1-3\">\n                    No cambia el software: cambia en qué te apoyás según el tipo de consulta que atendés.\n                </p>\n            </div>\n            <div class=\"mt-14 grid gap-6 lg:grid-cols-2\" data-kid=\"1-13-1-2\">\n                <article class=\"flex flex-col rounded-[1.5rem] border border-[var(--line)] p-8 lg:p-10\" data-kid=\"1-13-1-2-1\">\n                    <div class=\"flex items-center gap-4\" data-kid=\"1-13-1-2-1-1\">\n                        <span class=\"flex h-11 w-11 items-center justify-center rounded-full bg-[var(--brand-soft)] text-[var(--brand)]\" data-kid=\"1-13-1-2-1-1-1\">\n                            <i class=\"ph ph-stethoscope text-xl\" data-kid=\"1-13-1-2-1-1-1-1\">\n                            </i>\n                        </span>\n                        <h3 class=\"text-xl font-black leading-snug tracking-tight\" data-kid=\"1-13-1-2-1-1-2\">\n                            Nutrición clínica\n                        </h3>\n                    </div>\n                    <p class=\"mt-6 text-[15px] leading-relaxed text-[var(--muted)]\" data-kid=\"1-13-1-2-1-2\">\n                        Cargás antecedentes e historia clínica durante la consulta, con el cálculo antropométrico saliendo de la plataforma, y el seguimiento queda en el mismo expediente que tu paciente ve desde el portal.\n                    </p>\n                    <ul class=\"mt-7 flex flex-wrap gap-2 text-xs font-bold text-[var(--muted)]\" data-kid=\"1-13-1-2-1-3\">\n                        <li class=\"rounded-full border border-[var(--line)] px-3.5 py-1.5\" data-kid=\"1-13-1-2-1-3-1\">\n                            Consultas y Seguimiento\n                        </li>\n                        <li class=\"rounded-full border border-[var(--line)] px-3.5 py-1.5\" data-kid=\"1-13-1-2-1-3-2\">\n                            Cálculo Antropométrico\n                        </li>\n                        <li class=\"rounded-full border border-[var(--line)] px-3.5 py-1.5\" data-kid=\"1-13-1-2-1-3-3\">\n                            App/Portal para Pacientes\n                        </li>\n                    </ul>\n                </article>\n                <article class=\"flex flex-col rounded-[1.5rem] border border-[var(--line)] p-8 lg:p-10\" data-kid=\"1-13-1-2-2\">\n                    <div class=\"flex items-center gap-4\" data-kid=\"1-13-1-2-2-1\">\n                        <span class=\"flex h-11 w-11 items-center justify-center rounded-full bg-[var(--brand-soft)] text-[var(--brand)]\" data-kid=\"1-13-1-2-2-1-1\">\n                            <i class=\"ph ph-barbell text-xl\" data-kid=\"1-13-1-2-2-1-1-1\">\n                            </i>\n                        </span>\n                        <h3 class=\"text-xl font-black leading-snug tracking-tight\" data-kid=\"1-13-1-2-2-1-2\">\n                            Nutrición deportiva\n                        </h3>\n                    </div>\n                    <p class=\"mt-6 text-[15px] leading-relaxed text-[var(--muted)]\" data-kid=\"1-13-1-2-2-2\">\n                        Reutilizás las mismas plantillas de dietas y las personalizás para cada etapa del plan, en lugar de armar todo desde cero en cada consulta. Las listas de intercambio te dejan ajustar sin reescribir el menú.\n                    </p>\n                    <ul class=\"mt-7 flex flex-wrap gap-2 text-xs font-bold text-[var(--muted)]\" data-kid=\"1-13-1-2-2-3\">\n                        <li class=\"rounded-full border border-[var(--line)] px-3.5 py-1.5\" data-kid=\"1-13-1-2-2-3-1\">\n                            Plantillas de Dietas\n                        </li>\n                        <li class=\"rounded-full border border-[var(--line)] px-3.5 py-1.5\" data-kid=\"1-13-1-2-2-3-2\">\n                            Personalización de Plantillas\n                        </li>\n                        <li class=\"rounded-full border border-[var(--line)] px-3.5 py-1.5\" data-kid=\"1-13-1-2-2-3-3\">\n                            Menús y Planes de Alimentación\n                        </li>\n                    </ul>\n                </article>\n                <article class=\"flex flex-col rounded-[1.5rem] border border-[var(--line)] p-8 lg:p-10\" data-kid=\"1-13-1-2-3\">\n                    <div class=\"flex items-center gap-4\" data-kid=\"1-13-1-2-3-1\">\n                        <span class=\"flex h-11 w-11 items-center justify-center rounded-full bg-[var(--brand-soft)] text-[var(--brand)]\" data-kid=\"1-13-1-2-3-1-1\">\n                            <i class=\"ph ph-baby text-xl\" data-kid=\"1-13-1-2-3-1-1-1\">\n                            </i>\n                        </span>\n                        <h3 class=\"text-xl font-black leading-snug tracking-tight\" data-kid=\"1-13-1-2-3-1-2\">\n                            Nutrición pediátrica\n                        </h3>\n                    </div>\n                    <p class=\"mt-6 text-[15px] leading-relaxed text-[var(--muted)]\" data-kid=\"1-13-1-2-3-2\">\n                        Armás el plan con la base de alimentos completa y las listas de intercambio, y la lista de compras automática sale lista para la familia. Tu portafolio digital reúne tu perfil y tu especialidad.\n                    </p>\n                    <ul class=\"mt-7 flex flex-wrap gap-2 text-xs font-bold text-[var(--muted)]\" data-kid=\"1-13-1-2-3-3\">\n                        <li class=\"rounded-full border border-[var(--line)] px-3.5 py-1.5\" data-kid=\"1-13-1-2-3-3-1\">\n                            Base de Alimentos Completa\n                        </li>\n                        <li class=\"rounded-full border border-[var(--line)] px-3.5 py-1.5\" data-kid=\"1-13-1-2-3-3-2\">\n                            Listas de Compras Automáticas\n                        </li>\n                        <li class=\"rounded-full border border-[var(--line)] px-3.5 py-1.5\" data-kid=\"1-13-1-2-3-3-3\">\n                            Portafolios Digitales\n                        </li>\n                    </ul>\n                </article>\n                <article class=\"flex flex-col rounded-[1.5rem] border border-[var(--line)] p-8 lg:p-10\" data-kid=\"1-13-1-2-4\">\n                    <div class=\"flex items-center gap-4\" data-kid=\"1-13-1-2-4-1\">\n                        <span class=\"flex h-11 w-11 items-center justify-center rounded-full bg-[var(--brand-soft)] text-[var(--brand)]\" data-kid=\"1-13-1-2-4-1-1\">\n                            <i class=\"ph ph-buildings text-xl\" data-kid=\"1-13-1-2-4-1-1-1\">\n                            </i>\n                        </span>\n                        <h3 class=\"text-xl font-black leading-snug tracking-tight\" data-kid=\"1-13-1-2-4-1-2\">\n                            Grupos y empresas\n                        </h3>\n                    </div>\n                    <p class=\"mt-6 text-[15px] leading-relaxed text-[var(--muted)]\" data-kid=\"1-13-1-2-4-2\">\n                        Cuando atendés grupos o programas corporativos, sumás atención en grupos y sistema de referidos. Si además trabajás con colegas, la gestión de equipo, la marca personalizada y las analíticas quedan del lado de Clínica.\n                    </p>\n                    <ul class=\"mt-7 flex flex-wrap gap-2 text-xs font-bold text-[var(--muted)]\" data-kid=\"1-13-1-2-4-3\">\n                        <li class=\"rounded-full border border-[var(--line)] px-3.5 py-1.5\" data-kid=\"1-13-1-2-4-3-1\">\n                            Atención en Grupos\n                        </li>\n                        <li class=\"rounded-full border border-[var(--line)] px-3.5 py-1.5\" data-kid=\"1-13-1-2-4-3-2\">\n                            Sistema de Referidos\n                        </li>\n                        <li class=\"rounded-full border border-[var(--line)] px-3.5 py-1.5\" data-kid=\"1-13-1-2-4-3-3\">\n                            Gestión de Equipo\n                        </li>\n                    </ul>\n                </article>\n            </div>\n        </div>\n    </section>\n    <!-- ================= FAQ ================= -->\n    <section class=\"scroll-mt-24 border-t border-[var(--line)] bg-[var(--bg-soft)] px-6 py-24 lg:px-10 lg:py-32\" data-kid=\"1-7\" id=\"faq\">\n        <div class=\"mx-auto grid max-w-[1200px] gap-14 lg:grid-cols-12 lg:gap-12\" data-kid=\"1-7-1\">\n            <div class=\"lg:col-span-4\" data-kid=\"1-7-1-1\">\n                <p class=\"text-[11px] font-bold uppercase tracking-[0.2em] text-[var(--brand)]\" data-kid=\"1-7-1-1-1\">\n                    Preguntas frecuentes\n                </p>\n                <h2 class=\"mt-6 text-3xl font-black leading-[1.1] tracking-tight sm:text-4xl\" data-kid=\"1-7-1-1-2\">\n                    Las dudas que cambian la decisión.\n                </h2>\n                <p class=\"mt-6 text-base leading-relaxed text-[var(--muted)]\" data-kid=\"1-7-1-1-3\">\n                    Si algo queda suelto, el asistente está abajo a la derecha y responde sobre funciones, precios y Campus. También podés escribirnos por WhatsApp.\n                </p>\n                <a class=\"mt-8 inline-flex items-center gap-2.5 text-sm font-bold text-[var(--brand)] transition-opacity hover:opacity-80\" data-kid=\"1-7-1-1-4\" href=\"mailto:nutringest@gmail.com\">\n                    <i class=\"ph ph-envelope-simple text-lg\" data-kid=\"1-7-1-1-4-1\">\n                    </i>\n                    nutringest@gmail.com\n                </a>\n            </div>\n            <div class=\"lg:col-span-8 lg:pl-6\" data-kid=\"1-7-1-2\">\n                <div class=\"border-t border-[var(--line)]\" data-kid=\"1-7-1-2-1\">\n                    <details class=\"nr-faq border-b border-[var(--line)]\" data-kid=\"1-7-1-2-1-1\" open=\"\">\n                        <summary class=\"flex cursor-pointer items-center justify-between gap-6 py-6\" data-kid=\"1-7-1-2-1-1-1\">\n                            <span class=\"pr-4 text-base font-bold leading-snug sm:text-lg\" data-kid=\"1-7-1-2-1-1-1-1\">\n                                ¿Cómo funciona la prueba de 14 días?\n                            </span>\n                            <i class=\"ph-bold ph-plus nr-plus shrink-0 text-xl text-[var(--faint)]\" data-kid=\"1-7-1-2-1-1-1-2\">\n                            </i>\n                        </summary>\n                        <p class=\"pb-7 pr-10 text-sm leading-relaxed text-[var(--muted)] sm:text-base\" data-kid=\"1-7-1-2-1-1-2\">\n                            Entrás con acceso a todas las funciones desde el primer día, sin tarjeta de crédito y sin compromiso de permanencia. Sirve para cargar tus pacientes y probar el flujo completo de consulta, plan y seguimiento.\n                        </p>\n                    </details>\n                    <details class=\"nr-faq border-b border-[var(--line)]\" data-kid=\"1-7-1-2-1-2\">\n                        <summary class=\"flex cursor-pointer items-center justify-between gap-6 py-6\" data-kid=\"1-7-1-2-1-2-1\">\n                            <span class=\"pr-4 text-base font-bold leading-snug sm:text-lg\" data-kid=\"1-7-1-2-1-2-1-1\">\n                                ¿Mis historias clínicas y los datos de mis pacientes están seguros?\n                            </span>\n                            <i class=\"ph-bold ph-plus nr-plus shrink-0 text-xl text-[var(--faint)]\" data-kid=\"1-7-1-2-1-2-1-2\">\n                            </i>\n                        </summary>\n                        <p class=\"pb-7 pr-10 text-sm leading-relaxed text-[var(--muted)] sm:text-base\" data-kid=\"1-7-1-2-1-2-2\">\n                            Tus datos viajan cifrados y se respaldan automáticamente en la nube, con acceso desde cualquier dispositivo. Vos decidís qué compartir con cada paciente desde el portal.\n                        </p>\n                    </details>\n                    <details class=\"nr-faq border-b border-[var(--line)]\" data-kid=\"1-7-1-2-1-3\">\n                        <summary class=\"flex cursor-pointer items-center justify-between gap-6 py-6\" data-kid=\"1-7-1-2-1-3-1\">\n                            <span class=\"pr-4 text-base font-bold leading-snug sm:text-lg\" data-kid=\"1-7-1-2-1-3-1-1\">\n                                ¿Puedo exportar los planes y reportes en PDF?\n                            </span>\n                            <i class=\"ph-bold ph-plus nr-plus shrink-0 text-xl text-[var(--faint)]\" data-kid=\"1-7-1-2-1-3-1-2\">\n                            </i>\n                        </summary>\n                        <p class=\"pb-7 pr-10 text-sm leading-relaxed text-[var(--muted)] sm:text-base\" data-kid=\"1-7-1-2-1-3-2\">\n                            Sí. Generamos reportes antropométricos y planes alimenticios listos para imprimir en A4 o enviar por WhatsApp, sin volver a transcribir nada a mano.\n                        </p>\n                    </details>\n                    <details class=\"nr-faq border-b border-[var(--line)]\" data-kid=\"1-7-1-2-1-4\">\n                        <summary class=\"flex cursor-pointer items-center justify-between gap-6 py-6\" data-kid=\"1-7-1-2-1-4-1\">\n                            <span class=\"pr-4 text-base font-bold leading-snug sm:text-lg\" data-kid=\"1-7-1-2-1-4-1-1\">\n                                ¿Qué es Nutringest Campus y quiénes aplican?\n                            </span>\n                            <i class=\"ph-bold ph-plus nr-plus shrink-0 text-xl text-[var(--faint)]\" data-kid=\"1-7-1-2-1-4-1-2\">\n                            </i>\n                        </summary>\n                        <p class=\"pb-7 pr-10 text-sm leading-relaxed text-[var(--muted)] sm:text-base\" data-kid=\"1-7-1-2-1-4-2\">\n                            Es el programa para estudiantes: si cursás el último año de la licenciatura en nutrición o estás en pasantías profesionales, accedés a 120 días de acceso premium sin costo. Se solicita desde el botón de la sección Campus.\n                        </p>\n                    </details>\n                    <details class=\"nr-faq border-b border-[var(--line)]\" data-kid=\"1-7-1-2-1-5\">\n                        <summary class=\"flex cursor-pointer items-center justify-between gap-6 py-6\" data-kid=\"1-7-1-2-1-5-1\">\n                            <span class=\"pr-4 text-base font-bold leading-snug sm:text-lg\" data-kid=\"1-7-1-2-1-5-1-1\">\n                                ¿Qué diferencia hay entre PRO y PREMIUM?\n                            </span>\n                            <i class=\"ph-bold ph-plus nr-plus shrink-0 text-xl text-[var(--faint)]\" data-kid=\"1-7-1-2-1-5-1-2\">\n                            </i>\n                        </summary>\n                        <p class=\"pb-7 pr-10 text-sm leading-relaxed text-[var(--muted)] sm:text-base\" data-kid=\"1-7-1-2-1-5-2\">\n                            PRO cubre el día a día del consultorio individual: pacientes, consultas, planes, intercambios, portal, compras, antropometría y base de alimentos. PREMIUM suma plantillas de dietas, personalización, portafolios digitales, nutrición deportiva y pediátrica, referidos y atención en grupos.\n                        </p>\n                    </details>\n                </div>\n            </div>\n        </div>\n    </section>\n    <!-- ================= CTA FINAL + NEWSLETTER ================= -->\n    <section class=\"px-6 pb-24 lg:px-10 lg:pb-32\" data-kid=\"1-14\" id=\"empezar-ahora\">\n        <div class=\"mx-auto max-w-[1200px]\" data-kid=\"1-14-1\">\n            <div class=\"overflow-hidden rounded-[2rem] bg-[var(--brand)] px-8 py-14 text-[var(--on-brand)] lg:px-16 lg:py-18\" data-kid=\"1-14-1-1\">\n                <div class=\"grid gap-14 lg:grid-cols-12 lg:gap-16\" data-kid=\"1-14-1-1-1\">\n                    <div class=\"lg:col-span-7\" data-kid=\"1-14-1-1-1-1\">\n                        <p class=\"text-[11px] font-bold uppercase tracking-[0.2em] opacity-80\" data-kid=\"1-14-1-1-1-1-1\">\n                            Último paso\n                        </p>\n                        <h2 class=\"mt-6 text-3xl font-black leading-[1.06] tracking-tight sm:text-4xl lg:text-[3rem]\" data-kid=\"1-14-1-1-1-1-2\">\n                            Probá Nutringest 14 días y decidí con los precios a la vista.\n                        </h2>\n                        <p class=\"mt-6 max-w-xl text-base leading-relaxed opacity-90 lg:text-lg\" data-kid=\"1-14-1-1-1-1-3\">\n                            Entrás con todas las funciones, sin tarjeta de crédito y sin compromiso de permanencia. Si tu caso es una clínica o un equipo, lo cotizamos por WhatsApp el mismo día.\n                        </p>\n                        <div class=\"mt-10 flex flex-wrap items-center gap-4\" data-kid=\"1-14-1-1-1-1-4\">\n                            <a class=\"inline-flex items-center justify-center gap-2 rounded-xl bg-[var(--bg)] px-7 py-4 text-sm font-bold text-[var(--brand)] transition-transform hover:-translate-y-0.5\" data-kid=\"1-14-1-1-1-1-4-1\" href=\"#planes\">\n                                Comenzar prueba de 14 días\n                                <i class=\"ph-bold ph-arrow-right text-base\" data-kid=\"1-14-1-1-1-1-4-1-1\">\n                                </i>\n                            </a>\n                            <a class=\"inline-flex items-center justify-center gap-2 rounded-xl border border-[var(--on-brand)]/40 px-7 py-4 text-sm font-bold text-[var(--on-brand)] transition-colors hover:bg-[var(--on-brand)]/10\" data-kid=\"1-14-1-1-1-1-4-2\" href=\"https://wa.me/584243153383?text=Hola,%20quiero%20cotizar%20Nutringest%20para%20mi%20cl%C3%ADnica%20o%20equipo\" rel=\"noopener noreferrer\" target=\"_blank\">\n                                <i class=\"ph-bold ph-whatsapp-logo text-base\" data-kid=\"1-14-1-1-1-1-4-2-1\">\n                                </i>\n                                Cotizar Clínica\n                            </a>\n                        </div>\n                        <div class=\"mt-9 flex flex-wrap items-center gap-x-8 gap-y-3 border-t border-[var(--on-brand)]/20 pt-7 text-sm font-semibold\" data-kid=\"1-14-1-1-1-1-5\">\n                            <button class=\"inline-flex items-center gap-2 transition-opacity hover:opacity-80\" data-kid=\"1-14-1-1-1-1-5-1\" onclick=\"document.getElementById('nr-chat').classList.remove('nr-hidden')\" type=\"button\">\n                                <i class=\"ph ph-sparkle text-base\" data-kid=\"1-14-1-1-1-1-5-1-1\">\n                                </i>\n                                Preguntarle al asistente\n                            </button>\n                            <a class=\"inline-flex items-center gap-2 transition-opacity hover:opacity-80\" data-kid=\"1-14-1-1-1-1-5-2\" href=\"https://wa.me/584243153383?text=Hola,%20tengo%20una%20consulta%20sobre%20Nutringest\" rel=\"noopener noreferrer\" target=\"_blank\">\n                                <i class=\"ph-bold ph-whatsapp-logo text-base\" data-kid=\"1-14-1-1-1-1-5-2-1\">\n                                </i>\n                                Escribir por WhatsApp\n                            </a>\n                            <a class=\"inline-flex items-center gap-2 transition-opacity hover:opacity-80\" data-kid=\"1-14-1-1-1-1-5-3\" href=\"mailto:nutringest@gmail.com\">\n                                <i class=\"ph ph-envelope-simple text-base\" data-kid=\"1-14-1-1-1-1-5-3-1\">\n                                </i>\n                                nutringest@gmail.com\n                            </a>\n                        </div>\n                    </div>\n                    <div class=\"lg:col-span-5 lg:border-l lg:border-[var(--on-brand)]/20 lg:pl-14\" data-kid=\"1-14-1-1-1-2\">\n                        <h3 class=\"text-lg font-black leading-snug tracking-tight\" data-kid=\"1-14-1-1-1-2-1\">\n                            Novedades y guías para nutricionistas\n                        </h3>\n                        <p class=\"mt-4 text-sm leading-relaxed opacity-90\" data-kid=\"1-14-1-1-1-2-2\">\n                            Dejanos tu correo y te avisamos cuando publiquemos nuevas guías, plantillas y mejoras de la plataforma.\n                        </p>\n                        <form class=\"mt-8\" data-kid=\"1-14-1-1-1-2-3\" onsubmit=\"return false\">\n                            <label class=\"text-[10px] font-black uppercase tracking-[0.16em] opacity-80\" data-kid=\"1-14-1-1-1-2-3-1\" for=\"nr-news\">\n                                Tu correo\n                            </label>\n                            <input class=\"mt-3 w-full rounded-xl border border-[var(--on-brand)]/35 bg-transparent px-5 py-4 text-sm text-[var(--on-brand)] outline-none placeholder:text-[var(--on-brand)]/50\" data-kid=\"1-14-1-1-1-2-3-2\" id=\"nr-news\" placeholder=\"tucorreo@ejemplo.com\" type=\"email\"/>\n                            <button class=\"mt-4 inline-flex w-full items-center justify-center gap-2 rounded-xl bg-[var(--bg)] px-6 py-4 text-sm font-bold text-[var(--brand)] transition-transform hover:-translate-y-0.5\" data-kid=\"1-14-1-1-1-2-3-3\" type=\"submit\">\n                                Suscribirme\n                                <i class=\"ph-bold ph-paper-plane-tilt text-base\" data-kid=\"1-14-1-1-1-2-3-3-1\">\n                                </i>\n                            </button>\n                        </form>\n                        <p class=\"mt-4 text-xs leading-relaxed opacity-70\" data-kid=\"1-14-1-1-1-2-4\">\n                            Solo información de Nutringest. Podés darte de baja cuando quieras.\n                        </p>\n                    </div>\n                </div>\n            </div>\n        </div>\n    </section>\n    <!-- ================= FOOTER ================= -->\n    <footer class=\"border-t border-[var(--line)] bg-[var(--bg-soft)] px-6 pb-44 pt-20 lg:px-10\" data-kid=\"1-8\">\n        <div class=\"mx-auto max-w-[1200px]\" data-kid=\"1-8-1\">\n            <div class=\"grid gap-12 lg:grid-cols-12\" data-kid=\"1-8-1-1\">\n                <div class=\"lg:col-span-5\" data-kid=\"1-8-1-1-1\">\n                    <img alt=\"Nutringest\" class=\"nr-logo-light h-9 w-auto\" data-kid=\"1-8-1-1-1-1\" decoding=\"async\" loading=\"lazy\" src=\"/api/local/images/webapp/public/png/ImagotipoPurpura.png\"/>\n                    <img alt=\"Nutringest\" class=\"nr-logo-dark h-9 w-auto\" data-kid=\"1-8-1-1-1-2\" decoding=\"async\" loading=\"lazy\" src=\"/api/local/images/webapp/public/png/ImagotipoBlanco.png\"/>\n                    <p class=\"mt-6 max-w-sm text-sm leading-relaxed text-[var(--muted)]\" data-kid=\"1-8-1-1-1-3\">\n                        Software de gestión integral para consultorios, especialistas y clínicas de nutrición. De nutricionistas, para nutricionistas.\n                    </p>\n                </div>\n                <div class=\"lg:col-span-3\" data-kid=\"1-8-1-1-2\">\n                    <h4 class=\"text-xs font-black uppercase tracking-[0.18em]\" data-kid=\"1-8-1-1-2-1\">\n                        Producto\n                    </h4>\n                    <ul class=\"mt-5 space-y-3 text-sm text-[var(--muted)]\" data-kid=\"1-8-1-1-2-2\">\n                        <li data-kid=\"1-8-1-1-2-2-1\">\n                            <a class=\"transition-colors hover:text-[var(--brand)]\" data-kid=\"1-8-1-1-2-2-1-1\" href=\"#incluye\">\n                                Qué incluye\n                            </a>\n                        </li>\n                        <li data-kid=\"1-8-1-1-2-2-2\">\n                            <a class=\"transition-colors hover:text-[var(--brand)]\" data-kid=\"1-8-1-1-2-2-2-1\" href=\"#planes\">\n                                Comparar planes\n                            </a>\n                        </li>\n                        <li data-kid=\"1-8-1-1-2-2-3\">\n                            <a class=\"transition-colors hover:text-[var(--brand)]\" data-kid=\"1-8-1-1-2-2-3-1\" href=\"#campus\">\n                                Nutringest Campus\n                            </a>\n                        </li>\n                        <li data-kid=\"1-8-1-1-2-2-4\">\n                            <a class=\"transition-colors hover:text-[var(--brand)]\" data-kid=\"1-8-1-1-2-2-4-1\" href=\"#faq\">\n                                Preguntas frecuentes\n                            </a>\n                        </li>\n                    </ul>\n                </div>\n                <div class=\"lg:col-span-4\" data-kid=\"1-8-1-1-3\">\n                    <h4 class=\"text-xs font-black uppercase tracking-[0.18em]\" data-kid=\"1-8-1-1-3-1\">\n                        Contacto\n                    </h4>\n                    <ul class=\"mt-5 space-y-3.5 text-sm text-[var(--muted)]\" data-kid=\"1-8-1-1-3-2\">\n                        <li data-kid=\"1-8-1-1-3-2-1\">\n                            <a class=\"inline-flex items-center gap-2.5 transition-colors hover:text-[var(--brand)]\" data-kid=\"1-8-1-1-3-2-1-1\" href=\"mailto:nutringest@gmail.com\">\n                                <i class=\"ph ph-envelope-simple text-lg text-[var(--brand)]\" data-kid=\"1-8-1-1-3-2-1-1-1\">\n                                </i>\n                                nutringest@gmail.com\n                            </a>\n                        </li>\n                        <li data-kid=\"1-8-1-1-3-2-2\">\n                            <a class=\"inline-flex items-center gap-2.5 transition-colors hover:text-[var(--brand)]\" data-kid=\"1-8-1-1-3-2-2-1\" href=\"https://wa.me/584243153383?text=Hola,%20tengo%20una%20consulta%20sobre%20Nutringest\" rel=\"noopener noreferrer\" target=\"_blank\">\n                                <i class=\"ph-bold ph-whatsapp-logo text-lg text-[var(--brand)]\" data-kid=\"1-8-1-1-3-2-2-1-1\">\n                                </i>\n                                +58 424-3153383\n                            </a>\n                        </li>\n                        <li data-kid=\"1-8-1-1-3-2-3\">\n                            <a class=\"inline-flex items-center gap-2.5 transition-colors hover:text-[var(--brand)]\" data-kid=\"1-8-1-1-3-2-3-1\" href=\"https://www.instagram.com/nutringest/\" rel=\"noopener noreferrer\" target=\"_blank\">\n                                <i class=\"ph ph-instagram-logo text-lg text-[var(--brand)]\" data-kid=\"1-8-1-1-3-2-3-1-1\">\n                                </i>\n                                @nutringest\n                            </a>\n                        </li>\n                        <li class=\"flex items-center gap-2.5\" data-kid=\"1-8-1-1-3-2-4\">\n                            <i class=\"ph ph-map-pin text-lg text-[var(--brand)]\" data-kid=\"1-8-1-1-3-2-4-1\">\n                            </i>\n                            Guárico, Venezuela\n                        </li>\n                    </ul>\n                </div>\n            </div>\n            <div class=\"mt-16 flex flex-col justify-between gap-4 border-t border-[var(--line)] pt-8 text-xs text-[var(--faint)] sm:flex-row\" data-kid=\"1-8-1-2\">\n                <p data-kid=\"1-8-1-2-1\">\n                    © 2026 Nutringest. Todos los derechos reservados.\n                </p>\n                <p data-kid=\"1-8-1-2-2\">\n                    Facturación mensual en todos los planes · Precios en USD\n                </p>\n            </div>\n        </div>\n    </footer>\n    <!-- ================= WIDGETS FLOTANTES ================= -->\n    <div class=\"nr-hidden fixed bottom-[150px] right-6 z-50 w-[336px] max-w-[calc(100vw-3rem)] overflow-hidden rounded-2xl border border-[var(--line-strong)] bg-[var(--surface)] shadow-2xl\" data-dynamic=\"true\" data-kid=\"1-9\" data-name=\"floating chat widget\" data-reason=\"chat panel visibility toggled by script\" id=\"nr-chat\">\n        <div class=\"flex items-center gap-3 bg-[var(--brand)] px-5 py-4 text-[var(--on-brand)]\" data-kid=\"1-9-1\">\n            <i class=\"ph ph-sparkle text-xl\" data-kid=\"1-9-1-1\">\n            </i>\n            <div class=\"flex-1\" data-kid=\"1-9-1-2\">\n                <p class=\"text-sm font-bold leading-tight\" data-kid=\"1-9-1-2-1\">\n                    Asistente Nutringest\n                </p>\n                <p class=\"text-[11px] leading-tight opacity-80\" data-kid=\"1-9-1-2-2\">\n                    Responde sobre funciones, precios y Campus\n                </p>\n            </div>\n            <button aria-label=\"Cerrar el chat\" class=\"flex h-7 w-7 items-center justify-center rounded-full transition-colors hover:bg-black/10\" data-kid=\"1-9-1-3\" id=\"nr-chat-close\" type=\"button\">\n                <i class=\"ph-bold ph-x text-base\" data-kid=\"1-9-1-3-1\">\n                </i>\n            </button>\n        </div>\n        <div class=\"max-h-[290px] space-y-3 overflow-y-auto px-5 py-5 text-sm\" data-kid=\"1-9-2\">\n            <div class=\"max-w-[88%] rounded-2xl rounded-tl-sm bg-[var(--bg-soft)] px-4 py-3 leading-relaxed\" data-kid=\"1-9-2-1\">\n                ¡Hola! Soy el asistente de Nutringest. Puedo ayudarte a comparar PRO, PREMIUM y Clínica.\n            </div>\n            <div class=\"ml-auto max-w-[88%] rounded-2xl rounded-tr-sm bg-[var(--brand)] px-4 py-3 leading-relaxed text-[var(--on-brand)]\" data-kid=\"1-9-2-2\">\n                ¿Cuál me conviene si trabajo sola?\n            </div>\n            <div class=\"max-w-[88%] rounded-2xl rounded-tl-sm bg-[var(--bg-soft)] px-4 py-3 leading-relaxed\" data-kid=\"1-9-2-3\">\n                Si atendés consultorio individual,\n                <span class=\"font-bold\" data-kid=\"1-9-2-3-1\">\n                    PRO\n                </span>\n                cubre pacientes, consultas, planes, antropometría y portal por\n                <span class=\"font-bold\" data-kid=\"1-9-2-3-2\">\n                    $4.00/mes\n                </span>\n                en preventa. Si además querés plantillas y especialidades,\n                <span class=\"font-bold\" data-kid=\"1-9-2-3-3\">\n                    PREMIUM\n                </span>\n                suma eso por $20.00/mes.\n            </div>\n        </div>\n        <form class=\"border-t border-[var(--line)] p-3\" data-kid=\"1-9-3\" onsubmit=\"return false\">\n            <div class=\"flex items-center gap-2 rounded-xl border border-[var(--line)] bg-[var(--bg)] px-4 py-2.5\" data-kid=\"1-9-3-1\">\n                <input aria-label=\"Escribí tu pregunta\" class=\"w-full bg-transparent text-sm text-[var(--ink)] outline-none placeholder:text-[var(--faint)]\" data-kid=\"1-9-3-1-1\" placeholder=\"Escribí tu pregunta…\" type=\"text\"/>\n                <button aria-label=\"Enviar\" class=\"text-[var(--brand)] transition-transform hover:scale-110\" data-kid=\"1-9-3-1-2\" type=\"submit\">\n                    <i class=\"ph-bold ph-paper-plane-tilt text-lg\" data-kid=\"1-9-3-1-2-1\">\n                    </i>\n                </button>\n            </div>\n        </form>\n    </div>\n    <div class=\"fixed bottom-6 right-6 z-50 flex flex-col items-end gap-3\" data-kid=\"1-10\">\n        <button aria-label=\"Abrir el chat con el asistente de IA\" class=\"flex h-14 w-14 items-center justify-center rounded-full bg-[var(--brand)] text-[var(--on-brand)] shadow-xl ring-1 ring-black/5 transition-transform hover:scale-105\" data-kid=\"1-10-1\" id=\"nr-chat-toggle\" type=\"button\">\n            <i class=\"ph ph-sparkle text-2xl\" data-kid=\"1-10-1-1\">\n            </i>\n        </button>\n        <a aria-label=\"Escribir por WhatsApp\" class=\"flex h-14 w-14 items-center justify-center rounded-full bg-[#25d366] text-white shadow-xl ring-1 ring-black/5 transition-transform hover:scale-105\" data-kid=\"1-10-2\" href=\"https://wa.me/584243153383?text=Hola,%20tengo%20una%20consulta%20sobre%20Nutringest\" rel=\"noopener noreferrer\" target=\"_blank\">\n            <i class=\"ph-bold ph-whatsapp-logo text-2xl\" data-kid=\"1-10-2-1\">\n            </i>\n        </a>\n    </div>\n</div>\n<script>\n    (function () {\n  var root = document.querySelector('.nr-root');\n  var themeBtn = document.getElementById('nr-theme');\n  if (root && themeBtn) {\n    themeBtn.addEventListener('click', function () {\n      var next = root.getAttribute('data-theme') === 'dark' ? 'light' : 'dark';\n      root.setAttribute('data-theme', next);\n    });\n  }\n  var panel = document.getElementById('nr-chat');\n  var toggle = document.getElementById('nr-chat-toggle');\n  var close = document.getElementById('nr-chat-close');\n  if (panel && toggle) {\n    toggle.addEventListener('click', function () {\n      panel.classList.toggle('nr-hidden');\n    });\n  }\n  if (panel && close) {\n    close.addEventListener('click', function () {\n      panel.classList.add('nr-hidden');\n    });\n  }\n})();\n</script>\n",
