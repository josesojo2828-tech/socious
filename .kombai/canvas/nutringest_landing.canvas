           <tr data-kid=\"3-1-2-1-4-5\">\n                                <th class=\"border-t border-[var(--ng-border)] py-3.5 pr-6 text-left text-[14px] font-medium text-[var(--ng-ink)]\" data-kid=\"3-1-2-1-4-5-1\" scope=\"row\">\n                                    Soporte Prioritario VIP\n                                </th>\n                                <td class=\"border-t border-[var(--ng-border)] py-3.5 text-center\" data-kid=\"3-1-2-1-4-5-2\">\n                                    <span aria-hidden=\"true\" class=\"text-[15px] font-bold text-[var(--ng-border)]\" data-kid=\"3-1-2-1-4-5-2-1\">\n                                        —\n                                    </span>\n                                    <span class=\"sr-only\" data-kid=\"3-1-2-1-4-5-2-2\">\n                                        No incluido\n                                    </span>\n                                </td>\n                                <td class=\"border-t border-[var(--ng-border)] py-3.5 text-center\" data-kid=\"3-1-2-1-4-5-3\">\n                                    <span aria-hidden=\"true\" class=\"text-[15px] font-bold text-[var(--ng-border)]\" data-kid=\"3-1-2-1-4-5-3-1\">\n                                        —\n                                    </span>\n                                    <span class=\"sr-only\" data-kid=\"3-1-2-1-4-5-3-2\">\n                                        No incluido\n                                    </span>\n                                </td>\n                                <td class=\"border-t border-[var(--ng-border)] py-3.5 text-center\" data-kid=\"3-1-2-1-4-5-4\">\n                                    <i aria-hidden=\"true\" class=\"ph ph-check text-[17px] text-[var(--ng-accent)]\" data-kid=\"3-1-2-1-4-5-4-1\">\n                                    </i>\n                                    <span class=\"sr-only\" data-kid=\"3-1-2-1-4-5-4-2\">\n                                        Incluido\n                                    </span>\n                                </td>\n                            </tr>\n                            <tr data-kid=\"3-1-2-1-4-6\">\n                                <th class=\"border-t border-[var(--ng-border)] py-3.5 pr-6 text-left text-[14px] font-medium text-[var(--ng-ink)]\" data-kid=\"3-1-2-1-4-6-1\" scope=\"row\">\n                                    Multi-nutricionista\n                                </th>\n                                <td class=\"border-t border-[var(--ng-border)] py-3.5 text-center\" data-kid=\"3-1-2-1-4-6-2\">\n                                    <span aria-hidden=\"true\" class=\"text-[15px] font-bold text-[var(--ng-border)]\" data-kid=\"3-1-2-1-4-6-2-1\">\n                                        —\n                                    </span>\n                                    <span class=\"sr-only\" data-kid=\"3-1-2-1-4-6-2-2\">\n                                        No incluido\n                                    </span>\n                                </td>\n                                <td class=\"border-t border-[var(--ng-border)] py-3.5 text-center\" data-kid=\"3-1-2-1-4-6-3\">\n                                    <span aria-hidden=\"true\" class=\"text-[15px] font-bold text-[var(--ng-border)]\" data-kid=\"3-1-2-1-4-6-3-1\">\n                                        —\n                                    </span>\n                                    <span class=\"sr-only\" data-kid=\"3-1-2-1-4-6-3-2\">\n                                        No incluido\n                                    </span>\n                                </td>\n                                <td class=\"border-t border-[var(--ng-border)] py-3.5 text-center\" data-kid=\"3-1-2-1-4-6-4\">\n                                    <i aria-hidden=\"true\" class=\"ph ph-check text-[17px] text-[var(--ng-accent)]\" data-kid=\"3-1-2-1-4-6-4-1\">\n                                    </i>\n                                    <span class=\"sr-only\" data-kid=\"3-1-2-1-4-6-4-2\">\n                                        Incluido\n                                    </span>\n                                </td>\n                            </tr>\n                            <tr data-kid=\"3-1-2-1-4-7\">\n                                <th class=\"border-t border-[var(--ng-border)] py-3.5 pr-6 text-left text-[14px] font-medium text-[var(--ng-ink)]\" data-kid=\"3-1-2-1-4-7-1\" scope=\"row\">\n                                    Analíticas Avanzadas\n                                </th>\n                                <td class=\"border-t border-[var(--ng-border)] py-3.5 text-center\" data-kid=\"3-1-2-1-4-7-2\">\n                                    <span aria-hidden=\"true\" class=\"text-[15px] font-bold text-[var(--ng-border)]\" data-kid=\"3-1-2-1-4-7-2-1\">\n                                        —\n                                    </span>\n                                    <span class=\"sr-only\" data-kid=\"3-1-2-1-4-7-2-2\">\n                                        No incluido\n                                    </span>\n                                </td>\n                                <td class=\"border-t border-[var(--ng-border)] py-3.5 text-center\" data-kid=\"3-1-2-1-4-7-3\">\n                                    <span aria-hidden=\"true\" class=\"text-[15px] font-bold text-[var(--ng-border)]\" data-kid=\"3-1-2-1-4-7-3-1\">\n                                        —\n                                    </span>\n                                    <span class=\"sr-only\" data-kid=\"3-1-2-1-4-7-3-2\">\n                                        No incluido\n                                    </span>\n                                </td>\n                                <td class=\"border-t border-[var(--ng-border)] py-3.5 text-center\" data-kid=\"3-1-2-1-4-7-4\">\n                                    <i aria-hidden=\"true\" class=\"ph ph-check text-[17px] text-[var(--ng-accent)]\" data-kid=\"3-1-2-1-4-7-4-1\">\n                                    </i>\n                                    <span class=\"sr-only\" data-kid=\"3-1-2-1-4-7-4-2\">\n                                        Incluido\n                                    </span>\n                                </td>\n                            </tr>\n                        </tbody>\n                        <tfoot data-kid=\"3-1-2-1-5\" data-name=\"comparison price footer\">\n                            <tr data-kid=\"3-1-2-1-5-5\">\n                                <th class=\"border-t-2 border-[var(--ng-ink)] pt-6 text-left text-[11px] font-bold uppercase tracking-[0.2em] text-[var(--ng-ink)]\" data-kid=\"3-1-2-1-5-1\" data-name=\"price row label\" scope=\"row\">\n                                    Precio mensual (preventa)\n                                </th>\n                                <td class=\"border-t-2 border-[var(--ng-ink)] pt-6 text-center text-[15px] font-extrabold tracking-[-0.02em] text-[var(--ng-ink)]\" data-kid=\"3-1-2-1-5-2\" data-name=\"pro price cell\">\n                                    $4.00\n                                </td>\n                                <td class=\"border-t-2 border-[var(--ng-ink)] pt-6 text-center text-[15px] font-extrabold tracking-[-0.02em] text-[var(--ng-ink)]\" data-kid=\"3-1-2-1-5-3\" data-name=\"premium price cell\">\n                                    $20.00\n                                </td>\n                                <td class=\"border-t-2 border-[var(--ng-ink)] pt-6 text-center text-[15px] font-extrabold tracking-[-0.02em] text-[var(--ng-ink)]\" data-kid=\"3-1-2-1-5-4\" data-name=\"clinica price cell\">\n                                    $99.99\n                                </td>\n                            </tr>\n                        </tfoot>\n                    </table>\n                </div>\n                <p class=\"mt-8 text-[13px] font-medium text-[var(--ng-muted)]\" data-kid=\"3-1-3\" data-name=\"comparison footnote text\">\n                    Clínica también se puede pagar por nutricionista: $9.99 al mes. Los tres planes se facturan mensualmente.\n                </p>\n            </div>\n        </div>\n    </section>\n    <!-- ===== CASOS DE USO ===== -->\n    <section class=\"scroll-mt-24 border-t border-[var(--ng-border)]\" data-kid=\"3-2\" data-name=\"use cases section\" id=\"especialidades\">\n        <div class=\"mx-auto max-w-[1180px] px-6 py-20 lg:px-10 lg:py-24\" data-kid=\"3-2-1\" data-name=\"use cases content container\">\n            <div class=\"max-w-2xl\" data-kid=\"3-2-1-1\" data-name=\"use cases header\">\n                <p class=\"text-[11px] font-bold uppercase tracking-[0.22em] text-[var(--ng-accent)]\" data-kid=\"3-2-1-1-1\" data-name=\"use cases tag line\">\n                    Casos de uso\n                </p>\n                <h2 class=\"mt-5 text-[2rem] font-extrabold leading-[1.1] tracking-[-0.03em] sm:text-[2.4rem]\" data-kid=\"3-2-1-1-2\" data-name=\"use cases headline text\">\n                    La misma plataforma, cuatro formas de trabajar\n                </h2>\n                <p class=\"mt-5 text-[15.5px] leading-relaxed text-[var(--ng-muted)]\" data-kid=\"3-2-1-1-3\" data-name=\"use cases description text\">\n                    Lo que cambia entre una práctica y otra no es el sistema, es qué parte de Nutringest usás todos los días.\n                </p>\n            </div>\n            <div class=\"mt-12 grid gap-5 sm:grid-cols-2\" data-kid=\"3-2-1-2\" data-name=\"use cases grid\">\n                <article class=\"flex flex-col rounded-3xl border border-[var(--ng-border)] bg-[var(--ng-surface)] p-8\" data-kid=\"3-2-1-2-1\" data-name=\"use case clinical\">\n                    <i class=\"ph ph-stethoscope text-[22px] text-[var(--ng-accent)]\" data-kid=\"3-2-1-2-1-1\" data-name=\"stethoscope icon\">\n                    </i>\n                    <h3 class=\"mt-5 text-[1.3rem] font-extrabold leading-tight tracking-[-0.02em]\" data-kid=\"3-2-1-2-1-2\" data-name=\"use case title\">\n                        Nutrición clínica\n                    </h3>\n                    <p class=\"mt-3 text-[15px] leading-relaxed text-[var(--ng-muted)]\" data-kid=\"3-2-1-2-1-3\" data-name=\"use case description\">\n                        Historia clínica y antecedentes, Cálculo Antropométrico y seguimiento de cada consulta en la misma ficha, con App/Portal para Pacientes para que vean su plan.\n                    </p>\n                    <p class=\"mt-6 border-t border-[var(--ng-border)] pt-5 text-[12px] font-bold uppercase tracking-wider text-[var(--ng-muted)]\" data-kid=\"3-2-1-2-1-4\" data-name=\"use case plan label\">\n                        Incluido desde PRO\n                    </p>\n                </article>\n                <article class=\"flex flex-col rounded-3xl border border-[var(--ng-border)] bg-[var(--ng-surface)] p-8\" data-kid=\"3-2-1-2-2\" data-name=\"use case sports\">\n                    <i class=\"ph ph-barbell text-[22px] text-[var(--ng-accent)]\" data-kid=\"3-2-1-2-2-1\" data-name=\"barbell icon\">\n                    </i>\n                    <h3 class=\"mt-5 text-[1.3rem] font-extrabold leading-tight tracking-[-0.02em]\" data-kid=\"3-2-1-2-2-2\" data-name=\"use case title\">\n                        Nutrición deportiva\n                    </h3>\n                    <p class=\"mt-3 text-[15px] leading-relaxed text-[var(--ng-muted)]\" data-kid=\"3-2-1-2-2-3\" data-name=\"use case description\">\n                        Medición de composición corporal y planes por objetivo con Menús y Planes de Alimentación y Listas de Intercambio, apoyados en Plantillas de Dietas.\n                    </p>\n                    <p class=\"mt-6 border-t border-[var(--ng-border)] pt-5 text-[12px] font-bold uppercase tracking-wider text-[var(--ng-muted)]\" data-kid=\"3-2-1-2-2-4\" data-name=\"use case plan label\">\n                        Plantillas y especialidades en PREMIUM\n                    </p>\n                </article>\n                <article class=\"flex flex-col rounded-3xl border border-[var(--ng-border)] bg-[var(--ng-surface)] p-8\" data-kid=\"3-2-1-2-3\" data-name=\"use case pediatric\">\n                    <i class=\"ph ph-baby text-[22px] text-[var(--ng-accent)]\" data-kid=\"3-2-1-2-3-1\" data-name=\"baby icon\">\n                    </i>\n                    <h3 class=\"mt-5 text-[1.3rem] font-extrabold leading-tight tracking-[-0.02em]\" data-kid=\"3-2-1-2-3-2\" data-name=\"use case title\">\n                        Nutrición pediátrica\n                    </h3>\n                    <p class=\"mt-3 text-[15px] leading-relaxed text-[var(--ng-muted)]\" data-kid=\"3-2-1-2-3-3\" data-name=\"use case description\">\n                        Planes y seguimiento adaptados a cada etapa, con Nutrición Pediátrica y Personalización de Plantillas para dejar tus formatos listos.\n                    </p>\n                    <p class=\"mt-6 border-t border-[var(--ng-border)] pt-5 text-[12px] font-bold uppercase tracking-wider text-[var(--ng-muted)]\" data-kid=\"3-2-1-2-3-4\" data-name=\"use case plan label\">\n                        Nutrición Pediátrica en PREMIUM\n                    </p>\n                </article>\n                <article class=\"flex flex-col rounded-3xl border border-[var(--ng-border)] bg-[var(--ng-surface)] p-8\" data-kid=\"3-2-1-2-4\" data-name=\"use case teams\">\n                    <i class=\"ph ph-users-three text-[22px] text-[var(--ng-accent)]\" data-kid=\"3-2-1-2-4-1\" data-name=\"users three icon\">\n                    </i>\n                    <h3 class=\"mt-5 text-[1.3rem] font-extrabold leading-tight tracking-[-0.02em]\" data-kid=\"3-2-1-2-4-2\" data-name=\"use case title\">\n                        Grupos y empresas\n                    </h3>\n                    <p class=\"mt-3 text-[15px] leading-relaxed text-[var(--ng-muted)]\" data-kid=\"3-2-1-2-4-3\" data-name=\"use case description\">\n                        Atención en Grupos y Sistema de Referidos desde PREMIUM; con Clínica se suman Gestión de Equipo, Multi-nutricionista y Marca Personalizada.\n                    </p>\n                    <p class=\"mt-6 border-t border-[var(--ng-border)] pt-5 text-[12px] font-bold uppercase tracking-wider text-[var(--ng-muted)]\" data-kid=\"3-2-1-2-4-4\" data-name=\"use case plan label\">\n                        Equipos en Clínica\n                    </p>\n                </article>\n            </div>\n        </div>\n    </section>\n    <!-- ===== PREGUNTAS FRECUENTES ===== -->\n    <section class=\"mx-auto max-w-[1180px] scroll-mt-24 px-6 py-20 lg:px-10 lg:py-24\" data-kid=\"1-7\" data-name=\"faq section\" id=\"faq\">\n        <div class=\"grid gap-12 lg:grid-cols-12 lg:gap-16\" data-kid=\"1-7-1\" data-name=\"faq content container\">\n            <div class=\"lg:col-span-4\" data-kid=\"1-7-1-1\" data-name=\"faq text header\">\n                <p class=\"text-[11px] font-bold uppercase tracking-[0.22em] text-[var(--ng-accent)]\" data-kid=\"1-7-1-1-1\" data-name=\"faq tag line\">\n                    Preguntas frecuentes\n                </p>\n                <h2 class=\"mt-5 text-[1.8rem] font-extrabold leading-[1.12] tracking-[-0.03em] sm:text-[2.1rem]\" data-kid=\"1-7-1-1-2\" data-name=\"faq headline\">\n                    Lo que suelen preguntar antes de empezar.\n                </h2>\n                <p class=\"mt-5 text-[15px] leading-relaxed text-[var(--ng-muted)]\" data-kid=\"1-7-1-1-3\" data-name=\"faq description text\">\n                    Si te queda una duda puntual, escribinos y la resolvemos.\n                </p>\n                <a class=\"mt-6 inline-flex items-center gap-2 text-[14.5px] font-bold text-[var(--ng-ink)] underline decoration-[var(--ng-accent)] decoration-2 underline-offset-[7px]\" data-kid=\"1-7-1-1-4\" data-name=\"faq whatsapp support link\" href=\"https://wa.me/584243153383?text=Hola,%20tengo%20una%20consulta%20sobre%20Nutringest\" rel=\"noopener noreferrer\" target=\"_blank\">\n                    <i class=\"ph ph-whatsapp-logo text-[16px] text-[#25D366]\" data-kid=\"1-7-1-1-4-1\" data-name=\"whatsapp icon\">\n                    </i>\n                    <span data-kid=\"1-7-1-1-4-2\" data-name=\"support link text\">\n                        Escribinos por WhatsApp\n                    </span>\n                </a>\n            </div>\n            <div class=\"lg:col-span-8\" data-kid=\"1-7-1-2\" data-name=\"faq list container\">\n                <details class=\"border-t border-[var(--ng-border)] py-6\" data-kid=\"1-7-1-2-1\" data-name=\"faq question one\" open=\"\">\n                    <summary class=\"flex items-start justify-between gap-6\" data-kid=\"1-7-1-2-1-1\" data-name=\"faq summary one\">\n                        <span class=\"text-[16.5px] font-bold leading-snug\" data-kid=\"1-7-1-2-1-1-1\" data-name=\"faq question text\">\n                            ¿Cómo funciona la prueba gratuita de 14 días?\n                        </span>\n                        <span class=\"mt-1 shrink-0 text-[var(--ng-accent)]\" data-kid=\"1-7-1-2-1-1-2\" data-name=\"faq icon container\">\n                            <i class=\"ph ph-plus ng-faq-plus text-[20px]\" data-kid=\"1-7-1-2-1-1-2-1\" data-name=\"plus icon\">\n                            </i>\n                            <i class=\"ph ph-minus ng-faq-minus text-[20px]\" data-kid=\"1-7-1-2-1-1-2-2\" data-name=\"minus icon\">\n                            </i>\n                        </span>\n                    </summary>\n                    <p class=\"mt-4 max-w-2xl pr-8 text-[15px] leading-relaxed text-[var(--ng-muted)]\" data-kid=\"1-7-1-2-1-2\" data-name=\"faq answer text\">\n                        Accedés a todas las funciones de PREMIUM desde el primer día. No pedimos tarjeta de crédito ni compromiso de permanencia: si no te sirve, la prueba termina y listo.\n                    </p>\n                </details>\n                <details class=\"border-t border-[var(--ng-border)] py-6\" data-kid=\"1-7-1-2-2\" data-name=\"faq question two\">\n                    <summary class=\"flex items-start justify-between gap-6\" data-kid=\"1-7-1-2-2-1\" data-name=\"faq summary two\">\n                        <span class=\"text-[16.5px] font-bold leading-snug\" data-kid=\"1-7-1-2-2-1-1\" data-name=\"faq question text\">\n                            ¿Mis historias clínicas y los datos de mis pacientes están seguros?\n                        </span>\n                        <span class=\"mt-1 shrink-0 text-[var(--ng-accent)]\" data-kid=\"1-7-1-2-2-1-2\" data-name=\"faq icon container\">\n                            <i class=\"ph ph-plus ng-faq-plus text-[20px]\" data-kid=\"1-7-1-2-2-1-2-1\" data-name=\"plus icon\">\n                            </i>\n                            <i class=\"ph ph-minus ng-faq-minus text-[20px]\" data-kid=\"1-7-1-2-2-1-2-2\" data-name=\"minus icon\">\n                            </i>\n                        </span>\n                    </summary>\n                    <p class=\"mt-4 max-w-2xl pr-8 text-[15px] leading-relaxed text-[var(--ng-muted)]\" data-kid=\"1-7-1-2-2-2\" data-name=\"faq answer text\">\n                        La información vive en tu cuenta, con respaldo continuo en la nube y acceso restringido al profesional que la carga. Podés exportar lo que necesites en cualquier momento.\n                    </p>\n                </details>\n                <details class=\"border-t border-[var(--ng-border)] py-6\" data-kid=\"1-7-1-2-3\" data-name=\"faq question three\">\n                    <summary class=\"flex items-start justify-between gap-6\" data-kid=\"1-7-1-2-3-1\" data-name=\"faq summary three\">\n                        <span class=\"text-[16.5px] font-bold leading-snug\" data-kid=\"1-7-1-2-3-1-1\" data-name=\"faq question text\">\n                            ¿Puedo exportar los planes y reportes en PDF?\n                        </span>\n                        <span class=\"mt-1 shrink-0 text-[var(--ng-accent)]\" data-kid=\"1-7-1-2-3-1-2\" data-name=\"faq icon container\">\n                            <i class=\"ph ph-plus ng-faq-plus text-[20px]\" data-kid=\"1-7-1-2-3-1-2-1\" data-name=\"plus icon\">\n                            </i>\n                            <i class=\"ph ph-minus ng-faq-minus text-[20px]\" data-kid=\"1-7-1-2-3-1-2-2\" data-name=\"minus icon\">\n                            </i>\n                        </span>\n                    </summary>\n                    <p class=\"mt-4 max-w-2xl pr-8 text-[15px] leading-relaxed text-[var(--ng-muted)]\" data-kid=\"1-7-1-2-3-2\" data-name=\"faq answer text\">\n                        Sí. Los reportes y los planes alimentarios se exportan en PDF listo para imprimir en A4 o para enviar directamente a tu paciente.\n                    </p>\n                </details>\n                <details class=\"border-t border-[var(--ng-border)] py-6\" data-kid=\"1-7-1-2-4\" data-name=\"faq question four\">\n                    <summary class=\"flex items-start justify-between gap-6\" data-kid=\"1-7-1-2-4-1\" data-name=\"faq summary four\">\n                        <span class=\"text-[16.5px] font-bold leading-snug\" data-kid=\"1-7-1-2-4-1-1\" data-name=\"faq question text\">\n                            ¿Qué es Nutringest Campus y quiénes aplican?\n                        </span>\n                        <span class=\"mt-1 shrink-0 text-[var(--ng-accent)]\" data-kid=\"1-7-1-2-4-1-2\" data-name=\"faq icon container\">\n                            <i class=\"ph ph-plus ng-faq-plus text-[20px]\" data-kid=\"1-7-1-2-4-1-2-1\" data-name=\"plus icon\">\n                            </i>\n                            <i class=\"ph ph-minus ng-faq-minus text-[20px]\" data-kid=\"1-7-1-2-4-1-2-2\" data-name=\"minus icon\">\n                            </i>\n                        </span>\n                    </summary>\n                    <p class=\"mt-4 max-w-2xl pr-8 text-[15px] leading-relaxed text-[var(--ng-muted)]\" data-kid=\"1-7-1-2-4-2\" data-name=\"faq answer text\">\n                        Es el programa para estudiantes de último año o en pasantías: 120 días de acceso premium gratuito para que hagas tus prácticas con la plataforma completa.\n                    </p>\n                </details>\n                <details class=\"border-y border-[var(--ng-border)] py-6\" data-kid=\"1-7-1-2-5\" data-name=\"faq question five\">\n                    <summary class=\"flex items-start justify-between gap-6\" data-kid=\"1-7-1-2-5-1\" data-name=\"faq summary five\">\n                        <span class=\"text-[16.5px] font-bold leading-snug\" data-kid=\"1-7-1-2-5-1-1\" data-name=\"faq question text\">\n                            ¿Puedo tener mi propio portafolio público de nutricionista?\n                        </span>\n                        <span class=\"mt-1 shrink-0 text-[var(--ng-accent)]\" data-kid=\"1-7-1-2-5-1-2\" data-name=\"faq icon container\">\n                            <i class=\"ph ph-plus ng-faq-plus text-[20px]\" data-kid=\"1-7-1-2-5-1-2-1\" data-name=\"plus icon\">\n                            </i>\n                            <i class=\"ph ph-minus ng-faq-minus text-[20px]\" data-kid=\"1-7-1-2-5-1-2-2\" data-name=\"minus icon\">\n                            </i>\n                        </span>\n                    </summary>\n                    <p class=\"mt-4 max-w-2xl pr-8 text-[15px] leading-relaxed text-[var(--ng-muted)]\" data-kid=\"1-7-1-2-5-2\" data-name=\"faq answer text\">\n                        Sí, con los Portafolios Digitales publicás tu perfil con biografía, especialidades y datos de contacto para que nuevos pacientes te encuentren.\n                    </p>\n                </details>\n            </div>\n        </div>\n    </section>\n    <!-- ===== CTA FINAL + NEWSLETTER ===== -->\n    <section class=\"mx-auto max-w-[1180px] scroll-mt-24 px-6 py-20 lg:px-10 lg:py-24\" data-kid=\"4-1\" data-name=\"final cta section\" id=\"cierre\">\n        <div class=\"rounded-[32px] border border-[var(--ng-border)] bg-[var(--ng-tint)] px-8 py-14 lg:px-16 lg:py-16\" data-kid=\"4-1-1\" data-name=\"final cta panel\">\n            <div class=\"grid gap-14 lg:grid-cols-12 lg:gap-16\" data-kid=\"4-1-1-1\" data-name=\"final cta grid\">\n                <div class=\"lg:col-span-7\" data-kid=\"4-1-1-1-1\" data-name=\"final cta content\">\n                    <p class=\"text-[11px] font-bold uppercase tracking-[0.22em] text-[var(--ng-tint-ink)]\" data-kid=\"4-1-1-1-1-1\" data-name=\"final cta tag line\">\n                        Empezá hoy\n                    </p>\n                    <h2 class=\"mt-5 text-[2rem] font-extrabold leading-[1.1] tracking-[-0.03em] text-[var(--ng-ink)] sm:text-[2.4rem]\" data-kid=\"4-1-1-1-1-2\" data-name=\"final cta headline text\">\n                        Probá Nutringest 14 días y decidí con la plataforma en la mano.\n                    </h2>\n                    <p class=\"mt-5 max-w-xl text-[15.5px] leading-relaxed text-[var(--ng-muted)]\" data-kid=\"4-1-1-1-1-3\" data-name=\"final cta description text\">\n                        Sin tarjeta de crédito y sin permanencia. Si sos estudiante de último año o estás en pasantías, tu ruta es Campus: 120 días de premium gratis.\n                    </p>\n                    <div class=\"mt-9 flex flex-wrap items-center gap-4\" data-kid=\"4-1-1-1-1-4\" data-name=\"final cta buttons group\">\n                        <a class=\"inline-flex items-center gap-2 rounded-full bg-[var(--ng-primary)] px-7 py-3.5 text-[15px] font-bold text-[var(--ng-primary-fg)] transition-transform hover:-translate-y-0.5\" data-kid=\"4-1-1-1-1-4-1\" data-name=\"final cta primary button\" href=\"#empezar\">\n                            <span data-kid=\"4-1-1-1-1-4-1-1\" data-name=\"final cta primary text\">\n                                Comenzar prueba de 14 días\n                            </span>\n                            <i class=\"ph ph-arrow-right text-[15px]\" data-kid=\"4-1-1-1-1-4-1-2\" data-name=\"arrow right icon\">\n                            </i>\n                        </a>\n                        <a class=\"inline-flex items-center gap-2 rounded-full border border-[var(--ng-accent)] px-7 py-3.5 text-[15px] font-bold text-[var(--ng-accent)] transition-colors hover:bg-[var(--ng-bg)]\" data-kid=\"4-1-1-1-1-4-2\" data-name=\"final cta campus button\" href=\"#campus\">\n                            <span data-kid=\"4-1-1-1-1-4-2-1\" data-name=\"final cta campus text\">\n                                Solicitar acceso Campus\n                            </span>\n                        </a>\n                    </div>\n                    <div class=\"mt-8 flex flex-wrap items-center gap-x-8 gap-y-3\" data-kid=\"4-1-1-1-1-5\" data-name=\"final cta direct channels\">\n                        <a class=\"inline-flex items-center gap-2 text-[14px] font-bold text-[var(--ng-ink)] underline decoration-[var(--ng-accent)] decoration-2 underline-offset-[7px]\" data-kid=\"4-1-1-1-1-5-1\" data-name=\"final cta whatsapp link\" href=\"https://wa.me/584243153383?text=Hola,%20tengo%20una%20consulta%20sobre%20Nutringest\" rel=\"noopener noreferrer\" target=\"_blank\">\n                            <i class=\"ph ph-whatsapp-logo text-[16px] text-[#25D366]\" data-kid=\"4-1-1-1-1-5-1-1\" data-name=\"whatsapp icon\">\n                            </i>\n                            <span data-kid=\"4-1-1-1-1-5-1-2\" data-name=\"whatsapp link text\">\n                                Escribinos por WhatsApp\n                            </span>\n                        </a>\n                        <button class=\"inline-flex items-center gap-2 text-[14px] font-bold text-[var(--ng-ink)] underline decoration-[var(--ng-accent)] decoration-2 underline-offset-[7px]\" data-kid=\"4-1-1-1-1-5-2\" data-name=\"final cta ia assistant button\" onclick=\"var p=document.getElementById('ng-ai-panel'); if(p){p.classList.remove('hidden');}\" type=\"button\">\n                            <i class=\"ph ph-sparkle text-[16px] text-[var(--ng-accent)]\" data-kid=\"4-1-1-1-1-5-2-1\" data-name=\"sparkle icon\">\n                            </i>\n                            <span data-kid=\"4-1-1-1-1-5-2-2\" data-name=\"ia assistant link text\">\n                                Preguntarle al asistente\n                            </span>\n                        </button>\n                    </div>\n                </div>\n                <div class=\"lg:col-span-5 lg:border-l lg:border-[var(--ng-border)] lg:pl-14\" data-kid=\"4-1-1-1-2\" data-name=\"newsletter container\">\n                    <p class=\"text-[11px] font-bold uppercase tracking-[0.22em] text-[var(--ng-tint-ink)]\" data-kid=\"4-1-1-1-2-1\" data-name=\"newsletter tag line\">\n                        Novedades para nutricionistas\n                    </p>\n                    <h3 class=\"mt-5 text-[1.35rem] font-extrabold leading-tight tracking-[-0.02em] text-[var(--ng-ink)]\" data-kid=\"4-1-1-1-2-2\" data-name=\"newsletter title\">\n                        Guías y novedades del producto, en tu correo\n                    </h3>\n                    <p class=\"mt-3 text-[14.5px] leading-relaxed text-[var(--ng-muted)]\" data-kid=\"4-1-1-1-2-3\" data-name=\"newsletter description text\">\n                        Te escribimos cuando publicamos algo útil sobre consulta, antropometría o planes. Podés darte de baja cuando quieras.\n                    </p>\n                    <form class=\"mt-7 flex flex-col gap-3 sm:flex-row\" data-kid=\"4-1-1-1-2-4\" data-name=\"newsletter form\" onsubmit=\"return false\">\n                        <label class=\"sr-only\" data-kid=\"4-1-1-1-2-4-1\" data-name=\"newsletter email label\" for=\"ng-news-email\">\n                            Tu correo electrónico\n                        </label>\n                        <input class=\"w-full rounded-full border border-[var(--ng-border)] bg-[var(--ng-bg)] px-5 py-3 text-[14px] text-[var(--ng-ink)] outline-none placeholder:text-[var(--ng-muted)] sm:w-56\" data-kid=\"4-1-1-1-2-4-2\" data-name=\"newsletter email input\" id=\"ng-news-email\" name=\"email\" placeholder=\"tu@email.com\" type=\"email\"/>\n                        <button class=\"shrink-0 rounded-full border border-[var(--ng-ink)] px-6 py-3 text-[14px] font-bold text-[var(--ng-ink)] transition-colors hover:bg-[var(--ng-bg)]\" data-kid=\"4-1-1-1-2-4-3\" data-name=\"newsletter submit button\" type=\"submit\">\n                            Suscribirme\n                        </button>\n                    </form>\n                    <p class=\"mt-4 text-[12.5px] text-[var(--ng-muted)]\" data-kid=\"4-1-1-1-2-5\" data-name=\"newsletter disclaimer text\">\n                        No compartimos tu correo con terceros.\n                    </p>\n                </div>\n            </div>\n        </div>\n    </section>\n    <!-- ===== FOOTER ===== -->\n    <footer class=\"border-t border-[var(--ng-band-border)] bg-[var(--ng-ink-band)] text-[var(--ng-band-ink)]\" data-kid=\"1-8\" data-name=\"footer\">\n        <div class=\"mx-auto max-w-[1180px] px-6 py-16 lg:px-10\" data-kid=\"1-8-1\" data-name=\"footer content container\">\n            <div class=\"grid gap-12 lg:grid-cols-12 lg:gap-16\" data-kid=\"1-8-1-1\" data-name=\"footer links grid\">\n                <div class=\"lg:col-span-5\" data-kid=\"1-8-1-1-1\" data-name=\"footer brand container\">\n                    <img alt=\"Nutringest\" class=\"h-7 w-auto\" data-kid=\"1-8-1-1-1-1\" data-name=\"footer white logo image\" src=\"/api/local/images/webapp/public/png/ImagotipoBlanco.png\"/>\n                    <p class=\"mt-5 max-w-sm text-[14px] leading-relaxed text-[var(--ng-band-muted)]\" data-kid=\"1-8-1-1-1-2\" data-name=\"footer description text\">\n                        Plataforma de gestión para consultorios nutricionales: pacientes, antropometría, planes alimentarios y seguimiento en un solo lugar.\n                    </p>\n                    <a class=\"mt-6 inline-flex items-center gap-2 text-[13.5px] font-bold text-[var(--ng-band-ink)]\" data-kid=\"1-8-1-1-1-3\" data-name=\"footer social link\" href=\"https://www.instagram.com/nutringest/\" rel=\"noopener noreferrer\" target=\"_blank\">\n                        <i class=\"ph ph-instagram-logo text-[16px]\" data-kid=\"1-8-1-1-1-3-1\" data-name=\"instagram icon\">\n                        </i>\n                        <span data-kid=\"1-8-1-1-1-3-2\" data-name=\"instagram handle\">\n                            @nutringest\n                        </span>\n                    </a>\n                </div>\n                <div class=\"lg:col-span-3\" data-kid=\"1-8-1-1-2\" data-name=\"footer product links container\">\n                    <h4 class=\"text-[11px] font-bold uppercase tracking-[0.2em] text-[var(--ng-band-muted)]\" data-kid=\"1-8-1-1-2-1\" data-name=\"product section title\">\n                        Producto\n                    </h4>\n                    <ul class=\"mt-5 space-y-3 text-[14px] font-semibold\" data-kid=\"1-8-1-1-2-2\" data-name=\"footer product links list\">\n                        <li data-kid=\"1-8-1-1-2-2-1\" data-name=\"footer link list item\">\n                            <a class=\"text-[var(--ng-band-ink)] transition-opacity hover:opacity-70\" data-kid=\"1-8-1-1-2-2-1-1\" data-name=\"footer link one\" href=\"#funciones\">\n                                Funciones\n                            </a>\n                        </li>\n                        <li data-kid=\"1-8-1-1-2-2-2\" data-name=\"footer link list item\">\n                            <a class=\"text-[var(--ng-band-ink)] transition-opacity hover:opacity-70\" data-kid=\"1-8-1-1-2-2-2-1\" data-name=\"footer link two\" href=\"#planes\">\n                                Planes\n                            </a>\n                        </li>\n                        <li data-kid=\"1-8-1-1-2-2-3\" data-name=\"footer link list item\">\n                            <a class=\"text-[var(--ng-band-ink)] transition-opacity hover:opacity-70\" data-kid=\"1-8-1-1-2-2-3-1\" data-name=\"footer link three\" href=\"#campus\">\n                                Nutringest Campus\n                            </a>\n                        </li>\n                        <li data-kid=\"1-8-1-1-2-2-4\" data-name=\"footer link list item\">\n                            <a class=\"text-[var(--ng-band-ink)] transition-opacity hover:opacity-70\" data-kid=\"1-8-1-1-2-2-4-1\" data-name=\"footer link four\" href=\"#faq\">\n                                Preguntas frecuentes\n                            </a>\n                        </li>\n                    </ul>\n                </div>\n                <div class=\"lg:col-span-4\" data-kid=\"1-8-1-1-3\" data-name=\"footer contact info container\">\n                    <h4 class=\"text-[11px] font-bold uppercase tracking-[0.2em] text-[var(--ng-band-muted)]\" data-kid=\"1-8-1-1-3-1\" data-name=\"contact section title\">\n                        Contacto\n                    </h4>\n                    <ul class=\"mt-5 space-y-3.5 text-[14px] font-semibold\" data-kid=\"1-8-1-1-3-2\" data-name=\"footer contact links list\">\n                        <li data-kid=\"1-8-1-1-3-2-1\" data-name=\"footer contact list item\">\n                            <a class=\"inline-flex items-center gap-2.5 text-[var(--ng-band-ink)] transition-opacity hover:opacity-70\" data-kid=\"1-8-1-1-3-2-1-1\" data-name=\"footer whatsapp link\" href=\"https://wa.me/584243153383?text=Hola,%20quisiera%20más%20información%20sobre%20Nutringest\" rel=\"noopener noreferrer\" target=\"_blank\">\n                                <i class=\"ph ph-whatsapp-logo text-[17px] text-[#25D366]\" data-kid=\"1-8-1-1-3-2-1-1-1\" data-name=\"whatsapp icon\">\n                                </i>\n                                <span data-kid=\"1-8-1-1-3-2-1-1-2\" data-name=\"whatsapp number\">\n                                    WhatsApp: +58 424-3153383\n                                </span>\n                            </a>\n                        </li>\n                        <li data-kid=\"1-8-1-1-3-2-2\" data-name=\"footer contact list item\">\n                            <a class=\"inline-flex items-center gap-2.5 break-all text-[var(--ng-band-ink)] transition-opacity hover:opacity-70\" data-kid=\"1-8-1-1-3-2-2-1\" data-name=\"footer email link\" href=\"mailto:nutringest@gmail.com\">\n                                <i class=\"ph ph-envelope-simple text-[17px] text-[var(--ng-accent)]\" data-kid=\"1-8-1-1-3-2-2-1-1\" data-name=\"email icon\">\n                                </i>\n                                <span data-kid=\"1-8-1-1-3-2-2-1-2\" data-name=\"email address\">\n                                    nutringest@gmail.com\n                                </span>\n                            </a>\n                        </li>\n                        <li class=\"flex items-center gap-2.5 text-[var(--ng-band-muted)]\" data-kid=\"1-8-1-1-3-2-3\" data-name=\"footer contact list item\">\n                            <i class=\"ph ph-map-pin text-[17px] text-[var(--ng-accent)]\" data-kid=\"1-8-1-1-3-2-3-1\" data-name=\"location icon\">\n                            </i>\n                            <span data-kid=\"1-8-1-1-3-2-3-2\" data-name=\"location text\">\n                                Guárico, Venezuela\n                            </span>\n                        </li>\n                    </ul>\n                </div>\n            </div>\n            <div class=\"mt-14 flex flex-col items-center justify-between gap-3 border-t border-white/12 pt-7 text-[12.5px] text-[var(--ng-band-muted)] sm:flex-row\" data-kid=\"1-8-1-2\" data-name=\"footer copyright container\">\n                <p data-kid=\"1-8-1-2-1\" data-name=\"copyright text\">\n                    © 2026 Nutringest. Todos los derechos reservados.\n                </p>\n                <p class=\"flex items-center gap-1.5\" data-kid=\"1-8-1-2-2\" data-name=\"footer mission text\">\n                    De nutricionistas, para nutricionistas\n                </p>\n            </div>\n        </div>\n    </footer>\n    <!-- ===== BURBUJAS FLOTANTES ===== -->\n    <div class=\"fixed bottom-6 right-6 z-50 flex flex-col items-end gap-3\" data-kid=\"1-9\" data-name=\"floating tools container\">\n        <!-- Panel del agente IA -->\n        <div class=\"hidden w-[330px] max-w-[calc(100vw-3rem)] overflow-hidden rounded-2xl border border-[var(--ng-border)] bg-[var(--ng-surface)] shadow-[0_30px_70px_-25px_rgba(20,16,31,0.5)]\" data-kid=\"1-9-1\" data-name=\"ia agent panel\" id=\"ng-ai-panel\">\n            <div class=\"flex items-center gap-3 bg-[var(--ng-ink-band)] px-4 py-3.5 text-[var(--ng-band-ink)]\" data-kid=\"1-9-1-1\" data-name=\"ia agent panel header\">\n                <span class=\"flex h-8 w-8 items-center justify-center rounded-full bg-[var(--ng-accent)] text-white\" data-kid=\"1-9-1-1-1\" data-name=\"ia sparkle icon container\">\n                    <i class=\"ph ph-sparkle text-[15px]\" data-kid=\"1-9-1-1-1-1\" data-name=\"sparkle icon\">\n                    </i>\n                </span>\n                <div class=\"min-w-0 flex-1\" data-kid=\"1-9-1-1-2\" data-name=\"ia agent title container\">\n                    <p class=\"text-[13px] font-bold leading-tight\" data-kid=\"1-9-1-1-2-1\" data-name=\"ia agent name\">\n                        Asistente Nutringest\n                    </p>\n                    <p class=\"text-[11px] text-[var(--ng-band-muted)]\" data-kid=\"1-9-1-1-2-2\" data-name=\"ia agent description\">\n                        Funciones, planes y Campus\n                    </p>\n                </div>\n                <button aria-label=\"Cerrar chat\" class=\"text-[var(--ng-band-muted)] transition-opacity hover:opacity-70\" data-kid=\"1-9-1-1-3\" data-name=\"ia panel close button\" id=\"ng-ai-close\" type=\"button\">\n                    <i class=\"ph ph-x text-[16px]\" data-kid=\"1-9-1-1-3-1\" data-name=\"close icon\">\n                    </i>\n                </button>\n            </div>\n            <div class=\"space-y-3 px-4 py-4\" data-kid=\"1-9-1-2\" data-name=\"ia chat messages container\">\n                <div class=\"max-w-[85%] rounded-2xl rounded-tl-sm bg-[var(--ng-tint)] px-3.5 py-2.5 text-[13px] leading-snug text-[var(--ng-ink)]\" data-kid=\"1-9-1-2-1\" data-name=\"ia chat message one\">\n                    ¡Hola! Soy el asistente de Nutringest. ¿Querés que te explique qué incluye cada plan?\n                </div>\n                <div class=\"ml-auto max-w-[85%] rounded-2xl rounded-tr-sm bg-[var(--ng-primary)] px-3.5 py-2.5 text-[13px] leading-snug text-[var(--ng-primary-fg)]\" data-kid=\"1-9-1-2-2\" data-name=\"ia chat message two\">\n                    ¿Cuál me conviene si trabajo sola en mi consultorio?\n                </div>\n                <div class=\"max-w-[85%] rounded-2xl rounded-tl-sm bg-[var(--ng-tint)] px-3.5 py-2.5 text-[13px] leading-snug text-[var(--ng-ink)]\" data-kid=\"1-9-1-2-3\" data-name=\"ia chat message three\">\n                    Si trabajás sola,\n                    <span class=\"font-bold\" data-kid=\"1-9-1-2-3-1\" data-name=\"ia chat message highlight\">\n                        PRO\n                    </span>\n                    cubre tu consultorio individual. Si además usás plantillas, nutrición deportiva o pediátrica,\n                    <span class=\"font-bold\" data-kid=\"1-9-1-2-3-2\" data-name=\"ia chat message highlight\">\n                        PREMIUM\n                    </span>\n                    suma esas herramientas. Las dos tienen 14 días de prueba.\n                </div>\n            </div>\n            <div class=\"flex items-center gap-2 border-t border-[var(--ng-border)] px-3 py-3\" data-kid=\"1-9-1-3\" data-name=\"ia chat input container\">\n                <input class=\"min-w-0 flex-1 rounded-full bg-[var(--ng-soft)] px-3.5 py-2.5 text-[13px] text-[var(--ng-ink)] outline-none\" data-kid=\"1-9-1-3-1\" data-name=\"ia chat input field\" placeholder=\"Escribí tu pregunta…\" type=\"text\"/>\n                <button aria-label=\"Enviar\" class=\"flex h-9 w-9 shrink-0 items-center justify-center rounded-full bg-[var(--ng-primary)] text-[var(--ng-primary-fg)]\" data-kid=\"1-9-1-3-2\" data-name=\"ia chat send button\" type=\"button\">\n                    <i class=\"ph ph-paper-plane-tilt text-[15px]\" data-kid=\"1-9-1-3-2-1\" data-name=\"send icon\">\n                    </i>\n                </button>\n            </div>\n        </div>\n        <!-- Burbuja chat IA -->\n        <button aria-label=\"Abrir chat con el asistente de IA\" class=\"flex h-14 w-14 items-center justify-center rounded-full bg-[var(--ng-primary)] text-[var(--ng-primary-fg)] shadow-[0_18px_40px_-14px_rgba(91,33,182,0.8)] transition-transform hover:-translate-y-0.5\" data-kid=\"1-9-2\" data-name=\"ia agent trigger button\" id=\"ng-ai-fab\" type=\"button\">\n            <i class=\"ph ph-chat-circle-dots text-[24px]\" data-kid=\"1-9-2-1\" data-name=\"chat circle dots icon\">\n            </i>\n        </button>\n        <!-- Burbuja WhatsApp -->\n        <a aria-label=\"Contactar por WhatsApp\" class=\"flex h-14 w-14 items-center justify-center rounded-full bg-[#25D366] text-white shadow-[0_18px_40px_-14px_rgba(37,211,102,0.9)] transition-transform hover:-translate-y-0.5\" data-kid=\"1-9-3\" data-name=\"whatsapp floating link\" href=\"https://wa.me/584243153383?text=Hola,%20tengo%20una%20consulta%20sobre%20Nutringest\" rel=\"noopener noreferrer\" target=\"_blank\">\n            <i class=\"ph ph-whatsapp-logo text-[26px]\" data-kid=\"1-9-3-1\" data-name=\"whatsapp icon\">\n            </i>\n        </a>\n    </div>\n    <script>\n        (function () {\n      var root = document.getElementById('ng-root');\n      var toggle = document.getElementById('ng-theme-toggle');\n      var fab = document.getElementById('ng-ai-fab');\n      var panel = document.getElementById('ng-ai-panel');\n      var close = document.getElementById('ng-ai-close');\n\n      if (root && toggle) {\n        toggle.addEventListener('click', function () {\n          var next = root.getAttribute('data-theme') === 'dark' ? 'light' : 'dark';\n          root.setAttribute('data-theme', next);\n        });\n      }\n      if (fab && panel) {\n        fab.addEventListener('click', function () {\n          panel.classList.toggle('hidden');\n        });\n      }\n      if (close && panel) {\n        close.addEventListener('click', function () {\n          panel.classList.add('hidden');\n        });\n      }\n    })();\n    </script>\n</div>\n",
      "comments": [],
      "created": "2026-09-27T17:45:09.153496+00:00",
      "modified": "2026-09-27T18:43:58.328494+00:00",
      "id": "var_722d919bd6d3"
    },
    "var_27daa8a4c4ad": {
      "type": "variant",
      "label": "Landing V2 — Comparar planes sin ambigüedad",
      "parentId": null,
      "themeId": null,
      "rect": {
        "x": 2760,
        "y": 0,
        "w": 1280,
        "h": 800
      },
      "html": "<style>\n    @import url('https://fonts.googleapis.com/css2?family=Montserrat:wght@300;400;500;600;700;800;900&display=swap');\n@import url(\"https://cdn.jsdelivr.net/npm/@phosphor-icons/web@2.1.1/src/regular/style.css\");\n@import url(\"https://cdn.jsdelivr.net/npm/@phosphor-icons/web@2.1.1/src/bold/style.css\");\n\nhtml { scroll-behavior: smooth; }\nbody { margin: 0; }\n\n.nr-root {\n  --bg: #ffffff;\n  --bg-soft: #f7f5fc;\n  --surface: #ffffff;\n  --nav-bg: rgba(255, 255, 255, 0.88);\n  --line: #e8e3f3;\n  --line-strong: #d7cfeb;\n  --ink: #150b26;\n  --muted: #6b6482;\n  --faint: #948da8;\n  --brand: #5b21b6;\n  --accent: #7c3aed;\n  --blue: #0ea5e9;\n  --brand-soft: #f2ecfe;\n  --on-brand: #ffffff;\n  font-family: 'Montserrat', ui-sans-serif, system-ui, sans-serif;\n  background-color: var(--bg);\n  color: var(--ink);\n  -webkit-font-smoothing: antialiased;\n}\n\n.nr-root[data-theme=\"dark\"] {\n  --bg: #0c0916;\n  --bg-soft: #120e20;\n  --surface: #161127;\n  --nav-bg: rgba(12, 9, 22, 0.85);\n  --line: #2a2340;\n  --line-strong: #3b3059;\n  --ink: #f3f1fa;\n  --muted: #a9a1c1;\n  --faint: #8b83a6;\n  --brand: #a78bfa;\n  --accent: #c4b5fd;\n  --blue: #38bdf8;\n  --brand-soft: #1b1432;\n  --on-brand: #130c26;\n}\n\n.nr-logo-dark { display: none; }\n.nr-root[data-theme=\"dark\"] .nr-logo-dark { display: block; }\n.nr-root[data-theme=\"dark\"] .nr-logo-light { display: none; }\n\n.nr-icon-moon { display: inline-flex; }\n.nr-icon-sun { display: none; }\n.nr-root[data-theme=\"dark\"] .nr-icon-moon { display: none; }\n.nr-root[data-theme=\"dark\"] .nr-icon-sun { display: inline-flex; }\n\n.nr-hidden { display: none; }\n\n.nr-faq summary { list-style: none; }\n.nr-faq summary::-webkit-details-marker { display: none; }\n.nr-faq .nr-plus { transition: transform 0.25s ease, color 0.25s ease; }\n.nr-faq[open] .nr-plus { transform: rotate(45deg); color: var(--brand); }\n</style>\n<div class=\"nr-root min-h-screen\" data-dynamic=\"true\" data-kid=\"1\" data-name=\"page layout container\" data-reason=\"theme attribute toggled by script\" data-theme=\"light\">\n    <!-- ================= NAVBAR (fixed) ================= -->\n    <header class=\"fixed inset-x-0 top-0 z-40 border-b border-[var(--line)] bg-[var(--nav-bg)] backdrop-blur-xl\" data-kid=\"1-1\">\n        <div class=\"mx-auto flex h-[74px] max-w-[1200px] items-center justify-between gap-6 px-6 lg:px-10\" data-kid=\"1-1-1\">\n            <a aria-label=\"Nutringest, inicio\" class=\"flex shrink-0 items-center\" data-kid=\"1-1-1-1\" href=\"#top\">\n                <img alt=\"Nutringest\" class=\"nr-logo-light h-8 w-auto\" data-kid=\"1-1-1-1-1\" decoding=\"async\" loading=\"lazy\" src=\"/api/local/images/webapp/public/png/ImagotipoPurpura.png\"/>\n                <img alt=\"Nutringest\" class=\"nr-logo-dark h-8 w-auto\" data-kid=\"1-1-1-1-2\" decoding=\"async\" loading=\"lazy\" src=\"/api/local/images/webapp/public/png/ImagotipoBlanco.png\"/>\n            </a>\n            <nav aria-label=\"Secciones\" class=\"hidden items-center gap-8 lg:flex\" data-kid=\"1-1-1-2\">\n                <a class=\"text-sm font-semibold text-[var(--muted)] transition-colors hover:text-[var(--brand)]\" data-kid=\"1-1-1-2-1\" href=\"#incluye\">\n                    Qué incluye\n                </a>\n                <a class=\"text-sm font-semibold text-[var(--muted)] transition-colors hover:text-[var(--brand)]\" data-kid=\"1-1-1-2-2\" href=\"#campus\">\n                    Campus\n                </a>\n                <a class=\"text-sm font-semibold text-[var(--muted)] transition-colors hover:text-[var(--brand)]\" data-kid=\"1-1-1-2-3\" href=\"#planes\">\n                    Comparar planes\n                </a>\n                <a class=\"text-sm font-semibold text-[var(--muted)] transition-colors hover:text-[var(--brand)]\" data-kid=\"1-1-1-2-4\" href=\"#faq\">\n                    FAQ\n                </a>\n            </nav>\n            <div class=\"flex items-center gap-3\" data-kid=\"1-1-1-3\">\n                <button aria-label=\"Cambiar entre modo claro y oscuro\" class=\"flex h-10 w-10 items-center justify-center rounded-full border border-[var(--line-strong)] text-[var(--ink)] transition-colors hover:border-[var(--brand)] hover:text-[var(--brand)]\" data-kid=\"1-1-1-3-1\" id=\"nr-theme\" type=\"button\">\n                    <i class=\"ph ph-moon nr-icon-moon text-lg\" data-kid=\"1-1-1-3-1-1\">\n                    </i>\n                    <i class=\"ph ph-sun nr-icon-sun text-lg\" data-kid=\"1-1-1-3-1-2\">\n                    </i>\n                </button>\n                <a class=\"hidden text-sm font-semibold text-[var(--muted)] transition-colors hover:text-[var(--ink)] sm:inline-flex\" data-kid=\"1-1-1-3-2\" href=\"#\">\n                    Iniciar sesión\n                </a>\n                <a class=\"inline-flex items-center justify-center gap-2 rounded-xl bg-[var(--brand)] px-5 py-3 text-sm font-bold text-[var(--on-brand)] transition-transform hover:-translate-y-0.5\" data-kid=\"1-1-1-3-3\" href=\"#planes\">\n                    <span class=\"hidden sm:inline\" data-kid=\"1-1-1-3-3-1\">\n                        Comenzar prueba de 14 días\n                    </span>\n                    <span class=\"sm:hidden\" data-kid=\"1-1-1-3-3-2\">\n                        Prueba 14 días\n                    </span>\n                </a>\n            </div>\n        </div>\n    </header>\n    <!-- ================= HERO ================= -->\n    <section class=\"px-6 pb-24 pt-36 lg:px-10 lg:pb-32 lg:pt-44\" data-kid=\"1-2\" id=\"top\">\n        <div class=\"mx-auto grid max-w-[1200px] items-center gap-16 lg:grid-cols-12 lg:gap-10\" data-kid=\"1-2-1\">\n            <div class=\"lg:col-span-7\" data-kid=\"1-2-1-1\">\n                <p class=\"flex items-center gap-3 text-[11px] font-bold uppercase tracking-[0.2em] text-[var(--brand)]\" data-kid=\"1-2-1-1-1\">\n                    <span class=\"h-px w-8 bg-[var(--brand)]\" data-kid=\"1-2-1-1-1-1\">\n                    </span>\n                    Software para nutricionistas\n                </p>\n                <h1 class=\"mt-8 text-[2.6rem] font-black leading-[1.04] tracking-[-0.03em] sm:text-5xl lg:text-[3.7rem]\" data-kid=\"1-2-1-1-2\">\n                    Elegí tu plan sin\n                    <span class=\"text-[var(--brand)]\" data-kid=\"1-2-1-1-2-1\">\n                        adivinar qué incluye cada uno.\n                    </span>\n                </h1>\n                <p class=\"mt-8 max-w-xl text-lg leading-relaxed text-[var(--muted)]\" data-kid=\"1-2-1-1-3\">\n                    ¿Consultorio individual, especialidad o clínica? Los tres precios están a la vista, junto con lo que suma cada nivel.\n          Historia clínica, antropometría, planes alimenticios y portal del paciente en la misma plataforma.\n                </p>\n                <div class=\"mt-10 flex flex-wrap items-center gap-4\" data-kid=\"1-2-1-1-4\">\n                    <a class=\"inline-flex items-center justify-center gap-2 rounded-xl bg-[var(--brand)] px-7 py-4 text-sm font-bold text-[var(--on-brand)] transition-transform hover:-translate-y-0.5\" data-kid=\"1-2-1-1-4-1\" href=\"#planes\">\n                        Ver planes\n                        <i class=\"ph-bold ph-arrow-right text-base\" data-kid=\"1-2-1-1-4-1-1\">\n                        </i>\n                    </a>\n                    <a class=\"inline-flex items-center justify-center gap-2 rounded-xl border border-[var(--line-strong)] px-7 py-4 text-sm font-bold text-[var(--ink)] transition-colors hover:border-[var(--brand)] hover:text-[var(--brand)]\" data-kid=\"1-2-1-1-4-2\" href=\"#incluye\">\n                        Ver qué incluye\n                    </a>\n                </div>\n                <p class=\"mt-7 text-sm text-[var(--faint)]\" data-kid=\"1-2-1-1-5\">\n                    14 días de prueba completa · No pedimos tarjeta de crédito\n                </p>\n            </div>\n            <div class=\"relative lg:col-span-5\" data-kid=\"1-2-1-2\">\n                <img alt=\"Nutricionista trabajando con mediciones y un plan alimentario en su consultorio — Foto de B Y G en Unsplash\" class=\"aspect-[5/6] w-full rounded-[2rem] object-cover\" data-kid=\"1-2-1-2-1\" decoding=\"async\" loading=\"lazy\" src=\"https://images.unsplash.com/photo-1675270690434-aa99f4871e8a?auto=format&fit=crop&w=1400&q=80\"/>\n                <img alt=\"Plan alimentario impreso sobre la mesa de trabajo — Foto de beyzahzah en Pexels\" class=\"absolute -bottom-8 -left-6 z-10 hidden h-52 w-40 rounded-2xl border-[6px] border-[var(--bg)] object-cover shadow-xl sm:block\" data-kid=\"1-2-1-2-2\" decoding=\"async\" loading=\"lazy\" src=\"https://images.pexels.com/photos/15319046/pexels-photo-15319046.jpeg?auto=compress&cs=tinysrgb&w=900\"/>\n            </div>\n        </div>\n    </section>\n    <!-- ================= CTA & MÉTRICAS ================= -->\n    <section class=\"border-y border-[var(--line)] bg-[var(--bg-soft)] px-6 py-20 lg:px-10 lg:py-24\" data-kid=\"1-3\">\n        <div class=\"mx-auto max-w-[1200px]\" data-kid=\"1-3-1\">\n            <div class=\"flex flex-col justify-between gap-8 lg:flex-row lg:items-end\" data-kid=\"1-3-1-1\">\n                <div class=\"max-w-2xl\" data-kid=\"1-3-1-1-1\">\n                    <p class=\"text-[11px] font-bold uppercase tracking-[0.2em] text-[var(--brand)]\" data-kid=\"1-3-1-1-1-1\">\n                        Las cifras, con su condición\n                    </p>\n                    <h2 class=\"mt-5 text-3xl font-black leading-[1.1] tracking-tight sm:text-4xl\" data-kid=\"1-3-1-1-1-2\">\n                        Sabés exactamente qué estás comparando.\n                    </h2>\n                    <p class=\"mt-4 text-lg leading-relaxed text-[var(--muted)]\" data-kid=\"1-3-1-1-1-3\">\n                        Duración de prueba, programa académico y descuentos de preventa: cada número viene con lo que significa, sin mezclarlos.\n                    </p>\n                </div>\n                <a class=\"inline-flex shrink-0 items-center justify-center gap-2 rounded-xl border border-[var(--line-strong)] px-6 py-3.5 text-sm font-bold text-[var(--ink)] transition-colors hover:border-[var(--brand)] hover:text-[var(--brand)]\" data-kid=\"1-3-1-1-2\" href=\"#planes\">\n                    Comparar los 3 planes\n                    <i class=\"ph-bold ph-arrow-down text-base\" data-kid=\"1-3-1-1-2-1\">\n                    </i>\n                </a>\n            </div>\n            <dl class=\"mt-14 grid gap-px overflow-hidden rounded-[1.5rem] border border-[var(--line)] bg-[var(--line)] sm:grid-cols-2 lg:grid-cols-4\" data-kid=\"1-3-1-2\">\n                <div class=\"bg-[var(--bg)] p-7\" data-kid=\"1-3-1-2-1\">\n                    <dt class=\"text-4xl font-black tracking-tight\" data-kid=\"1-3-1-2-1-1\">\n                        14 días\n                    </dt>\n                    <dd class=\"mt-3 text-sm leading-relaxed text-[var(--muted)]\" data-kid=\"1-3-1-2-1-2\">\n                        de prueba con todas las funciones. No pedimos tarjeta de crédito ni permanencia.\n                    </dd>\n                </div>\n                <div class=\"bg-[var(--bg)] p-7\" data-kid=\"1-3-1-2-2\">\n                    <dt class=\"text-4xl font-black tracking-tight\" data-kid=\"1-3-1-2-2-1\">\n                        120 días\n                    </dt>\n                    <dd class=\"mt-3 text-sm leading-relaxed text-[var(--muted)]\" data-kid=\"1-3-1-2-2-2\">\n                        de acceso premium gratis si cursás el último año o estás en pasantías\n                        <a class=\"font-semibold text-[var(--brand)] underline decoration-1 underline-offset-2\" data-kid=\"1-3-1-2-2-2-1\" href=\"#campus\">\n                            (Campus)\n                        </a>\n                        .\n                    </dd>\n                </div>\n                <div class=\"bg-[var(--bg)] p-7\" data-kid=\"1-3-1-2-3\">\n                    <dt class=\"text-4xl font-black tracking-tight\" data-kid=\"1-3-1-2-3-1\">\n                        60%\n                    </dt>\n                    <dd class=\"mt-3 text-sm leading-relaxed text-[var(--muted)]\" data-kid=\"1-3-1-2-3-2\">\n                        de ahorro en PRO durante la preventa:\n                        <span class=\"font-semibold text-[var(--ink)]\" data-kid=\"1-3-1-2-3-2-1\">\n                            $4.00\n                        </span>\n                        al mes en vez de $10.00.\n                    </dd>\n                </div>\n                <div class=\"bg-[var(--bg)] p-7\" data-kid=\"1-3-1-2-4\">\n                    <dt class=\"text-4xl font-black tracking-tight\" data-kid=\"1-3-1-2-4-1\">\n                        20%\n                    </dt>\n                    <dd class=\"mt-3 text-sm leading-relaxed text-[var(--muted)]\" data-kid=\"1-3-1-2-4-2\">\n                        de ahorro en PREMIUM durante la preventa:\n                        <span class=\"font-semibold text-[var(--ink)]\" data-kid=\"1-3-1-2-4-2-1\">\n                            $20.00\n                        </span>\n                        al mes en vez de $25.00.\n                    </dd>\n                </div>\n            </dl>\n            <div class=\"mt-10 flex flex-col items-start justify-between gap-5 sm:flex-row sm:items-center\" data-kid=\"1-3-1-3\">\n                <p class=\"text-sm text-[var(--faint)]\" data-kid=\"1-3-1-3-1\">\n                    Todas las modalidades se facturan mensualmente. Cancelás cuando quieras.\n                </p>\n                <a class=\"inline-flex items-center justify-center gap-2 rounded-xl bg-[var(--brand)] px-7 py-4 text-sm font-bold text-[var(--on-brand)] transition-transform hover:-translate-y-0.5\" data-kid=\"1-3-1-3-2\" href=\"#\">\n                    Comenzar prueba de 14 días\n                    <i class=\"ph-bold ph-arrow-right text-base\" data-kid=\"1-3-1-3-2-1\">\n                    </i>\n                </a>\n            </div>\n        </div>\n    </section>\n    <!-- ================= QUÉ ABARCA EL SOFTWARE ================= -->\n    <section class=\"scroll-mt-24 px-6 py-24 lg:px-10 lg:py-32\" data-kid=\"1-4\" id=\"incluye\">\n        <div class=\"mx-auto max-w-[1200px]\" data-kid=\"1-4-1\">\n            <div class=\"max-w-3xl\" data-kid=\"1-4-1-1\">\n                <p class=\"text-[11px] font-bold uppercase tracking-[0.2em] text-[var(--brand)]\" data-kid=\"1-4-1-1-1\">\n                    Qué abarca el software\n                </p>\n                <h2 class=\"mt-6 text-3xl font-black leading-[1.08] tracking-tight sm:text-4xl lg:text-[2.9rem]\" data-kid=\"1-4-1-1-2\">\n                    Un mismo expediente para\n                    <span class=\"text-[var(--brand)]\" data-kid=\"1-4-1-1-2-1\">\n                        consulta, plan y seguimiento\n                    </span>\n                    .\n                </h2>\n                <p class=\"mt-6 text-lg leading-relaxed text-[var(--muted)]\" data-kid=\"1-4-1-1-3\">\n                    Agrupado por lo que decidís hacer: atender cualquier consultorio, especializarte o coordinar un equipo. La lista exacta de cada plan la ves más abajo.\n                </p>\n            </div>\n            <figure class=\"mt-14 overflow-hidden rounded-[1.5rem] border border-[var(--line)]\" data-kid=\"1-4-1-2\">\n                <img alt=\"Nutricionista revisando mediciones y un plan alimentario en su escritorio — Foto de beyzahzah en Pexels\" class=\"h-[260px] w-full object-cover lg:h-[380px]\" data-kid=\"1-4-1-2-1\" decoding=\"async\" loading=\"lazy\" src=\"https://images.pexels.com/photos/15319038/pexels-photo-15319038.jpeg?auto=compress&cs=tinysrgb&w=1400\"/>\n            </figure>\n            <div class=\"mt-20 grid gap-14 lg:grid-cols-12 lg:gap-12\" data-kid=\"1-4-1-3\">\n                <div class=\"lg:col-span-5\" data-kid=\"1-4-1-3-1\">\n                    <p class=\"text-[11px] font-bold uppercase tracking-[0.2em] text-[var(--brand)]\" data-kid=\"1-4-1-3-1-1\">\n                        01 — Para cualquier consultorio\n                    </p>\n                    <h3 class=\"mt-5 text-2xl font-black leading-snug tracking-tight\" data-kid=\"1-4-1-3-1-2\">\n                        El día a día del consultorio individual.\n                    </h3>\n                    <ul class=\"mt-8 space-y-4\" data-kid=\"1-4-1-3-1-3\">\n                        <li class=\"flex items-start gap-3 text-[15px] leading-snug\" data-kid=\"1-4-1-3-1-3-1\">\n                            <i class=\"ph-bold ph-check mt-0.5 text-[var(--brand)]\" data-kid=\"1-4-1-3-1-3-1-1\">\n                            </i>\n                            <span data-kid=\"1-4-1-3-1-3-1-2\">\n                                Pacientes Ilimitados\n                            </span>\n                        </li>\n                        <li class=\"flex items-start gap-3 text-[15px] leading-snug\" data-kid=\"1-4-1-3-1-3-2\">\n                            <i class=\"ph-bold ph-check mt-0.5 text-[var(--brand)]\" data-kid=\"1-4-1-3-1-3-2-1\">\n                            </i>\n                            <span data-kid=\"1-4-1-3-1-3-2-2\">\n                                Consultas y Seguimiento\n                            </span>\n                        </li>\n                        <li class=\"flex items-start gap-3 text-[15px] leading-snug\" data-kid=\"1-4-1-3-1-3-3\">\n                            <i class=\"ph-bold ph-check mt-0.5 text-[var(--brand)]\" data-kid=\"1-4-1-3-1-3-3-1\">\n                            </i>\n                            <span data-kid=\"1-4-1-3-1-3-3-2\">\n                                Menús y Planes de Alimentación\n                            </span>\n                        </li>\n                        <li class=\"flex items-start gap-3 text-[15px] leading-snug\" data-kid=\"1-4-1-3-1-3-4\">\n                            <i class=\"ph-bold ph-check mt-0.5 text-[var(--brand)]\" data-kid=\"1-4-1-3-1-3-4-1\">\n                            </i>\n                            <span data-kid=\"1-4-1-3-1-3-4-2\">\n                                Listas de Intercambio\n                            </span>\n                        </li>\n                        <li class=\"flex items-start gap-3 text-[15px] leading-snug\" data-kid=\"1-4-1-3-1-3-5\">\n                            <i class=\"ph-bold ph-check mt-0.5 text-[var(--brand)]\" data-kid=\"1-4-1-3-1-3-5-1\">\n                            </i>\n                            <span data-kid=\"1-4-1-3-1-3-5-2\">\n                                App/Portal para Pacientes\n                            </span>\n                        </li>\n                        <li class=\"flex items-start gap-3 text-[15px] leading-snug\" data-kid=\"1-4-1-3-1-3-6\">\n                            <i class=\"ph-bold ph-check mt-0.5 text-[var(--brand)]\" data-kid=\"1-4-1-3-1-3-6-1\">\n                            </i>\n                            <span data-kid=\"1-4-1-3-1-3-6-2\">\n                                Listas de Compras Automáticas\n                            </span>\n                        </li>\n                        <li class=\"flex items-start gap-3 text-[15px] leading-snug\" data-kid=\"1-4-1-3-1-3-7\">\n                            <i class=\"ph-bold ph-check mt-0.5 text-[var(--brand)]\" data-kid=\"1-4-1-3-1-3-7-1\">\n                            </i>\n                            <span data-kid=\"1-4-1-3-1-3-7-2\">\n                                Cálculo Antropométrico\n                            </span>\n                        </li>\n                        <li class=\"flex items-start gap-3 text-[15px] leading-snug\" data-kid=\"1-4-1-3-1-3-8\">\n                            <i class=\"ph-bold ph-check mt-0.5 text-[var(--brand)]\" data-kid=\"1-4-1-3-1-3-8-1\">\n                            </i>\n                            <span data-kid=\"1-4-1-3-1-3-8-2\">\n                                Base de Alimentos Completa\n                            </span>\n                        </li>\n                    </ul>\n                </div>\n                <div class=\"border-t border-[var(--line)] pt-14 lg:col-span-7 lg:border-l lg:border-t-0 lg:pl-12 lg:pt-0\" data-kid=\"1-4-1-3-2\">\n                    <div class=\"grid gap-14 sm:grid-cols-2 sm:gap-10\" data-kid=\"1-4-1-3-2-1\">\n                        <div data-kid=\"1-4-1-3-2-1-1\">\n                            <p class=\"text-[11px] font-bold uppercase tracking-[0.2em] text-[var(--brand)]\" data-kid=\"1-4-1-3-2-1-1-1\">\n                                02 — Para especializarte\n                            </p>\n                            <h3 class=\"mt-5 text-xl font-black leading-snug tracking-tight\" data-kid=\"1-4-1-3-2-1-1-2\">\n                                Plantillas, especialidades y portafolios.\n                            </h3>\n                            <ul class=\"mt-7 space-y-3.5\" data-kid=\"1-4-1-3-2-1-1-3\">\n                                <li class=\"flex items-start gap-3 text-sm leading-snug\" data-kid=\"1-4-1-3-2-1-1-3-1\">\n                                    <i class=\"ph-bold ph-check mt-0.5 text-[var(--brand)]\" data-kid=\"1-4-1-3-2-1-1-3-1-1\">\n                                    </i>\n                                    <span data-kid=\"1-4-1-3-2-1-1-3-1-2\">\n                                        Plantillas de Dietas\n                                    </span>\n                                </li>\n                                <li class=\"flex items-start gap-3 text-sm leading-snug\" data-kid=\"1-4-1-3-2-1-1-3-2\">\n                                    <i class=\"ph-bold ph-check mt-0.5 text-[var(--brand)]\" data-kid=\"1-4-1-3-2-1-1-3-2-1\">\n                                    </i>\n                                    <span data-kid=\"1-4-1-3-2-1-1-3-2-2\">\n                                        Personalización de Plantillas\n                                    </span>\n                                </li>\n                                <li class=\"flex items-start gap-3 text-sm leading-snug\" data-kid=\"1-4-1-3-2-1-1-3-3\">\n                                    <i class=\"ph-bold ph-check mt-0.5 text-[var(--brand)]\" data-kid=\"1-4-1-3-2-1-1-3-3-1\">\n                                    </i>\n                                    <span data-kid=\"1-4-1-3-2-1-1-3-3-2\">\n                                        Portafolios Digitales\n                                    </span>\n                                </li>\n                                <li class=\"flex items-start gap-3 text-sm leading-snug\" data-kid=\"1-4-1-3-2-1-1-3-4\">\n                                    <i class=\"ph-bold ph-check mt-0.5 text-[var(--brand)]\" data-kid=\"1-4-1-3-2-1-1-3-4-1\">\n                                    </i>\n                                    <span data-kid=\"1-4-1-3-2-1-1-3-4-2\">\n                                        Nutrición Deportiva\n                                    </span>\n                                </li>\n                                <li class=\"flex items-start gap-3 text-sm leading-snug\" data-kid=\"1-4-1-3-2-1-1-3-5\">\n                                    <i class=\"ph-bold ph-check mt-0.5 text-[var(--brand)]\" data-kid=\"1-4-1-3-2-1-1-3-5-1\">\n                                    </i>\n                                    <span data-kid=\"1-4-1-3-2-1-1-3-5-2\">\n                                        Nutrición Pediátrica\n                                    </span>\n                                </li>\n                                <li class=\"flex items-start gap-3 text-sm leading-snug\" data-kid=\"1-4-1-3-2-1-1-3-6\">\n                                    <i class=\"ph-bold ph-check mt-0.5 text-[var(--brand)]\" data-kid=\"1-4-1-3-2-1-1-3-6-1\">\n                                    </i>\n                                    <span data-kid=\"1-4-1-3-2-1-1-3-6-2\">\n                                        Sistema de Referidos\n                                    </span>\n                                </li>\n                                <li class=\"flex items-start gap-3 text-sm leading-snug\" data-kid=\"1-4-1-3-2-1-1-3-7\">\n                                    <i class=\"ph-bold ph-check mt-0.5 text-[var(--brand)]\" data-kid=\"1-4-1-3-2-1-1-3-7-1\">\n                                    </i>\n                                    <span data-kid=\"1-4-1-3-2-1-1-3-7-2\">\n                                        Atención en Grupos\n                                    </span>\n                                </li>\n                            </ul>\n                        </div>\n                        <div data-kid=\"1-4-1-3-2-1-2\">\n                            <p class=\"text-[11px] font-bold uppercase tracking-[0.2em] text-[var(--brand)]\" data-kid=\"1-4-1-3-2-1-2-1\">\n                                03 — Para trabajar en equipo\n                            </p>\n                            <h3 class=\"mt-5 text-xl font-black leading-snug tracking-tight\" data-kid=\"1-4-1-3-2-1-2-2\">\n                                Equipos, marca y analíticas.\n                            </h3>\n                            <ul class=\"mt-7 space-y-3.5\" data-kid=\"1-4-1-3-2-1-2-3\">\n                                <li class=\"flex items-start gap-3 text-sm leading-snug\" data-kid=\"1-4-1-3-2-1-2-3-1\">\n                                    <i class=\"ph-bold ph-check mt-0.5 text-[var(--brand)]\" data-kid=\"1-4-1-3-2-1-2-3-1-1\">\n                                    </i>\n                                    <span data-kid=\"1-4-1-3-2-1-2-3-1-2\">\n                                        Gestión de Equipo\n                                    </span>\n                                </li>\n                                <li class=\"flex items-start gap-3 text-sm leading-snug\" data-kid=\"1-4-1-3-2-1-2-3-2\">\n                                    <i class=\"ph-bold ph-check mt-0.5 text-[var(--brand)]\" data-kid=\"1-4-1-3-2-1-2-3-2-1\">\n                                    </i>\n                                    <span data-kid=\"1-4-1-3-2-1-2-3-2-2\">\n                                        Multi-nutricionista\n                                    </span>\n                                </li>\n                                <li class=\"flex items-start gap-3 text-sm leading-snug\" data-kid=\"1-4-1-3-2-1-2-3-3\">\n                                    <i class=\"ph-bold ph-check mt-0.5 text-[var(--brand)]\" data-kid=\"1-4-1-3-2-1-2-3-3-1\">\n                                    </i>\n                                    <span data-kid=\"1-4-1-3-2-1-2-3-3-2\">\n                                        Marca Personalizada\n                                    </span>\n                                </li>\n                                <li class=\"flex items-start gap-3 text-sm leading-snug\" data-kid=\"1-4-1-3-2-1-2-3-4\">\n                                    <i class=\"ph-bold ph-check mt-0.5 text-[var(--brand)]\" data-kid=\"1-4-1-3-2-1-2-3-4-1\">\n                                    </i>\n                                    <span data-kid=\"1-4-1-3-2-1-2-3-4-2\">\n                                        Analíticas Avanzadas\n                                    </span>\n                                </li>\n                                <li class=\"flex items-start gap-3 text-sm leading-snug\" data-kid=\"1-4-1-3-2-1-2-3-5\">\n                                    <i class=\"ph-bold ph-check mt-0.5 text-[var(--brand)]\" data-kid=\"1-4-1-3-2-1-2-3-5-1\">\n                                    </i>\n                                    <span data-kid=\"1-4-1-3-2-1-2-3-5-2\">\n                                        Soporte Prioritario VIP\n                                    </span>\n                                </li>\n                            </ul>\n                        </div>\n                    </div>\n                </div>\n            </div>\n        </div>\n    </section>\n    <!-- ================= PARA QUIÉN ES ================= -->\n    <section class=\"scroll-mt-24 border-y border-[var(--line)] bg-[var(--bg-soft)] px-6 py-24 lg:px-10 lg:py-32\" data-kid=\"1-11\" id=\"para-quien\">\n        <div class=\"mx-auto max-w-[1200px]\" data-kid=\"1-11-1\">\n            <div class=\"max-w-3xl\" data-kid=\"1-11-1-1\">\n                <p class=\"text-[11px] font-bold uppercase tracking-[0.2em] text-[var(--brand)]\" data-kid=\"1-11-1-1-1\">\n                    Para quién es\n                </p>\n                <h2 class=\"mt-6 text-3xl font-black leading-[1.08] tracking-tight sm:text-4xl lg:text-[2.9rem]\" data-kid=\"1-11-1-1-2\">\n                    Ubicá tu caso y ya sabés\n                    <span class=\"text-[var(--brand)]\" data-kid=\"1-11-1-1-2-1\">\n                        qué plan te toca.\n                    </span>\n                </h2>\n                <p class=\"mt-6 text-lg leading-relaxed text-[var(--muted)]\" data-kid=\"1-11-1-1-3\">\n                    Cuatro puntos de partida distintos. Cada uno tiene una ruta recomendada, y podés cambiarla cuando tu práctica cambie.\n                </p>\n            </div>\n            <div class=\"mt-14 grid gap-px overflow-hidden rounded-[1.5rem] border border-[var(--line)] bg-[var(--line)] sm:grid-cols-2 lg:grid-cols-4\" data-kid=\"1-11-1-2\">\n                <div class=\"flex flex-col bg-[var(--bg)] p-8\" data-kid=\"1-11-1-2-1\">\n                    <i class=\"ph ph-graduation-cap text-2xl text-[var(--brand)]\" data-kid=\"1-11-1-2-1-1\">\n                    </i>\n                    <h3 class=\"mt-6 text-lg font-black leading-snug tracking-tight\" data-kid=\"1-11-1-2-1-2\">\n                        Estudiante o pasantía\n                    </h3>\n                    <p class=\"mt-3 flex-1 text-sm leading-relaxed text-[var(--muted)]\" data-kid=\"1-11-1-2-1-3\">\n                        Cursás el último año de la licenciatura en nutrición o estás haciendo tus prácticas profesionales.\n                    </p>\n                    <p class=\"mt-7 text-[10px] font-black uppercase tracking-[0.16em] text-[var(--faint)]\" data-kid=\"1-11-1-2-1-4\">\n                        Ruta recomendada\n                    </p>\n                    <p class=\"mt-2 text-base font-black\" data-kid=\"1-11-1-2-1-5\">\n                        Campus\n                    </p>\n                    <p class=\"mt-1 text-sm leading-relaxed text-[var(--muted)]\" data-kid=\"1-11-1-2-1-6\">\n                        120 días de acceso premium gratis, sin costo ni tarjeta.\n                    </p>\n                    <a class=\"mt-6 inline-flex items-center gap-2 text-sm font-bold text-[var(--brand)] transition-opacity hover:opacity-80\" data-kid=\"1-11-1-2-1-7\" href=\"#campus\">\n                        Solicitar acceso\n                        <i class=\"ph-bold ph-arrow-right text-base\" data-kid=\"1-11-1-2-1-7-1\">\n                        </i>\n                    </a>\n                </div>\n                <div class=\"flex flex-col bg-[var(--bg)] p-8\" data-kid=\"1-11-1-2-2\">\n                    <i class=\"ph ph-user text-2xl text-[var(--brand)]\" data-kid=\"1-11-1-2-2-1\">\n                    </i>\n                    <h3 class=\"mt-6 text-lg font-black leading-snug tracking-tight\" data-kid=\"1-11-1-2-2-2\">\n                        Consultorio individual\n                    </h3>\n                    <p class=\"mt-3 flex-1 text-sm leading-relaxed text-[var(--muted)]\" data-kid=\"1-11-1-2-2-3\">\n                        Atendés tus propios pacientes y necesitás historia clínica, planes y seguimiento en un solo lugar.\n                    </p>\n                    <p class=\"mt-7 text-[10px] font-black uppercase tracking-[0.16em] text-[var(--faint)]\" data-kid=\"1-11-1-2-2-4\">\n                        Ruta recomendada\n                    </p>\n                    <p class=\"mt-2 text-base font-black\" data-kid=\"1-11-1-2-2-5\">\n                        PRO\n                        <span class=\"ml-2 text-sm font-bold text-[var(--brand)]\" data-kid=\"1-11-1-2-2-5-1\">\n                            $4.00/mes\n                        </span>\n                    </p>\n                    <p class=\"mt-1 text-sm leading-relaxed text-[var(--muted)]\" data-kid=\"1-11-1-2-2-6\">\n                        Preventa: antes $10.00/mes, 60% de ahorro. Pacientes ilimitados, menús, intercambios, antropometría y portal.\n                    </p>\n                    <a class=\"mt-6 inline-flex items-center gap-2 text-sm font-bold text-[var(--brand)] transition-opacity hover:opacity-80\" data-kid=\"1-11-1-2-2-7\" href=\"#planes\">\n                        Ver plan PRO\n                        <i class=\"ph-bold ph-arrow-right text-base\" data-kid=\"1-11-1-2-2-7-1\">\n                        </i>\n                    </a>\n                </div>\n                <div class=\"flex flex-col bg-[var(--bg)] p-8\" data-kid=\"1-11-1-2-3\">\n                    <i class=\"ph ph-heartbeat text-2xl text-[var(--brand)]\" data-kid=\"1-11-1-2-3-1\">\n                    </i>\n                    <h3 class=\"mt-6 text-lg font-black leading-snug tracking-tight\" data-kid=\"1-11-1-2-3-2\">\n                        Especialista\n                    </h3>\n                    <p class=\"mt-3 flex-1 text-sm leading-relaxed text-[var(--muted)]\" data-kid=\"1-11-1-2-3-3\">\n                        Trabajás nutrición deportiva, pediátrica o con plantillas propias que querés reutilizar y personalizar.\n                    </p>\n                    <p class=\"mt-7 text-[10px] font-black uppercase tracking-[0.16em] text-[var(--faint)]\" data-kid=\"1-11-1-2-3-4\">\n                        Ruta recomendada\n                    </p>\n                    <p class=\"mt-2 text-base font-black\" data-kid=\"1-11-1-2-3-5\">\n                        PREMIUM\n                        <span class=\"ml-2 text-sm font-bold text-[var(--brand)]\" data-kid=\"1-11-1-2-3-5-1\">\n                            $20.00/mes\n                        </span>\n                    </p>\n                    <p class=\"mt-1 text-sm leading-relaxed text-[var(--muted)]\" data-kid=\"1-11-1-2-3-6\">\n                        Preventa: antes $25.00/mes, 20% de ahorro. Todo lo de PRO más herramientas pro y especialidades.\n                    </p>\n                    <a class=\"mt-6 inline-flex items-center gap-2 text-sm font-bold text-[var(--brand)] transition-opacity hover:opacity-80\" data-kid=\"1-11-1-2-3-7\" href=\"#planes\">\n                        Ver plan PREMIUM\n                        <i class=\"ph-bold ph-arrow-right text-base\" data-kid=\"1-11-1-2-3-7-1\">\n                        </i>\n                    </a>\n                </div>\n                <div class=\"flex flex-col bg-[var(--bg)] p-8\" data-kid=\"1-11-1-2-4\">\n                    <i class=\"ph ph-users-three text-2xl text-[var(--brand)]\" data-kid=\"1-11-1-2-4-1\">\n                    </i>\n                    <h3 class=\"mt-6 text-lg font-black leading-snug tracking-tight\" data-kid=\"1-11-1-2-4-2\">\n                        Equipos y clínicas\n                    </h3>\n                    <p class=\"mt-3 flex-1 text-sm leading-relaxed text-[var(--muted)]\" data-kid=\"1-11-1-2-4-3\">\n                        Varios nutricionistas atienden bajo una misma marca y necesitás una vista compartida del trabajo.\n                    </p>\n                    <p class=\"mt-7 text-[10px] font-black uppercase tracking-[0.16em] text-[var(--faint)]\" data-kid=\"1-11-1-2-4-4\">\n                        Ruta recomendada\n                    </p>\n                    <p class=\"mt-2 text-base font-black\" data-kid=\"1-11-1-2-4-5\">\n                        Clínica\n                        <span class=\"ml-2 text-sm font-bold text-[var(--brand)]\" data-kid=\"1-11-1-2-4-5-1\">\n                            $99.99/mes\n                        </span>\n                    </p>\n                    <p class=\"mt-1 text-sm leading-relaxed text-[var(--muted)]\" data-kid=\"1-11-1-2-4-6\">\n                        O $9.99 por nutricionista. Incluye multi-nutricionista, marca personalizada, analíticas avanzadas y soporte VIP.\n                    </p>\n                    <a class=\"mt-6 inline-flex items-center gap-2 text-sm font-bold text-[var(--brand)] transition-opacity hover:opacity-80\" data-kid=\"1-11-1-2-4-7\" href=\"https://wa.me/584243153383?text=Hola,%20quiero%20cotizar%20Nutringest%20para%20mi%20cl%C3%ADnica%20o%20equipo\" rel=\"noopener noreferrer\" target=\"_blank\">\n                        Cotizar Clínica\n                        <i class=\"ph-bold ph-arrow-right text-base\" data-kid=\"1-11-1-2-4-7-1\">\n                        </i>\n                    </a>\n                </div>\n            </div>\n        </div>\n    </section>\n    <!-- ================= CAMPUS ================= -->\n    <section class=\"scroll-mt-24 px-6 lg:px-10\" data-kid=\"1-5\" id=\"campus\">\n        <div class=\"mx-auto max-w-[1200px]\" data-kid=\"1-5-1\">\n            <div class=\"overflow-hidden rounded-[2rem] border border-[var(--line)] bg-[var(--brand-soft)] px-8 py-14 lg:px-16 lg:py-18\" data-kid=\"1-5-1-1\">\n                <div class=\"grid gap-12 lg:grid-cols-12 lg:items-center\" data-kid=\"1-5-1-1-1\">\n                    <div class=\"lg:col-span-7\" data-kid=\"1-5-1-1-1-1\">\n                        <p class=\"text-[11px] font-bold uppercase tracking-[0.2em] text-[var(--brand)]\" data-kid=\"1-5-1-1-1-1-1\">\n                            Nutringest Campus\n                        </p>\n                        <h2 class=\"mt-6 text-3xl font-black leading-[1.1] tracking-tight sm:text-4xl\" data-kid=\"1-5-1-1-1-1-2\">\n                            120 días de acceso premium gratis para tus prácticas.\n                        </h2>\n                