        "h": 800
      },
      "html": "<div class=\"min-h-screen bg-[var(--ng-bg)] text-[var(--ng-ink)]\" data-kid=\"1\" data-name=\"page layout container\" data-theme=\"light\" id=\"ng-root\">\n    <style>\n        @import url('https://fonts.googleapis.com/css2?family=Montserrat:wght@400;500;600;700;800;900&display=swap');\n    @import url('https://cdn.jsdelivr.net/npm/@phosphor-icons/web@2.1.1/src/regular/style.css');\n\n    #ng-root { font-family: 'Montserrat', ui-sans-serif, system-ui, sans-serif; }\n\n    #ng-root[data-theme=\"light\"] {\n      --ng-bg: #ffffff;\n      --ng-soft: #f7f6fb;\n      --ng-surface: #ffffff;\n      --ng-border: #e8e5f2;\n      --ng-ink: #14101f;\n      --ng-muted: #6d6784;\n      --ng-primary: #5b21b6;\n      --ng-primary-fg: #ffffff;\n      --ng-accent: #7c3aed;\n      --ng-tint: #f3f0fb;\n      --ng-tint-ink: #4c1d95;\n      --ng-blue: #0ea5e9;\n      --ng-ink-band: #14101f;\n      --ng-band-ink: #f5f3fb;\n      --ng-band-muted: #a9a2c0;\n      --ng-band-border: transparent;\n      --ng-shadow-card: 0 20px 50px -34px rgba(20, 16, 31, 0.45);\n    }\n    #ng-root[data-theme=\"dark\"] {\n      --ng-bg: #0d0a15;\n      --ng-soft: #130f20;\n      --ng-surface: #16112a;\n      --ng-border: #2b2442;\n      --ng-ink: #f4f2fb;\n      --ng-muted: #a49dbe;\n      --ng-primary: #7c3aed;\n      --ng-primary-fg: #ffffff;\n      --ng-accent: #b79bff;\n      --ng-tint: #1e1735;\n      --ng-tint-ink: #cbb6ff;\n      --ng-blue: #38bdf8;\n      --ng-ink-band: #1c1633;\n      --ng-band-ink: #f5f3fb;\n      --ng-band-muted: #a9a2c0;\n      --ng-band-border: #322a4d;\n      --ng-shadow-card: 0 20px 50px -34px rgba(0, 0, 0, 0.85);\n    }\n\n    #ng-root .ng-glass {\n      background-color: color-mix(in srgb, var(--ng-bg) 88%, transparent);\n      backdrop-filter: blur(12px);\n      -webkit-backdrop-filter: blur(12px);\n    }\n\n    #ng-root .ng-logo-white { display: none; }\n    #ng-root[data-theme=\"dark\"] .ng-logo-brand { display: none; }\n    #ng-root[data-theme=\"dark\"] .ng-logo-white { display: block; }\n\n    #ng-root .ng-tgl-sun { display: none; }\n    #ng-root[data-theme=\"dark\"] .ng-tgl-sun { display: inline-flex; }\n    #ng-root[data-theme=\"dark\"] .ng-tgl-moon { display: none; }\n\n    #ng-root summary { list-style: none; cursor: pointer; }\n    #ng-root summary::-webkit-details-marker { display: none; }\n    #ng-root details[open] .ng-faq-plus { display: none; }\n    #ng-root details:not([open]) .ng-faq-minus { display: none; }\n\n    html { scroll-behavior: smooth; }\n    </style>\n    <!-- ===== NAVBAR (fijo al hacer scroll) ===== -->\n    <header class=\"ng-glass sticky top-0 z-40 border-b border-[var(--ng-border)]\" data-kid=\"1-1\" data-name=\"sticky navigation bar\">\n        <div class=\"mx-auto flex max-w-[1180px] items-center justify-between gap-6 px-6 py-3.5 lg:px-10\" data-kid=\"1-1-1\" data-name=\"navbar layout container\">\n            <a class=\"flex shrink-0 items-center\" data-kid=\"1-1-1-1\" data-name=\"brand logo link\" href=\"#inicio\">\n                <img alt=\"Nutringest\" class=\"ng-logo-brand h-6 w-auto\" data-kid=\"1-1-1-1-1\" data-name=\"brand color logo image\" src=\"/api/local/images/webapp/public/png/ImagotipoPurpura.png\"/>\n                <img alt=\"Nutringest\" class=\"ng-logo-white h-6 w-auto\" data-kid=\"1-1-1-1-2\" data-name=\"brand white logo image\" src=\"/api/local/images/webapp/public/png/ImagotipoBlanco.png\"/>\n            </a>\n            <nav aria-label=\"Secciones\" class=\"hidden items-center gap-1 lg:flex\" data-kid=\"1-1-1-2\" data-name=\"navbar navigation links\">\n                <a class=\"rounded-full px-3.5 py-2 text-[13px] font-semibold text-[var(--ng-muted)] transition-colors hover:text-[var(--ng-ink)]\" data-kid=\"1-1-1-2-5\" data-name=\"audience navigation link\" href=\"#para-quien\">\n                    Para quién es\n                </a>\n                <a class=\"rounded-full px-3.5 py-2 text-[13px] font-semibold text-[var(--ng-muted)] transition-colors hover:text-[var(--ng-ink)]\" data-kid=\"1-1-1-2-1\" data-name=\"functions navigation link\" href=\"#funciones\">\n                    Funciones\n                </a>\n                <a class=\"rounded-full px-3.5 py-2 text-[13px] font-semibold text-[var(--ng-muted)] transition-colors hover:text-[var(--ng-ink)]\" data-kid=\"1-1-1-2-2\" data-name=\"campus navigation link\" href=\"#campus\">\n                    Campus\n                </a>\n                <a class=\"rounded-full px-3.5 py-2 text-[13px] font-semibold text-[var(--ng-muted)] transition-colors hover:text-[var(--ng-ink)]\" data-kid=\"1-1-1-2-3\" data-name=\"plans navigation link\" href=\"#planes\">\n                    Planes\n                </a>\n                <a class=\"rounded-full px-3.5 py-2 text-[13px] font-semibold text-[var(--ng-muted)] transition-colors hover:text-[var(--ng-ink)]\" data-kid=\"1-1-1-2-4\" data-name=\"faq navigation link\" href=\"#faq\">\n                    Preguntas frecuentes\n                </a>\n            </nav>\n            <div class=\"flex items-center gap-2.5\" data-kid=\"1-1-1-3\" data-name=\"navbar actions container\">\n                <button aria-label=\"Cambiar entre modo claro y oscuro\" class=\"flex h-9 w-9 items-center justify-center rounded-full border border-[var(--ng-border)] text-[var(--ng-ink)] transition-colors hover:bg-[var(--ng-soft)]\" data-kid=\"1-1-1-3-1\" data-name=\"theme toggle button\" id=\"ng-theme-toggle\" type=\"button\">\n                    <i class=\"ph ph-moon ng-tgl-moon text-[17px]\" data-kid=\"1-1-1-3-1-1\" data-name=\"moon icon\">\n                    </i>\n                    <i class=\"ph ph-sun ng-tgl-sun text-[17px]\" data-kid=\"1-1-1-3-1-2\" data-name=\"sun icon\">\n                    </i>\n                </button>\n                <a class=\"hidden text-[13px] font-semibold text-[var(--ng-muted)] transition-colors hover:text-[var(--ng-ink)] sm:inline-block\" data-kid=\"1-1-1-3-2\" data-name=\"login navigation link\" href=\"#empezar\">\n                    Iniciar sesión\n                </a>\n                <a class=\"inline-flex items-center gap-1.5 rounded-full bg-[var(--ng-primary)] px-5 py-2.5 text-[13px] font-bold text-[var(--ng-primary-fg)] transition-transform hover:-translate-y-0.5\" data-kid=\"1-1-1-3-3\" data-name=\"free trial cta button\" href=\"#empezar\">\n                    <span data-kid=\"1-1-1-3-3-1\" data-name=\"free trial cta button text\">\n                        Prueba gratis\n                    </span>\n                    <i class=\"ph ph-arrow-right text-[14px]\" data-kid=\"1-1-1-3-3-2\" data-name=\"arrow right icon\">\n                    </i>\n                </a>\n            </div>\n        </div>\n    </header>\n    <!-- ===== HERO ===== -->\n    <section class=\"mx-auto max-w-[1180px] scroll-mt-24 px-6 pt-16 pb-20 lg:px-10 lg:pt-24 lg:pb-24\" data-kid=\"1-2\" data-name=\"hero section\" id=\"inicio\">\n        <div class=\"grid items-center gap-12 lg:grid-cols-12 lg:gap-14\" data-kid=\"1-2-1\" data-name=\"hero content grid\">\n            <div class=\"lg:col-span-6\" data-kid=\"1-2-1-1\" data-name=\"hero text content container\">\n                <p class=\"flex items-center gap-3 text-[11px] font-bold uppercase tracking-[0.22em] text-[var(--ng-muted)]\" data-kid=\"1-2-1-1-1\" data-name=\"hero tag line container\">\n                    <span class=\"inline-block h-px w-10 bg-[var(--ng-accent)]\" data-kid=\"1-2-1-1-1-1\" data-name=\"decorative accent line\">\n                    </span>\n                    Software para nutricionistas\n                </p>\n                <h1 class=\"mt-7 text-[2.4rem] font-extrabold leading-[1.06] tracking-[-0.035em] text-[var(--ng-ink)] sm:text-[3rem] lg:text-[3.4rem]\" data-kid=\"1-2-1-1-2\" data-name=\"hero headline text\">\n                    Prepará el plan, medí y hacé seguimiento en el mismo expediente.\n                </h1>\n                <p class=\"mt-6 max-w-xl text-[16.5px] leading-relaxed text-[var(--ng-muted)]\" data-kid=\"1-2-1-1-3\" data-name=\"hero description text\">\n                    Nutringest ordena el día a día de tu consulta: antecedentes y pacientes, evaluación antropométrica, menús e intercambios, y un portal donde tu paciente ve su plan.\n                </p>\n                <div class=\"mt-9 flex flex-wrap items-center gap-x-7 gap-y-4\" data-kid=\"1-2-1-1-4\" data-name=\"hero cta group\">\n                    <a class=\"inline-flex items-center gap-2 rounded-full bg-[var(--ng-primary)] px-7 py-3.5 text-[15px] font-bold text-[var(--ng-primary-fg)] transition-transform hover:-translate-y-0.5\" data-kid=\"1-2-1-1-4-1\" data-name=\"hero primary cta button\" href=\"#empezar\">\n                        <span data-kid=\"1-2-1-1-4-1-1\" data-name=\"hero primary cta text\">\n                            Comenzar prueba de 14 días\n                        </span>\n                        <i class=\"ph ph-arrow-right text-[15px]\" data-kid=\"1-2-1-1-4-1-2\" data-name=\"right arrow icon\">\n                        </i>\n                    </a>\n                    <a class=\"text-[15px] font-bold text-[var(--ng-ink)] underline decoration-[var(--ng-accent)] decoration-2 underline-offset-[7px]\" data-kid=\"1-2-1-1-4-2\" data-name=\"hero secondary cta link\" href=\"#funciones\">\n                        Ver qué incluye\n                    </a>\n                </div>\n                <p class=\"mt-6 text-[13px] font-medium text-[var(--ng-muted)]\" data-kid=\"1-2-1-1-5\" data-name=\"hero disclaimer text\">\n                    14 días con todas las funciones de PREMIUM. Sin tarjeta de crédito.\n                </p>\n            </div>\n            <div class=\"lg:col-span-6\" data-kid=\"1-2-1-2\" data-name=\"hero image grid\">\n                <div class=\"grid gap-4 lg:grid-cols-5 lg:gap-5\" data-kid=\"1-2-1-2-1\" data-name=\"hero image layout container\">\n                    <img alt=\"Nutricionista durante una consulta real con una paciente (B Y G on Unsplash)\" class=\"h-[320px] w-full rounded-[28px] object-cover sm:h-[420px] lg:col-span-3 lg:h-[530px]\" data-kid=\"1-2-1-2-1-1\" data-name=\"main hero image\" decoding=\"async\" loading=\"lazy\" src=\"https://images.unsplash.com/photo-1675270745543-883eae091a5c?auto=format&fit=crop&w=1400&q=80\"/>\n                    <div class=\"grid gap-4 lg:col-span-2 lg:gap-5\" data-kid=\"1-2-1-2-1-2\" data-name=\"secondary image layout container\">\n                        <img alt=\"Consulta nutricional con registros sobre la mesa (beyzahzah on Pexels)\" class=\"h-[200px] w-full rounded-2xl object-cover lg:h-[252px]\" data-kid=\"1-2-1-2-1-2-1\" data-name=\"secondary hero image\" decoding=\"async\" loading=\"lazy\" src=\"https://images.pexels.com/photos/15319020/pexels-photo-15319020.jpeg?auto=compress&cs=tinysrgb&w=900\"/>\n                        <div class=\"flex flex-col justify-between rounded-2xl bg-[var(--ng-tint)] p-6 lg:h-[252px]\" data-kid=\"1-2-1-2-1-2-2\" data-name=\"hero pricing badge container\">\n                            <span class=\"text-[11px] font-bold uppercase tracking-[0.2em] text-[var(--ng-tint-ink)]\" data-kid=\"1-2-1-2-1-2-2-1\" data-name=\"hero pricing badge label\">\n                                Preventa vigente\n                            </span>\n                            <div data-kid=\"1-2-1-2-1-2-2-2\" data-name=\"hero pricing details container\">\n                                <p class=\"text-[26px] font-extrabold leading-none tracking-[-0.03em] text-[var(--ng-ink)]\" data-kid=\"1-2-1-2-1-2-2-2-1\" data-name=\"hero pro price text\">\n                                    PRO desde $4.00\n                                    <span class=\"ml-1 text-[13px] font-semibold text-[var(--ng-muted)]\" data-kid=\"1-2-1-2-1-2-2-2-1-1\" data-name=\"hero per month text\">\n                                        /mes\n                                    </span>\n                                </p>\n                                <a class=\"mt-3 inline-flex items-center gap-1.5 text-[13px] font-bold text-[var(--ng-tint-ink)]\" data-kid=\"1-2-1-2-1-2-2-2-2\" data-name=\"hero pricing plans link\" href=\"#planes\">\n                                    <span data-kid=\"1-2-1-2-1-2-2-2-2-1\" data-name=\"hero pricing plans text\">\n                                        Ver los 3 planes\n                                    </span>\n                                    <i class=\"ph ph-arrow-right text-[13px]\" data-kid=\"1-2-1-2-1-2-2-2-2-2\" data-name=\"hero pricing plans arrow icon\">\n                                    </i>\n                                </a>\n                            </div>\n                        </div>\n                    </div>\n                </div>\n            </div>\n        </div>\n    </section>\n    <!-- ===== CTA + MÉTRICAS ===== -->\n    <section class=\"scroll-mt-24 border-y border-[var(--ng-border)] bg-[var(--ng-soft)]\" data-kid=\"1-3\" data-name=\"cta metrics section\" id=\"empezar\">\n        <div class=\"mx-auto max-w-[1180px] px-6 py-20 lg:px-10 lg:py-24\" data-kid=\"1-3-1\" data-name=\"cta section content container\">\n            <div class=\"grid gap-14 lg:grid-cols-12 lg:gap-16\" data-kid=\"1-3-1-1\" data-name=\"cta metrics grid\">\n                <div class=\"lg:col-span-5\" data-kid=\"1-3-1-1-1\" data-name=\"cta text content container\">\n                    <p class=\"text-[11px] font-bold uppercase tracking-[0.22em] text-[var(--ng-accent)]\" data-kid=\"1-3-1-1-1-1\" data-name=\"cta tag line\">\n                        Comenzá hoy\n                    </p>\n                    <h2 class=\"mt-5 text-[2rem] font-extrabold leading-[1.1] tracking-[-0.03em] sm:text-[2.4rem]\" data-kid=\"1-3-1-1-1-2\" data-name=\"cta headline text\">\n                        Probá el plan completo y decidí después.\n                    </h2>\n                    <p class=\"mt-5 text-[15.5px] leading-relaxed text-[var(--ng-muted)]\" data-kid=\"1-3-1-1-1-3\" data-name=\"cta description text\">\n                        Lo que antes copiabas a mano, ahora sale calculado: medidas, intercambios y listas de compras desde el mismo paciente. Menos trabajo repetitivo, más tiempo en la consulta.\n                    </p>\n                    <div class=\"mt-9 flex flex-wrap items-center gap-x-6 gap-y-4\" data-kid=\"1-3-1-1-1-4\" data-name=\"cta button group\">\n                        <a class=\"inline-flex items-center gap-2 rounded-full bg-[var(--ng-primary)] px-7 py-3.5 text-[15px] font-bold text-[var(--ng-primary-fg)] transition-transform hover:-translate-y-0.5\" data-kid=\"1-3-1-1-1-4-1\" data-name=\"cta primary button\" href=\"#planes\">\n                            <span data-kid=\"1-3-1-1-1-4-1-1\" data-name=\"cta primary button text\">\n                                Comenzar prueba de 14 días\n                            </span>\n                            <i class=\"ph ph-arrow-right text-[15px]\" data-kid=\"1-3-1-1-1-4-1-2\" data-name=\"right arrow icon\">\n                            </i>\n                        </a>\n                        <a class=\"text-[15px] font-bold text-[var(--ng-ink)] underline decoration-[var(--ng-accent)] decoration-2 underline-offset-[7px]\" data-kid=\"1-3-1-1-1-4-2\" data-name=\"cta secondary link\" href=\"#campus\">\n                            Solicitar acceso Campus\n                        </a>\n                    </div>\n                </div>\n                <div class=\"lg:col-span-7\" data-kid=\"1-3-1-1-2\" data-name=\"metrics grid container\">\n                    <div class=\"grid grid-cols-1 sm:grid-cols-2\" data-kid=\"1-3-1-1-2-1\" data-name=\"metrics card grid\">\n                        <div class=\"border-t border-[var(--ng-border)] py-7 sm:pr-10\" data-kid=\"1-3-1-1-2-1-1\" data-name=\"metric card one\">\n                            <p class=\"text-[2.4rem] font-extrabold leading-none tracking-[-0.04em] text-[var(--ng-ink)]\" data-kid=\"1-3-1-1-2-1-1-1\" data-name=\"metric value text\">\n                                14 días\n                            </p>\n                            <p class=\"mt-3 text-[14px] font-bold text-[var(--ng-ink)]\" data-kid=\"1-3-1-1-2-1-1-2\" data-name=\"metric label text\">\n                                de prueba gratis\n                            </p>\n                            <p class=\"mt-1 text-[12.5px] text-[var(--ng-muted)]\" data-kid=\"1-3-1-1-2-1-1-3\" data-name=\"metric description text\">\n                                Sin tarjeta de crédito\n                            </p>\n                        </div>\n                        <div class=\"border-t border-[var(--ng-border)] py-7 sm:border-l sm:pl-10\" data-kid=\"1-3-1-1-2-1-2\" data-name=\"metric card two\">\n                            <p class=\"text-[2.4rem] font-extrabold leading-none tracking-[-0.04em] text-[var(--ng-ink)]\" data-kid=\"1-3-1-1-2-1-2-1\" data-name=\"metric value text\">\n                                60%\n                            </p>\n                            <p class=\"mt-3 text-[14px] font-bold text-[var(--ng-ink)]\" data-kid=\"1-3-1-1-2-1-2-2\" data-name=\"metric label text\">\n                                de ahorro en PRO\n                            </p>\n                            <p class=\"mt-1 text-[12.5px] text-[var(--ng-muted)]\" data-kid=\"1-3-1-1-2-1-2-3\" data-name=\"metric description text\">\n                                $4.00/mes en preventa, antes $10.00/mes\n                            </p>\n                        </div>\n                        <div class=\"border-t border-[var(--ng-border)] py-7 sm:pr-10\" data-kid=\"1-3-1-1-2-1-3\" data-name=\"metric card three\">\n                            <p class=\"text-[2.4rem] font-extrabold leading-none tracking-[-0.04em] text-[var(--ng-ink)]\" data-kid=\"1-3-1-1-2-1-3-1\" data-name=\"metric value text\">\n                                20%\n                            </p>\n                            <p class=\"mt-3 text-[14px] font-bold text-[var(--ng-ink)]\" data-kid=\"1-3-1-1-2-1-3-2\" data-name=\"metric label text\">\n                                de ahorro en PREMIUM\n                            </p>\n                            <p class=\"mt-1 text-[12.5px] text-[var(--ng-muted)]\" data-kid=\"1-3-1-1-2-1-3-3\" data-name=\"metric description text\">\n                                $20.00/mes en preventa, antes $25.00/mes\n                            </p>\n                        </div>\n                        <div class=\"border-t border-[var(--ng-border)] py-7 sm:border-l sm:pl-10\" data-kid=\"1-3-1-1-2-1-4\" data-name=\"metric card four\">\n                            <p class=\"text-[2.4rem] font-extrabold leading-none tracking-[-0.04em] text-[var(--ng-ink)]\" data-kid=\"1-3-1-1-2-1-4-1\" data-name=\"metric value text\">\n                                120 días\n                            </p>\n                            <p class=\"mt-3 text-[14px] font-bold text-[var(--ng-ink)]\" data-kid=\"1-3-1-1-2-1-4-2\" data-name=\"metric label text\">\n                                gratis para estudiantes\n                            </p>\n                            <p class=\"mt-1 text-[12.5px] text-[var(--ng-muted)]\" data-kid=\"1-3-1-1-2-1-4-3\" data-name=\"metric description text\">\n                                Programa Nutringest Campus\n                            </p>\n                        </div>\n                    </div>\n                </div>\n            </div>\n        </div>\n    </section>\n    <!-- ===== QUÉ ABARCA EL SOFTWARE ===== -->\n    <section class=\"mx-auto max-w-[1180px] scroll-mt-24 px-6 py-20 lg:px-10 lg:py-24\" data-kid=\"1-4\" data-name=\"software features section\" id=\"funciones\">\n        <div class=\"max-w-2xl\" data-kid=\"1-4-1\" data-name=\"section header container\">\n            <p class=\"text-[11px] font-bold uppercase tracking-[0.22em] text-[var(--ng-accent)]\" data-kid=\"1-4-1-1\" data-name=\"section tag line\">\n                Qué abarca Nutringest\n            </p>\n            <h2 class=\"mt-5 text-[2rem] font-extrabold leading-[1.1] tracking-[-0.03em] sm:text-[2.4rem]\" data-kid=\"1-4-1-2\" data-name=\"section headline text\">\n                De la primera consulta al seguimiento, sin saltar entre herramientas.\n            </h2>\n            <p class=\"mt-5 text-[15.5px] leading-relaxed text-[var(--ng-muted)]\" data-kid=\"1-4-1-3\" data-name=\"section description text\">\n                Cuatro momentos de tu trabajo, cubiertos en la misma plataforma.\n            </p>\n        </div>\n        <div class=\"mt-12 grid gap-5 lg:grid-cols-12\" data-kid=\"1-4-2\" data-name=\"features grid container\">\n            <!-- PASO 01 -->\n            <article class=\"rounded-3xl border border-[var(--ng-border)] bg-[var(--ng-surface)] p-8 lg:col-span-7\" data-kid=\"1-4-2-1\" data-name=\"feature card step one\">\n                <div class=\"flex items-baseline justify-between gap-4\" data-kid=\"1-4-2-1-1\" data-name=\"feature card header\">\n                    <span class=\"text-[11px] font-bold uppercase tracking-[0.22em] text-[var(--ng-accent)]\" data-kid=\"1-4-2-1-1-1\" data-name=\"feature step label\">\n                        Paso 01\n                    </span>\n                    <i class=\"ph ph-clipboard-text text-[22px] text-[var(--ng-border)]\" data-kid=\"1-4-2-1-1-2\" data-name=\"clipboard icon\">\n                    </i>\n                </div>\n                <h3 class=\"mt-5 text-[1.55rem] font-extrabold leading-tight tracking-[-0.02em]\" data-kid=\"1-4-2-1-2\" data-name=\"feature title text\">\n                    Registrá la consulta y a tus pacientes\n                </h3>\n                <p class=\"mt-3 max-w-lg text-[15px] leading-relaxed text-[var(--ng-muted)]\" data-kid=\"1-4-2-1-3\" data-name=\"feature description text\">\n                    Antecedentes e historias clínicas en un mismo lugar, sin planillas sueltas ni cuadernos paralelos.\n                </p>\n                <ul class=\"mt-6 space-y-2.5 border-t border-[var(--ng-border)] pt-6\" data-kid=\"1-4-2-1-4\" data-name=\"feature checklist container\">\n                    <li class=\"flex items-start gap-2.5 text-[14.5px]\" data-kid=\"1-4-2-1-4-1\" data-name=\"feature list item one\">\n                        <i class=\"ph ph-check mt-0.5 text-[var(--ng-accent)]\" data-kid=\"1-4-2-1-4-1-1\" data-name=\"checkmark icon\">\n                        </i>\n                        <span data-kid=\"1-4-2-1-4-1-2\" data-name=\"list text\">\n                            Pacientes Ilimitados\n                        </span>\n                    </li>\n                    <li class=\"flex items-start gap-2.5 text-[14.5px]\" data-kid=\"1-4-2-1-4-2\" data-name=\"feature list item two\">\n                        <i class=\"ph ph-check mt-0.5 text-[var(--ng-accent)]\" data-kid=\"1-4-2-1-4-2-1\" data-name=\"checkmark icon\">\n                        </i>\n                        <span data-kid=\"1-4-2-1-4-2-2\" data-name=\"list text\">\n                            Consultas y Seguimiento\n                        </span>\n                    </li>\n                </ul>\n            </article>\n            <!-- PASO 02 -->\n            <article class=\"rounded-3xl border border-[var(--ng-border)] bg-[var(--ng-surface)] p-8 lg:col-span-5\" data-kid=\"1-4-2-2\" data-name=\"feature card step two\">\n                <div class=\"flex items-baseline justify-between gap-4\" data-kid=\"1-4-2-2-1\" data-name=\"feature card header\">\n                    <span class=\"text-[11px] font-bold uppercase tracking-[0.22em] text-[var(--ng-accent)]\" data-kid=\"1-4-2-2-1-1\" data-name=\"feature step label\">\n                        Paso 02\n                    </span>\n                    <i class=\"ph ph-ruler text-[22px] text-[var(--ng-border)]\" data-kid=\"1-4-2-2-1-2\" data-name=\"ruler icon\">\n                    </i>\n                </div>\n                <h3 class=\"mt-5 text-[1.55rem] font-extrabold leading-tight tracking-[-0.02em]\" data-kid=\"1-4-2-2-2\" data-name=\"feature title text\">\n                    Medí con método\n                </h3>\n                <p class=\"mt-3 text-[15px] leading-relaxed text-[var(--ng-muted)]\" data-kid=\"1-4-2-2-3\" data-name=\"feature description text\">\n                    Las mediciones y los cálculos salen de la plataforma, no de una calculadora aparte.\n                </p>\n                <ul class=\"mt-6 space-y-2.5 border-t border-[var(--ng-border)] pt-6\" data-kid=\"1-4-2-2-4\" data-name=\"feature checklist container\">\n                    <li class=\"flex items-start gap-2.5 text-[14.5px]\" data-kid=\"1-4-2-2-4-1\" data-name=\"feature list item one\">\n                        <i class=\"ph ph-check mt-0.5 text-[var(--ng-accent)]\" data-kid=\"1-4-2-2-4-1-1\" data-name=\"checkmark icon\">\n                        </i>\n                        <span data-kid=\"1-4-2-2-4-1-2\" data-name=\"list text\">\n                            Cálculo Antropométrico\n                        </span>\n                    </li>\n                    <li class=\"flex items-start gap-2.5 text-[14.5px]\" data-kid=\"1-4-2-2-4-2\" data-name=\"feature list item two\">\n                        <i class=\"ph ph-check mt-0.5 text-[var(--ng-accent)]\" data-kid=\"1-4-2-2-4-2-1\" data-name=\"checkmark icon\">\n                        </i>\n                        <span data-kid=\"1-4-2-2-4-2-2\" data-name=\"list text\">\n                            Base de Alimentos Completa\n                        </span>\n                    </li>\n                </ul>\n            </article>\n            <!-- PASO 03 (momento principal) -->\n            <article class=\"overflow-hidden rounded-3xl border border-[var(--ng-border)] bg-[var(--ng-surface)] lg:col-span-12\" data-kid=\"1-4-2-3\" data-name=\"feature card step three full width\">\n                <div class=\"grid lg:grid-cols-12\" data-kid=\"1-4-2-3-1\" data-name=\"feature card inner layout\">\n                    <div class=\"p-8 lg:col-span-5 lg:p-10\" data-kid=\"1-4-2-3-1-1\" data-name=\"feature content container\">\n                        <div class=\"flex items-baseline justify-between gap-4\" data-kid=\"1-4-2-3-1-1-1\" data-name=\"feature header\">\n                            <span class=\"text-[11px] font-bold uppercase tracking-[0.22em] text-[var(--ng-accent)]\" data-kid=\"1-4-2-3-1-1-1-1\" data-name=\"feature step label\">\n                                Paso 03\n                            </span>\n                            <i class=\"ph ph-fork-knife text-[22px] text-[var(--ng-border)]\" data-kid=\"1-4-2-3-1-1-1-2\" data-name=\"cutlery icon\">\n                            </i>\n                        </div>\n                        <h3 class=\"mt-5 text-[1.75rem] font-extrabold leading-tight tracking-[-0.02em] lg:text-[2rem]\" data-kid=\"1-4-2-3-1-1-2\" data-name=\"feature title text\">\n                            Armá el plan alimentario y las compras\n                        </h3>\n                        <p class=\"mt-3 text-[15px] leading-relaxed text-[var(--ng-muted)]\" data-kid=\"1-4-2-3-1-1-3\" data-name=\"feature description text\">\n                            El menú, los intercambios y la lista de compras se generan desde el mismo plan y salen listos para entregar.\n                        </p>\n                        <ul class=\"mt-6 space-y-3 border-t border-[var(--ng-border)] pt-6\" data-kid=\"1-4-2-3-1-1-4\" data-name=\"feature checklist container\">\n                            <li class=\"flex items-start gap-2.5 text-[14.5px]\" data-kid=\"1-4-2-3-1-1-4-1\" data-name=\"feature list item one\">\n                                <i class=\"ph ph-check mt-0.5 text-[var(--ng-accent)]\" data-kid=\"1-4-2-3-1-1-4-1-1\" data-name=\"checkmark icon\">\n                                </i>\n                                <span data-kid=\"1-4-2-3-1-1-4-1-2\" data-name=\"list text\">\n                                    Menús y Planes de Alimentación\n                                </span>\n                            </li>\n                            <li class=\"flex items-start gap-2.5 text-[14.5px]\" data-kid=\"1-4-2-3-1-1-4-2\" data-name=\"feature list item two\">\n                                <i class=\"ph ph-check mt-0.5 text-[var(--ng-accent)]\" data-kid=\"1-4-2-3-1-1-4-2-1\" data-name=\"checkmark icon\">\n                                </i>\n                                <span data-kid=\"1-4-2-3-1-1-4-2-2\" data-name=\"list text\">\n                                    Listas de Intercambio\n                                </span>\n                            </li>\n                            <li class=\"flex items-start gap-2.5 text-[14.5px]\" data-kid=\"1-4-2-3-1-1-4-3\" data-name=\"feature list item three\">\n                                <i class=\"ph ph-check mt-0.5 text-[var(--ng-accent)]\" data-kid=\"1-4-2-3-1-1-4-3-1\" data-name=\"checkmark icon\">\n                                </i>\n                                <span data-kid=\"1-4-2-3-1-1-4-3-2\" data-name=\"list text\">\n                                    Listas de Compras Automáticas\n                                </span>\n                            </li>\n                        </ul>\n                    </div>\n                    <div class=\"lg:col-span-7\" data-kid=\"1-4-2-3-1-2\" data-name=\"feature image container\">\n                        <img alt=\"Nutricionista preparando un plan alimentario con notas, frutas y calculadora (beyzahzah on Pexels)\" class=\"h-[240px] w-full object-cover lg:h-full\" data-kid=\"1-4-2-3-1-2-1\" data-name=\"feature image\" decoding=\"async\" loading=\"lazy\" src=\"https://images.pexels.com/photos/15319038/pexels-photo-15319038.jpeg?auto=compress&cs=tinysrgb&w=1400\"/>\n                    </div>\n                </div>\n            </article>\n            <!-- PASO 04 -->\n            <article class=\"rounded-3xl border border-[var(--ng-border)] bg-[var(--ng-surface)] p-8 lg:col-span-7\" data-kid=\"1-4-2-4\" data-name=\"feature card step four\">\n                <div class=\"flex items-baseline justify-between gap-4\" data-kid=\"1-4-2-4-1\" data-name=\"feature card header\">\n                    <span class=\"text-[11px] font-bold uppercase tracking-[0.22em] text-[var(--ng-accent)]\" data-kid=\"1-4-2-4-1-1\" data-name=\"feature step label\">\n                        Paso 04\n                    </span>\n                    <i class=\"ph ph-device-mobile text-[22px] text-[var(--ng-border)]\" data-kid=\"1-4-2-4-1-2\" data-name=\"mobile icon\">\n                    </i>\n                </div>\n                <h3 class=\"mt-5 text-[1.55rem] font-extrabold leading-tight tracking-[-0.02em]\" data-kid=\"1-4-2-4-2\" data-name=\"feature title text\">\n                    Compartí el plan y seguí de cerca\n                </h3>\n                <p class=\"mt-3 max-w-lg text-[15px] leading-relaxed text-[var(--ng-muted)]\" data-kid=\"1-4-2-4-3\" data-name=\"feature description text\">\n                    Tu paciente entra a ver su plan y vos retomás la consulta con el historial completo a mano.\n                </p>\n                <ul class=\"mt-6 space-y-2.5 border-t border-[var(--ng-border)] pt-6\" data-kid=\"1-4-2-4-4\" data-name=\"feature checklist container\">\n                    <li class=\"flex items-start gap-2.5 text-[14.5px]\" data-kid=\"1-4-2-4-4-1\" data-name=\"feature list item one\">\n                        <i class=\"ph ph-check mt-0.5 text-[var(--ng-accent)]\" data-kid=\"1-4-2-4-4-1-1\" data-name=\"checkmark icon\">\n                        </i>\n                        <span data-kid=\"1-4-2-4-4-1-2\" data-name=\"list text\">\n                            App/Portal para Pacientes\n                        </span>\n                    </li>\n                    <li class=\"flex items-start gap-2.5 text-[14.5px]\" data-kid=\"1-4-2-4-4-2\" data-name=\"feature list item two\">\n                        <i class=\"ph ph-check mt-0.5 text-[var(--ng-accent)]\" data-kid=\"1-4-2-4-4-2-1\" data-name=\"checkmark icon\">\n                        </i>\n                        <span data-kid=\"1-4-2-4-4-2-2\" data-name=\"list text\">\n                            Portal público con tu perfil de nutricionista\n                        </span>\n                    </li>\n                </ul>\n            </article>\n            <!-- DETALLES SECUNDARIOS -->\n            <article class=\"rounded-3xl border border-[var(--ng-border)] bg-[var(--ng-soft)] p-8 lg:col-span-5\" data-kid=\"1-4-2-5\" data-name=\"secondary feature card\">\n                <span class=\"text-[11px] font-bold uppercase tracking-[0.22em] text-[var(--ng-muted)]\" data-kid=\"1-4-2-5-1\" data-name=\"feature title text\">\n                    Además, cuando lo necesites\n                </span>\n                <h3 class=\"mt-5 text-[1.3rem] font-extrabold leading-tight tracking-[-0.02em]\" data-kid=\"1-4-2-5-2\" data-name=\"feature header title\">\n                    Plantillas, especialidades y equipos\n                </h3>\n                <div class=\"mt-6 flex flex-wrap gap-2 border-t border-[var(--ng-border)] pt-6\" data-kid=\"1-4-2-5-3\" data-name=\"features tag container\">\n                    <span class=\"rounded-full border border-[var(--ng-border)] px-3 py-1.5 text-[12.5px] font-semibold text-[var(--ng-muted)]\" data-kid=\"1-4-2-5-3-1\" data-name=\"feature tag\">\n                        Plantillas de Dietas\n                    </span>\n                    <span class=\"rounded-full border border-[var(--ng-border)] px-3 py-1.5 text-[12.5px] font-semibold text-[var(--ng-muted)]\" data-kid=\"1-4-2-5-3-2\" data-name=\"feature tag\">\n                        Personalización de Plantillas\n                    </span>\n                    <span class=\"rounded-full border border-[var(--ng-border)] px-3 py-1.5 text-[12.5px] font-semibold text-[var(--ng-muted)]\" data-kid=\"1-4-2-5-3-3\" data-name=\"feature tag\">\n                        Portafolios Digitales\n                    </span>\n                    <span class=\"rounded-full border border-[var(--ng-border)] px-3 py-1.5 text-[12.5px] font-semibold text-[var(--ng-muted)]\" data-kid=\"1-4-2-5-3-4\" data-name=\"feature tag\">\n                        Nutrición Deportiva\n                    </span>\n                    <span class=\"rounded-full border border-[var(--ng-border)] px-3 py-1.5 text-[12.5px] font-semibold text-[var(--ng-muted)]\" data-kid=\"1-4-2-5-3-5\" data-name=\"feature tag\">\n                        Nutrición Pediátrica\n                    </span>\n                    <span class=\"rounded-full border border-[var(--ng-border)] px-3 py-1.5 text-[12.5px] font-semibold text-[var(--ng-muted)]\" data-kid=\"1-4-2-5-3-6\" data-name=\"feature tag\">\n                        Sistema de Referidos\n                    </span>\n                    <span class=\"rounded-full border border-[var(--ng-border)] px-3 py-1.5 text-[12.5px] font-semibold text-[var(--ng-muted)]\" data-kid=\"1-4-2-5-3-7\" data-name=\"feature tag\">\n                        Atención en Grupos\n                    </span>\n                </div>\n            </article>\n        </div>\n    </section>\n    <!-- ===== PARA QUIÉN ES ===== -->\n    <section class=\"mx-auto max-w-[1180px] scroll-mt-24 px-6 py-20 lg:px-10 lg:py-24\" data-kid=\"2-1\" data-name=\"audience section\" id=\"para-quien\">\n        <div class=\"max-w-2xl\" data-kid=\"2-1-1\" data-name=\"audience section header\">\n            <p class=\"text-[11px] font-bold uppercase tracking-[0.22em] text-[var(--ng-accent)]\" data-kid=\"2-1-1-1\" data-name=\"audience tag line\">\n                Para quién es\n            </p>\n            <h2 class=\"mt-5 text-[2rem] font-extrabold leading-[1.1] tracking-[-0.03em] sm:text-[2.4rem]\" data-kid=\"2-1-1-2\" data-name=\"audience headline text\">\n                La misma plataforma, cuatro puntos de partida.\n            </h2>\n            <p class=\"mt-5 text-[15.5px] leading-relaxed text-[var(--ng-muted)]\" data-kid=\"2-1-1-3\" data-name=\"audience description text\">\n                Dónde estás hoy define con qué plan arrancás, no lo que podés hacer con Nutringest. Estas son las cuatro rutas más comunes.\n            </p>\n        </div>\n        <div class=\"mt-12 border-t border-[var(--ng-border)]\" data-kid=\"2-1-2\" data-name=\"audience rows container\">\n            <div class=\"grid gap-6 border-b border-[var(--ng-border)] py-9 lg:grid-cols-12 lg:gap-10\" data-kid=\"2-1-2-1\" data-name=\"audience row student\">\n                <div class=\"lg:col-span-7\" data-kid=\"2-1-2-1-1\" data-name=\"audience row text\">\n                    <p class=\"text-[11px] font-bold uppercase tracking-[0.22em] text-[var(--ng-muted)]\" data-kid=\"2-1-2-1-1-1\" data-name=\"audience row index\">\n                        01 · Estudiante o pasantías\n                    </p>\n                    <h3 class=\"mt-4 text-[1.4rem] font-extrabold leading-tight tracking-[-0.02em]\" data-kid=\"2-1-2-1-1-2\" data-name=\"audience row title\">\n                        Llegá a tus prácticas con la herramienta completa\n                    </h3>\n                    <p class=\"mt-3 max-w-xl text-[15px] leading-relaxed text-[var(--ng-muted)]\" data-kid=\"2-1-2-1-1-3\" data-name=\"audience row description\">\n                        Si cursás el último año de la licenciatura o estás en pasantías, no arranques con planillas sueltas: usá la plataforma entera mientras te formás.\n                    </p>\n                </div>\n                <div class=\"lg:col-span-5 lg:border-l lg:border-[var(--ng-border)] lg:pl-10\" data-kid=\"2-1-2-1-2\" data-name=\"audience row route\">\n                    <p class=\"text-[11px] font-bold uppercase tracking-[0.2em] text-[var(--ng-accent)]\" data-kid=\"2-1-2-1-2-1\" data-name=\"audience route label\">\n                        Ruta recomendada\n                    </p>\n                    <p class=\"mt-3 text-[17px] font-extrabold tracking-[-0.02em] text-[var(--ng-ink)]\" data-kid=\"2-1-2-1-2-2\" data-name=\"audience route plan\">\n                        Nutringest Campus\n                    </p>\n                    <p class=\"mt-2 text-[14px] leading-relaxed text-[var(--ng-muted)]\" data-kid=\"2-1-2-1-2-3\" data-name=\"audience route detail\">\n                        120 días de premium gratis. Sin tarjeta de crédito.\n                    </p>\n                    <a class=\"mt-4 inline-flex items-center gap-1.5 text-[14px] font-bold text-[var(--ng-ink)] underline decoration-[var(--ng-accent)] decoration-2 underline-offset-[7px]\" data-kid=\"2-1-2-1-2-4\" data-name=\"audience route link\" href=\"#campus\">\n                        <span data-kid=\"2-1-2-1-2-4-1\" data-name=\"audience route link text\">\n                            Solicitar acceso Campus\n                        </span>\n                        <i class=\"ph ph-arrow-right text-[14px]\" data-kid=\"2-1-2-1-2-4-2\" data-name=\"arrow right icon\">\n                        </i>\n                    </a>\n                </div>\n            </div>\n            <div class=\"grid gap-6 border-b border-[var(--ng-border)] py-9 lg:grid-cols-12 lg:gap-10\" data-kid=\"2-1-2-2\" data-name=\"audience row individual\">\n                <div class=\"lg:col-span-7\" data-kid=\"2-1-2-2-1\" data-name=\"audience row text\">\n                    <p class=\"text-[11px] font-bold uppercase tracking-[0.22em] text-[var(--ng-muted)]\" data-kid=\"2-1-2-2-1-1\" data-name=\"audience row index\">\n                        02 · Consultorio individual\n                    </p>\n                    <h3 class=\"mt-4 text-[1.4rem] font-extrabold leading-tight tracking-[-0.02em]\" data-kid=\"2-1-2-2-1-2\" data-name=\"audience row title\">\n                        Atendé, medí y armá el plan sin cambiar de herramienta\n                    </h3>\n                    <p class=\"mt-3 max-w-xl text-[15px] leading-relaxed text-[var(--ng-muted)]\" data-kid=\"2-1-2-2-1-3\" data-name=\"audience row description\">\n                        El día a día de la consulta: antecedentes y pacientes, antropometría, menú, intercambios y lista de compras desde la misma ficha.\n                    </p>\n                </div>\n                <div class=\"lg:col-span-5 lg:border-l lg:border-[var(--ng-border)] lg:pl-10\" data-kid=\"2-1-2-2-2\" data-name=\"audience row route\">\n                    <p class=\"text-[11px] font-bold uppercase tracking-[0.2em] text-[var(--ng-accent)]\" data-kid=\"2-1-2-2-2-1\" data-name=\"audience route label\">\n                        Ruta recomendada\n                    </p>\n                    <p class=\"mt-3 text-[17px] font-extrabold tracking-[-0.02em] text-[var(--ng-ink)]\" data-kid=\"2-1-2-2-2-2\" data-name=\"audience route plan\">\n                        PRO · $4.00/mes\n                    </p>\n                    <p class=\"mt-2 text-[14px] leading-relaxed text-[var(--ng-muted)]\" data-kid=\"2-1-2-2-2-3\" data-name=\"audience route detail\">\n                        En preventa, antes $10.00/mes. Pacientes Ilimitados, Menús y Planes de Alimentación, Consultas y Seguimiento y App/Portal para Pacientes.\n                    </p>\n                    <a class=\"mt-4 inline-flex items-center gap-1.5 text-[14px] font-bold text-[var(--ng-ink)] underline decoration-[var(--ng-accent)] decoration-2 underline-offset-[7px]\" data-kid=\"2-1-2-2-2-4\" data-name=\"audience route link\" href=\"#planes\">\n                        <span data-kid=\"2-1-2-2-2-4-1\" data-name=\"audience route link text\">\n                            Ver el plan PRO\n                        </span>\n                        <i class=\"ph ph-arrow-right text-[14px]\" data-kid=\"2-1-2-2-2-4-2\" data-name=\"arrow right icon\">\n                        </i>\n                    </a>\n                </div>\n            </div>\n            <div class=\"grid gap-6 border-b border-[var(--ng-border)] py-9 lg:grid-cols-12 lg:gap-10\" data-kid=\"2-1-2-3\" data-name=\"audience row specialist\">\n                <div class=\"lg:col-span-7\" data-kid=\"2-1-2-3-1\" data-name=\"audience row text\">\n                    <p class=\"text-[11px] font-bold uppercase tracking-[0.22em] text-[var(--ng-muted)]\" data-kid=\"2-1-2-3-1-1\" data-name=\"audience row index\">\n                        03 · Especialista\n                    </p>\n                    <h3 class=\"mt-4 text-[1.4rem] font-extrabold leading-tight tracking-[-0.02em]\" data-kid=\"2-1-2-3-1-2\" data-name=\"audience row title\">\n                        Sumá plantillas propias y especialidades a tu consulta\n                    </h3>\n                    <p class=\"mt-3 max-w-xl text-[15px] leading-relaxed text-[var(--ng-muted)]\" data-kid=\"2-1-2-3-1-3\" data-name=\"audience row description\">\n                        Cuando la consulta pide más —deportiva, pediátrica o atención en grupos—, dejás de resolverlo por fuera del sistema.\n                    </p>\n                </div>\n                <div class=\"lg:col-span-5 lg:border-l lg:border-[var(--ng-border)] lg:pl-10\" data-kid=\"2-1-2-3-2\" data-name=\"audience row route\">\n                    <p class=\"text-[11px] font-bold uppercase tracking-[0.2em] text-[var(--ng-accent)]\" data-kid=\"2-1-2-3-2-1\" data-name=\"audience route label\">\n                        Ruta recomendada\n                    </p>\n                    <p class=\"mt-3 text-[17px] font-extrabold tracking-[-0.02em] text-[var(--ng-ink)]\" data-kid=\"2-1-2-3-2-2\" data-name=\"audience route plan\">\n                        PREMIUM · $20.00/mes\n                    </p>\n                    <p class=\"mt-2 text-[14px] leading-relaxed text-[var(--ng-muted)]\" data-kid=\"2-1-2-3-2-3\" data-name=\"audience route detail\">\n                        En preventa, antes $25.00/mes. Plantillas de Dietas, Personalización de Plantillas, Portafolios Digitales, Nutrición Deportiva y Pediátrica.\n                    </p>\n                    <a class=\"mt-4 inline-flex items-center gap-1.5 text-[14px] font-bold text-[var(--ng-ink)] underline decoration-[var(--ng-accent)] decoration-2 underline-offset-[7px]\" data-kid=\"2-1-2-3-2-4\" data-name=\"audience route link\" href=\"#planes\">\n                        <span data-kid=\"2-1-2-3-2-4-1\" data-name=\"audience route link text\">\n                            Ver el plan PREMIUM\n                        </span>\n                        <i class=\"ph ph-arrow-right text-[14px]\" data-kid=\"2-1-2-3-2-4-2\" data-name=\"arrow right icon\">\n                        </i>\n                    </a>\n                </div>\n            </div>\n            <div class=\"grid gap-6 border-b border-[var(--ng-border)] py-9 lg:grid-cols-12 lg:gap-10\" data-kid=\"2-1-2-4\" data-name=\"audience row clinics\">\n                <div class=\"lg:col-span-7\" data-kid=\"2-1-2-4-1\" data-name=\"audience row text\">\n                    <p class=\"text-[11px] font-bold uppercase tracking-[0.22em] text-[var(--ng-muted)]\" data-kid=\"2-1-2-4-1-1\" data-name=\"audience row index\">\n                        04 · Equipos y clínicas\n                    </p>\n                    <h3 class=\"mt-4 text-[1.4rem] font-extrabold leading-tight tracking-[-0.02em]\" data-kid=\"2-1-2-4-1-2\" data-name=\"audience row title\">\n                        Coordiná a varios nutricionistas bajo tu propia marca\n                    </h3>\n                    <p class=\"mt-3 max-w-xl text-[15px] leading-relaxed text-[var(--ng-muted)]\" data-kid=\"2-1-2-4-1-3\" data-name=\"audience row description\">\n                        Un equipo atendiendo con la misma base clínica y tu identidad, con lectura de la práctica a nivel de clínica.\n                    </p>\n                </div>\n                <div class=\"lg:col-span-5 lg:border-l lg:border-[var(--ng-border)] lg:pl-10\" data-kid=\"2-1-2-4-2\" data-name=\"audience row route\">\n                    <p class=\"text-[11px] font-bold uppercase tracking-[0.2em] text-[var(--ng-accent)]\" data-kid=\"2-1-2-4-2-1\" data-name=\"audience route label\">\n                        Ruta recomendada\n                    </p>\n                    <p class=\"mt-3 text-[17px] font-extrabold tracking-[-0.02em] text-[var(--ng-ink)]\" data-kid=\"2-1-2-4-2-2\" data-name=\"audience route plan\">\n                        Clínica · $99.99/mes\n                    </p>\n                    <p class=\"mt-2 text-[14px] leading-relaxed text-[var(--ng-muted)]\" data-kid=\"2-1-2-4-2-3\" data-name=\"audience route detail\">\n                        O $9.99 por nutricionista. Gestión de Equipo, Multi-nutricionista, Marca Personalizada, Analíticas Avanzadas y Soporte Prioritario VIP.\n                    </p>\n                    <a class=\"mt-4 inline-flex items-center gap-1.5 text-[14px] font-bold text-[var(--ng-ink)] underline decoration-[var(--ng-accent)] decoration-2 underline-offset-[7px]\" data-kid=\"2-1-2-4-2-4\" data-name=\"audience route link\" href=\"#planes\">\n                        <span data-kid=\"2-1-2-4-2-4-1\" data-name=\"audience route link text\">\n                            Ver el plan Clínica\n                        </span>\n                        <i class=\"ph ph-arrow-right text-[14px]\" data-kid=\"2-1-2-4-2-4-2\" data-name=\"arrow right icon\">\n                        </i>\n                    </a>\n                </div>\n            </div>\n        </div>\n    </section>\n    <!-- ===== CAMPUS ===== -->\n    <section class=\"mx-auto max-w-[1180px] scroll-mt-24 px-6 pb-20 lg:px-10 lg:pb-24\" data-kid=\"1-5\" data-name=\"campus section\" id=\"campus\">\n        <div class=\"relative overflow-hidden rounded-[32px] border border-[var(--ng-band-border)] bg-[var(--ng-ink-band)] px-8 py-14 text-[var(--ng-band-ink)] lg:px-16 lg:py-16\" data-kid=\"1-5-1\" data-name=\"campus content container\">\n            <span class=\"absolute left-0 top-0 h-1 w-full bg-[var(--ng-accent)]\" data-kid=\"1-5-1-1\" data-name=\"decorative top border\">\n            </span>\n            <div class=\"grid gap-12 lg:grid-cols-12 lg:gap-16\" data-kid=\"1-5-1-2\" data-name=\"campus grid\">\n                <div class=\"lg:col-span-7\" data-kid=\"1-5-1-2-1\" data-name=\"campus text content container\">\n                    <p class=\"text-[11px] font-bold uppercase tracking-[0.22em] text-[var(--ng-accent)]\" data-kid=\"1-5-1-2-1-1\" data-name=\"campus tag line\">\n                        Nutringest Campus\n                    </p>\n                    <h2 class=\"mt-5 text-[1.9rem] font-extrabold leading-[1.1] tracking-[-0.03em] sm:text-[2.3rem]\" data-kid=\"1-5-1-2-1-2\" data-name=\"campus headline text\">\n                        Si cursás el último año o hacés pasantías, el premium va por nuestra cuenta.\n                    </h2>\n                    <p class=\"mt-5 max-w-xl text-[15.5px] leading-relaxed text-[var(--ng-band-muted)]\" data-kid=\"1-5-1-2-1-3\" data-name=\"campus description text\">\n                        Nutringest Campus existe para que llegues a tus prácticas profesionales con una herramienta de nivel clínico:\n                        <span class=\"font-bold text-[var(--ng-band-ink)]\" data-kid=\"1-5-1-2-1-3-1\" data-name=\"campus bold highlight text\">\n                            120 días de acceso premium gratuito\n                        </span>\n                        , sin tarjeta de crédito.\n                    </p>\n                </div>\n                <div class=\"lg:col-span-5\" data-kid=\"1-5-1-2-2\" data-name=\"campus call to action container\">\n                    <ul class=\"space-y-3 border-t border-white/15 pt-7\" data-kid=\"1-5-1-2-2-1\" data-name=\"campus checklist container\">\n                        <li class=\"flex items-start gap-3 text-[14.5px] text-[var(--ng-band-ink)]\" data-kid=\"1-5-1-2-2-1-1\" data-name=\"checklist item one\">\n                            <i class=\"ph ph-check mt-0.5 text-[var(--ng-accent)]\" data-kid=\"1-5-1-2-2-1-1-1\" data-name=\"checkmark icon\">\n                            </i>\n                            <span data-kid=\"1-5-1-2-2-1-1-2\" data-name=\"list text\">\n                                Cursando el último año de la licenciatura\n                            </span>\n                        </li>\n                        <li class=\"flex items-start gap-3 text-[14.5px] text-[var(--ng-band-ink)]\" data-kid=\"1-5-1-2-2-1-2\" data-name=\"checklist item two\">\n                            <i class=\"ph ph-check mt-0.5 text-[var(--ng-accent)]\" data-kid=\"1-5-1-2-2-1-2-1\" data-name=\"checkmark icon\">\n                            </i>\n                            <span data-kid=\"1-5-1-2-2-1-2-2\" data-name=\"list text\">\n                                O haciendo tus pasantías profesionales\n                            </span>\n                        </li>\n                        <li class=\"flex items-start gap-3 text-[14.5px] text-[var(--ng-band-ink)]\" data-kid=\"1-5-1-2-2-1-3\" data-name=\"checklist item three\">\n                            <i class=\"ph ph-check mt-0.5 text-[var(--ng-accent)]\" data-kid=\"1-5-1-2-2-1-3-1\" data-name=\"checkmark icon\">\n                            </i>\n                            <span data-kid=\"1-5-1-2-2-1-3-2\" data-name=\"list text\">\n                                120 días de premium completo\n                            </span>\n                        </li>\n                    </ul>\n                    <a class=\"mt-8 inline-flex items-center gap-2 rounded-full bg-[var(--ng-band-ink)] px-7 py-3.5 text-[15px] font-bold text-[var(--ng-ink-band)] transition-transform hover:-translate-y-0.5\" data-kid=\"1-5-1-2-2-2\" data-name=\"campus cta button\" href=\"#empezar\">\n                        <span data-kid=\"1-5-1-2-2-2-1\" data-name=\"campus cta button text\">\n                            Solicitar acceso Campus\n                        </span>\n                        <i class=\"ph ph-arrow-right text-[15px]\" data-kid=\"1-5-1-2-2-2-2\" data-name=\"right arrow icon\">\n                        </i>\n                    </a>\n                </div>\n            </div>\n        </div>\n    </section>\n    <!-- ===== CÓMO EMPEZAR ===== -->\n    <section class=\"mx-auto max-w-[1180px] scroll-mt-24 px-6 py-20 lg:px-10 lg:py-24\" data-kid=\"2-2\" data-name=\"getting started section\" id=\"como-empezar\">\n        <div class=\"flex flex-col justify-between gap-8 lg:flex-row lg:items-end\" data-kid=\"2-2-1\" data-name=\"getting started header\">\n            <div class=\"max-w-2xl\" data-kid=\"2-2-1-1\" data-name=\"getting started header text\">\n                <p class=\"text-[11px] font-bold uppercase tracking-[0.22em] text-[var(--ng-accent)]\" data-kid=\"2-2-1-1-1\" data-name=\"getting started tag line\">\n                    Cómo empezar\n                </p>\n                <h2 class=\"mt-5 text-[2rem] font-extrabold leading-[1.1] tracking-[-0.03em] sm:text-[2.4rem]\" data-kid=\"2-2-1-1-2\" data-name=\"getting started headline text\">\n                    Tres pasos y tu primer plan está listo.\n                </h2>\n                <p class=\"mt-5 text-[15.5px] leading-relaxed text-[var(--ng-muted)]\" data-kid=\"2-2-1-1-3\" data-name=\"getting started description text\">\n                    Sin migraciones complicadas ni configuración previa: entrás, cargás un paciente y sacás su plan.\n                </p>\n            </div>\n            <a class=\"inline-flex shrink-0 items-center gap-2 rounded-full bg-[var(--ng-primary)] px-7 py-3.5 text-[15px] font-bold text-[var(--ng-primary-fg)] transition-transform hover:-translate-y-0.5\" data-kid=\"2-2-1-2\" data-name=\"getting started cta button\" href=\"#empezar\">\n                <span data-kid=\"2-2-1-2-1\" data-name=\"getting started cta text\">\n                    Comenzar prueba de 14 días\n                </span>\n                <i class=\"ph ph-arrow-right text-[15px]\" data-kid=\"2-2-1-2-2\" data-name=\"arrow right icon\">\n                </i>\n            </a>\n        </div>\n        <div class=\"mt-14 grid gap-10 border-t border-[var(--ng-border)] pt-10 lg:grid-cols-3 lg:gap-12\" data-kid=\"2-2-2\" data-name=\"getting started steps container\">\n            <div data-kid=\"2-2-2-1\" data-name=\"getting started step one\">\n                <span class=\"text-[2.6rem] font-extrabold leading-none tracking-[-0.05em] text-[var(--ng-muted)] opacity-40\" data-kid=\"2-2-2-1-1\" data-name=\"step number\">\n                    01\n                </span>\n                <h3 class=\"mt-5 text-[1.25rem] font-extrabold leading-tight tracking-[-0.02em]\" data-kid=\"2-2-2-1-2\" data-name=\"step title\">\n                    Creá tu cuenta\n                </h3>\n                <p class=\"mt-3 text-[15px] leading-relaxed text-[var(--ng-muted)]\" data-kid=\"2-2-2-1-3\" data-name=\"step description\">\n                    14 días con todas las funciones, sin tarjeta de crédito ni permanencia. Entrás y la plataforma ya está completa.\n                </p>\n            </div>\n            <div class=\"lg:border-l lg:border-[var(--ng-border)] lg:pl-12\" data-kid=\"2-2-2-2\" data-name=\"getting started step two\">\n                <span class=\"text-[2.6rem] font-extrabold leading-none tracking-[-0.05em] text-[var(--ng-muted)] opacity-40\" data-kid=\"2-2-2-2-1\" data-name=\"step number\">\n                    02\n                </span>\n                <h3 class=\"mt-5 text-[1.25rem] font-extrabold leading-tight tracking-[-0.02em]\" data-kid=\"2-2-2-2-2\" data-name=\"step title\">\n                    Cargá tu primer paciente\n                </h3>\n                <p class=\"mt-3 text-[15px] leading-relaxed text-[var(--ng-muted)]\" data-kid=\"2-2-2-2-3\" data-name=\"step description\">\n                    Antecedentes, historia clínica y mediciones en la misma ficha. El cálculo antropométrico sale solo.\n                </p>\n            </div>\n            <div class=\"lg:border-l lg:border-[var(--ng-border)] lg:pl-12\" data-kid=\"2-2-2-3\" data-name=\"getting started step three\">\n                <span class=\"text-[2.6rem] font-extrabold leading-none tracking-[-0.05em] text-[var(--ng-muted)] opacity-40\" data-kid=\"2-2-2-3-1\" data-name=\"step number\">\n                    03\n                </span>\n                <h3 class=\"mt-5 text-[1.25rem] font-extrabold leading-tight tracking-[-0.02em]\" data-kid=\"2-2-2-3-2\" data-name=\"step title\">\n                    Sacá tu primer plan\n                </h3>\n                <p class=\"mt-3 text-[15px] leading-relaxed text-[var(--ng-muted)]\" data-kid=\"2-2-2-3-3\" data-name=\"step description\">\n                    Menú, listas de intercambio y lista de compras desde el mismo plan, listos para exportar en PDF y compartir con tu paciente.\n                </p>\n            </div>\n        </div>\n    </section>\n    <!-- ===== PLANES ===== -->\n    <section class=\"scroll-mt-24 border-t border-[var(--ng-border)] bg-[var(--ng-soft)]\" data-kid=\"1-6\" data-name=\"plans section\" id=\"planes\">\n        <div class=\"mx-auto max-w-[1180px] px-6 py-20 pb-28 lg:px-10 lg:py-24 lg:pb-32\" data-kid=\"1-6-1\" data-name=\"plans content container\">\n            <div class=\"max-w-2xl\" data-kid=\"1-6-1-1\" data-name=\"plans header container\">\n                <p class=\"text-[11px] font-bold uppercase tracking-[0.22em] text-[var(--ng-accent)]\" data-kid=\"1-6-1-1-1\" data-name=\"plans tag line\">\n                    Planes a tu medida\n                </p>\n                <h2 class=\"mt-5 text-[2rem] font-extrabold leading-[1.1] tracking-[-0.03em] sm:text-[2.4rem]\" data-kid=\"1-6-1-1-2\" data-name=\"plans headline text\">\n                    Precios transparentes para potenciar tu consultorio. Sin complicaciones.\n                </h2>\n            </div>\n            <div class=\"mt-12 grid items-stretch gap-6 lg:grid-cols-3\" data-kid=\"1-6-1-2\" data-name=\"plans cards grid\">\n                <!-- PRO -->\n                <article class=\"flex flex-col rounded-3xl border border-[var(--ng-border)] bg-[var(--ng-surface)] p-8 shadow-[var(--ng-shadow-card)]\" data-kid=\"1-6-1-2-1\" data-name=\"pro plan card\">\n                    <div class=\"flex items-center justify-between gap-3\" data-kid=\"1-6-1-2-1-1\" data-name=\"plan header\">\n                        <span class=\"rounded-full bg-[var(--ng-tint)] px-3 py-1 text-[11px] font-bold uppercase tracking-wider text-[var(--ng-tint-ink)]\" data-kid=\"1-6-1-2-1-1-1\" data-name=\"plan badge label\">\n                            Preventa\n                        </span>\n                        <span class=\"text-[12px] font-semibold text-[var(--ng-muted)]\" data-kid=\"1-6-1-2-1-1-2\" data-name=\"plan target audience\">\n                            Consultorio Individual\n                        </span>\n                    </div>\n                    <h3 class=\"mt-6 text-[2rem] font-extrabold tracking-[-0.03em]\" data-kid=\"1-6-1-2-1-2\" data-name=\"plan title\">\n                        PRO\n                    </h3>\n                    <p class=\"mt-2 min-h-[40px] text-[13px] leading-snug text-[var(--ng-muted)]\" data-kid=\"1-6-1-2-1-3\" data-name=\"plan description\">\n                        Todo lo que necesitas para tu consultorio individual\n                    </p>\n                    <div class=\"mt-6 border-t border-[var(--ng-border)] pt-6\" data-kid=\"1-6-1-2-1-4\" data-name=\"plan pricing container\">\n                        <div class=\"flex items-end gap-1.5\" data-kid=\"1-6-1-2-1-4-1\" data-name=\"price display container\">\n                            <span class=\"text-[2.6rem] font-extrabold leading-none tracking-[-0.04em]\" data-kid=\"1-6-1-2-1-4-1-1\" data-name=\"plan price\">\n                                $4.00\n                            </span>\n                            <span class=\"mb-1 text-[13px] font-semibold text-[var(--ng-muted)]\" data-kid=\"1-6-1-2-1-4-1-2\" 