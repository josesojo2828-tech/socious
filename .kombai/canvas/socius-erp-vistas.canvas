group flex-1 flex flex-col justify-center px-4 cursor-pointer\" data-kid=\"1-2-2-3-3\" data-name=\"received payments KPI metric\">\n<span class=\"text-[12px] text-[#2B2D2F]/70\" data-kid=\"1-2-2-3-3-1\" data-name=\"received payments KPI label\">Cobros recibidos del periodo</span>\n<span class=\"ff-fig text-[24px] leading-[1.15] group-hover:underline decoration-1 underline-offset-[5px]\" data-kid=\"1-2-2-3-3-2\" data-name=\"received payments KPI value\">USD 8.771,50</span>\n<span class=\"text-[11px] text-[#2B2D2F]/70 tnum\" data-kid=\"1-2-2-3-3-3\" data-name=\"received payments daily context\">7 cobros hoy</span>\n</a>\n<div class=\"w-px bg-[#2B2D2F]/12\" data-kid=\"1-2-2-3-4\" data-name=\"KPI vertical divider\"></div>\n<a class=\"group flex-1 flex flex-col justify-center px-4 cursor-pointer\" data-kid=\"1-2-2-3-5\" data-name=\"outstanding receivables KPI metric\">\n<span class=\"text-[12px] text-[#2B2D2F]/70\" data-kid=\"1-2-2-3-5-1\" data-name=\"outstanding receivables KPI label\">Saldo por cobrar</span>\n<span class=\"ff-fig text-[24px] leading-[1.15] group-hover:underline decoration-1 underline-offset-[5px]\" data-kid=\"1-2-2-3-5-2\" data-name=\"outstanding receivables KPI value\">USD 630,92</span>\n<span class=\"text-[11px] text-[#E65F2B] font-semibold tnum\" data-kid=\"1-2-2-3-5-3\" data-name=\"receivables overdue warning\">Vencido USD 459,40</span>\n</a>\n<div class=\"w-px bg-[#2B2D2F]/12\" data-kid=\"1-2-2-3-6\" data-name=\"KPI vertical divider\"></div>\n<a class=\"group flex-1 flex flex-col justify-center pl-4 cursor-pointer\" data-kid=\"1-2-2-3-7\" data-name=\"outstanding payables KPI metric\">\n<span class=\"text-[12px] text-[#2B2D2F]/70\" data-kid=\"1-2-2-3-7-1\" data-name=\"outstanding payables KPI label\">Saldo por pagar</span>\n<span class=\"ff-fig text-[24px] leading-[1.15] group-hover:underline decoration-1 underline-offset-[5px]\" data-kid=\"1-2-2-3-7-2\" data-name=\"outstanding payables KPI value\">USD 1.326,50</span>\n<span class=\"text-[11px] tex