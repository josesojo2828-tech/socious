border-[#2B2D2F]/15\" data-kid=\"1-2-1-1-2-5-2-1-1-4\" data-name=\"method column header\">Medio</th>\n<th class=\"text-left font-semibold pb-1 border-b border-[#2B2D2F]/15\" data-kid=\"1-2-1-1-2-5-2-1-1-5\" data-name=\"currency column header\">Moneda</th>\n<th class=\"text-right font-semibold pb-1 border-b border-[#2B2D2F]/15\" data-kid=\"1-2-1-1-2-5-2-1-1-6\" data-name=\"amount column header\">Importe</th>\n</tr>\n</thead>\n<tbody class=\"text-[13px]\" data-kid=\"1-2-1-1-2-5-2-2\" data-name=\"movements table body\">\n<tr class=\"border-b border-[#2B2D2F]/10\" data-kid=\"1-2-1-1-2-5-2-2-1\" data-name=\"opening movement row\">\n<td class=\"py-[3px] ff-fig tabular-nums\" data-kid=\"1-2-1-1-2-5-2-2-1-1\" data-name=\"opening time cell\">08:00</td>\n<td class=\"py-[3px] ff-fig tabular-nums\" data-kid=\"1-2-1-1-2-5-2-2-1-2\" data-name=\"opening document cell\">T-031</td>\n<td class=\"py-[3px]\" data-kid=\"1-2-1-1-2-5-2-2-1-3\" data-name=\"opening type cell\">Apertura</td>\n<td class=\"py-[3px] text-[#2B2D2F]/75\" data-kid=\"1-2-1-1-2-5-2-2-1-4\" data-name=\"opening method cell\">Efectivo</td>\n<td class=\"py-[3px]\" data-kid=\"1-2-1-1-2-5-2-2-1-5\" data-name=\"opening currency cell\">USD</td>\n<td class=\"py-[3px] text-right ff-fig tabular-nums\" data-kid=\"1-2-1-1-2-5-2-2-1-6\" data-name=\"opening amount cell\">100,00</td>\n</tr>\n<tr class=\"border-b border-[#2B2D2F]/10\" data-kid=\"1-2-1-1-2-5-2-2-2\" data-name=\"purchase movement row\">\n<td class=\"py-[3px] ff-fig tabular-nums\" data-kid=\"1-2-1-1-2-5-2-2-2-1\" data-name=\"purchase time cell\">09:47</td>\n<td class=\"py-[3px] ff-fig tabular-nums\" data-kid=\"1-2-1-1-2-5-2-2-2-2\" data-name=\"purchase document cell\">C-0031</td>\n<td class=\"py-[3px]\" data-kid=\"1-2-1-1-2-5-2-2-2-3\" data-name=\"purchase type cell\">Compra</td>\n<td class=\"py-[3px] text-[#2B2D2F]/75\" data-kid=\"1-2-1-1-2-5-2-2-2-4\" data-name=\"purchase method cell\">Efectivo</td>\n<td class=\"py-[3px]\" data-kid=\"1-2-1-1-2-5-2-2-2-5\" data-name=\"purchase currency cell\">USD</td>\n<td class=\"py-[3px] text-right ff-fig tabular-nums\" data-kid=\"1-2-1-1-2-5-2-2-2-6\" data-name=\"purchase amount cell\">−86,40</td>\n</tr>\n<tr class=\"border-b border-[#2B2D2F]/10\" data-kid=\"1-2-1-1-2-5-2-2-3\" data-name=\"paid sale movement row\">\n<td class=\"py-[3px] ff-fig tabular-nums\" data-kid=\"1-2-1-1-2-5-2-2-3-1\" data-name=\"sale time cell\">10:12</td>\n<td class=\"py-[3px] ff-fig tabular-nums\" data-kid=\"1-2-1-1-2-5-2-2-3-2\" data-name=\"sale document cell\">V-0058</td>\n<td class=\"py-[3px]\" data-kid=\"1-2-1-1-2-5-2-2-3-3\" data-name=\"sale type cell with status badge\">Venta <span class=\"text-[#4A5340]\" data-kid=\"1-2-1-1-2-5-2-2-3-3-1\" data-name=\"paid status text\">cobrada</span></td>\n<td class=\"py-[3px] text-[#2B2D2F]/75\" data-kid=\"1-2-1-1-2-5-2-2-3-4\" data-name=\"sale method cell\">Efectivo</td>\n<td class=\"py-[3px]\" data-kid=\"1-2-1-1-2-5-2-2-3-5\" data-name=\"sale currency cell\">USD</td>\n<td class=\"py-[3px] text-right ff-fig tabular-nums\" data-kid=\"1-2-1-1-2-5-2-2-3-6\" data-name=\"sale amount cell\">+11,02</td>\n</tr>\n<tr data-kid=\"1-2-1-1-2-5-2-2-4\" data-name=\"mobile payment sale row\">\n<td class=\"py-[3px] ff-fig tabular-nums\" data-kid=\"1-2-1-1-2-5-2-2-4-1\" data-name=\"mobile sale time cell\">11:26</td>\n<td class=\"py-[3px] ff-fig tabular-nums\" data-kid=\"1-2-1-1-2-5-2-2-4-2\" data-name=\"mobile sale document cell\">V-0059</td>\n<td class=\"py-[3px]\" data-kid=\"1-2-1-1-2-5-2-2-4-3\" data-name=\"mobile sale type cell\">Venta</td>\n<td class=\"py-[3px] text-[#2B2D2F]/75\" data-kid=\"1-2-1-1-2-5-2-2-4-4\" data-name=\"mobile sale method cell\">Pago móvil</td>\n<td class=\"py-[3px]\" data-kid=\"1-2-1-1-2-5-2-2-4-5\" data-name=\"mobile sale currency cell\">Bs</td>\n<td class=\"py-[3px] text-right ff-fig tabular-nums\" data-kid=\"1-2-1-1-2-5-2-2-4-6\" data-name=\"mobile sale amount cell\">+625,00</td>\n</tr>\n</tbody>\n</table>\n</div>\n</div>\n</div>\n</section>\n<!-- ============ 2. CAPACIDADES — White, py 56, filas índice+detalle ============ -->\n<section class=\"bg-white border-b border-[#2B2D2F]/15\" data-kid=\"1-2-2\" data-name=\"capabilities section\" id=\"capacidades\">\n<div class=\"mx-auto w-[1192px] py-[56px]\" data-kid=\"1-2-2-1\" data-name=\"capabilities content container\">\n<h2 class=\"text-[28px] font-semibold tracking-[-0.01em]\" data-kid=\"1-2-2-1-1\" data-name=\"capabilities section heading\">Capacidades</h2>\n<div class=\"mt-8 border-t border-[#2B2D2F]/15\" data-kid=\"1-2-2-1-2\" data-name=\"capabilities list container\">\n<a class=\"grid grid-cols-[320px_1fr] gap-x-12 py-5 border-b border-[#2B2D2F]/12 group\" data-kid=\"1-2-2-1-2-1\" data-name=\"inventory capability row\" href=\"#\">\n<span class=\"text-[17px] font-semibold group-hover:underline underline-offset-4 decoration-[#2B2D2F]/30 t\" data-kid=\"1-2-2-1-2-1-1\" data-name=\"inventory capability label\">Inventario y catálogo</span>\n<span class=\"text-[15px] leading-[1.55] text-[#2B2D2F]/75 max-w-[660px]\" data-kid=\"1-2-2-1-2-1-2\" data-name=\"inventory capability description\">Productos, categorías, proveedores, stock mínimo y kardex de movimientos.</span>\n</a>\n<a class=\"grid grid-cols-[320px_1fr] gap-x-12 py-5 border-b border-[#2B2D2F]/12 group\" data-kid=\"1-2-2-1-2-2\" data-name=\"POS capability row\" href=\"#\">\n<span class=\"text-[17px] font-semibold group-hover:underline underline-offset-4 decoration-[#2B2D2F]/30 t\" data-kid=\"1-2-2-1-2-2-1\" data-name=\"POS capability label\">Punto de venta y caja</span>\n<span class=\"text-[15px] leading-[1.55] text-[#2B2D2F]/75 max-w-[660px]\" data-kid=\"1-2-2-1-2-2-2\" data-name=\"POS capability description\">Cobros multi-moneda con las tasas del día, turnos con arqueo o caja siempre activa.</span>\n</a>\n<a class=\"grid grid-cols-[320px_1fr] gap-x-12 py-5 border-b border-[#2B2D2F]/12 group\" data-kid=\"1-2-2-1-2-3\" data-name=\"orders capability row\" href=\"#\">\n<span class=\"text-[17px] font-semibold group-hover:underline underline-offset-4 decoration-[#2B2D2F]/30 t\" data-kid=\"1-2-2-1-2-3-1\" data-name=\"orders capability label\">Pedidos, envíos y rutas</span>\n<span class=\"text-[15px] leading-[1.55] text-[#2B2D2F]/75 max-w-[660px]\" data-kid=\"1-2-2-1-2-3-2\" data-name=\"orders capability description\">Pedidos desde tu tienda online, agencias de envío, delivery y rutas por día.</span>\n</a>\n<a class=\"grid grid-cols-[320px_1fr] gap-x-12 py-5 border-b border-[#2B2D2F]/12 group\" data-kid=\"1-2-2-1-2-4\" data-name=\"multicurrency capability row\" href=\"#\">\n<span class=\"text-[17px] font-semibold group-hover:underline underline-offset-4 decoration-[#2B2D2F]/30 t\" data-kid=\"1-2-2-1-2-4-1\" data-name=\"multicurrency capability label\">Multi-moneda y sucursales</span>\n<span class=\"text-[15px] leading-[1.55] text-[#2B2D2F]/75 max-w-[660px]\" data-kid=\"1-2-2-1-2-4-2\" data-name=\"multicurrency capability description\">Precios y cobros en USD, Bs y USDT; crece a sucursales cuando tu plan lo permite.</span>\n</a>\n</div>\n</div>\n</section>\n<!-- ============ 3. CÓMO OPERA — Parchment, py 64, recorrido continuo ============ -->\n<section class=\"border-b border-[#2B2D2F]/15\" data-kid=\"1-2-3\" data-name=\"how it operates section\">\n<div class=\"mx-auto w-[1192px] py-[64px]\" data-kid=\"1-2-3-1\" data-name=\"operates content container\">\n<h2 class=\"text-[28px] font-semibold tracking-[-0.01em]\" data-kid=\"1-2-3-1-1\" data-name=\"operates section heading\">Cómo opera</h2>\n<div class=\"mt-12 border-t border-[#2B2D2F]/25 grid grid-cols-[1.15fr_1fr_0.85fr] gap-x-10\" data-kid=\"1-2-3-1-2\" data-name=\"operates steps container\">\n<div class=\"relative pt-9\" data-kid=\"1-2-3-1-2-1\" data-name=\"step one column\">\n<span class=\"absolute -top-[11px] left-0 w-[22px] h-[22px] bg-[#2B2D2F] text-[#F3F3EF] flex items-center justify-center text-[12px] font-semibold\" data-kid=\"1-2-3-1-2-1-1\" data-name=\"step one number marker\">1</span>\n<h3 class=\"text-[18px] font-semibold\" data-kid=\"1-2-3-1-2-1-2\" data-name=\"step one title\">Carga tu catálogo</h3>\n<p class=\"mt-2 text-[15px] leading-[1.55] text-[#2B2D2F]/75\" data-kid=\"1-2-3-1-2-1-3\" data-name=\"step one description\">Productos, precios y proveedores en minutos. El stock se actualiza con cada venta y cada compra.</p>\n</div>\n<div class=\"relative pt-9\" data-kid=\"1-2-3-1-2-2\" data-name=\"step two column\">\n<span class=\"absolute -top-[11px] left-0 w-[22px] h-[22px] bg-[#2B2D2F] text-[#F3F3EF] flex items-center justify-center text-[12px] font-semibold\" data-kid=\"1-2-3-1-2-2-1\" data-name=\"step two number marker\">2</span>\n<h3 class=\"text-[18px] font-semibold\" data-kid=\"1-2-3-1-2-2-2\" data-name=\"step two title\">Cobra y recibe pedidos</h3>\n<p class=\"mt-2 text-[15px] leading-[1.55] text-[#2B2D2F]/75\" data-kid=\"1-2-3-1-2-2-3\" data-name=\"step two description\">Vende en el mostrador con el POS o recibe pedidos desde tu tienda online con contacto verificable.</p>\n</div>\n<div class=\"relative pt-9\" data-kid=\"1-2-3-1-2-3\" data-name=\"step three column\">\n<span class=\"absolute -top-[11px] left-0 w-[22px] h-[22px] bg-[#2B2D2F] text-[#F3F3EF] flex items-center justify-center text-[12px] font-semibold\" data-kid=\"1-2-3-1-2-3-1\" data-name=\"step three number marker\">3</span>\n<h3 class=\"text-[18px] font-semibold\" data-kid=\"1-2-3-1-2-3-2\" data-name=\"step three title\">Cierra tu día</h3>\n<p class=\"mt-2 text-[15px] leading-[1.55] text-[#2B2D2F]/75\" data-kid=\"1-2-3-1-2-3-3\" data-name=\"step three description\">Arqueo de caja, cobranzas del mes y rutas de entrega del día en una sola vista.</p>\n</div>\n</div>\n</div>\n</section>\n<!-- ============ 4. PLANES — White, py 72, tabla comparativa ============ -->\n<section class=\"bg-white border-b border-[#2B2D2F]/15\" data-kid=\"1-2-4\" data-name=\"pricing plans section\" id=\"planes\">\n<div class=\"mx-auto w-[1192px] py-[72px]\" data-kid=\"1-2-4-1\" data-name=\"pricing content container\">\n<h2 class=\"text-[28px] font-semibold tracking-[-0.01em]\" data-kid=\"1-2-4-1-1\" data-name=\"pricing section heading\">Planes</h2>\n<table class=\"mt-8 w-full text-[14px]\" data-kid=\"1-2-4-1-2\" data-name=\"pricing comparison table\">\n<thead data-kid=\"1-2-4-1-2-1\" data-name=\"pricing table header\">\n<tr class=\"border-b border-[#2B2D2F]/25 text-left align-bottom\" data-kid=\"1-2-4-1-2-1-1\" data-name=\"pricing header row\">\n<th class=\"pb-2 pr-6 text-[11px] uppercase tracking-[0.06em] text-[#2B2D2F]/70 font-semibold w-[180px]\" data-kid=\"1-2-4-1-2-1-1-1\" data-name=\"plan column header\">Plan</th>\n<th class=\"pb-2 pr-6 w-[170px]\" data-kid=\"1-2-4-1-2-1-1-2\" data-name=\"price column header\">\n<span class=\"block text-[11px] uppercase tracking-[0.06em] text-[#2B2D2F]/70 font-semibold\" data-kid=\"1-2-4-1-2-1-1-2-1\" data-name=\"price column main label\">Precio</span>\n<span class=\"block text-[11px] font-normal normal-case tracking-normal text-[#2B2D2F]/70\" data-kid=\"1-2-4-1-2-1-1-2-2\" data-name=\"price column subtitle\">por usuario y mes</span>\n</th>\n<th class=\"pb-2 pr-6 text-[11px] uppercase tracking-[0.06em] text-[#2B2D2F]/70 font-semibold w-[90px]\" data-kid=\"1-2-4-1-2-1-1-3\" data-name=\"currency column header\">Moneda</th>\n<th class=\"pb-2 pr-6 text-[11px] uppercase tracking-[0.06em] text-[#2B2D2F]/70 font-semibold\" data-kid=\"1-2-4-1-2-1-1-4\" data-name=\"features column header\">Prestaciones</th>\n<th class=\"pb-2 pr-6 text-right text-[11px] uppercase tracking-[0.06em] text-[#2B2D2F]/70 font-semibold w-[120px]\" data-kid=\"1-2-4-1-2-1-1-5\" data-name=\"branches column header\">\n<span class=\"block\" data-kid=\"1-2-4-1-2-1-1-5-1\" data-name=\"branches column main label\">Sucursales</span>\n<span class=\"block text-[11px] font-normal normal-case tracking-normal text-[#2B2D2F]/70\" data-kid=\"1-2-4-1-2-1-1-5-2\" data-name=\"branches column subtitle\">incluidas</span>\n</th>\n<th class=\"pb-2 pr-6 text-right text-[11px] uppercase tracking-[0.06em] text-[#2B2D2F]/70 font-semibold w-[130px]\" data-kid=\"1-2-4-1-2-1-1-6\" data-name=\"employees column header\">\n<span class=\"block\" data-kid=\"1-2-4-1-2-1-1-6-1\" data-name=\"employees column main label\">Empleados</span>\n<span class=\"block text-[11px] font-normal normal-case tracking-normal text-[#2B2D2F]/70\" data-kid=\"1-2-4-1-2-1-1-6-2\" data-name=\"employees column subtitle\">incluidos</span>\n</th>\n<th class=\"pb-2 w-[170px]\" data-kid=\"1-2-4-1-2-1-1-7\" data-name=\"action column header cell\"></th>\n</tr>\n</thead>\n<tbody data-kid=\"1-2-4-1-2-2\" data-name=\"pricing table body\">\n<tr class=\"border-b border-[#2B2D2F]/12\" data-kid=\"1-2-4-1-2-2-1\" data-name=\"inital pricing row\">\n<td class=\"py-5 pr-6 text-[16px] font-semibold align-top\" data-kid=\"1-2-4-1-2-2-1-1\" data-name=\"inital plan name cell\">Inicial</td>\n<td class=\"py-5 pr-6 align-top ff-fig tabular-nums text-[20px] font-semibold\" data-kid=\"1-2-4-1-2-2-1-2\" data-name=\"inital plan price cell\">USD 9,00</td>\n<td class=\"py-5 pr-6 align-top text-[13px] text-[#2B2D2F]/75\" data-kid=\"1-2-4-1-2-2-1-3\" data-name=\"inital plan currency cell\">USD</td>\n<td class=\"py-5 pr-6 align-top text-[13px] leading-[1.5] text-[#2B2D2F]/75\" data-kid=\"1-2-4-1-2-2-1-4\" data-name=\"inital plan features cell\">Punto de venta, inventario, caja, clientes y proveedores</td>\n<td class=\"py-5 pr-6 text-right align-top ff-fig tabular-nums text-[15px]\" data-kid=\"1-2-4-1-2-2-1-5\" data-name=\"inital plan branches cell\">1</td>\n<td class=\"py-5 pr-6 text-right align-top ff-fig tabular-nums text-[15px]\" data-kid=\"1-2-4-1-2-2-1-6\" data-name=\"inital plan employees cell\">2</td>\n<td class=\"py-5 text-right align-top\" data-kid=\"1-2-4-1-2-2-1-7\" data-name=\"inital plan action cell\">\n<a class=\"inline-block bg-[#E65F2B] text-black px-4 py-2 text-[13px] font-semibold hover:bg-[#cf5222] t\" data-kid=\"1-2-4-1-2-2-1-7-1\" data-name=\"select initial plan button\" href=\"#\">Elegir Inicial</a>\n</td>\n</tr>\n<tr class=\"border-b border-[#2B2D2F]/12\" data-kid=\"1-2-4-1-2-2-2\" data-name=\"negocio pricing row\">\n<td class=\"py-5 pr-6 text-[16px] font-semibold align-top\" data-kid=\"1-2-4-1-2-2-2-1\" data-name=\"negocio plan name cell\">Negocio</td>\n<td class=\"py-5 pr-6 align-top ff-fig tabular-nums text-[20px] font-semibold\" data-kid=\"1-2-4-1-2-2-2-2\" data-name=\"negocio plan price cell\">USD 15,00</td>\n<td class=\"py-5 pr-6 align-top text-[13px] text-[#2B2D2F]/75\" data-kid=\"1-2-4-1-2-2-2-3\" data-name=\"negocio plan currency cell\">USD</td>\n<td class=\"py-5 pr-6 align-top text-[13px] leading-[1.5] text-[#2B2D2F]/75\" data-kid=\"1-2-4-1-2-2-2-4\" data-name=\"negocio plan features cell\">Inicial + pedidos, envíos, cuentas por cobrar y reportes</td>\n<td class=\"py-5 pr-6 text-right align-top ff-fig tabular-nums text-[15px]\" data-kid=\"1-2-4-1-2-2-2-5\" data-name=\"negocio plan branches cell\">2</td>\n<td class=\"py-5 pr-6 text-right align-top ff-fig tabular-nums text-[15px]\" data-kid=\"1-2-4-1-2-2-2-6\" data-name=\"negocio plan employees cell\">5</td>\n<td class=\"py-5 text-right align-top\" data-kid=\"1-2-4-1-2-2-2-7\" data-name=\"negocio plan action cell\">\n<a class=\"inline-block bg-[#E65F2B] text-black px-4 py-2 text-[13px] font-semibold hover:bg-[#cf5222] t\" data-kid=\"1-2-4-1-2-2-2-7-1\" data-name=\"select negocio plan button\" href=\"#\">Elegir Negocio</a>\n</td>\n</tr>\n<tr class=\"border-b border-[#2B2D2F]/12\" data-kid=\"1-2-4-1-2-2-3\" data-name=\"sucursales pricing row\">\n<td class=\"py-5 pr-6 text-[16px] font-semibold align-top\" data-kid=\"1-2-4-1-2-2-3-1\" data-name=\"sucursales plan name cell\">Sucursales</td>\n<td class=\"py-5 pr-6 align-top ff-fig tabular-nums text-[20px] font-semibold\" data-kid=\"1-2-4-1-2-2-3-2\" data-name=\"sucursales plan price cell\">USD 24,00</td>\n<td class=\"py-5 pr-6 align-top text-[13px] text-[#2B2D2F]/75\" data-kid=\"1-2-4-1-2-2-3-3\" data-name=\"sucursales plan currency cell\">USD</td>\n<td class=\"py-5 pr-6 align-top text-[13px] leading-[1.5] text-[#2B2D2F]/75\" data-kid=\"1-2-4-1-2-2-3-4\" data-name=\"sucursales plan features cell\">Negocio + multi-sucursal, kardex, cuentas por pagar y rutas de entrega</td>\n<td class=\"py-5 pr-6 text-right align-top ff-fig tabular-nums text-[15px]\" data-kid=\"1-2-4-1-2-2-3-5\" data-name=\"sucursales plan branches cell\">4</td>\n<td class=\"py-5 pr-6 text-right align-top ff-fig tabular-nums text-[15px]\" data-kid=\"1-2-4-1-2-2-3-6\" data-name=\"sucursales plan employees cell\">12</td>\n<td class=\"py-5 text-right align-top\" data-kid=\"1-2-4-1-2-2-3-7\" data-name=\"sucursales plan action cell\">\n<a class=\"inline-block bg-[#E65F2B] text-black px-4 py-2 text-[13px] font-semibold hover:bg-[#cf5222] t\" data-kid=\"1-2-4-1-2-2-3-7-1\" data-name=\"select sucursales plan button\" href=\"#\">Elegir Sucursales</a>\n</td>\n</tr>\n</tbody>\n</table>\n</div>\n</section>\n</main>\n<!-- ============ 5. CIERRE Y LEGAL — Parchment, py 32, fila compacta ============ -->\n<footer class=\"bg-[#F3F3EF]\" data-kid=\"1-3\" data-name=\"site footer bar\">\n<div class=\"mx-auto w-[1192px] py-[32px] flex items-center justify-between\" data-kid=\"1-3-1\" data-name=\"footer content container\">\n<span class=\"text-[13px] text-[#2B2D2F]/75\" data-kid=\"1-3-1-1\" data-name=\"footer copyright text\">© 2026 Socius ERP · Gestión de comercios</span>\n<div class=\"flex items-center gap-6\" data-kid=\"1-3-1-2\" data-name=\"footer actions group\">\n<a class=\"bg-[#E65F2B] text-black px-4 py-2 text-[13px] font-semibold hover:bg-[#cf5222] t\" data-kid=\"1-3-1-2-1\" data-name=\"footer create account button\" href=\"#\">Crear cuenta</a>\n<a class=\"text-[13px] font-semibold text-[#2B2D2F] hover:text-black t\" data-kid=\"1-3-1-2-2\" data-name=\"footer login link\" href=\"#\">Acceder</a>\n<a class=\"text-[13px] text-[#2B2D2F]/75 hover:text-[#2B2D2F] t\" data-kid=\"1-3-1-2-3\" data-name=\"footer terms link\" href=\"#\">Términos y condiciones</a>\n<a class=\"text-[13px] text-[#2B2D2F]/