      "html": "<style>\n  @import url('https://fonts.googleapis.com/css2?family=Domine:wght@500;600;700&family=Titillium+Web:wght@300;400;600;700&display=swap');\n  @import url('https://cdn.jsdelivr.net/npm/@tabler/icons-webfont@3.48.0/dist/tabler-icons.min.css');\n  .ff-sans { font-family: 'Titillium Web', ui-sans-serif, system-ui, sans-serif; }\n  .ff-fig { font-family: 'Domine', Georgia, serif; }\n  .t { transition: color 140ms ease, background-color 140ms ease, border-color 140ms ease; }\n  .stamp { letter-spacing: 0.08em; }\n</style>\n<div class=\"ff-sans bg-[#F3F3EF] text-[#2B2D2F]\" data-kid=\"1\" data-name=\"page layout container\">\n<!-- ============ CABECERA 64px ============ -->\n<header class=\"h-16 bg-[#F3F3EF] border-b border-[#2B2D2F]/15\" data-kid=\"1-1\" data-name=\"site header bar\">\n<div class=\"mx-auto w-[1192px] h-full flex items-center justify-between\" data-kid=\"1-1-1\" data-name=\"header content container\">\n<a class=\"flex items-center gap-2.5\" data-kid=\"1-1-1-1\" data-name=\"brand logo link\" href=\"#\">\n<span class=\"w-7 h-7 bg-[#2B2D2F] text-[#F3F3EF] flex items-center justify-center text-[15px] font-bold\" data-kid=\"1-1-1-1-1\" data-name=\"brand monogram badge\">S</span>\n<span class=\"text-[18px] font-semibold tracking-[-0.01em]\" data-kid=\"1-1-1-1-2\" data-name=\"brand name text\">Socius ERP</span>\n</a>\n<nav class=\"flex items-center gap-8\" data-kid=\"1-1-1-2\" data-name=\"main navigation bar\">\n<a class=\"text-[15px] text-[#2B2D2F]/75 hover:text-[#2B2D2F] t\" data-kid=\"1-1-1-2-1\" data-name=\"capabilities nav link\" href=\"#capacidades\">Capacidades</a>\n<a class=\"text-[15px] text-[#2B2D2F]/75 hover:text-[#2B2D2F] t\" data-kid=\"1-1-1-2-2\" data-name=\"pricing plans nav link\" href=\"#planes\">Planes</a>\n<span class=\"w-px h-5 bg-[#2B2D2F]/20\" data-kid=\"1-1-1-2-3\" data-name=\"nav vertical divider\"></span>\n<a class=\"text-[15px] font-semibold text-[#2B2D2F] hover:text-black t\" data-kid=\"1-1-1-2-4\" data-name=\"login nav link\" href=\"#\">Acceder</a>\n<a class=\"bg-[#E65F2B] text-black px-4 py-2 text-[15px] font-semibold hover:bg-[#cf5222] t\" data-kid=\"1-1-1-2-5\" data-name=\"create account nav button\" href=\"#\">Crear cuenta</a>\n</nav>\n</div>\n</header>\n<main data-kid=\"1-2\" data-name=\"page main content\">\n<!-- ============ 1. PRESENTACIÓN — Parchment, py 72 ============ -->\n<section class=\"border-b border-[#2B2D2F]/15\" data-kid=\"1-2-1\" data-name=\"hero presentation section\">\n<div class=\"mx-auto w-[1192px] py-[72px] flex items-start justify-between\" data-kid=\"1-2-1-1\" data-name=\"hero content container\">\n<div class=\"w-[460px] shrink-0 pt-2\" data-kid=\"1-2-1-1-1\" data-name=\"hero copy container\">\n<h1 class=\"text-[56px] leading-[1.05] font-bold tracking-[-0.02em]\" data-kid=\"1-2-1-1-1-1\" data-name=\"hero headline text\">Tu negocio,<br data-kid=\"1-2-1-1-1-1-1\" data-name=\"line break in headline\"/>bajo control.</h1>\n<p class=\"mt-6 text-[17px] leading-[1.6] text-[#2B2D2F]/75\" data-kid=\"1-2-1-1-1-2\" data-name=\"hero description text\">Inventario, ventas, caja, clientes, proveedores, pedidos y envíos en un solo lugar. Cada venta descuenta el stock y queda en el cierre del día.</p>\n<div class=\"mt-8 flex items-center gap-3\" data-kid=\"1-2-1-1-1-3\" data-name=\"hero call-to-action group\">\n<a class=\"bg-[#E65F2B] text-black px-6 py-3 text-[15px] font-semibold hover:bg-[#cf5222] t\" data-kid=\"1-2-1-1-1-3-1\" data-name=\"primary create account button\" href=\"#\">Crear cuenta</a>\n<a class=\"border border-[#2B2D2F]/30 px-6 py-3 text-[15px] font-semibold hover:bg-[#2B2D2F]/5 t\" data-kid=\"1-2-1-1-1-3-2\" data-name=\"secondary view plans button\" href=\"#planes\">Ver planes</a>\n</div>\n</div>\n<!-- Muestra real del componente de caja — 620 x ~340 -->\n<div class=\"w-[620px] shrink-0 bg-white border border-[#2B2D2F]/20\" data-kid=\"1-2-1-1-2\" data-name=\"cash register component mockup\">\n<div class=\"flex items-center justify-between px-4 h-[40px] border-b border-[#2B2D2F]/12\" data-kid=\"1-2-1-1-2-1\" data-name=\"mockup header bar\">\n<div class=\"flex items-center gap-2\" data-kid=\"1-2-1-1-2-1-1\" data-name=\"mockup title group\">\n<i class=\"ti ti-cash text-[16px] text-[#2B2D2F]/70\" data-kid=\"1-2-1-1-2-1-1-1\" data-name=\"register icon\"></i>\n<span class=\"text-[15px] font-semibold\" data-kid=\"1-2-1-1-2-1-1-2\" data-name=\"mockup title text\">Caja</span>\n<span class=\"w-px h-3.5 bg-[#2B2D2F]/20 mx-1\" data-kid=\"1-2-1-1-2-1-1-3\" data-name=\"title divider\"></span>\n<span class=\"text-[13px] text-[#2B2D2F]/75\" data-kid=\"1-2-1-1-2-1-1-4\" data-name=\"store name text\">Comercial La Esquina</span>\n</div>\n<span class=\"text-[12px] text-[#2B2D2F]/70\" data-kid=\"1-2-1-1-2-1-2\" data-name=\"sample data label\">Datos de ejemplo</span>\n</div>\n<div class=\"flex items-center justify-between px-4 h-[32px] border-b border-[#2B2D2F]/12\" data-kid=\"1-2-1-1-2-2\" data-name=\"mockup date bar\">\n<div class=\"flex items-center gap-3 text-[13px] text-[#2B2D2F]/70\" data-kid=\"1-2-1-1-2-2-1\" data-name=\"date bar info group\">\n<span class=\"ff-fig tabular-nums\" data-kid=\"1-2-1-1-2-2-1-1\" data-name=\"date text\">31/10/2026</span>\n<span class=\"w-px h-3.5 bg-[#2B2D2F]/20\" data-kid=\"1-2-1-1-2-2-1-2\" data-name=\"date bar divider\"></span>\n<span data-kid=\"1-2-1-1-2-2-1-3\" data-name=\"shift time text\">Turno desde 08:00</span>\n<span class=\"w-px h-3.5 bg-[#2B2D2F]/20\" data-kid=\"1-2-1-1-2-2-1-4\" data-name=\"date bar divider\"></span>\n<span data-kid=\"1-2-1-1-2-2-1-5\" data-name=\"cashier name text\">María Rivas</span>\n</div>\n<span class=\"stamp border border-[#E65F2B] text-[#E65F2B] px-2 py-[2px] text-[11px] font-semibold uppercase\" data-kid=\"1-2-1-1-2-2-2\" data-name=\"open status stamp\">Abierto</span>\n</div>\n<!-- Regla de tasas — corchetes + filete paprika -->\n<div class=\"mx-4 mt-3\" data-kid=\"1-2-1-1-2-3\" data-name=\"daily rates section\">\n<div class=\"relative bg-[#2B2D2F]/[0.04] px-3 h-[34px] flex items-center justify-between\" data-kid=\"1-2-1-1-2-3-1\" data-name=\"rates row container\">\n<span class=\"absolute left-0 top-0 w-2 h-2 border-l border-t border-[#E65F2B]/70\" data-kid=\"1-2-1-1-2-3-1-1\" data-name=\"top-left corner tick\"></span>\n<span class=\"absolute right-0 top-0 w-2 h-2 border-r border-t border-[#E65F2B]/70\" data-kid=\"1-2-1-1-2-3-1-2\" data-name=\"top-right corner tick\"></span>\n<span class=\"absolute left-0 bottom-0 w-2 h-2 border-l border-b border-[#E65F2B]/70\" data-kid=\"1-2-1-1-2-3-1-3\" data-name=\"bottom-left corner tick\"></span>\n<span class=\"absolute right-0 bottom-0 w-2 h-2 border-r border-b border-[#E65F2B]/70\" data-kid=\"1-2-1-1-2-3-1-4\" data-name=\"bottom-right corner tick\"></span>\n<span class=\"text-[12px] text-[#2B2D2F]/70\" data-kid=\"1-2-1-1-2-3-1-5\" data-name=\"rates section label\">Tasas del día</span>\n<div class=\"flex items-center gap-4 text-[13px]\" data-kid=\"1-2-1-1-2-3-1-6\" data-name=\"rates values group\">\n<span class=\"ff-fig tabular-nums\" data-kid=\"1-2-1-1-2-3-1-6-1\" data-name=\"BCV exchange rate value\">BCV 250,00 Bs/USD</span>\n<span class=\"w-px h-3.5 bg-[#2B2D2F]/20\" data-kid=\"1-2-1-1-2-3-1-6-2\" data-name=\"rate divider\"></span>\n<span class=\"ff-fig tabular-nums\" data-kid=\"1-2-1-1-2-3-1-6-3\" data-name=\"USDT exchange rate value\">USDT 260,00 Bs/USDT</span>\n</div>\n</div>\n<div class=\"h-[2px] bg-[#E65F2B]\" data-kid=\"1-2-1-1-2-3-2\" data-name=\"rates underline accent\"></div>\n</div>\n<!-- Matriz de caja por moneda -->\n<div class=\"px-4 pt-2\" data-kid=\"1-2-1-1-2-4\" data-name=\"cash matrix by currency container\">\n<table class=\"w-full\" data-kid=\"1-2-1-1-2-4-1\" data-name=\"cash matrix table\">\n<thead data-kid=\"1-2-1-1-2-4-1-1\" data-name=\"cash matrix table header\">\n<tr class=\"text-[11px] uppercase tracking-[0.06em] text-[#2B2D2F]/70\" data-kid=\"1-2-1-1-2-4-1-1-1\" data-name=\"cash matrix header row\">\n<th class=\"text-left font-semibold pb-1 border-b border-[#2B2D2F]/15\" data-kid=\"1-2-1-1-2-4-1-1-1-1\" data-name=\"currency column header\">Moneda</th>\n<th class=\"text-right font-semibold pb-1 border-b border-[#2B2D2F]/15\" data-kid=\"1-2-1-1-2-4-1-1-1-2\" data-name=\"cash column header\">Efectivo</th>\n<th class=\"text-right font-semibold pb-1 border-b border-[#2B2D2F]/15\" data-kid=\"1-2-1-1-2-4-1-1-1-3\" data-name=\"other methods column header\">Otros medios</th>\n<th class=\"text-right font-semibold pb-1 border-b border-[#2B2D2F]/15\" data-kid=\"1-2-1-1-2-4-1-1-1-4\" data-name=\"total column header\">Total</th>\n</tr>\n</thead>\n<tbody class=\"text-[13px]\" data-kid=\"1-2-1-1-2-4-1-2\" data-name=\"cash matrix table body\">\n<tr class=\"border-b border-[#2B2D2F]/10\" data-kid=\"1-2-1-1-2-4-1-2-1\" data-name=\"USD cash row\">\n<td class=\"py-[5px] font-semibold\" data-kid=\"1-2-1-1-2-4-1-2-1-1\" data-name=\"USD currency cell\">USD</td>\n<td class=\"py-[5px] text-right ff-fig tabular-nums\" data-kid=\"1-2-1-1-2-4-1-2-1-2\" data-name=\"USD cash amount cell\">320,40</td>\n<td class=\"py-[5px] text-right ff-fig tabular-nums\" data-kid=\"1-2-1-1-2-4-1-2-1-3\" data-name=\"USD other methods amount cell\">145,80</td>\n<td class=\"py-[5px] text-right ff-fig tabular-nums font-semibold\" data-kid=\"1-2-1-1-2-4-1-2-1-4\" data-name=\"USD total amount cell\">466,20</td>\n</tr>\n<tr class=\"border-b border-[#2B2D2F]/10\" data-kid=\"1-2-1-1-2-4-1-2-2\" data-name=\"Bs cash row\">\n<td class=\"py-[5px] font-semibold\" data-kid=\"1-2-1-1-2-4-1-2-2-1\" data-name=\"Bs currency cell\">Bs</td>\n<td class=\"py-[5px] text-right ff-fig tabular-nums\" data-kid=\"1-2-1-1-2-4-1-2-2-2\" data-name=\"Bs cash amount cell\">12.480,00</td>\n<td class=\"py-[5px] text-right ff-fig tabular-nums\" data-kid=\"1-2-1-1-2-4-1-2-2-3\" data-name=\"Bs other methods amount cell\">8.150,00</td>\n<td class=\"py-[5px] text-right ff-fig tabular-nums font-semibold\" data-kid=\"1-2-1-1-2-4-1-2-2-4\" data-name=\"Bs total amount cell\">20.630,00</td>\n</tr>\n<tr da