      "html": "<style>\n  @import url('https://fonts.googleapis.com/css2?family=Domine:wght@500;600;700&family=Titillium+Web:wght@300;400;600;700&display=swap');\n  @import url('https://cdn.jsdelivr.net/npm/@tabler/icons-webfont@3.48.0/dist/tabler-icons.min.css');\n  @layer components {\n    .ttw { font-family: 'Titillium Web', ui-sans-serif, system-ui, sans-serif; }\n    .ff-fig { font-family: 'Domine', ui-serif, Georgia, serif; font-variant-numeric: tabular-nums; }\n  }\n  @keyframes posRise { from { opacity: 0; transform: translateY(8px); } to { opacity: 1; transform: translateY(0); } }\n  .pos-rise { animation: posRise 160ms ease-out both; }\n  @media (prefers-reduced-motion: reduce) {\n    .pos-rise { animation: none; }\n  }\n</style>\n<div class=\"ttw h-screen min-h-[900px] w-full flex flex-col bg-[#F3F3EF] text-[#2B2D2F] antialiased overflow-hidden\" data-kid=\"1\">\n<!-- ============ BARRA SUPERIOR (56px) ============ -->\n<header class=\"h-[56px] shrink-0 flex items-center justify-between px-5 border-b border-[#2B2D2F]/12\" data-kid=\"1-1\">\n<div class=\"flex items-center gap-3\" data-kid=\"1-1-1\">\n<div class=\"h-7 w-7 bg-[#2B2D2F] text-[#F3F3EF] flex items-center justify-center text-[14px] font-semibold\" data-kid=\"1-1-1-1\">S</div>\n<span class=\"text-[15px] font-semibold tracking-[-0.01em]\" data-kid=\"1-1-1-2\">Socius ERP</span>\n<span class=\"h-5 w-px bg-[#2B2D2F]/15\" data-kid=\"1-1-1-3\"></span>\n<div class=\"flex items-baseline gap-2\" data-kid=\"1-1-1-4\">\n<span class=\"text-[13px] text-[#2B2D2F]/70\" data-kid=\"1-1-1-4-1\">Negocio</span>\n<span class=\"text-[14px] font-semibold\" data-kid=\"1-1-1-4-2\">Comercial La Esquina</span>\n</div>\n</div>\n<div class=\"flex items-baseline gap-2\" data-kid=\"1-1-2\">\n<span class=\"text-[13px] text-[#2B2D2F]/70\" data-kid=\"1-1-2-1\">Usuario</span>\n<span class=\"text-[14px] font-semibold\" data-kid=\"1-1-2-2\">Luis Márquez</span>\n</div>\n</header>\n<div class=\"flex flex-1 min-h-0\" data-kid=\"1-2\">\n<!-- ============ NAVEGACIÓN LATERAL (208px) ============ -->\n<nav class=\"w-[208px] shrink-0 border-r border-[#2B2D2F]/12 flex flex-col\" data-kid=\"1-2-1\">\n<div class=\"flex-1 px-3 py-4 flex flex-col gap-[2px]\" data-kid=\"1-2-1-1\">\n<a class=\"h-9 flex items-center px-3 text-[14px] text-[#2B2D2F]/70 hover:bg-[#2B2D2F]/6 hover:text-[#2B2D2F] transition-colors duration-[140ms]\" data-kid=\"1-2-1-1-1\" href=\"#\">Inicio</a>\n<a class=\"h-9 flex items-center px-3 text-[14px] font-semibold bg-[#2B2D2F] text-[#F3F3EF]\" data-kid=\"1-2-1-1-2\" href=\"#\">Punto de venta</a>\n<a class=\"h-9 flex items-center px-3 text-[14px] text-[#2B2D2F]/70 hover:bg-[#2B2D2F]/6 hover:text-[#2B2D2F] transition-colors duration-[140ms]\" data-kid=\"1-2-1-1-3\" href=\"#\">Ventas</a>\n<a class=\"h-9 flex items-center px-3 text-[14px] text-[#2B2D2F]/70 hover:bg-[#2B2D2F]/6 hover:text-[#2B2D2F] transition-colors duration-[140ms]\" data-kid=\"1-2-1-1-4\" href=\"#\">Compras</a>\n<a class=\"h-9 flex items-center px-3 text-[14px] text-[#2B2D2F]/70 hover:bg-[#2B2D2F]/6 hover:text-[#2B2D2F] transition-colors duration-[140ms]\" data-kid=\"1-2-1-1-5\" href=\"#\">Caja y turnos</a>\n<div class=\"my-3 border-t border-[#2B2D2F]/12\" data-kid=\"1-2-1-1-6\"></div>\n<a class=\"h-9 flex items-center px-3 text-[14px] text-[#2B2D2F]/70 hover:bg-[#2B2D2F]/6 hover:text-[#2B2D2F] transition-colors duration-[140ms]\" data-kid=\"1-2-1-1-7\" href=\"#\">Clientes</a>\n<a class=\"h-9 flex items-center px-3 text-[14px] text-[#2B2D2F]/70 hover:bg-[#2B2D2F]/6 hover:text-[#2B2D2F] transition-colors duration-[140ms]\" data-kid=\"1-2-1-1-8\" href=\"#\">Proveedores</a>\n<a class=\"h-9 flex items-center px-3 text-[14px] text-[#2B2D2F]/70 hover:bg-[#2B2D2F]/6 hover:text-[#2B2D2F] transition-colors duration-[140ms]\" data-kid=\"1-2-1-1-9\" href=\"#\">Productos</a>\n<a class=\"h-9 flex items-center px-3 text-[14px] text-[#2B2D2F]/70 hover:bg-[#2B2D2F]/6 hover:text-[#2B2D2F] transition-colors duration-[140ms]\" data-kid=\"1-2-1-1-10\" href=\"#\">Inventario</a>\n<div class=\"my-3 border-t border-[#2B2D2F]/12\" data-kid=\"1-2-1-1-11\"></div>\n<a class=\"h-9 flex items-center px-3 text-[14px] text-[#2B2D2F]/70 hover:bg-[#2B2D2F]/6 hover:text-[#2B2D2F] transition-colors duration-[140ms]\" data-kid=\"1-2-1-1-12\" href=\"#\">Cuentas por cobrar</a>\n<a class=\"h-9 flex items-center px-3 text-[14px] text-[#2B2D2F]/70 hover:bg-[#2B2D2F]/6 hover:text-[#2B2D2F] transition-colors duration-[140ms]\" data-kid=\"1-2-1-1-13\" href=\"#\">Cuentas por pagar</a>\n<a class=\"h-9 flex items-center px-3 text-[14px] text-[#2B2D2F]/70 hover:bg-[#2B2D2F]/6 hover:text-[#2B2D2F] transition-colors duration-[140ms]\" data-kid=\"1-2-1-1-14\" href=\"#\">Reportes</a>\n</div>\n<div class=\"border-t border-[#2B2D2F]/12 px-3 py-3\" data-kid=\"1-2-1-2\">\n<a class=\"h-8 flex items-center px-3 text-[13px] text-[#2B2D2F]/70 hover:text-[#2B2D2F] transition-colors duration-[140ms]\" data-kid=\"1-2-1-2-1\" href=\"#\">Ajustes</a>\n<a class=\"h-8 flex items-center px-3 text-[13px] text-[#2B2D2F]/70 hover:text-[#2B2D2F] transition-colors duration-[140ms]\" data-kid=\"1-2-1-2-2\" href=\"#\">Cuenta</a>\n</div>\n</nav>\n<!-- ============ ÁREA DE CONTENIDO ============ -->\n<main class=\"flex-1 min-w-0 p-5 flex flex-col gap-4\" data-kid=\"1-2-2\">\n<!-- Título de vista (48px) -->\n<div class=\"h-[48px] shrink-0 flex items-center\" data-kid=\"1-2-2-1\">\n<h1 class=\"text-[24px] font-semibold tracking-[-0.01em]\" data-kid=\"1-2-2-1-1\">Punto de venta</h1>\n</div>\n<!-- Franja de tasa / turno (36px) -->\n<div class=\"h-[36px] shrink-0 border-y border-[#2B2D2F]/12 flex items-center justify-between px-3\" data-kid=\"1-2-2-2\">\n<div class=\"flex items-center gap-3\" data-kid=\"1-2-2-2-1\">\n<div class=\"flex items-center gap-2\" data-kid=\"1-2-2-2-1-1\">\n<span class=\"text-[13px] text-[#2B2D2F]/70\" data-kid=\"1-2-2-2-1-1-1\">Estado de turno</span>\n<span class=\"bg-[#E65F2B] text-black text-[12px] font-semibold px-2 py-[1px] leading-[1.4]\" data-kid=\"1-2-2-2-1-1-2\">Abierto</span>\n</div>\n<span class=\"h-4 w-px bg-[#2B2D2F]/15\" data-kid=\"1-2-2-2-1-2\"></span>\n<div class=\"flex items-baseline gap-2\" data-kid=\"1-2-2-2-1-3\">\n<span class=\"text-[13px] text-[#2B2D2F]/70\" data-kid=\"1-2-2-2-1-3-1\">Responsable</span>\n<span class=\"text-[13px] font-semibold\" data-kid=\"1-2-2-2-1-3-2\">Luis Márquez</span>\n</div>\n<span class=\"h-4 w-px bg-[#2B2D2F]/15\" data-kid=\"1-2-2-2-1-4\"></span>\n<div class=\"flex items-baseline gap-2\" data-kid=\"1-2-2-2-1-5\">\n<span class=\"text-[13px] text-[#2B2D2F]/70\" data-kid=\"1-2-2-2-1-5-1\">Apertura</span>\n<span class=\"text-[13px] font-semibold\" data-kid=\"1-2-2-2-1-5-2\">31/10/2026, 08:00</span>\n</div>\n</div>\n<!-- Regla BCV/USDT: corchetes + filete paprika -->\n<div class=\"relative bg-[#ECECE5] px-3 py-[3px]\" data-kid=\"1-2-2-2-2\">\n<span class=\"absolute left-0 top-0 h-[6px] w-[6px] border-l border-t border-[#2B2D2F]/45\" data-kid=\"1-2-2-2-2-1\"></span>\n<span class=\"absolute right-0 top-0 h-[6px] w-[6px] border-r border-t border-[#2B2D2F]/45\" data-kid=\"1-2-2-2-2-2\"></span>\n<span class=\"absolute left-0 bottom-0 h-[6px] w-[6px] border-l border-b border-[#2B2D2F]/45\" data-kid=\"1-2-2-2-2-3\"></span>\n<span class=\"absolute right-0 bottom-0 h-[6px] w-[6px] border-r border-b border-[#2B2D2F]/45\" data-kid=\"1-2-2-2-2-4\"></span>\n<div class=\"flex items-center gap-3\" data-kid=\"1-2-2-2-2-5\">\n<span class=\"text-[13px] text-[#2B2D2F]/70\" data-kid=\"1-2-2-2-2-5-1\">Tasas</span>\n<div class=\"flex items-baseline gap-1\" data-kid=\"1-2-2-2-2-5-2\">\n<span class=\"text-[13px] text-[#2B2D2F]/70\" data-kid=\"1-2-2-2-2-5-2-1\">BCV</span>\n<span class=\"ff-fig text-[14px] font-semibold\" data-kid=\"1-2-2-2-2-5-2-2\">250,00</span>\n<span class=\"text-[12px] text-[#2B2D2F]/70\" data-kid=\"1-2-2-2-2-5-2-3\">Bs/USD</span>\n</div>\n<div class=\"flex items-baseline gap-1\" data-kid=\"1-2-2-2-2-5-3\">\n<span class=\"text-[13px] text-[#2B2D2F]/70\" data-kid=\"1-2-2-2-2-5-3-1\">USDT</span>\n<span class=\"ff-fig text-[14px] font-semibold\" data-kid=\"1-2-2-2-2-5-3-2\">260,00</span>\n<span class=\"text-[12px] text-[#2B2D2F]/70\" data-kid=\"1-2-2-2-2-5-3-3\">Bs/USDT</span>\n</div>\n</div>\n<div class=\"absolute left-0 right-0 bottom-0 h-[2px] bg-[#E65F2B]\" data-kid=\"1-2-2-2-2-6\"></div>\n</div>\n</div>\n<!-- Área operativa: 748 catálogo + 16 + 428 carrito -->\n<div class=\"h-[688px] shrink-0 flex gap-4\" data-kid=\"1-2-2-3\">\n<!-- ======= CATÁLOGO ======= -->\n<section class=\"w-[748px] h-full flex flex-col pos-rise\" data-kid=\"1-2-2-3-1\">\n<!-- Búsqueda 40px -->\n<div class=\"h-[56px] shrink-0 flex items-center\" data-kid=\"1-2-2-3-1-1\">\n<label class=\"sr-only\" data-kid=\"1-2-2-3-1-1-1\" for=\"pos-buscar\">Buscar productos por nombre, SKU o código de barras</label>\n<div class=\"h-[40px] w-full bg-white border border-[#2B2D2F]/15 flex items-center px-3 gap-2\" data-kid=\"1-2-2-3-1-1-2\">\n<span class=\"text-[16px] flex items-center\" data-kid=\"1-2-2-3-1-1-2-1\"><i class=\"ti ti-search text-[#2B2D2F]/70\" data-kid=\"1-2-2-3-1-1-2-1-1\"></i></span>\n<input class=\"flex-1 min-w-0 bg-transparent text-[14px] outline-none placeholder:text-[#2B2D2F]/70\" data-kid=\"1-2-2-3-1-1-2-2\" id=\"pos-buscar\" placeholder=\"Buscar por nombre, SKU o código de barras\" type=\"search\"/>\n<span class=\"text-[18px] flex items-center\" data-kid=\"1-2-2-3-1-1-2-3\"><i class=\"ti ti-barcode text-[#2B2D2F]/70\" data-kid=\"1-2-2-3-1-1-2-3-1\"></i></span>\n</div>\n</div>\n<!-- Hoja de catálogo: perímetro fino, filas interiores sin caja -->\n<div class=\"flex-1 min-h-0 border border-[#2B2D2F]/15 flex flex-col\" data-kid=\"1-2-2-3-1-2\">\n<div class=\"flex-1 min-h-0 grid grid-cols-3 gap-px bg-[#2B2D2F]/10\" data-kid=\"1-2-2-3-1-2-1\">\n<button class=\"bg-[#F3F3EF] p-3 flex flex-col text-left hover:bg-[#ECECE5] transition-colors duration-[140ms]\" data-kid=\"1-2-2-3-1-2-1-1\" type=\"button\">\n<p class=\"text-[14px] font-semibold leading-[1.2]\" data-kid=\"1-2-2-3-1-2-1-1-1\">Detergente líquido 1 L</p>\n<p class=\"mt-1 text-[13px] text-[#2B2D2F]/70 leading-[1.2]\" data-kid=\"1-2-2-3-1-2-1-1-2\">DET-001</p>\n<div class=\"mt-auto pt-2 flex items-end justify-between\" data-kid=\"1-2-2-3-1-2-1-1-3\">\n<span class=\"ff-fig text-[16px] font-semibold leading-none\" data-kid=\"1-2-2-3-1-2-1-1-3-1\">USD 3,50</span>\n<span class=\"text-[13px] text-[#2B2D2F]/70 leading-none\" data-kid=\"1-2-2-3-1-2-1-1-3-2\">24 un</span>\n</div>\n</button>\n<button class=\"bg-[#F3F3EF] p-3 flex flex-col text-left hover:bg-[#ECECE5] transition-colors duration-[140ms]\" data-kid=\"1-2-2-3-1-2-1-2\" type=\"button\">\n<p class=\"text-[14px] font-semibold leading-[1.2]\" data-kid=\"1-2-2-3-1-2-1-2-1\">Lavaplatos 500 ml</p>\n<p class=\"mt-1 text-[13px] text-[#2B2D2F]/70 leading-[1.2]\" data-kid=\"1-2-2-3-1-2-1-2-2\">LAV-002</p>\n<div class=\"mt-auto pt-2 flex items-end justify-between\" data-kid=\"1-2-2-3-1-2-1-2-3\">\n<span class=\"ff-fig text-[16px] font-semibold leading-none\" data-kid=\"1-2-2-3-1-2-1-2-3-1\">USD 2,50</span>\n<span class=\"text-[13px] text-[#2B2D2F]/70 leading-none\" data-kid=\"1-2-2-3-1-2-1-2-3-2\">18 un</span>\n</div>\n</button>\n<button class=\"bg-[#F3F3EF] p-3 flex flex-col text-left hover:bg-[#ECECE5] transition-colors duration-[140ms]\" data-kid=\"1-2-2-3-1-2-1-3\" type=\"button\">\n<p class=\"text-[14px] font-semibold leading-[1.2]\" data-kid=\"1-2-2-3-1-2-1-3-1\">Desinfectante 1 L</p>\n<p class=\"mt-1 text-[13px] text-[#2B2D2F]/70 leading-[1.2]\" data-kid=\"1-2-2-3-1-2-1-3-2\">DES-003</p>\n<div class=\"mt-auto pt-2 flex items-end justify-between\" data-kid=\"1-2-2-3-1-2-1-3-3\">\n<span class=\"ff-fig text-[16px] font-semibold leading-none\" data-kid=\"1-2-2-3-1-2-1-3-3-1\">USD 4,20</span>\n<span class=\"text-[13px] text-[#2B2D2F]/70 leading-none\" data-kid=\"1-2-2-3-1-2-1-3-3-2\">30 un</span>\n</div>\n</button>\n<button class=\"bg-[#F3F3EF] p-3 flex flex-col text-left hover:bg-[#ECECE5] transition-colors durat