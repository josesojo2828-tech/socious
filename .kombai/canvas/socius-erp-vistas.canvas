      "html": "<style>\n  @import url('https://fonts.googleapis.com/css2?family=Titillium+Web:wght@400;600;700&display=swap');\n  @import url('https://cdn.jsdelivr.net/npm/@tabler/icons-webfont@3.48.0/dist/tabler-icons.min.css');\n\n  :root {\n    --parchment: #F3F3EF;\n    --white: #FFFFFF;\n    --graphite: #2B2D2F;\n    --graphite-70: rgba(43, 45, 47, 0.7);\n    --graphite-55: rgba(43, 45, 47, 0.55);\n    --hairline: rgba(43, 45, 47, 0.22);\n    --field-border: rgba(43, 45, 47, 0.3);\n    --paprika: #E65F2B;\n    --paprika-hover: #CF5222;\n    --ebony: #4A5340;\n  }\n\n  body {\n    margin: 0;\n    background: var(--parchment);\n    color: var(--graphite);\n    font-family: 'Titillium Web', ui-sans-serif, system-ui, sans-serif;\n    -webkit-font-smoothing: antialiased;\n    font-size: 14px;\n    line-height: 1.4;\n  }\n\n  .page {\n    min-height: 900px;\n    display: flex;\n    flex-direction: column;\n  }\n\n  /* ---- Top bar ---- */\n  .topbar {\n    height: 56px;\n    flex: none;\n    display: flex;\n    align-items: center;\n    justify-content: space-between;\n    padding: 0 32px;\n    border-bottom: 1px solid var(--hairline);\n    background: var(--parchment);\n  }\n  .brand {\n    display: flex;\n    align-items: center;\n    gap: 10px;\n  }\n  .brand-tile {\n    width: 28px;\n    height: 28px;\n    background: var(--graphite);\n    color: var(--parchment);\n    font-size: 15px;\n    font-weight: 700;\n    display: flex;\n    align-items: center;\n    justify-content: center;\n  }\n  .brand-name {\n    font-size: 16px;\n    font-weight: 600;\n    letter-spacing: 0.1px;\n  }\n  .back-link {\n    display: inline-flex;\n    align-items: center;\n    gap: 6px;\n    font-size: 14px;\n    color: var(--graphite-70);\n    text-decoration: none;\n    transition: color 140ms ease, opacity 140ms ease;\n  }\n  .back-link .ti { font-size: 15px; }\n  .back-link:hover { color: var(--graphite); }\n\n  /* ---- Main / sheet ---- */\n  main {\n    flex: 1;\n    display: flex;\n    justify-content: center;\n    align-items: flex-start;\n    padding: 48px 20px 24px;\n  }\n  .sheet {\n    width: 560px;\n    background: var(--white);\n    border: 1px solid var(--hairline);\n    padding: 36px 40px;\n    animation: rise 160ms ease-out both;\n  }\n  @keyframes rise {\n    from { opacity: 0; transform: translateY(8px); }\n    to { opacity: 1; transform: none; }\n  }\n  @media (prefers-reduced-motion: reduce) {\n    .sheet { animation: none; }\n  }\n\n  h1 {\n    margin: 0;\n    font-size: 24px;\n    line-height: 30px;\n    font-weight: 600;\n    letter-spacing: 0;\n  }\n  .sub {\n    margin: 8px 0 0;\n    font-size: 14px;\n    color: var(--graphite-70);\n  }\n\n  .inline-link {\n    color: var(--graphite);\n    text-decoration: underline;\n    text-underline-offset: 2px;\n    text-decoration-thickness: 1px;\n    transition: opacity 140ms ease;\n  }\n  .inline-link:hover { opacity: 0.72; }\n\n  form { margin-top: 28px; }\n  .row-2 {\n    display: grid;\n    grid-template-columns: 1fr 1fr;\n    gap: 16px;\n    margin-bottom: 16px;\n  }\n  .field { margin-bottom: 16px; }\n  .field:last-of-type { margin-bottom: 0; }\n\n  .label {\n    display: block;\n    font-size: 13px;\n    line-height: 16px;\n    font-weight: 600;\n    color: var(--graphite-70);\n    margin-bottom: 4px;\n  }\n  .label-row {\n    display: flex;\n    align-items: center;\n    justify-content: space-between;\n    margin-bottom: 4px;\n    min-height: 18px;\n  }\n  .label-row .label { margin-bottom: 0; }\n\n  .input-wrap { position: relative; }\n  .input {\n    width: 100%;\n    height: 44px;\n    box-sizing: border-box;\n    background: var(--white);\n    border: 1px solid var(--field-border);\n    border-radius: 0;\n    padding: 0 12px;\n    font-family: inherit;\n    font-size: 14px;\n    color: var(--graphite);\n    transition: border-color 140ms ease;\n  }\n  .input::placeholder { color: var(--graphite-55); }\n  .input:focus {\n    outline: 1px solid var(--graphite);\n    border-color: var(--graphite);\n  }\n  input[type=\"date\"] { font-variant-numeric: tabular-nums; }\n  input[type=\"date\"]::-webkit-calendar-picker-indicator { opacity: 0.55; cursor: pointer; }\n  .input.has-icon { padding-right: 40px; }\n\n  select.input {\n    appearance: none;\n    -webkit-appearance: none;\n    padding-right: 36px;\n    cursor: pointer;\n  }\n  .select-chevron {\n    position: absolute;\n    right: 12px;\n    top: 50%;\n    transform: translateY(-50%);\n    font-size: 16px;\n    color: var(--graphite-55);\n    pointer-events: none;\n  }\n  .eye-btn {\n    position: absolute;\n    right: 6px;\n    top: 50%;\n    transform: translateY(-50%);\n    width: 32px;\n    height: 32px;\n    display: flex;\n    align-items: center;\n    justify-content: center;\n    background: none;\n    border: 0;\n    padding: 0;\n    color: var(--graphite-55);\n    cursor: pointer;\n    font-size: 17px;\n    transition: color 140ms ease;\n  }\n  .eye-btn:hover { color: var(--graphite); }\n\n  /* ---- States ---- */\n  .field.error .input { border-color: var(--paprika); }\n  .err {\n    display: flex;\n    align-items: center;\n    gap: 5px;\n    margin: 4px 0 0;\n    font-size: 13px;\n    line-height: 16px;\n    font-weight: 600;\n    color: var(--paprika);\n  }\n  .err .ti { font-size: 13px; }\n\n  .chip-applied {\n    display: inline-flex;\n    align-items: center;\n    gap: 4px;\n    background: var(--ebony);\n    color: var(--parchment);\n    font-size: 12px;\n    font-weight: 600;\n    line-height: 16px;\n    padding: 2px 8px;\n  }\n  .chip-applied .ti { font-size: 12px; }\n\n  /* ---- Terms ---- */\n  .terms {\n    display: flex;\n    align-items: flex-start;\n    gap: 8px;\n    margin-bottom: 16px;\n  }\n  .checkbox {\n    width: 16px;\n    height: 16px;\n    flex: none;\n    margin-top: 1px;\n    border: 1.5px solid var(--field-border);\n    border-radius: 0;\n    background: var(--white);\n    appearance: none;\n    -webkit-appearance: none;\n    cursor: pointer;\n  }\n  .terms.error .checkbox { border-color: var(--paprika); }\n  .terms-text {\n    margin: 0;\n    font-size: 13px;\n    line-height: 18px;\n    color: var(--graphite-70);\n  }\n\n  /* ---- Button ---- */\n  .btn-primary {\n    width: 100%;\n    height: 48px;\n    background: var(--paprika);\n    color: #000000;\n    border: 0;\n    border-radius: 0;\n    font-family: inherit;\n    font-size: 15px;\n    font-weight: 700;\n    letter-spacing: 0.1px;\n    cursor: pointer;\n    transition: background-color 140ms ease;\n  }\n  .btn-primary:hover { background: var(--paprika-hover); }\n\n  .next-note {\n    margin: 10px 0 0;\n    font-size: 13px;\n    line-height: 18px;\n    color: var(--graphite-70);\n  }\n\n  /* ---- Footer ---- */\n  footer {\n    flex: none;\n    padding: 18px 20px;\n    text-align: center;\n    font-size: 13px;\n    color: var(--graphite-70);\n  }\n</style>\n<div class=\"page\" data-kid=\"1\" data-name=\"page layout container\">\n<header class=\"topbar\" data-kid=\"1-1\" data-name=\"top navigation bar\">\n<div class=\"brand\" data-kid=\"1-1-1\" data-name=\"brand logo group\">\n<div class=\"brand-tile\" data-kid=\"1-1-1-1\" data-name=\"brand monogram tile\">S</div>\n<div class=\"brand-name\" data-kid=\"1-1-1-2\" data-name=\"brand name text\">Socius ERP</div>\n</div>\n<a class=\"back-link\" data-kid=\"1-1-2\" data-name=\"back-to-home link\" href=\"/\"><i class=\"ti ti-arrow-left\" data-kid=\"1-1-2-1\" data-name=\"left arrow icon\"></i>Volver al inicio</a>\n</header>\n<main data-kid=\"1-2\" data-name=\"main content area\">\n<div class=\"sheet\" data-kid=\"1-2-1\" data-name=\"account signup card\">\n<h1 data-kid=\"1-2-1-1\" data-name=\"page heading\">Crear cuenta</h1>\n<p class=\"sub\" data-kid=\"1-2-1-2\" data-name=\"subheading with login link\">¿Ya tienes una cuenta? <a class=\"inline-link\" data-kid=\"1-2-1-2-1\" data-name=\"login link\" href=\"/login\">Iniciar sesión</a></p>\n<form data-kid=\"1-2-1-3\" data-name=\"signup form\">\n<div class=\"row-2\" data-kid=\"1-2-1-3-1\" data-name=\"first and last name row\">\n<div class=\"field\" data-kid=\"1-2-1-3-1-1\" data-name=\"first name field group\">\n<label class=\"label\" data-kid=\"1-2-1-3-1-1-1\" data-name=\"first name label\" for=\"nombre\">Nombre</label>\n<div class=\"input-wrap\" data-kid=\"1-2-1-3-1-1-2\" data-name=\"input wrapper\">\n<input class=\"input\" data-kid=\"1-2-1-3-1-1-2-1\" data-name=\"first name input field\" id=\"nombre\" type=\"text\" value=\"Ana Lucía\"/>\n</div>\n</div>\n<div class=\"field\" data-kid=\"1-2-1-3-1-2\" data-name=\"last name field group\">\n<label class=\"label\" data-kid=\"1-2-1-3-1-2-1\" data-name=\"last name label\" for=\"apellidos\">Apellidos</label>\n<div class=\"input-wrap\" data-kid=\"1-2-1-3-1-2-2\" data-name=\"input wrapper\">\n<input class=\"input\" data-kid=\"1-2-1-3-1-2-2-1\" data-name=\"last name input field\" id=\"apellidos\" type=\"text\" value=\"Pérez\"/>\n</div>\n</div>\n</div>\n<div class=\"field\" data-kid=\"1-2-1-3-2\" data-name=\"email field group\">\n<label class=\"label\" data-kid=\"1-2-1-3-2-1\" data-name=\"email label\" for=\"correo\">Correo electrónico</label>\n<div class=\"input-wrap\" data-kid=\"1-2-1-3-2-2\" data-name=\"input wrapper\">\n<input class=\"input\" data-kid=\"1-2-1-3-2-2-1\" data-name=\"email input field\" id=\"correo\" type=\"email\" value=\"ana.perez@correo.com\"/>\n</div>\n</div>\n<div class=\"row-2\" data-kid=\"1-2-1-3-3\" data-name=\"password and confirm row\">\n<div class=\"field\" data-kid=\"1-2-1-3-3-1\" data-name=\"password field group\">\n<label class=\"label\" data-kid=\"1-2-1-3-3-1-1\" data-name=\"password label\" for=\"clave\">Contraseña</label>\n<div class=\"input-wrap\" data-kid=\"1-2-1-3-3-1-2\" data-name=\"password input wrapper\">\n<input class=\"input has-icon\" data-kid=\"1-2-1-3-3-1-2-1\" data-name=\"password input field\" id=\"clave\" type=\"password\" value=\"clave2026x\"/>\n<button aria-label=\"Mostrar contraseña\" class=\"eye-btn\" data-dynamic=\"true\" data-kid=\"1-2-1-3-3-1-2-2\" data-name=\"show/hide password button\" data-reason=\"toggles input type between password and text\" type=\"button\"><i class=\"ti ti-eye\" data-kid=\"1-2-1-3-3-1-2-2-1\" data-name=\"eye icon\"></i></button>\n</div>\n</div>\n<div class=\"field error\" data-kid=\"1-2-1-3-3-2\" data-name=\"confirm password field group\">\n<label class=\"label\" data-kid=\"1-2-1-3-3-2-1\" data-name=\"confirm password label\" for=\"clave2\">Confirmar contraseña</label>\n<div class=\"input-wrap\" data-kid=\"1-2-1-3-3-2-2\" data-name=\"confirm password input wrapper\">\n<input class=\"input has-icon\" data-kid=\"1-2-1-3-3-2-2-1\" data-name=\"confirm password input field\" id=\"clave2\" type=\"password\" value=\"clave2026\"/>\n<button aria-label=\"Mostrar contraseña\" class=\"eye-btn\" data-dynamic=\"true\" data-kid=\"1-2-1-3-3-2-2-2\" data-name=\"show/hide password button\" data-reason=\"toggles input type between password and text\" type=\"button\"><i class=\"ti ti-eye\" data-kid=\"1-2-1-3-3-2-2-2-1\" data-name=\"eye icon\"></i></button>\n</div>\n<p class=\"err\" data-kid=\"1-2-1-3-3-2-3\" data-name=\"password mismatch error message\"><i class=\"ti ti-alert-circle\" data-kid=\"1-2-1-3-3-2-3-1\" data-name=\"alert circle icon\"></i>Las contraseñas no coinciden.</p>\n</div>\n</div>\n<div class=\"row-2\" data-kid=\"1-2-1-3-4\" data-name=\"date and gender row\">\n<div class=\"field\" data-kid=\"1-2-1-3-4-1\" data-name=\"birth date field group\">\n<label class=\"label\" data-kid=\"1-2-1-3-4-1-1\" data-name=\"birth date label\" for=\"nacimiento\">Fecha de nacimiento</label>\n<div class=\"input-wrap\" data-kid=\"1-2-1-3-4-1-2\" data-name=\"input wrapper\">\n<input class=\"input\" data-kid=\"1-2-1-3-4-1-2-1\" data-name=\"date picker input field\" id=\"nacimiento\" type=\"date\" value=\"1994-03-14\"/>\n</div>\n</div>\n<div class=\"field\" data-kid=\"1-2-1-3-4-2\" data-name=\"gender field group\">\n<label class=\"label\" data-kid=\"1-2-1-3-4-2-1\" data-name=\"gender label\" for=\"genero\">Género</label>\n<div class=\"input-wrap\" data-kid=\"1-2-1-3-4-2-2\" data-name=\"select wrapper\">\n<select class=\"input\" data-kid=\"1-2-1-3-4-2-2-1\" data-name=\"gender select dropdown\" id=\"genero\">\n<option data-kid=\"1-2-1-3-4-2-2-1-1\" data-name=\"select gender default option\">Seleccionar género</option>\n<option data-kid=\"1-2-1-3-4-2-2-1-2\" data-name=\"male option\">Masculino</option>\n<option data-kid=\"1-2-1-3-4-2-2-1-3\" data-name=\"female option\" selected=\"\">Femenino</option>\n<option data-kid=\"1-2-1-3-4-2-2-1-4\" data-name=\"other option\">Otro</option>\n</select>\n<i class=\"ti ti-chevron-down select-chevron\" data-kid=\"1-2-1-3-4-2-2-2\" data-name=\"chevron down icon\"></i>\n</div>\n</div>\n</div>\n<div class=\"field\" data-kid=\"1-2-1-3-5\" data-name=\"referral code field group\">\n<div class=\"label-row\" data-kid=\"1-2-1-3-5-1\" data-name=\"label row with applied chip\">\n<label class=\"label\" data-kid=\"1-2-1-3-5-1-1\" data-name=\"referral code label\" for=\"referido\">Código de referido (opcional)</label>\n<span class=\"chip-applied\" data-kid=\"1-2-1-3-5-1-2\" data-name=\"applied status chip\"><i class=\"ti ti-check\" data-kid=\"1-2-1-3-5-1-2-1\" data-name=\"checkmark icon\"></i>Aplicado</span>\n</div>\n<div class=\"input-wrap\" data-kid=\"1-2-1-3-5-2\" data-name=\"input wrapper\">\n<input class=\"input\" data-kid=\"1-2-1-3-5-2-1\" data-name=\"referral code input field\" id=\"referido\" type=\"text\" value=\"ESQ-2026\"/>\n</div>\n</div>\n<div class=\"terms error\" data-kid=\"1-2-1-3-6\" data-name=\"terms acceptance row\">\n<input class=\"checkbox\" data-kid=\"1-2-1-3-6-1\" data-name=\"terms checkbox\" id=\"terminos\" type=\"checkbox\"/>\n<div data-kid=\"1-2-1-3-6-2\" data-name=\"terms content wrapper\">\n<p class=\"terms-text\" data-kid=\"1-2-1-3-6-2-1\" data-name=\"terms text with links\">Acepto los <a class=\"inline-link\" data-kid=\"1-2-1-3-6-2-1-1\" data-name=\"terms of service link\" href=\"/terms\">Términos de Servicio</a> y la <a class=\"inline-link\" data-kid=\"1-2-1-3-6-2-1-2\" data-name=\"privacy policy link\" href=\"/privacy\">Política de Privacidad</a> de Socius.</p>\n<p class=\"err\" data-kid=\"1-2-1-3-6-2-2\" data-name=\"terms not accepted error message\"><i class=\"ti ti-alert-circle\" data-kid=\"1-2-1-3-6-2-2-1\" data-name=\"alert circle icon\"></i>Acepta los términos y condiciones para continuar.</p>\n</div>\n</div>\n<button class=\"btn-primary\" data-kid=\"1-2-1-3-7\" data-name=\"create account submit button\" type=\"button\">Crear cuenta</button>\n<p class=\"next-note\" data-kid=\"1-2-1-3-8\" data-name=\"next step note\">El siguiente paso es registrar los datos de tu negocio.</p>\n</form>\n</div>\n</main>\n<footer data-kid=\"1-3\" data-name=\"footer copyright\">© 2026 Socius ERP</footer>\n</div>",
