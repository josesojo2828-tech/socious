-2-2\">\n<div class=\"h-full px-5 pt-5 pb-5 flex flex-col\" data-kid=\"2-2-2-1\">\n<!-- Título de vista -->\n<div class=\"h-12 shrink-0 flex items-end pb-1\" data-kid=\"2-2-2-1-1\">\n<h1 class=\"text-[24px] font-semibold leading-none\" data-kid=\"2-2-2-1-1-1\">Punto de venta</h1>\n</div>\n<!-- Franja de tasa / turno -->\n<div class=\"mt-3 h-9 shrink-0 flex items-center border-y border-[#2B2D2F]/12\" data-kid=\"2-2-2-1-2\">\n<div class=\"flex items-center gap-2 text-[13px]\" data-kid=\"2-2-2-1-2-1\">\n<span class=\"text-[#2B2D2F]/70\" data-kid=\"2-2-2-1-2-1-1\">Tasa del día</span>\n<span class=\"tnum border-b-2 border-[#E65F2B] pb-[1px]\" data-kid=\"2-2-2-1-2-1-2\">\n<span class=\"text-[#2B2D2F]/70\" data-kid=\"2-2-2-1-2-1-2-1\">[</span>BCV 250,00 Bs/USD<span class=\"text-[#2B2D2F]/70\" data-kid=\"2-2-2-1-2-1-2-2\">]</span>\n<span class=\"text-[#2B2D2F]/70\" data-kid=\"2-2-2-1-2-1-2-3\">[</span>USDT 260,00 Bs/USDT<span class=\"text-[#2B2D2F]/70\" data-kid=\"2-2-2-1-2-1-2-4\">]</span>\n</span>\n</div>\n<div class=\"ml-8 flex items-center gap-2 text-[13px]\" data-kid=\"2-2-2-1-2-2\">\n<span class=\"text-[#2B2D2F]/70\" data-kid=\"2-2-2-1-2-2-1\">Estado de turno</span>\n<span class=\"inline-flex items-center gap-1.5 font-semibold text-[#E65F2B]\" data-kid=\"2-2-2-1-2-2-2\"><span class=\"w-2 h-2 bg-[#E65F2B]\" data-kid=\"2-2-2-1-2-2-2-1\"></span>Abierto</span>\n</div>\n<div class=\"ml-6 flex items-center gap-2 text-[13px]\" data-kid=\"2-2-2-1-2-3\">\n<span class=\"text-[#2B2D2F]/70\" data-kid=\"2-2-2-1-2-3-1\">Registro</span>\n<span class=\"font-semibold\" data-kid=\"2-2-2-1-2-3-2\">En turno</span>\n</div>\n</div>\n<!-- Área operativa -->\n<div class=\"mt-4 flex gap-4 flex-1 min-h-0\" data-kid=\"2-2-2-1-3\">\n<!-- Catálogo -->\n<section class=\"w-[748px] flex flex-col\" data-kid=\"2-2-2-1-3-1\">\n<div class=\"flex-1 min-h-0 border border-[#2B2D2F]/15 bg-[#F3F3EF] flex flex-col\" data-kid=\"2-2-2-1-3-1-1\">\n<div class=\"h-10 shrink-0 flex items-center gap-2 px-3 border-b border-[#2B2D2F]/12 bg-white\" data-kid=\"2-2-2-1-3-1-1-1\">\n<i class=\"ti ti-search text-[18px] text-[#2B2D2F]/70\" data-kid=\"2-2-2-1-3-1-1-1-1\"></i>\n<span class=\"flex-1 text-[14px] text-[#2B2D2F]/70\" data-kid=\"2-2-2-1-3-1-1-1-2\">Nombre, SKU o código de barras</span>\n<i class=\"ti ti-barcode text-[18px] text-[#2B2D2F]/70\" data-kid=\"2-2-2-1-3-1-1-1-3\"></i>\n</div>\n<div class=\"flex-1 grid grid-cols-3 grid-rows-4\" data-kid=\"2-2-2-1-3-1-1-2\">\n<div class=\"p-3 border-r border-b border-[#2B2D2F]/12 flex flex-col\" data-kid=\"2-2-2-1-3-1-1-2-1\">\n<p class=\"text-[15px] font-semibold leading-[1.15]\" data-kid=\"2-2-2-1-3-1-1-2-1-1\">Detergente líquido 1 L</p>\n<p class=\"mt-1 text-[13px] tnum text-[#2B2D2F]/70\" data-kid=\"2-2-2-1-3-1-1-2-1-2\">DET-001</p>\n<div class=\"mt-auto flex items-end justify-between gap-2\" data-kid=\"2-2-2-1-3-1-1-2-1-3\">\n<span class=\"fig text-[18px] leading-none\" data-kid=\"2-2-2-1-3-1-1-2-1-3-1\">USD 3,50</span>\n<span class=\"text-[13px] text-[#4A5340] whitespace-nowrap\" data-kid=\"2-2-2-1-3-1-1-2-1-3-2\">24 botella</span>\n</div>\n</div>\n<div class=\"p-3 border-r border-b border-[#2B2D2F]/12 flex flex-col\" data-kid=\"2-2-2-1-3-1-1-2-2\">\n<p class=\"text-[15px] font-semibold leading-[1.15]\" data-kid=\"2-2-2-1-3-1-1-2-2-1\">Lavaplatos 500 ml</p>\n<p class=\"mt-1 text-[13px] tnum text-[#2B2D2F]/70\" data-kid=\"2-2-2-1-3-1-1-2-2-2\">LAV-002</p>\n<div class=\"mt-auto flex items-end justify-between gap-2\" data-kid=\"2-2-2-1-3-1-1-2-2-3\">\n<span class=\"fig text-[18px] leading-none\" data-kid=\"2-2-2-1-3-1-1-2-2-3-1\">USD 2,50</span>\n<span class=\"text-[13px] text-[#4A5340] whitespace-nowrap\" data-kid=\"2-2-2-1-3-1-1-2-2-3-2\">40 frasco</span>\n</div>\n</div>\n<div class=\"p-3 border-r border-b border-[#2B2D2F]/12 flex flex-col\" data-kid=\"2-2-2-1-3-1-1-2-3\">\n<p class=\"text-[15px] font-semibold leading-[1.15]\" data-kid=\"2-2-2-1-3-1-1-2-3-1\">Desinfectante 1 L</p>\n<p class=\"mt-1 text-[13px] tnum text-[#2B2D2F]/