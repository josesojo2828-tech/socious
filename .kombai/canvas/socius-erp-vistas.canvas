      "html": "<style>\n  @import url('https://fonts.googleapis.com/css2?family=Titillium+Web:wght@300;400;600;700&family=Domine:wght@600;700&display=swap');\n  .ff { font-family: 'Titillium Web', ui-sans-serif, system-ui, sans-serif; }\n  .fig { font-family: 'Domine', Georgia, serif; font-variant-numeric: tabular-nums; }\n  .tnum { font-variant-numeric: tabular-nums; }\n  @keyframes sheet-in { from { opacity: 0; transform: translateX(8px); } to { opacity: 1; transform: translateX(0); } }\n  @keyframes veil-in { from { opacity: 0; } to { opacity: 1; } }\n  .sheet { animation: sheet-in 160ms ease-out both; }\n  .veil { animation: veil-in 160ms ease-out both; }\n  @media (prefers-reduced-motion: reduce) { .sheet, .veil { animation: none; } }\n</style>\n<link data-kid=\"1\" href=\"https://cdn.jsdelivr.net/npm/@tabler/icons-webfont@3.48.0/dist/tabler-icons.min.css\" rel=\"stylesheet\"/>\n<div class=\"ff w-[1440px] h-screen min-h-[900px] bg-[#F3F3EF] text-[#2B2D2F] flex flex-col overflow-hidden antialiased\" data-kid=\"2\">\n<!-- Barra superior -->\n<header class=\"h-14 shrink-0 bg-[#2B2D2F] text-[#F3F3EF] flex items-center justify-between px-4\" data-kid=\"2-1\">\n<div class=\"flex items-center gap-3\" data-kid=\"2-1-1\">\n<span class=\"text-[15px] font-semibold tracking-[0.02em]\" data-kid=\"2-1-1-1\">Socius ERP</span>\n<span class=\"w-px h-4 bg-[#F3F3EF]/25\" data-kid=\"2-1-1-2\"></span>\n<span class=\"text-[13px] text-[#F3F3EF]/85\" data-kid=\"2-1-1-3\">Comercial La Esquina · Sucursal Principal</span>\n</div>\n<div class=\"flex items-center gap-3 text-[13px]\" data-kid=\"2-1-2\">\n<span class=\"tnum text-[#F3F3EF]/85\" data-kid=\"2-1-2-1\">31/10/2026</span>\n<span class=\"w-px h-4 bg-[#F3F3EF]/25\" data-kid=\"2-1-2-2\"></span>\n<span class=\"font-semibold\" data-kid=\"2-1-2-3\">Luis Márquez</span>\n</div>\n</header>\n<div class=\"flex flex-1 min-h-0\" data-kid=\"2-2\">\n<!-- Navegación lateral -->\n<nav class=\"w-52 shrink-0 bg-[#2B2D2F] text-[#F3F3EF] flex flex-col\