      "html": "<style>\n  @import url('https://fonts.googleapis.com/css2?family=Domine:wght@500;600;700&family=Titillium+Web:wght@300;400;600;700&display=swap');\n  @import url('https://cdn.jsdelivr.net/npm/@tabler/icons-webfont@3.48.0/dist/tabler-icons.min.css');\n  .ttw { font-family: 'Titillium Web', ui-sans-serif, system-ui, sans-serif; }\n  .ff-fig { font-family: 'Domine', Georgia, serif; font-variant-numeric: tabular-nums; }\n  .tnum { font-variant-numeric: tabular-nums; }\n  .brk { position: relative; }\n  .brk::before, .brk::after { content: ''; position: absolute; width: 7px; height: 7px; border: 1.5px solid rgba(43,45,47,0.5); }\n  .brk::before { left: -5px; top: -5px; border-right: 0; border-bottom: 0; }\n  .brk::after { right: -5px; bottom: -5px; border-left: 0; border-top: 0; }\n  .fade-in { animation: fadeUp 160ms ease-out both; }\n  @keyframes fadeUp { from { opacity: 0; transform: translateY(8px); } to { opacity: 1; transform: none; } }\n  @media (prefers-reduced-motion: reduce) { .fade-in { animation: none; } .tr { transition: none !important; } }\n</style>\n<div class=\"ttw w-[1440px] h-screen min-h-[900px] bg-[#F3F3EF] text-[#2B2D2F] flex flex-col overflow-hidden antialiased\" data-kid=\"1\" data-name=\"ERP dashboard page container\">\n<!-- Barra superior 56px -->\n<header class=\"h-[56px] shrink-0 flex items-center justify-between px-5 border-b border-[#2B2D2F]/15\" data-kid=\"1-1\" data-name=\"top application header bar\">\n<div class=\"flex items-center gap-2.5\" data-kid=\"1-1-1\" data-name=\"brand and company identity group\">\n<div class=\"h-[26px] w-[26px] bg-[#2B2D2F] text-[#F3F3EF] flex items-center justify-center text-[13px] font-semibold\" data-kid=\"1-1-1-1\" data-name=\"monogram logo mark\">S</div>\n<span class=\"text-[15px] font-semibold tracking-[-0.01em]\" data-kid=\"1-1-1-2\" data-name=\"application name text\">Socius ERP</span>\n<span class=\"h-[14px] w-px bg-[#2B2D2F]/20\" data-kid=\"1-1-1-3\" data-name=\"brand separator divider\"></span>\n<span class=\"text-[13px] text-[#2B2D2F]/70\" data-kid=\"1-1-1-4\" data-name=\"company name text\">Comercial La Esquina</span>\n</div>\n<div class=\"flex items-center gap-2.5\" data-kid=\"1-1-2\" data-name=\"user profile identity group\">\n<span class=\"text-[13px] text-[#2B2D2F]/75\" data-kid=\"1-1-2-1\" data-name=\"logged-in user name\">Luis Márquez</span>\n<span class=\"h-[14px] w-px bg-[#2B2D2F]/20\" data-kid=\"1-1-2-2\" data-name=\"user info separator divider\"></span>\n<span class=\"text-[12px] text-[#2B2D2F]/70\" data-kid=\"1-1-2-3\" data-name=\"user role label\">Administrador</span>\n</div>\n</header>\n<div class=\"flex flex-1 min-h-0\" data-kid=\"1-2\" data-name=\"main content workspace\">\n<!-- Navegación lateral 208px -->\n<aside class=\"w-[208px] shrink-0 border-r border-[#2B2D2F]/15 flex flex-col\" data-kid=\"1-2-1\" data-name=\"sidebar navigation panel\">\n<nav class=\"flex-1 pt-3\" data-kid=\"1-2-1-1\" data-name=\"sidebar primary navigation menu\">\n<a class=\"mx-2 flex h-[32px] items-center px-2.5 bg-[#2B2D2F] text-[#F3F3EF] text-[13px] font-semibold cursor-pointer\" data-kid=\"1-2-1-1-1\" data-name=\"home navigation link (active)\">Inicio</a>\n<a class=\"mx-2 flex h-[32px] items-center px-2.5 text-[13px] text-[#2B2D2F]/75 hover:bg-[#2B2D2F]/6 transition-colors duration-[140ms] cursor-pointer\" data-kid=\"1-2-1-1-2\" data-name=\"point of sale navigation link\">Punto de venta</a>\n<a class=\"mx-2 flex h-[32px] items-center px-2.5 text-[13px] text-[#2B2D2F]/75 hover:bg-[#2B2D2F]/6 transition-colors duration-[140ms] cursor-pointer\" data-kid=\"1-2-1-1-3\" data-name=\"sales navigation link\">Ventas</a>\n<a class=\"mx-2 flex h-[32px] items-center px-2.5 text-[13px] text-[#2B2D2F]/75 hover:bg-[#2B2D2F]/6 transition-colors duration-[140ms] cursor-pointer\" data-kid=\"1-2-1-1-4\" data-name=\"purchases navigation link\">Compras</a>\n<a class=\"mx-2 flex h-[32px] items-center px-2.5 text-[13px] text-[#2B2D2F]/75 hover:bg-[#2B2D2F]/6 transition-colors duration-[140ms] cursor-pointer\" data-kid=\"1-2-1-1-5\" data-name=\"cash and shifts navigation link\">Caja y turnos</a>\n<div class=\"my-2.5 mx-2.5 h-px bg-[#2B2D2F]/12\" data-kid=\"1-2-1-1-6\" data-name=\"nav group divider line\"></div>\n<a class=\"mx-2 flex h-[32px] items-center px-2.5 text-[13px] text-[#2B2D2F]/75 hover:bg-[#2B2D2F]/6 transition-colors duration-[140ms] cursor-pointer\" data-kid=\"1-2-1-1-7\" data-name=\"customers navigation link\">Clientes</a>\n<a class=\"mx-2 flex h-[32px] items-center px-2.5 text-[13px] text-[#2B2D2F]/75 hover:bg-[#2B2D2F]/6 transition-colors duration-[140ms] cursor-pointer\" data-kid=\"1-2-1-1-8\" data-name=\"suppliers navigation link\">Proveedores</a>\n<div class=\"my-2.5 mx-2.5 h-px bg-[#2B2D2F]/12\" data-kid=\"1-2-1-1-9\" data-name=\"nav group divider line\"></div>\n<a class=\"mx-2 flex h-[32px] items-center px-2.5 text-[13px] text-[#2B2D2F]/75 hover:bg-[#2B2D2F]/6 transition-colors duration-[140ms] cursor-pointer\" data-kid=\"1-2-1-1-10\" data-name=\"products navigation link\">Productos</a>\n<a class=\"mx-2 flex h-[32px] items-center px-2.5 text-[13px] text-[#2B2D2F]/75 hover:bg-[#2B2D2F]/6 transition-colors duration-[140ms] cursor-pointer\" data-kid=\"1-2-1-1-11\" data-name=\"inventory navigation link\">Inventario</a>\n<div class=\"my-2.5 mx-2.5 h-px bg-[#2B2D2F]/12\" data-kid=\"1-2-1-1-12\" data-name=\"nav group divider line\"></div>\n<a class=\"mx-2 flex h-[32px] items-center px-2.5 text-[13px] text-[#2B2D2F]/75 hover:bg-[#2B2D2F]/6 transition-colors duration-[140ms] cursor-pointer\" data-kid=\"1-2-1-1-13\" data-name=\"accounts receivable navigation link\">Cuentas por cobrar</a>\n<a class=\"mx-2 flex h-[32px] items-center px-2.5 text-[13px] text-[#2B2D2F]/75 hover:bg-[#2B2D2F]/6 transition-colors duration-[140ms] cursor-pointer\" data-kid=\"1-2-1-1-14\" data-name=\"accounts payable navigation link\">Cuentas por pagar</a>\n<div class=\"my-2.5 mx-2.5 h-px bg-[#2B2D2F]/12\" data-kid=\"1-2-1-1-15\" data-name=\"nav group divider line\"></div>\n<a class=\"mx-2 flex h-[32px] items-center px-2.5 text-[13px] text-[#2B2D2F]/75 hover:bg-[#2B2D2F]/6 transition-colors duration-[140ms] cursor-pointer\" data-kid=\"1-2-1-1-16\" data-name=\"reports navigation link\">Reportes</a>\n</nav>\n<div class=\"border-t border-[#2B2D2F]/12 px-2.5 py-3\" data-kid=\"1-2-1-2\" data-name=\"sidebar utility account section\">\n<a class=\"flex h-[28px] items-center px-2.5 text-[12px] text-[#2B2D2F]/70 hover:bg-[#2B2D2F]/6 transition-colors duration-[140ms] cursor-pointer\" data-kid=\"1-2-1-2-1\" data-name=\"settings link\">Ajustes</a>\n<a class=\"flex h-[28px] items-center px-2.5 text-[12px] text-[#2B2D2F]/70 hover:bg-[#2B2D2F]/6 transition-colors duration-[140ms] cursor-pointer\" data-kid=\"1-2-1-2-2\" data-name=\"my account link\">Mi cuenta</a>\n</div>\n</aside>\n<!-- Área de trabajo -->\n<main class=\"flex-1 min-w-0 p-5 fade-in\" data-kid=\"1-2-2\" data-name=\"main dashboard work area\">\n<!-- Título -->\n<div class=\"h-[44px] flex items-end justify-between pb-1\" data-kid=\"1-2-2-1\" data-name=\"page title header row\">\n<h1 class=\"text-[24px] leading-none font-semibold tracking-[-0.01em]\" data-kid=\"1-2-2-1-1\" data-name=\"dashboard page title\">Inicio</h1>\n<span class=\"text-[12px] text-[#2B2D2F]/70 tnum\" data-kid=\"1-2-2-1-2\" data-name=\"current date display\">Sábado, 31 de octubre de 2026</span>\n</div>\n<!-- Filtros -->\n<div class=\"mt-3 h-[36px] flex items-center gap-2\" data-kid=\"1-2-2-2\" data-name=\"period and branch filter bar\">\n<span class=\"text-[13px] text-[#2B2D2F]/70\" data-kid=\"1-2-2-2-1\" data-name=\"period filter label\">Periodo</span>\n<div class=\"h-[36px] flex items-center border border-[#2B2D2F]/25 bg-white px-3 text-[13px] tnum cursor-pointer tr transition-colors duration-[140ms] hover:border-[#2B2D2F]/45\" data-kid=\"1-2-2-2-2\" data-name=\"start date picker\">01/10/2026</div>\n<span class=\"text-[13px] text-[#2B2D2F]/70\" data-kid=\"1-2-2-2-3\" data-name=\"date range to co