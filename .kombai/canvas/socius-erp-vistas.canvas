      "html": "<style>\n  @import url('https://fonts.googleapis.com/css2?family=Titillium+Web:wght@300;400;600;700&family=Domine:wght@600;700&display=swap');\n  @import url('https://cdn.jsdelivr.net/npm/@tabler/icons-webfont@3.48.0/dist/tabler-icons.min.css');\n  .ttw { font-family: 'Titillium Web', ui-sans-serif, system-ui, sans-serif; }\n  @keyframes formIn { from { opacity: 0; } to { opacity: 1; } }\n  .form-in { animation: formIn 150ms ease-out both; }\n  @media (prefers-reduced-motion: reduce) { .form-in { animation: none; } }\n</style>\n<div class=\"ttw h-screen min-h-[720px] w-full bg-[#F3F3EF] text-[#2B2D2F] flex flex-col overflow-hidden antialiased\" data-kid=\"1\" data-name=\"page layout container\">\n<!-- Top bar: marca + vuelta al inicio -->\n<header class=\"shrink-0 h-16 border-b border-[#2B2D2F]/15\" data-kid=\"1-1\" data-name=\"top header bar\">\n<div class=\"h-full max-w-[1192px] mx-auto px-5 flex items-center justify-between\" data-kid=\"1-1-1\" data-name=\"header inner layout bar\">\n<div class=\"flex items-center gap-2.5\" data-kid=\"1-1-1-1\" data-name=\"brand logo group\">\n<span class=\"h-7 w-7 bg-[#2B2D2F] text-[#F3F3EF] text-[15px] font-bold flex items-center justify-center leading-none\" data-kid=\"1-1-1-1-1\" data-name=\"brand logo monogram\">S</span>\n<span class=\"text-[15px] font-semibold\" data-kid=\"1-1-1-1-2\" data-name=\"brand name text\">Socius ERP</span>\n</div>\n<a class=\"text-[13px] text-[#2B2D2F]/70 hover:text-[#2B2D2F] underline underline-offset-[3px] decoration-[#2B2D2F]/30 hover:decoration-[#2B2D2F]/70 transition-colors duration-[140ms]\" data-kid=\"1-1-1-2\" data-name=\"back to home link\" href=\"#\">Volver al inicio</a>\n</div>\n</header>\n<!-- Formulario, 400px, sin panel paralelo -->\n<main class=\"flex-1 flex justify-center items-center overflow-hidden\" data-kid=\"1-2\" data-name=\"main login area\">\n<div class=\"w-[400px] mb-7 form-in\" data-kid=\"1-2-1\" data-name=\"login form card container\">\n<div class=\"pb-5 border-b border-[#2B2D2F]/15\" data-kid=\"1-2-1-1\" data-name=\"form title header section\">\n<h1 class=\"text-[32px] leading-[1.15] font-bold tracking-[-0.01em]\" data-kid=\"1-2-1-1-1\" data-name=\"login headline\">Iniciar sesión</h1>\n</div>\n<form class=\"mt-6 space-y-4\" data-kid=\"1-2-1-2\" data-name=\"login form\">\n<!-- Correo -->\n<div data-kid=\"1-2-1-2-1\" data-name=\"email field group\">\n<label class=\"block text-[13px] font-semibold text-[#2B2D2F]/70 mb-1\" data-kid=\"1-2-1-2-1-1\" data-name=\"email field label\" for=\"correo\">Correo</label>\n<input class=\"w-full h-11 bg-white px-3 text-[14px] text-[#2B2D2F] placeholder:text-[#2B2D2F]/40 border-[1.5px] border-[#2B2D2F] outline-none\" data-kid=\"1-2-1-2-1-2\" data-name=\"email input field\" id=\"correo\" placeholder=\"nombre@negocio.com\" type=\"email\"/>\n</div>\n<!-- Contraseña -->\n<div data-kid=\"1-2-1-2-2\" data-name=\"password field group\">\n<div class=\"flex items-baseline justify-between mb-1\" data-kid=\"1-2-1-2-2-1\" data-name=\"password label and forgot link row\">\n<label class=\"text-[13px] font-semibold text-[#2B2D2F]/70\" data-kid=\"1-2-1-2-2-1-1\" data-name=\"password field label\" for=\"password\">Contraseña</label>\n<a class=\"text-[13px] text-[#2B2D2F]/70 hover:text-[#2B2D2F] underline underline-offset-[3px] decoration-[#2B2D2F]/30 hover:decoration-[#2B2D2F]/70 transition-colors duration-[140ms]\" data-kid=\"1-2-1-2-2-1-2\" data-name=\"forgot password link\" href=\"#\">¿Olvidaste tu contraseña?</a>\n</div>\n<div class=\"relative\" data-kid=\"1-2-1-2-2-2\" data-name=\"password input wrapper\">\n<input class=\"w-full h-11 bg-white px-3 pr-11 text-[14px] text-[#2B2D2F] placeholder:text-[#2B2D2F]/35 border border-[#2B2D2F]/25 focus:border-[1.5px] focus:border-[#2B2D2F] outline-none transition-colors duration-[140ms]\" data-kid=\"1-2-1-2-2-2-1\" data-name=\"password input field\" id=\"password\" placeholder=\"••••••••\" type=\"password\"/>\n<button aria-label=\"Mostrar contraseña\" class=\"absolute right-0 top-0 h-11 w-11 flex items-center justify-center text-[18px] text-[#2B2D2F]/45 hover:text-[#2B2D2F]/80 transition-colors duration-[140ms]\" data-kid=\"1-2-1-2-2-2-2\" data-name=\"show password toggle button\" type=\"button\">\n<i class=\"ti ti-eye\" data-kid=\"1-2-1-2-2-2-2-1\" data-name=\"eye icon\"></i>\n</button>\n</div>\n</div>\n</form>\n<!-- Acción primaria -->\n<button class=\"mt-6 h-12 w-full bg-[#E65F2B] text-black text-[15px] font-semibold tracking-[0.03em] hover:bg-[#D2541F] transition-colors duration-[140ms]\" data-kid=\"1-2-1-3\" data-name=\"primary login submit button\" type=\"button\">\n        Acceder\n      </button>\n<p class=\"mt-5 text-[13px] text-[#2B2D2F]/70\" data-kid=\"1-2-1-4\" data-name=\"create account prompt text\">\n        ¿No tienes una cuenta?\n        <a class=\"text-[#2B2D2F] font-semibold underline underline-offset-[3px] decoration-[#2B2D2F]/40 hover:decoration-[#2B2D2F]/80 transition-colors duration-[140ms]\" data-kid=\"1-2-1-4-1\" data-name=\"create account link\" href=\"#\">Crear cuenta</a>\n</p>\n<div class=\"mt-6 border-t border-[#2B2D2F]/15 pt-4\" data-kid=\"1-2-1-5\" data-name=\"terms and privacy section\">\n<p class=\"text-[12px] leading-[1.6] text-[#2B2D2F]/65\" data-kid=\"1-2-1-5-1\" data-name=\"legal acceptance text\">\n          Al acceder, aceptas los\n          <a class=\"underline underline-offset-[3px] decoration-[#2B2D2F]/40 hover:decoration-[#2B2D2F]/80 text-[#2B2D2F]/85 transition-colors duration-[140ms]\" data-kid=\"1-2-1-5-1-1\" data-name=\"terms and conditions link\" href=\"#\">Términos y condiciones</a>\n          y el\n          <a class=\"underline underline-offset-[3px] decoration-[#2B2D2F]/40 hover:decoration-[#2B2D2F]/80 text-[#2B2D2F]/85 transition-colors duration-[140ms]\" data-kid=\"1-2-1-5-1-2\" data-name=\"privacy notice link\" href=\"#\">Aviso de privacidad</a>.\n        </p>\n</div>\n</div>\n</main>\n<!-- Pie -->\n<footer class=\"shrink-0 h-14 border-t border-[#2B2D2F]/15\" data-kid=\"1-3\" data-name=\"footer bar\">\n<div class=\"h-full max-w-[1192px] mx-auto px-5 flex items-center\" data-kid=\"1-3-1\" data-name=\"footer inner layout bar\">\n<p class=\"text-[12px] text-[#2B2D2F]/55\" data-kid=\"1-3-1-1\" data-name=\"footer copyright text\">© 2026 Socius ERP</p>\n</div>\n</footer>\n</div>",
