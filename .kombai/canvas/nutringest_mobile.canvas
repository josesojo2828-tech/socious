      "html": "<style>\n    @import url('https://fonts.googleapis.com/css2?family=Montserrat:wght@400;500;600;700;800&display=swap');\n  @import url('https://cdn.jsdelivr.net/npm/@tabler/icons-webfont@3.48.0/dist/tabler-icons.min.css');\n</style>\n<div class=\"min-h-screen bg-[#f6f7f9] font-[Montserrat,sans-serif] text-[#111827] flex flex-col\" data-kid=\"1\" data-name=\"patient detail screen container\">\n    <!-- ===== Back header ===== -->\n    <header class=\"sticky top-0 z-20 bg-[#f6f7f9]/90 backdrop-blur border-b border-[#e5e7eb]\" data-kid=\"1-1\" data-name=\"sticky header\">\n        <div class=\"flex items-center gap-3 px-4 h-14\" data-kid=\"1-1-1\" data-name=\"header layout container\">\n            <button class=\"w-9 h-9 -ml-1 rounded-full grid place-items-center text-[#111827] active:bg-[#eceef2]\" data-kid=\"1-1-1-1\" data-name=\"back button\">\n                <i class=\"ti ti-arrow-left text-lg\" data-kid=\"1-1-1-1-1\" data-name=\"left arrow icon\">\n                </i>\n            </button>\n            <div class=\"flex-1 min-w-0\" data-kid=\"1-1-1-2\" data-name=\"header title and subtitle container\">\n                <h1 class=\"text-[15px] font-bold leading-tight truncate\" data-kid=\"1-1-1-2-1\" data-name=\"header main title\">\n                    Ficha del paciente\n                </h1>\n                <p class=\"text-[11px] text-[#6b7280] leading-tight\" data-kid=\"1-1-1-2-2\" data-name=\"header subtitle\">\n                    Pacientes · Lucía Fernández\n                </p>\n            </div>\n            <button class=\"w-9 h-9 rounded-full grid place-items-center text-[#6b7280] active:bg-[#eceef2]\" data-kid=\"1-1-1-3\" data-name=\"options menu button\">\n                <i class=\"ti ti-dots text-lg\" data-kid=\"1-1-1-3-1\" data-name=\"dots menu icon\">\n                </i>\n            </button>\n        </div>\n    </header>\n    <main class=\"flex-1 overflow-y-auto pb-24\" data-kid=\"1-2\" data-name=\"main scrollable content area\">\n        <!-- ===== Compact patient identity ===== -->\n        <section class=\"px-4 pt-4\" data-kid=\"1-2-1\" data-name=\"patient identity section\">\n            <div class=\"bg-white rounded-2xl border border-[#e5e7eb] p-4 flex items-center gap-3\" data-kid=\"1-2-1-1\" data-name=\"patient identity card\">\n                <img alt=\"Foto de Lucía Fernández\" class=\"w-14 h-14 rounded-full object-cover ring-2 ring-[#ede9fe]\" data-kid=\"1-2-1-1-1\" data-name=\"patient profile image\" decoding=\"async\" loading=\"lazy\" src=\"https://i.pravatar.cc/96?u=luciafernandez\"/>\n                <div class=\"flex-1 min-w-0\" data-kid=\"1-2-1-1-2\" data-name=\"patient info container\">\n                    <h2 class=\"text-[17px] font-bold leading-tight truncate\" data-kid=\"1-2-1-1-2-1\" data-name=\"patient name title\">\n                        Lucía Fernández\n                    </h2>\n                    <div class=\"flex items-center gap-2 mt-1 text-[12px] text-[#6b7280]\" data-kid=\"1-2-1-1-2-2\" data-name=\"patient identity row\">\n                        <span class=\"inline-flex items-center gap-1\" data-kid=\"1-2-1-1-2-2-1\" data-name=\"national id container\">\n                            <i class=\"ti ti-id-badge-2 text-[13px]\" data-kid=\"1-2-1-1-2-2-1-1\" data-name=\"id badge icon\">\n                            </i>\n                            DNI 32.845.109\n                        </span>\n                        <span class=\"w-1 h-1 rounded-full bg-[#d1d5db]\" data-kid=\"1-2-1-1-2-2-2\" data-name=\"dot separator\">\n                        </span>\n                        <span data-kid=\"1-2-1-1-2-2-3\" data-name=\"patient age text\">\n                            34 años\n                        </span>\n                    </div>\n                    <p class=\"text-[11px] text-[#6b7280] mt-1 inline-flex items-center gap-1\" data-kid=\"1-2-1-1-2-3\" data-name=\"last visit date text\">\n                        <i class=\"ti ti-calendar-event text-[13px]\" data-kid=\"1-2-1-1-2-3-1\" data-name=\"calendar icon\">\n                        </i>\n                        Última consulta: 12 sep 2026\n                    </p>\n                </div>\n                <button aria-label=\"WhatsApp\" class=\"shrink-0 w-11 h-11 rounded-full bg-[#e0f2fe] text-[#0284c7] grid place-items-center active:scale-95 transition-transform\" data-kid=\"1-2-1-1-3\" data-name=\"whatsapp contact button\">\n                    <i class=\"ti ti-brand-whatsapp text-2xl\" data-kid=\"1-2-1-1-3-1\" data-name=\"whatsapp brand icon\">\n                    </i>\n                </button>\n            </div>\n        </section>\n        <!-- ===== Segmented tabs ===== -->\n        <nav class=\"px-4 mt-4\" data-kid=\"1-2-2\" data-name=\"segmented tabs navigation\">\n            <div class=\"grid grid-cols-3 gap-1 bg-[#eceef2] p-1 rounded-xl\" data-kid=\"1-2-2-1\" data-name=\"tabs container\" role=\"tablist\">\n                <button aria-selected=\"true\" class=\"h-10 px-1 rounded-lg text-[11.5px] font-semibold whitespace-nowrap bg-[#5b21b6] text-white shadow-sm\" data-kid=\"1-2-2-1-1\" data-name=\"active tab button\" role=\"tab\">\n                    Datos y objetivos\n                </button>\n                <button aria-selected=\"false\" class=\"h-10 px-1 rounded-lg text-[11.5px] font-semibold whitespace-nowrap text-[#4b5563]\" data-kid=\"1-2-2-1-2\" data-name=\"inactive tab button\" role=\"tab\">\n                    Consultas\n                </button>\n                <button aria-selected=\"false\" class=\"h-10 px-1 rounded-lg text-[11.5px] font-semibold whitespace-nowrap text-[#4b5563]\" data-kid=\"1-2-2-1-3\" data-name=\"inactive tab button\" role=\"tab\">\n                    Plan actual\n                </button>\n            </div>\n        </nav>\n        <!-- ===== Tab: Datos y objetivos ===== -->\n        <div class=\"px-4 mt-4 space-y-4\" data-kid=\"1-2-3\" data-name=\"tab content area\">\n            <!-- Antropometría actual + contextual actions -->\n            <section data-kid=\"1-2-3-1\" data-name=\"anthropometry section\">\n                <div class=\"flex items-baseline justify-between px-1 mb-2\" data-kid=\"1-2-3-1-1\" data-name=\"section header container\">\n                    <h3 class=\"text-[13px] font-bold tracking-wide text-[#374151]\" data-kid=\"1-2-3-1-1-1\" data-name=\"section header title\">\n                        Antropometría actual\n                    </h3>\n                    <span class=\"text-[11px] text-[#6b7280]\" data-kid=\"1-2-3-1-1-2\" data-name=\"section header date\">\n                        12 sep 2026\n                    </span>\n                </div>\n                <div class=\"bg-white rounded-2xl border border-[#e5e7eb] overflow-hidden\" data-kid=\"1-2-3-1-2\" data-name=\"measurements card container\">\n                    <div class=\"grid grid-cols-4 divide-x divide-[#e5e7eb]\" data-kid=\"1-2-3-1-2-1\" data-name=\"measurements grid\">\n                        <div class=\"px-2 py-3 text-center\" data-kid=\"1-2-3-1-2-1-1\" data-name=\"weight measurement column\">\n                            <p class=\"text-[18px] font-bold leading-none\" data-kid=\"1-2-3-1-2-1-1-1\" data-name=\"weight value\">\n                                68,4\n                                <span class=\"text-[11px] font-semibold text-[#6b7280]\" data-kid=\"1-2-3-1-2-1-1-1-1\" data-name=\"weight unit\">\n                                    kg\n                                </span>\n                            </p>\n                            <p class=\"text-[10.5px] text-[#6b7280] mt-1\" data-kid=\"1-2-3-1-2-1-1-2\" data-name=\"weight label\">\n                                Peso\n                            </p>\n                        </div>\n                        <div class=\"px-2 py-3 text-center\" data-kid=\"1-2-3-1-2-1-2\" data-name=\"body fat measurement column\">\n                            <p class=\"text-[18px] font-bold leading-none text-[#5b21b6]\" data-kid=\"1-2-3-1-2-1-2-1\" data-name=\"body fat value\">\n                                24,1\n                                <span class=\"text-[11px] font-semibold text-[#6b7280]\" data-kid=\"1-2-3-1-2-1-2-1-1\" data-name=\"body fat unit\">\n                                    %\n                                </span>\n                            </p>\n                            <p class=\"text-[10.5px] text-[#6b7280] mt-1\" data-kid=\"1-2-3-1-2-1-2-2\" data-name=\"body fat label\">\n                                Grasa\n                            </p>\n                        </div>\n                        <div class=\"px-2 py-3 text-center\" data-kid=\"1-2-3-1-2-1-3\" data-name=\"muscle mass measurement column\">\n                            <p class=\"text-[18px] font-bold leading-none text-[#7c3aed]\" data-kid=\"1-2-3-1-2-1-3-1\" data-name=\"muscle mass value\">\n                                38,7\n                                <span class=\"text-[11px] font-semibold text-[#6b7280]\" data-kid=\"1-2-3-1-2-1-3-1-1\" data-name=\"muscle mass unit\">\n                                    %\n                                </span>\n                            </p>\n                            <p class=\"text-[10.5px] text-[#6b7280] mt-1\" data-kid=\"1-2-3-1-2-1-3-2\" data-name=\"muscle mass label\">\n                                Músculo\n                            </p>\n                        </div>\n                        <div class=\"px-2 py-3 text-center\" data-kid=\"1-2-3-1-2-1-4\" data-name=\"folds measurement column\">\n                            <p class=\"text-[18px] font-bold leading-none\" data-kid=\"1-2-3-1-2-1-4-1\" data-name=\"folds value\">\n                                82,5\n                                <span class=\"text-[11px] font-semibold text-[#6b7280]\" data-kid=\"1-2-3-1-2-1-4-1-1\" data-name=\"folds unit\">\n                                    mm\n                                </span>\n                            </p>\n                            <p class=\"text-[10.5px] text-[#6b7280] mt-1\" data-kid=\"1-2-3-1-2-1-4-2\" data-name=\"folds label\">\n                                Σ 6 pliegues\n                            </p>\n                        </div>\n                    </div>\n                    <div class=\"grid grid-cols-2 gap-2 p-3 border-t border-[#e5e7eb] bg-[#fafafc]\" data-kid=\"1-2-3-1-2-2\" data-name=\"measurements actions container\">\n                        <button class=\"h-11 rounded-xl bg-[#5b21b6] text-white text-[13px] font-semibold inline-flex items-center justify-center gap-2 active:scale-[0.98] transition-transform\" data-kid=\"1-2-3-1-2-2-1\" data-name=\"register measurements button\">\n                            <i class=\"ti ti-ruler-measure text-base\" data-kid=\"1-2-3-1-2-2-1-1\" data-name=\"ruler icon\">\n                            </i>\n                            Registrar medidas\n                        </button>\n                        <button class=\"h-11 rounded-xl bg-white border border-[#d8d5e6] text-[#5b21b6] text-[13px] font-semibold inline-flex items-center justify-center gap-2 active:scale-[0.98] transition-transform\" data-kid=\"1-2-3-1-2-2-2\" data-name=\"view evolution button\">\n                            <i class=\"ti ti-chart-line text-base\" data-kid=\"1-2-3-1-2-2-2-1\" data-name=\"chart icon\">\n                            </i>\n                            Ver evolución\n                        </button>\n                    </div>\n                </div>\n            </section>\n            <!-- Objetivos -->\n            <section data-kid=\"1-2-3-2\" data-name=\"goals section\">\n                <h3 class=\"text-[13px] font-bold tracking-wide text-[#374151] px-1 mb-2\" data-kid=\"1-2-3-2-1\" data-name=\"goals section title\">\n                    Objetivos\n                </h3>\n                <div class=\"bg-white rounded-2xl border border-[#e5e7eb] divide-y divide-[#e5e7eb]\" data-kid=\"1-2-3-2-2\" data-name=\"goals list container\">\n                    <div class=\"flex items-center gap-3 px-4 py-3\" data-kid=\"1-2-3-2-2-1\" data-name=\"weight goal row\">\n                        <span class=\"w-8 h-8 rounded-lg bg-[#ede9fe] text-[#5b21b6] grid place-items-center\" data-kid=\"1-2-3-2-2-1-1\" data-name=\"weight icon container\">\n                            <i class=\"ti ti-target text-[17px]\" data-kid=\"1-2-3-2-2-1-1-1\" data-name=\"target icon\">\n                            </i>\n                        </span>\n                        <div class=\"flex-1\" data-kid=\"1-2-3-2-2-1-2\" data-name=\"weight goal text container\">\n                            <p class=\"text-[13px] text-[#6b7280]\" data-kid=\"1-2-3-2-2-1-2-1\" data-name=\"weight goal title\">\n                                Peso objetivo\n                            </p>\n                            <p class=\"text-[11px] text-[#9ca3af]\" data-kid=\"1-2-3-2-2-1-2-2\" data-name=\"weight goal status\">\n                                Actual 68,4 kg · faltan 3,4 kg\n                            </p>\n                        </div>\n                        <p class=\"text-[15px] font-bold\" data-kid=\"1-2-3-2-2-1-3\" data-name=\"weight goal value\">\n                            65,0\n                            <span class=\"text-[11px] font-semibold text-[#6b7280]\" data-kid=\"1-2-3-2-2-1-3-1\" data-name=\"weight goal unit\">\n                                kg\n                            </span>\n                        </p>\n                    </div>\n                    <div class=\"flex items-center gap-3 px-4 py-3\" data-kid=\"1-2-3-2-2-2\" data-name=\"body fat goal row\">\n                        <span class=\"w-8 h-8 rounded-lg bg-[#ede9fe] text-[#5b21b6] grid place-items-center\" data-kid=\"1-2-3-2-2-2-1\" data-name=\"body fat icon container\">\n                            <i class=\"ti ti-droplet-half-2 text-[17px]\" data-kid=\"1-2-3-2-2-2-1-1\" data-name=\"droplet icon\">\n                            </i>\n                        </span>\n                        <div class=\"flex-1\" data-kid=\"1-2-3-2-2-2-2\" data-name=\"body fat goal text container\">\n                            <p class=\"text-[13px] text-[#6b7280]\" data-kid=\"1-2-3-2-2-2-2-1\" data-name=\"body fat goal title\">\n                                % grasa objetivo\n                            </p>\n                            <p class=\"text-[11px] text-[#9ca3af]\" data-kid=\"1-2-3-2-2-2-2-2\" data-name=\"body fat goal status\">\n                                Actual 24,1%\n                            </p>\n                        </div>\n                        <p class=\"text-[15px] font-bold\" data-kid=\"1-2-3-2-2-2-3\" data-name=\"body fat goal value\">\n                            20,0\n                            <span class=\"text-[11px] font-semibold text-[#6b7280]\" data-kid=\"1-2-3-2-2-2-3-1\" data-name=\"body fat goal unit\">\n                                %\n                            </span>\n                        </p>\n                    </div>\n                    <div class=\"flex items-center gap-3 px-4 py-3\" data-kid=\"1-2-3-2-2-3\" data-name=\"motivation goal row\">\n                        <span class=\"w-8 h-8 rounded-lg bg-[#ede9fe] text-[#5b21b6] grid place-items-center\" data-kid=\"1-2-3-2-2-3-1\" data-name=\"motivation icon container\">\n                            <i class=\"ti ti-flag text-[17px]\" data-kid=\"1-2-3-2-2-3-1-1\" data-name=\"flag icon\">\n                            </i>\n                        </span>\n                        <div class=\"flex-1\" data-kid=\"1-2-3-2-2-3-2\" data-name=\"motivation goal text container\">\n                            <p class=\"text-[13px] text-[#6b7280]\" data-kid=\"1-2-3-2-2-3-2-1\" data-name=\"motivation goal title\">\n                                Motivo de consulta\n                            </p>\n                        </div>\n                        <p class=\"text-[13px] font-semibold text-[#374151]\" data-kid=\"1-2-3-2-2-3-3\" data-name=\"motivation goal value\">\n                            Recomposición\n                        </p>\n                    </div>\n                </div>\n            </section>\n            <!-- Datos personales -->\n            <section data-kid=\"1-2-3-3\" data-name=\"personal data section\">\n                <div class=\"flex items-baseline justify-between px-1 mb-2\" data-kid=\"1-2-3-3-1\" data-name=\"personal data header\">\n                    <h3 class=\"text-[13px] font-bold tracking-wide text-[#374151]\" data-kid=\"1-2-3-3-1-1\" data-name=\"personal data title\">\n                        Datos personales\n                    </h3>\n                    <button class=\"text-[12px] font-semibold text-[#5b21b6] inline-flex items-center gap-1\" data-kid=\"1-2-3-3-1-2\" data-name=\"edit button\">\n                        <i class=\"ti ti-pencil text-[13px]\" data-kid=\"1-2-3-3-1-2-1\" data-name=\"pencil icon\">\n                        </i>\n                        Editar\n                    </button>\n                </div>\n                <div class=\"bg-white rounded-2xl border border-[#e5e7eb] divide-y divide-[#e5e7eb]\" data-kid=\"1-2-3-3-2\" data-name=\"personal data list\">\n                    <div class=\"flex items-center justify-between px-4 py-2.5\" data-kid=\"1-2-3-3-2-1\" data-name=\"date of birth row\">\n                        <span class=\"text-[13px] text-[#6b7280]\" data-kid=\"1-2-3-3-2-1-1\" data-name=\"date of birth label\">\n                            Fecha de nacimiento\n                        </span>\n                        <span class=\"text-[13px] font-semibold text-[#374151]\" data-kid=\"1-2-3-3-2-1-2\" data-name=\"date of birth value\">\n                            14/03/1992\n                        </span>\n                    </div>\n                    <div class=\"flex items-center justify-between px-4 py-2.5\" data-kid=\"1-2-3-3-2-2\" data-name=\"phone number row\">\n                        <span class=\"text-[13px] text-[#6b7280]\" data-kid=\"1-2-3-3-2-2-1\" data-name=\"phone number label\">\n                            Teléfono\n                        </span>\n                        <span class=\"text-[13px] font-semibold text-[#374151]\" data-kid=\"1-2-3-3-2-2-2\" data-name=\"phone number value\">\n                            +54 11 5523-8890\n                        </span>\n                    </div>\n                    <div class=\"flex items-center justify-between px-4 py-2.5\" data-kid=\"1-2-3-3-2-3\" data-name=\"email row\">\n                        <span class=\"text-[13px] text-[#6b7280]\" data-kid=\"1-2-3-3-2-3-1\" data-name=\"email label\">\n                            Email\n                        </span>\n                        <span class=\"text-[13px] font-semibold text-[#374151] truncate max-w-[190px]\" data-kid=\"1-2-3-3-2-3-2\" data-name=\"email value\">\n                            lucia.fdz@gmail.com\n                        </span>\n                    </div>\n                    <div class=\"flex items-center justify-between px-4 py-2.5\" data-kid=\"1-2-3-3-2-4\" data-name=\"height row\">\n                        <span class=\"text-[13px] text-[#6b7280]\" data-kid=\"1-2-3-3-2-4-1\" data-name=\"height label\">\n                            Altura\n                        </span>\n                        <span class=\"text-[13px] font-semibold text-[#374151]\" data-kid=\"1-2-3-3-2-4-2\" data-name=\"height value\">\n                            1,68 m\n                        </span>\n                    </div>\n                    <div class=\"flex items-center justify-between px-4 py-2.5\" data-kid=\"1-2-3-3-2-5\" data-name=\"activity level row\">\n                        <span class=\"text-[13px] text-[#6b7280]\" data-kid=\"1-2-3-3-2-5-1\" data-name=\"activity level label\">\n                            Nivel de actividad\n                        </span>\n                        <span class=\"text-[13px] font-semibold text-[#374151]\" data-kid=\"1-2-3-3-2-5-2\" data-name=\"activity level value\">\n                            Moderado\n                        </span>\n                    </div>\n                </div>\n            </section>\n            <!-- Notes -->\n            <section class=\"pb-2\" data-kid=\"1-2-3-4\" data-name=\"notes section\">\n                <h3 class=\"text-[13px] font-bold tracking-wide text-[#374151] px-1 mb-2\" data-kid=\"1-2-3-4-1\" data-name=\"notes title\">\n                    Notas\n                </h3>\n                <div class=\"bg-white rounded-2xl border border-[#e5e7eb] p-4\" data-kid=\"1-2-3-4-2\" data-name=\"notes card\">\n                    <p class=\"text-[13px] leading-relaxed text-[#4b5563]\" data-kid=\"1-2-3-4-2-1\" data-name=\"notes text\">\n                        Paciente con buena adherencia. Refiere mejor energía por la tarde. Se ajustará plan en la próxima consulta para alcanzar el objetivo de grasa.\n                    </p>\n                </div>\n            </section>\n        </div>\n    </main>\n    <!-- ===== Bottom tab bar ===== -->\n    <nav class=\"fixed bottom-0 inset-x-0 bg-white border-t border-[#e5e7eb] px-2 pt-2 pb-3\" data-kid=\"1-3\" data-name=\"navigation bar\">\n        <div class=\"grid grid-cols-4\" data-kid=\"1-3-1\" data-name=\"nav items container\">\n            <a class=\"flex flex-col items-center gap-1 text-[#5b21b6]\" data-kid=\"1-3-1-1\" data-name=\"patients nav link\">\n                <i class=\"ti ti-users text-[22px]\" data-kid=\"1-3-1-1-1\" data-name=\"patients icon\">\n                </i>\n                <span class=\"text-[10.5px] font-semibold\" data-kid=\"1-3-1-1-2\" data-name=\"patients label\">\n                    Pacientes\n                </span>\n            </a>\n            <a class=\"flex flex-col items-center gap-1 text-[#9ca3af]\" data-kid=\"1-3-1-2\" data-name=\"plans nav link\">\n                <i class=\"ti ti-salad text-[22px]\" data-kid=\"1-3-1-2-1\" data-name=\"plans icon\">\n                </i>\n                <span class=\"text-[10.5px] font-medium\" data-kid=\"1-3-1-2-2\" data-name=\"plans label\">\n                    Planes\n                </span>\n            </a>\n            <a class=\"flex flex-col items-center gap-1 text-[#9ca3af]\" data-kid=\"1-3-1-3\" data-name=\"tools nav link\">\n                <i class=\"ti ti-calculator text-[22px]\" data-kid=\"1-3-1-3-1\" data-name=\"calculator icon\">\n                </i>\n                <span class=\"text-[10.5px] font-medium\" data-kid=\"1-3-1-3-2\" data-name=\"tools label\">\n                    Herramientas\n                </span>\n            </a>\n            <a class=\"flex flex-col items-center gap-1 text-[#9ca3af]\" data-kid=\"1-3-1-4\" data-name=\"profile nav link\">\n                <i class=\"ti ti-user-circle text-[22px]\" data-kid=\"1-3-1-4-1\" data-name=\"profile icon\">\n                </i>\n                <span class=\"text-[10.5px] font-medium\" data-kid=\"1-3-1-4-2\" data-name=\"profile label\">\n                    Perfil\n                </span>\n            </a>\n        </div>\n    </nav>\n</div>\n",
