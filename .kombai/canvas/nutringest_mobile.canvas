      "html": "<div class=\"h-[812px] w-full flex flex-col overflow-hidden bg-[#f6f7f9] font-[Montserrat] text-[#111827] antialiased\" data-kid=\"1\" data-name=\"clinical record layout container\">\n    <style>\n        @import url('https://fonts.googleapis.com/css2?family=Montserrat:wght@400;500;600;700;800&display=swap');\n    @import url('https://cdn.jsdelivr.net/npm/@tabler/icons-webfont@3.48.0/dist/tabler-icons.min.css');\n    .ng-scroll::-webkit-scrollbar { width: 0; height: 0; }\n    </style>\n    <!-- Status bar -->\n    <div class=\"shrink-0 flex items-center justify-between px-5 pt-3 pb-1 text-[12px] font-semibold text-[#2b0c4f]\" data-kid=\"1-1\" data-name=\"status bar\">\n        <span data-dynamic=\"true\" data-kid=\"1-1-1\" data-name=\"current time text\" data-reason=\"text replaced every minute by clock script\">\n            09:41\n        </span>\n        <div class=\"flex items-center gap-1.5 text-[15px]\" data-kid=\"1-1-2\" data-name=\"device status icon container\">\n            <i class=\"ti ti-wifi\" data-kid=\"1-1-2-1\" data-name=\"wifi signal icon\">\n            </i>\n            <i class=\"ti ti-battery-3\" data-kid=\"1-1-2-2\" data-name=\"battery level icon\">\n            </i>\n        </div>\n    </div>\n    <!-- App bar -->\n    <div class=\"shrink-0 flex items-center gap-3 px-4 py-2\" data-kid=\"1-2\" data-name=\"app bar\">\n        <button class=\"h-9 w-9 rounded-full bg-white border border-[#e5e7eb] grid place-items-center text-[#2b0c4f]\" data-kid=\"1-2-1\" data-name=\"back navigation button\">\n            <i class=\"ti ti-arrow-left text-[18px]\" data-kid=\"1-2-1-1\" data-name=\"left arrow icon\">\n            </i>\n        </button>\n        <div class=\"min-w-0\" data-kid=\"1-2-2\" data-name=\"patient information summary container\">\n            <p class=\"text-[15px] font-bold leading-tight text-[#2b0c4f]\" data-kid=\"1-2-2-1\" data-name=\"patient name title\">\n                Anamnesis\n            </p>\n            <p class=\"text-[11.5px] text-[#6b7280] leading-tight truncate\" data-kid=\"1-2-2-2\" data-name=\"patient demographic metadata\">\n                Lucía Fernández · 34 años · F\n            </p>\n        </div>\n        <button class=\"ml-auto h-9 w-9 rounded-full bg-white border border-[#e5e7eb] grid place-items-center text-[#6b7280]\" data-kid=\"1-2-3\" data-name=\"more options button\">\n            <i class=\"ti ti-dots text-[18px]\" data-kid=\"1-2-3-1\" data-name=\"three dots menu icon\">\n            </i>\n        </button>\n    </div>\n    <!-- Progress -->\n    <div class=\"shrink-0 px-4 pb-3\" data-kid=\"1-3\" data-name=\"progress summary section\">\n        <div class=\"flex items-center justify-between mb-1.5\" data-kid=\"1-3-1\" data-name=\"progress label and percentage container\">\n            <p class=\"text-[11.5px] font-semibold text-[#6b7280]\" data-kid=\"1-3-1-1\" data-name=\"clinical completion status label\">\n                Ficha clínica · 2 de 3 secciones completadas\n            </p>\n            <p class=\"text-[11.5px] font-bold text-[#5b21b6]\" data-dynamic=\"true\" data-kid=\"1-3-1-2\" data-name=\"completion percentage text\" data-reason=\"text updated based on form completion state\">\n                67%\n            </p>\n        </div>\n        <div class=\"flex gap-1.5\" data-kid=\"1-3-2\" data-name=\"progress bar visual container\">\n            <div class=\"h-1.5 flex-1 rounded-full bg-[#5b21b6]\" data-kid=\"1-3-2-1\" data-name=\"completed progress segment\">\n            </div>\n            <div class=\"h-1.5 flex-1 rounded-full bg-[#7c3aed]\" data-kid=\"1-3-2-2\" data-name=\"active progress segment\">\n            </div>\n            <div class=\"h-1.5 flex-1 rounded-full bg-[#e5e7eb]\" data-kid=\"1-3-2-3\" data-name=\"remaining progress segment\">\n            </div>\n        </div>\n    </div>\n    <!-- Scroll area -->\n    <div class=\"ng-scroll flex-1 overflow-y-auto px-4 pb-5\" data-kid=\"1-4\" data-name=\"clinical data scroll area\">\n        <!-- Antecedentes patológicos -->\n        <section class=\"pt-1\" data-kid=\"1-4-1\" data-name=\"pathological history section\">\n            <div class=\"flex items-baseline justify-between mb-2\" data-kid=\"1-4-1-1\" data-name=\"section header and status container\">\n                <h2 class=\"text-[13.5px] font-bold text-[#2b0c4f]\" data-kid=\"1-4-1-1-1\" data-name=\"section title\">\n                    Antecedentes patológicos\n                </h2>\n                <span class=\"text-[11.5px] font-semibold text-[#5b21b6]\" data-kid=\"1-4-1-1-2\" data-name=\"section status label\">\n                    2 refiere\n                </span>\n            </div>\n            <div class=\"grid grid-cols-3 gap-1 rounded-xl bg-[#eceef2] p-1 mb-1\" data-kid=\"1-4-1-2\" data-name=\"status selection toggle container\">\n                <button class=\"h-8 rounded-lg text-[11px] font-semibold text-[#6b7280]\" data-kid=\"1-4-1-2-1\" data-name=\"not asked button\">\n                    No preguntado\n                </button>\n                <button class=\"h-8 rounded-lg text-[11px] font-semibold text-[#6b7280]\" data-kid=\"1-4-1-2-2\" data-name=\"denies button\">\n                    Niega\n                </button>\n                <button class=\"h-8 rounded-lg text-[11px] font-semibold bg-[#5b21b6] text-white shadow-sm\" data-kid=\"1-4-1-2-3\" data-name=\"refers button\">\n                    Refiere\n                </button>\n            </div>\n            <p class=\"text-[11px] text-[#9ca3af] mb-2.5\" data-kid=\"1-4-1-3\" data-name=\"helper text notice\">\n                Sin respuesta no es lo mismo que «niega». Se guarda el estado tal como lo registrás.\n            </p>\n            <div class=\"flex flex-wrap gap-2\" data-kid=\"1-4-1-4\" data-name=\"selected condition tags container\">\n                <button class=\"h-9 px-3 rounded-full text-[12px] font-semibold bg-[#5b21b6] text-white flex items-center gap-1.5\" data-kid=\"1-4-1-4-1\" data-name=\"hypertension tag\">\n                    <i class=\"ti ti-check text-[14px]\" data-kid=\"1-4-1-4-1-1\" data-name=\"check mark icon\">\n                    </i>\n                    Hipertensión\n                </button>\n                <button class=\"h-9 px-3 rounded-full text-[12px] font-semibold bg-[#5b21b6] text-white flex items-center gap-1.5\" data-kid=\"1-4-1-4-2\" data-name=\"dyslipidemia tag\">\n                    <i class=\"ti ti-check text-[14px]\" data-kid=\"1-4-1-4-2-1\" data-name=\"check mark icon\">\n                    </i>\n                    Dislipemia\n                </button>\n                <button class=\"h-9 px-3 rounded-full text-[12px] font-semibold bg-white text-[#374151] border border-[#e5e7eb]\" data-kid=\"1-4-1-4-3\" data-name=\"type 2 diabetes tag\">\n                    Diabetes tipo 2\n                </button>\n                <button class=\"h-9 px-3 rounded-full text-[12px] font-semibold bg-white text-[#374151] border border-[#e5e7eb]\" data-kid=\"1-4-1-4-4\" data-name=\"hypothyroidism tag\">\n                    Hipotiroidismo\n                </button>\n                <button class=\"h-9 px-3 rounded-full text-[12px] font-semibold bg-white text-[#374151] border border-[#e5e7eb]\" data-kid=\"1-4-1-4-5\" data-name=\"celiac disease tag\">\n                    Celiaquía\n                </button>\n                <button class=\"h-9 px-3 rounded-full text-[12px] font-semibold bg-white text-[#374151] border border-[#e5e7eb]\" data-kid=\"1-4-1-4-6\" data-name=\"anemia tag\">\n                    Anemia\n                </button>\n                <button class=\"h-9 px-3 rounded-full text-[12px] font-semibold text-[#5b21b6] border border-dashed border-[#c4b5fd] flex items-center gap-1.5\" data-kid=\"1-4-1-4-7\" data-name=\"add other tag button\">\n                    <i class=\"ti ti-plus text-[14px]\" data-kid=\"1-4-1-4-7-1\" data-name=\"plus icon\">\n                    </i>\n                    Otro\n                </button>\n            </div>\n        </section>\n        <!-- Síntomas digestivos -->\n        <section class=\"mt-6 pt-5 border-t border-[#e5e7eb]\" data-kid=\"1-4-2\" data-name=\"digestive symptoms section\">\n            <div class=\"flex items-baseline justify-between mb-2\" data-kid=\"1-4-2-1\" data-name=\"section header and status container\">\n                <h2 class=\"text-[13.5px] font-bold text-[#2b0c4f]\" data-kid=\"1-4-2-1-1\" data-name=\"section title\">\n                    Síntomas digestivos\n                </h2>\n                <span class=\"text-[11.5px] font-semibold text-[#9ca3af]\" data-kid=\"1-4-2-1-2\" data-name=\"section status label\">\n                    Sin registrar\n                </span>\n            </div>\n            <div class=\"grid grid-cols-3 gap-1 rounded-xl bg-[#eceef2] p-1 mb-2\" data-kid=\"1-4-2-2\" data-name=\"status selection toggle container\">\n                <button class=\"h-8 rounded-lg text-[11px] font-semibold bg-white text-[#2b0c4f] border border-[#d1d5db]\" data-kid=\"1-4-2-2-1\" data-name=\"not asked button\">\n                    No preguntado\n                </button>\n                <button class=\"h-8 rounded-lg text-[11px] font-semibold text-[#6b7280]\" data-kid=\"1-4-2-2-2\" data-name=\"denies button\">\n                    Niega\n                </button>\n                <button class=\"h-8 rounded-lg text-[11px] font-semibold text-[#6b7280]\" data-kid=\"1-4-2-2-3\" data-name=\"refers button\">\n                    Refiere\n                </button>\n            </div>\n            <div class=\"flex items-start gap-2 rounded-xl border border-dashed border-[#f0a300]/50 bg-[#fffbeb] px-3 py-2.5 mb-2.5\" data-kid=\"1-4-2-3\" data-name=\"warning callout container\">\n                <i class=\"ti ti-help-circle text-[16px] text-[#b45309] mt-0.5\" data-kid=\"1-4-2-3-1\" data-name=\"help circle icon\">\n                </i>\n                <p class=\"text-[11.5px] leading-snug text-[#92400e]\" data-kid=\"1-4-2-3-2\" data-name=\"warning text\">\n                    Aún sin registrar. Se guardará como\n                    <span class=\"font-bold\" data-kid=\"1-4-2-3-2-1\" data-name=\"warning highlight text\">\n                        «No preguntado»\n                    </span>\n                    — no como ausencia de síntomas.\n                </p>\n            </div>\n            <div class=\"flex flex-wrap gap-2 opacity-55\" data-kid=\"1-4-2-4\" data-name=\"digestive symptom tag list container\">\n                <button class=\"h-9 px-3 rounded-full text-[12px] font-semibold bg-white text-[#6b7280] border border-[#e5e7eb]\" data-kid=\"1-4-2-4-1\" data-name=\"bloating tag\">\n                    Hinchazón\n                </button>\n                <button class=\"h-9 px-3 rounded-full text-[12px] font-semibold bg-white text-[#6b7280] border border-[#e5e7eb]\" data-kid=\"1-4-2-4-2\" data-name=\"constipation tag\">\n                    Estreñimiento\n                </button>\n                <button class=\"h-9 px-3 rounded-full text-[12px] font-semibold bg-white text-[#6b7280] border border-[#e5e7eb]\" data-kid=\"1-4-2-4-3\" data-name=\"reflux tag\">\n                    Reflujo\n                </button>\n                <button class=\"h-9 px-3 rounded-full text-[12px] font-semibold bg-white text-[#6b7280] border border-[#e5e7eb]\" data-kid=\"1-4-2-4-4\" data-name=\"abdominal pain tag\">\n                    Dolor abdominal\n                </button>\n                <button class=\"h-9 px-3 rounded-full text-[12px] font-semibold bg-white text-[#6b7280] border border-[#e5e7eb]\" data-kid=\"1-4-2-4-5\" data-name=\"gas tag\">\n                    Gases\n                </button>\n                <button class=\"h-9 px-3 rounded-full text-[12px] font-semibold bg-white text-[#6b7280] border border-[#e5e7eb]\" data-kid=\"1-4-2-4-6\" data-name=\"nausea tag\">\n                    Náuseas\n                </button>\n            </div>\n        </section>\n        <!-- Recordatorio de 24 horas -->\n        <section class=\"mt-6 pt-5 border-t border-[#e5e7eb]\" data-kid=\"1-4-3\" data-name=\"24-hour food recall section\">\n            <div class=\"flex items-baseline justify-between mb-1\" data-kid=\"1-4-3-1\" data-name=\"section header and completion status container\">\n                <h2 class=\"text-[13.5px] font-bold text-[#2b0c4f]\" data-kid=\"1-4-3-1-1\" data-name=\"section title\">\n                    Recordatorio de 24 horas\n                </h2>\n                <span class=\"text-[11.5px] font-semibold text-[#0ea5e9]\" data-kid=\"1-4-3-1-2\" data-name=\"meal completion status label\">\n                    3 de 4 comidas\n                </span>\n            </div>\n            <p class=\"text-[11.5px] text-[#9ca3af] mb-2\" data-kid=\"1-4-3-2\" data-name=\"section description text\">\n                Lo que la paciente refirió haber consumido ayer.\n            </p>\n            <div class=\"flex items-center justify-between mt-3\" data-kid=\"1-4-3-3\" data-name=\"breakfast item header container\">\n                <div class=\"flex items-center gap-2\" data-kid=\"1-4-3-3-1\" data-name=\"meal icon and name container\">\n                    <span class=\"h-6 w-6 rounded-full bg-[#ede9fe] text-[#5b21b6] grid place-items-center text-[13px]\" data-kid=\"1-4-3-3-1-1\" data-name=\"meal icon badge container\">\n                        <i class=\"ti ti-coffee\" data-kid=\"1-4-3-3-1-1-1\" data-name=\"coffee cup icon\">\n                        </i>\n                    </span>\n                    <span class=\"text-[13px] font-bold text-[#2b0c4f]\" data-kid=\"1-4-3-3-1-2\" data-name=\"meal name\">\n                        Desayuno\n                    </span>\n                    <span class=\"text-[11.5px] text-[#6b7280]\" data-kid=\"1-4-3-3-1-3\" data-name=\"meal time\">\n                        08:00\n                    </span>\n                </div>\n                <button class=\"text-[11.5px] font-semibold text-[#5b21b6]\" data-kid=\"1-4-3-3-2\" data-name=\"edit meal button\">\n                    Editar\n                </button>\n            </div>\n            <p class=\"text-[12.5px] leading-relaxed text-[#374151] mt-1.5 pl-8\" data-kid=\"1-4-3-4\" data-name=\"breakfast description text\">\n                Café con leche descremada, 2 tostadas de pan integral con queso untable y 1 banana.\n            </p>\n            <div class=\"flex items-center justify-between mt-4 pt-3.5 border-t border-[#e5e7eb]\" data-kid=\"1-4-3-5\" data-name=\"lunch item header container\">\n                <div class=\"flex items-center gap-2\" data-kid=\"1-4-3-5-1\" data-name=\"meal icon and name container\">\n                    <span class=\"h-6 w-6 rounded-full bg-[#ede9fe] text-[#5b21b6] grid place-items-center text-[13px]\" data-kid=\"1-4-3-5-1-1\" data-name=\"meal icon badge container\">\n                        <i class=\"ti ti-tools-kitchen-2\" data-kid=\"1-4-3-5-1-1-1\" data-name=\"kitchen tools icon\">\n                        </i>\n                    </span>\n                    <span class=\"text-[13px] font-bold text-[#2b0c4f]\" data-kid=\"1-4-3-5-1-2\" data-name=\"meal name\">\n                        Almuerzo\n                    </span>\n                    <span class=\"text-[11.5px] text-[#6b7280]\" data-kid=\"1-4-3-5-1-3\" data-name=\"meal time\">\n                        13:30\n                    </span>\n                </div>\n                <button class=\"text-[11.5px] font-semibold text-[#5b21b6]\" data-kid=\"1-4-3-5-2\" data-name=\"edit meal button\">\n                    Editar\n                </button>\n            </div>\n            <p class=\"text-[12.5px] leading-relaxed text-[#374151] mt-1.5 pl-8\" data-kid=\"1-4-3-6\" data-name=\"lunch description text\">\n                Milanesa de pollo al horno, puré de papa y ensalada mixta con aceite de oliva.\n            </p>\n            <div class=\"flex items-center justify-between mt-4 pt-3.5 border-t border-[#e5e7eb]\" data-kid=\"1-4-3-7\" data-name=\"snack item header container\">\n                <div class=\"flex items-center gap-2\" data-kid=\"1-4-3-7-1\" data-name=\"meal icon and name container\">\n                    <span class=\"h-6 w-6 rounded-full bg-[#ede9fe] text-[#5b21b6] grid place-items-center text-[13px]\" data-kid=\"1-4-3-7-1-1\" data-name=\"meal icon badge container\">\n                        <i class=\"ti ti-cup\" data-kid=\"1-4-3-7-1-1-1\" data-name=\"cup icon\">\n                        </i>\n                    </span>\n                    <span class=\"text-[13px] font-bold text-[#2b0c4f]\" data-kid=\"1-4-3-7-1-2\" data-name=\"meal name\">\n                        Merienda\n                    </span>\n                    <span class=\"text-[11.5px] text-[#6b7280]\" data-kid=\"1-4-3-7-1-3\" data-name=\"meal time\">\n                        17:15\n                    </span>\n                </div>\n                <button class=\"text-[11.5px] font-semibold text-[#5b21b6]\" data-kid=\"1-4-3-7-2\" data-name=\"edit meal button\">\n                    Editar\n                </button>\n            </div>\n            <p class=\"text-[12.5px] leading-relaxed text-[#374151] mt-1.5 pl-8\" data-kid=\"1-4-3-8\" data-name=\"snack description text\">\n                Yogur entero natural con granola y 1 manzana.\n            </p>\n            <div class=\"flex items-center justify-between mt-4 pt-3.5 border-t border-[#e5e7eb]\" data-kid=\"1-4-3-9\" data-name=\"dinner item header container\">\n                <div class=\"flex items-center gap-2\" data-kid=\"1-4-3-9-1\" data-name=\"meal icon and name container\">\n                    <span class=\"h-6 w-6 rounded-full bg-[#f1f5f9] text-[#94a3b8] grid place-items-center text-[13px]\" data-kid=\"1-4-3-9-1-1\" data-name=\"meal icon badge container\">\n                        <i class=\"ti ti-moon\" data-kid=\"1-4-3-9-1-1-1\" data-name=\"moon icon\">\n                        </i>\n                    </span>\n                    <span class=\"text-[13px] font-bold text-[#94a3b8]\" data-kid=\"1-4-3-9-1-2\" data-name=\"meal name\">\n                        Cena\n                    </span>\n                    <span class=\"text-[11.5px] text-[#94a3b8]\" data-kid=\"1-4-3-9-1-3\" data-name=\"meal time\">\n                        21:00\n                    </span>\n                </div>\n            </div>\n            <button class=\"mt-1.5 ml-8 flex items-center gap-1.5 text-[12.5px] font-semibold text-[#5b21b6]\" data-kid=\"1-4-3-10\" data-name=\"add meal button\">\n                <i class=\"ti ti-plus text-[15px]\" data-kid=\"1-4-3-10-1\" data-name=\"plus icon\">\n                </i>\n                Agregar lo que consumió\n            </button>\n        </section>\n    </div>\n    <!-- Sticky footer -->\n    <div class=\"shrink-0 border-t border-[#e5e7eb] bg-white px-4 pt-3 pb-5\" data-kid=\"1-5\" data-name=\"sticky footer action bar\">\n        <div class=\"flex items-center gap-1.5 mb-2.5 text-[11.5px] text-[#6b7280]\" data-kid=\"1-5-1\" data-name=\"save info status container\">\n            <i class=\"ti ti-info-circle text-[15px]\" data-kid=\"1-5-1-1\" data-name=\"info icon\">\n            </i>\n            <span data-kid=\"1-5-1-2\" data-name=\"save notification text\">\n                Se guardará en la ficha de Lucía Fernández · actualizada hoy\n            </span>\n        </div>\n        <button class=\"w-full h-12 rounded-full bg-[#5b21b6] text-white font-bold text-[14px] flex items-center justify-center gap-2\" data-kid=\"1-5-2\" data-name=\"save clinical record button\">\n            <i class=\"ti ti-device-floppy text-[18px]\" data-kid=\"1-5-2-1\" data-name=\"save floppy disk icon\">\n            </i>\n            Guardar ficha\n        </button>\n    </div>\n</div>\n",
      "comments": [],
      "created": "2026-10-02T18:37:34.189099+00:00",
      "modified": "2026-10-02T18:37:56.228458+00:00",
      "id": "var_059115dd5253"
    },
    "var_142cac0e02d1": {
      "type": "variant",
      "label": "Calculadora TMB & GET",
      "parentId": null,
      "themeId": null,
      "rect": {
        "x": 5225,
        "y": 0,
        "w": 375,
        "h": 812
      },
      "html": "<div class=\"h-[812px] w-full overflow-hidden flex flex-col bg-[#f6f7f9] text-[#111827] antialiased\" data-kid=\"1\" style=\"font-family:'Montserrat',system-ui,sans-serif\">\n    <style>\n        @import url('https://fonts.googleapis.com/css2?family=Montserrat:wght@400;500;600;700;800&display=swap');\n    @import url('https://cdn.jsdelivr.net/npm/@tabler/icons-webfont@3.48.0/dist/tabler-icons.min.css');\n    input[type=\"range\"]{ -webkit-appearance:none; appearance:none; height:6px; border-radius:9999px; background:#e5e7eb; outline:none; }\n    input[type=\"range\"]::-webkit-slider-thumb{ -webkit-appearance:none; appearance:none; height:21px; width:21px; border-radius:9999px; background:#5b21b6; border:3px solid #ffffff; box-shadow:0 1px 4px rgba(43,12,79,.35); cursor:pointer; }\n    input[type=\"range\"]::-moz-range-thumb{ height:17px; width:17px; border-radius:9999px; background:#5b21b6; border:3px solid #fff; cursor:pointer; }\n    .fld{ font-family:'Montserrat',sans-serif; }\n    </style>\n    <!-- status bar -->\n    <div class=\"flex items-center justify-between px-5 h-[28px] shrink-0 text-[12px] font-semibold text-[#2b0c4f]\" data-kid=\"1-1\">\n        <span data-dynamic=\"true\" data-kid=\"1-1-1\" data-name=\"current time text\" data-reason=\"time string updated by clock script\">\n            09:41\n        </span>\n        <div class=\"flex items-center gap-1.5 text-[14px]\" data-kid=\"1-1-2\">\n            <i class=\"ti ti-signal-3\" data-kid=\"1-1-2-1\">\n            </i>\n            <i class=\"ti ti-wifi\" data-kid=\"1-1-2-2\">\n            </i>\n            <i class=\"ti ti-battery-3\" data-kid=\"1-1-2-3\">\n            </i>\n        </div>\n    </div>\n    <!-- app bar -->\n    <div class=\"shrink-0 px-4 pb-2.5\" data-kid=\"1-2\">\n        <div class=\"flex items-center gap-3\" data-kid=\"1-2-1\">\n            <button class=\"h-9 w-9 grid place-items-center rounded-xl bg-white border border-[#e5e7eb] text-[#2b0c4f] text-[19px]\" data-kid=\"1-2-1-1\">\n                <i class=\"ti ti-chevron-left\" data-kid=\"1-2-1-1-1\">\n                </i>\n            </button>\n            <div class=\"flex-1 min-w-0\" data-kid=\"1-2-1-2\">\n                <h1 class=\"text-[17px] font-bold leading-tight text-[#2b0c4f]\" data-kid=\"1-2-1-2-1\">\n                    Requerimientos\n                </h1>\n                <p class=\"text-[11.5px] font-medium text-[#6b7280] leading-tight\" data-kid=\"1-2-1-2-2\">\n                    TMB & GET · Herramientas express\n                </p>\n            </div>\n            <button class=\"h-9 w-9 grid place-items-center rounded-xl bg-white border border-[#e5e7eb] text-[#4b5563] text-[18px]\" data-kid=\"1-2-1-3\">\n                <i class=\"ti ti-dots\" data-kid=\"1-2-1-3-1\">\n                </i>\n            </button>\n        </div>\n    </div>\n    <!-- scroll content -->\n    <div class=\"flex-1 overflow-y-auto px-4 pb-3 space-y-2.5\" data-kid=\"1-3\">\n        <!-- formula -->\n        <section data-kid=\"1-3-1\">\n            <div class=\"flex items-center justify-between mb-2\" data-kid=\"1-3-1-1\">\n                <h2 class=\"text-[12px] font-bold uppercase tracking-wide text-[#6b7280]\" data-kid=\"1-3-1-1-1\">\n                    Fórmula clínica\n                </h2>\n                <span class=\"text-[11px] font-semibold text-[#5b21b6] inline-flex items-center gap-1\" data-kid=\"1-3-1-1-2\">\n                    <i class=\"ti ti-adjustments-horizontal text-[13px]\" data-kid=\"1-3-1-1-2-1\">\n                    </i>\n                    Editable\n                </span>\n            </div>\n            <div aria-label=\"Fórmula clínica\" class=\"grid grid-cols-3 gap-1 bg-[#eceef2] p-1 rounded-xl\" data-kid=\"1-3-1-2\" role=\"tablist\">\n                <button aria-selected=\"true\" class=\"h-9 rounded-lg bg-[#5b21b6] text-white text-[10.5px] font-bold whitespace-nowrap shadow-sm\" data-kid=\"1-3-1-2-1\" role=\"tab\">\n                    Mifflin-St Jeor\n                </button>\n                <button aria-selected=\"false\" class=\"h-9 rounded-lg text-[10.5px] font-semibold text-[#4b5563] whitespace-nowrap\" data-kid=\"1-3-1-2-2\" role=\"tab\">\n                    Harris-Benedict\n                </button>\n                <button aria-selected=\"false\" class=\"h-9 rounded-lg text-[10.5px] font-semibold text-[#4b5563] whitespace-nowrap\" data-kid=\"1-3-1-2-3\" role=\"tab\">\n                    Cunningham\n                </button>\n            </div>\n            <p class=\"mt-1.5 text-[11px] text-[#6b7280] leading-snug flex items-start gap-1.5\" data-kid=\"1-3-1-3\">\n                <i class=\"ti ti-info-circle text-[13px] mt-[1px] shrink-0 text-[#7c3aed]\" data-kid=\"1-3-1-3-1\">\n                </i>\n                La más precisa en adultos sin composición corporal medida.\n            </p>\n        </section>\n        <!-- patient data -->\n        <section class=\"bg-white rounded-2xl border border-[#e5e7eb] p-3\" data-kid=\"1-3-2\">\n            <h2 class=\"text-[12px] font-bold uppercase tracking-wide text-[#6b7280] mb-2.5\" data-kid=\"1-3-2-1\">\n                Datos del paciente\n            </h2>\n            <div class=\"mb-3\" data-kid=\"1-3-2-2\">\n                <label class=\"block text-[11.5px] font-semibold text-[#374151] mb-1.5\" data-kid=\"1-3-2-2-1\">\n                    Sexo\n                </label>\n                <div class=\"grid grid-cols-2 gap-1 bg-[#eceef2] p-1 rounded-xl\" data-kid=\"1-3-2-2-2\">\n                    <button class=\"h-8 rounded-lg bg-white text-[12px] font-bold text-[#2b0c4f] shadow-sm inline-flex items-center justify-center gap-1.5\" data-kid=\"1-3-2-2-2-1\">\n                        <i class=\"ti ti-gender-female text-[15px]\" data-kid=\"1-3-2-2-2-1-1\">\n                        </i>\n                        Femenino\n                    </button>\n                    <button class=\"h-8 rounded-lg text-[12px] font-semibold text-[#6b7280] inline-flex items-center justify-center gap-1.5\" data-kid=\"1-3-2-2-2-2\">\n                        <i class=\"ti ti-gender-male text-[15px]\" data-kid=\"1-3-2-2-2-2-1\">\n                        </i>\n                        Masculino\n                    </button>\n                </div>\n            </div>\n            <div class=\"grid grid-cols-3 gap-2.5\" data-kid=\"1-3-2-3\">\n                <div data-kid=\"1-3-2-3-1\">\n                    <label class=\"block text-[11px] font-semibold text-[#374151] mb-1.5\" data-kid=\"1-3-2-3-1-1\">\n                        Edad\n                    </label>\n                    <div class=\"h-11 rounded-xl border border-[#e5e7eb] bg-white flex items-center justify-center gap-1\" data-kid=\"1-3-2-3-1-2\">\n                        <span class=\"fld text-[15.5px] font-bold text-[#111827]\" data-kid=\"1-3-2-3-1-2-1\">\n                            34\n                        </span>\n                        <span class=\"text-[10.5px] font-medium text-[#6b7280]\" data-kid=\"1-3-2-3-1-2-2\">\n                            años\n                        </span>\n                    </div>\n                </div>\n                <div data-kid=\"1-3-2-3-2\">\n                    <label class=\"block text-[11px] font-semibold text-[#374151] mb-1.5\" data-kid=\"1-3-2-3-2-1\">\n                        Peso\n                    </label>\n                    <div class=\"h-11 rounded-xl border-2 border-[#7c3aed] bg-white flex items-center justify-center gap-1\" data-kid=\"1-3-2-3-2-2\">\n                        <span class=\"fld text-[15.5px] font-bold text-[#111827]\" data-kid=\"1-3-2-3-2-2-1\">\n                            68,4\n                        </span>\n                        <span class=\"text-[10.5px] font-medium text-[#6b7280]\" data-kid=\"1-3-2-3-2-2-2\">\n                            kg\n                        </span>\n                    </div>\n                </div>\n                <div data-kid=\"1-3-2-3-3\">\n                    <label class=\"block text-[11px] font-semibold text-[#374151] mb-1.5\" data-kid=\"1-3-2-3-3-1\">\n                        Talla\n                    </label>\n                    <div class=\"h-11 rounded-xl border border-[#e5e7eb] bg-white flex items-center justify-center gap-1\" data-kid=\"1-3-2-3-3-2\">\n                        <span class=\"fld text-[15.5px] font-bold text-[#111827]\" data-kid=\"1-3-2-3-3-2-1\">\n                            165\n                        </span>\n                        <span class=\"text-[10.5px] font-medium text-[#6b7280]\" data-kid=\"1-3-2-3-3-2-2\">\n                            cm\n                        </span>\n                    </div>\n                </div>\n            </div>\n            <div class=\"mt-2.5 rounded-lg bg-[#fffbeb] border border-[#fde68a] px-2.5 py-1.5 flex items-center gap-1.5\" data-kid=\"1-3-2-4\">\n                <i class=\"ti ti-alert-triangle text-[13px] shrink-0 text-[#b45309]\" data-kid=\"1-3-2-4-1\">\n                </i>\n                <p class=\"text-[10.5px] leading-snug text-[#92400e]\" data-kid=\"1-3-2-4-2\">\n                    Peso y talla son obligatorios para calcular.\n                </p>\n            </div>\n        </section>\n        <!-- factors -->\n        <section class=\"bg-white rounded-2xl border border-[#e5e7eb] p-3 space-y-3\" data-kid=\"1-3-3\">\n            <h2 class=\"text-[12px] font-bold uppercase tracking-wide text-[#6b7280]\" data-kid=\"1-3-3-1\">\n                Factores\n            </h2>\n            <div data-kid=\"1-3-3-2\">\n                <div class=\"flex items-center justify-between mb-1.5\" data-kid=\"1-3-3-2-1\">\n                    <label class=\"text-[12px] font-semibold text-[#374151] inline-flex items-center gap-1.5\" data-kid=\"1-3-3-2-1-1\">\n                        <i class=\"ti ti-run text-[15px] text-[#7c3aed]\" data-kid=\"1-3-3-2-1-1-1\">\n                        </i>\n                        Nivel de actividad física\n                    </label>\n                    <span class=\"px-2 py-0.5 rounded-lg bg-[#ede9fe] text-[#5b21b6] text-[11.5px] font-bold inline-flex items-center gap-1\" data-dynamic=\"true\" data-kid=\"1-3-3-2-1-2\" data-name=\"active activity factor display\" data-reason=\"value dynamically updated by range input script\">\n                        1,55 · Moderada\n                        <i class=\"ti ti-pencil text-[11px]\" data-kid=\"1-3-3-2-1-2-1\">\n                        </i>\n                    </span>\n                </div>\n                <input aria-label=\"Nivel de actividad física\" class=\"w-full\" data-kid=\"1-3-3-2-2\" max=\"1.9\" min=\"1.2\" step=\"0.05\" type=\"range\" value=\"1.55\"/>\n                <div class=\"flex justify-between mt-1 text-[10px] font-medium text-[#9ca3af]\" data-kid=\"1-3-3-2-3\">\n                    <span data-kid=\"1-3-3-2-3-1\">\n                        1,2 Sedentario\n                    </span>\n                    <span data-kid=\"1-3-3-2-3-2\">\n                        1,9 Muy alta\n                    </span>\n                </div>\n            </div>\n            <div data-kid=\"1-3-3-3\">\n                <div class=\"flex items-center justify-between mb-1.5\" data-kid=\"1-3-3-3-1\">\n                    <label class=\"text-[12px] font-semibold text-[#374151] inline-flex items-center gap-1.5\" data-kid=\"1-3-3-3-1-1\">\n                        <i class=\"ti ti-flame text-[15px] text-[#7c3aed]\" data-kid=\"1-3-3-3-1-1-1\">\n                        </i>\n                        Factor de estrés\n                    </label>\n                    <span class=\"px-2 py-0.5 rounded-lg bg-[#ede9fe] text-[#5b21b6] text-[11.5px] font-bold inline-flex items-center gap-1\" data-dynamic=\"true\" data-kid=\"1-3-3-3-1-2\" data-name=\"active stress factor display\" data-reason=\"value dynamically updated by range input script\">\n                        1,10 · Leve\n                        <i class=\"ti ti-pencil text-[11px]\" data-kid=\"1-3-3-3-1-2-1\">\n                        </i>\n                    </span>\n                </div>\n                <input aria-label=\"Factor de estrés\" class=\"w-full\" data-kid=\"1-3-3-3-2\" max=\"1.3\" min=\"1\" step=\"0.05\" type=\"range\" value=\"1.10\"/>\n                <div class=\"flex justify-between mt-1 text-[10px] font-medium text-[#9ca3af]\" data-kid=\"1-3-3-3-3\">\n                    <span data-kid=\"1-3-3-3-3-1\">\n                        1,0 Sin estrés\n                    </span>\n                    <span data-kid=\"1-3-3-3-3-2\">\n                        1,3 Alto\n                    </span>\n                </div>\n            </div>\n        </section>\n    </div>\n    <!-- live result strip -->\n    <div class=\"shrink-0 px-4 pb-2\" data-kid=\"1-4\">\n        <div class=\"rounded-2xl bg-[#2b0c4f] p-3 text-white\" data-kid=\"1-4-1\">\n            <div class=\"flex items-center justify-between mb-2\" data-kid=\"1-4-1-1\">\n                <span class=\"text-[10.5px] uppercase tracking-wide font-bold text-white/60\" data-kid=\"1-4-1-1-1\">\n                    Cálculo en vivo\n                </span>\n                <span class=\"px-2 py-0.5 rounded-lg bg-white/10 text-[10.5px] font-semibold text-white/90\" data-kid=\"1-4-1-1-2\">\n                    Mifflin-St Jeor\n                </span>\n            </div>\n            <div class=\"flex items-center gap-3\" data-kid=\"1-4-1-2\">\n                <div class=\"flex-1\" data-kid=\"1-4-1-2-1\">\n                    <p class=\"text-[10px] uppercase tracking-wide font-bold text-white/55\" data-kid=\"1-4-1-2-1-1\">\n                        TMB\n                    </p>\n                    <p class=\"leading-tight\" data-kid=\"1-4-1-2-1-2\">\n                        <span class=\"fld text-[24px] font-extrabold\" data-dynamic=\"true\" data-kid=\"1-4-1-2-1-2-1\" data-name=\"TMB value\" data-reason=\"result value updated by calculation script\">\n                            1.384\n                        </span>\n                        <span class=\"text-[11px] font-semibold text-white/70\" data-kid=\"1-4-1-2-1-2-2\">\n                            kcal/día\n                        </span>\n                    </p>\n                </div>\n                <div class=\"w-px self-stretch bg-white/15\" data-kid=\"1-4-1-2-2\">\n                </div>\n                <div class=\"flex-1\" data-kid=\"1-4-1-2-3\">\n                    <p class=\"text-[10px] uppercase tracking-wide font-bold text-white/55\" data-kid=\"1-4-1-2-3-1\">\n                        GET\n                    </p>\n                    <p class=\"leading-tight\" data-kid=\"1-4-1-2-3-2\">\n                        <span class=\"fld text-[24px] font-extrabold text-[#c4b5fd]\" data-dynamic=\"true\" data-kid=\"1-4-1-2-3-2-1\" data-name=\"GET value\" data-reason=\"result value updated by calculation script\">\n                            2.360\n                        </span>\n                        <span class=\"text-[11px] font-semibold text-white/70\" data-kid=\"1-4-1-2-3-2-2\">\n                            kcal/día\n                        </span>\n                    </p>\n                </div>\n            </div>\n            <p class=\"mt-1.5 pt-1.5 border-t border-white/10 text-[10.5px] text-white/70\" data-dynamic=\"true\" data-kid=\"1-4-1-3\" data-name=\"calculation details summary text\" data-reason=\"text updated to reflect current patient data and formula\">\n                GET = TMB × actividad 1,55 × estrés 1,10\n            </p>\n        </div>\n    </div>\n    <!-- action -->\n    <div class=\"shrink-0 px-4 pb-2 flex items-center gap-2\" data-kid=\"1-5\">\n        <button class=\"flex-1 h-11 rounded-xl bg-[#5b21b6] text-white text-[13.5px] font-bold inline-flex items-center justify-center gap-2 shadow-sm\" data-kid=\"1-5-1\">\n            <i class=\"ti ti-device-floppy text-[17px]\" data-kid=\"1-5-1-1\">\n            </i>\n            Guardar en la ficha\n        </button>\n        <button class=\"h-11 px-3 rounded-xl border border-[#5b21b6] text-[#5b21b6] text-[13px] font-bold inline-flex items-center justify-center gap-1.5 bg-white\" data-kid=\"1-5-2\">\n            <i class=\"ti ti-clipboard-plus text-[16px]\" data-kid=\"1-5-2-1\">\n            </i>\n            Usar en plan\n        </button>\n    </div>\n    <!-- tab bar -->\n    <nav class=\"shrink-0 h-[58px] bg-white border-t border-[#e5e7eb] flex items-center justify-around px-2\" data-kid=\"1-6\" data-name=\"bottom navigation bar\">\n        <button class=\"flex flex-col items-center gap-1 text-[#9ca3af]\" data-kid=\"1-6-1\">\n            <i class=\"ti ti-users text-[22px]\" data-kid=\"1-6-1-1\">\n            </i>\n            <span class=\"text-[10.5px] font-medium\" data-kid=\"1-6-1-2\">\n                Pacientes\n            </span>\n        </button>\n        <button class=\"flex flex-col items-center gap-1 text-[#9ca3af]\" data-kid=\"1-6-2\">\n            <i class=\"ti ti-clipboard-text text-[22px]\" data-kid=\"1-6-2-1\">\n            </i>\n            <span class=\"text-[10.5px] font-medium\" data-kid=\"1-6-2-2\">\n                Planes\n            </span>\n        </button>\n        <button class=\"flex flex-col items-center gap-1 text-[#5b21b6]\" data-kid=\"1-6-3\">\n            <i class=\"ti ti-calculator text-[22px]\" data-kid=\"1-6-3-1\">\n            </i>\n            <span class=\"text-[10.5px] font-bold\" data-kid=\"1-6-3-2\">\n                Herramientas\n            </span>\n        </button>\n        <button class=\"flex flex-col items-center gap-1 text-[#9ca3af]\" data-kid=\"1-6-4\">\n            <i class=\"ti ti-user-circle text-[22px]\" data-kid=\"1-6-4-1\">\n            </i>\n            <span class=\"text-[10.5px] font-medium\" data-kid=\"1-6-4-2\">\n                Perfil\n            </span>\n        </button>\n    </nav>\n</div>\n",
