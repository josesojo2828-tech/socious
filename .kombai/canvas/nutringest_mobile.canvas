    "var_9a62b3b95dc5": {
      "type": "variant",
      "label": "Calculadora de Mermas",
      "parentId": null,
      "themeId": null,
      "rect": {
        "x": 3800,
        "y": 0,
        "w": 375,
        "h": 812
      },
      "html": "<div class=\"h-[812px] w-full overflow-hidden bg-[#f6f7f9] font-[Montserrat] text-[#111827] antialiased flex flex-col\" data-kid=\"1\" data-name=\"page layout container\">\n    <style>\n        @import url('https://fonts.googleapis.com/css2?family=Montserrat:wght@400;500;600;700;800&display=swap');\n    @import url('https://cdn.jsdelivr.net/npm/@tabler/icons-webfont@3.48.0/dist/tabler-icons.min.css');\n    </style>\n    <!-- Status bar -->\n    <div class=\"h-11 shrink-0 flex items-center justify-between px-5 pt-2 text-[13px] font-semibold\" data-kid=\"1-1\" data-name=\"status bar\">\n        <span data-dynamic=\"true\" data-kid=\"1-1-1\" data-name=\"current time text\" data-reason=\"text updated by system clock\">\n            9:41\n        </span>\n        <div class=\"flex items-center gap-1.5 text-[15px]\" data-kid=\"1-1-2\" data-name=\"device status icons container\">\n            <i class=\"ti ti-signal-3\" data-kid=\"1-1-2-1\" data-name=\"signal strength icon\">\n            </i>\n            <i class=\"ti ti-wifi\" data-kid=\"1-1-2-2\" data-name=\"wifi icon\">\n            </i>\n            <i class=\"ti ti-battery-4\" data-kid=\"1-1-2-3\" data-name=\"battery charge icon\">\n            </i>\n        </div>\n    </div>\n    <!-- App bar -->\n    <header class=\"shrink-0 flex items-center gap-3 px-4 pb-3\" data-kid=\"1-2\" data-name=\"application header\">\n        <button class=\"h-9 w-9 grid place-items-center rounded-full bg-white border border-[#e5e7eb] text-[#374151]\" data-kid=\"1-2-1\" data-name=\"back button\">\n            <i class=\"ti ti-arrow-left text-[18px]\" data-kid=\"1-2-1-1\" data-name=\"back arrow icon\">\n            </i>\n        </button>\n        <div class=\"flex-1 min-w-0\" data-kid=\"1-2-2\" data-name=\"page title container\">\n            <h1 class=\"text-[16px] font-bold leading-tight text-[#2b0c4f]\" data-kid=\"1-2-2-1\" data-name=\"main page headline\">\n                Mermas y conversión\n            </h1>\n            <p class=\"text-[11.5px] text-[#6b7280] leading-tight\" data-kid=\"1-2-2-2\" data-name=\"page description text\">\n                Peso bruto · peso neto · rendimiento\n            </p>\n        </div>\n        <button class=\"h-9 w-9 grid place-items-center rounded-full bg-white border border-[#e5e7eb] text-[#6b7280]\" data-kid=\"1-2-3\" data-name=\"help button\">\n            <i class=\"ti ti-help-circle text-[18px]\" data-kid=\"1-2-3-1\" data-name=\"help question mark icon\">\n            </i>\n        </button>\n    </header>\n    <!-- Scrollable content -->\n    <main class=\"flex-1 overflow-y-auto px-4 pb-4\" data-kid=\"1-3\" data-name=\"main content area\">\n        <!-- Segmented: which value is known -->\n        <p class=\"text-[12px] font-semibold text-[#4b5563] mb-2\" data-kid=\"1-3-1\" data-name=\"input type prompt\">\n            ¿Qué dato conocés?\n        </p>\n        <div class=\"grid grid-cols-3 gap-1 bg-[#eceef2] p-1 rounded-xl\" data-kid=\"1-3-2\" data-name=\"calculation mode selector tab bar\" role=\"tablist\">\n            <button aria-selected=\"true\" class=\"h-10 rounded-lg text-[11.5px] font-bold whitespace-nowrap bg-white text-[#5b21b6] shadow-sm\" data-kid=\"1-3-2-1\" data-name=\"peso bruto tab button\" role=\"tab\">\n                Peso bruto\n            </button>\n            <button aria-selected=\"false\" class=\"h-10 rounded-lg text-[11.5px] font-semibold whitespace-nowrap text-[#4b5563]\" data-kid=\"1-3-2-2\" data-name=\"peso neto tab button\" role=\"tab\">\n                Peso neto\n            </button>\n            <button aria-selected=\"false\" class=\"h-10 rounded-lg text-[11.5px] font-semibold whitespace-nowrap text-[#4b5563]\" data-kid=\"1-3-2-3\" data-name=\"rendimiento tab button\" role=\"tab\">\n                Rendimiento\n            </button>\n        </div>\n        <p class=\"mt-2 text-[11.5px] text-[#6b7280] flex items-center gap-1.5\" data-kid=\"1-3-3\" data-name=\"instruction text container\">\n            <i class=\"ti ti-info-circle text-[14px] text-[#7c3aed]\" data-kid=\"1-3-3-1\" data-name=\"info circle icon\">\n            </i>\n            Ingresá el segundo dato y calculamos los demás al instante.\n        </p>\n        <!-- Inputs -->\n        <div class=\"mt-4 bg-white border border-[#e5e7eb] rounded-2xl p-4 space-y-3\" data-kid=\"1-3-4\" data-name=\"input fields container\">\n            <div data-kid=\"1-3-4-1\" data-name=\"bruto weight input group\">\n                <div class=\"flex items-center justify-between mb-1.5\" data-kid=\"1-3-4-1-1\" data-name=\"label and status container\">\n                    <label class=\"text-[12.5px] font-semibold text-[#374151]\" data-kid=\"1-3-4-1-1-1\" data-name=\"bruto weight label\">\n                        Peso bruto\n                    </label>\n                    <span class=\"text-[11px] font-semibold text-[#5b21b6] bg-[#f3e8ff] px-2 py-0.5 rounded-full\" data-kid=\"1-3-4-1-1-2\" data-name=\"input status badge\">\n                        Conocido\n                    </span>\n                </div>\n                <div class=\"flex items-center justify-between rounded-xl border border-[#7c3aed] bg-white px-3.5 py-2.5 ring-2 ring-[#7c3aed]/20\" data-kid=\"1-3-4-1-2\" data-name=\"bruto weight display area\">\n                    <span class=\"text-[24px] font-bold tracking-tight text-[#111827]\" data-dynamic=\"true\" data-kid=\"1-3-4-1-2-1\" data-name=\"bruto weight value text\" data-reason=\"value recalculated based on input\">\n                        220\n                    </span>\n                    <span class=\"text-[14px] font-semibold text-[#9ca3af]\" data-kid=\"1-3-4-1-2-2\" data-name=\"bruto weight unit text\">\n                        g\n                    </span>\n                </div>\n            </div>\n            <div data-kid=\"1-3-4-2\" data-name=\"neto weight input group\">\n                <div class=\"flex items-center justify-between mb-1.5\" data-kid=\"1-3-4-2-1\" data-name=\"label and status container\">\n                    <label class=\"text-[12.5px] font-semibold text-[#374151]\" data-kid=\"1-3-4-2-1-1\" data-name=\"neto weight label\">\n                        Peso neto\n                    </label>\n                    <span class=\"text-[11px] text-[#9ca3af]\" data-kid=\"1-3-4-2-1-2\" data-name=\"input status label\">\n                        ingresar\n                    </span>\n                </div>\n                <div class=\"flex items-center justify-between rounded-xl border border-[#e5e7eb] bg-[#f9fafb] px-3.5 py-2.5\" data-kid=\"1-3-4-2-2\" data-name=\"neto weight display area\">\n                    <span class=\"text-[24px] font-bold tracking-tight text-[#111827]\" data-dynamic=\"true\" data-kid=\"1-3-4-2-2-1\" data-name=\"neto weight value text\" data-reason=\"value recalculated based on input\">\n                        190\n                    </span>\n                    <span class=\"text-[14px] font-semibold text-[#9ca3af]\" data-kid=\"1-3-4-2-2-2\" data-name=\"neto weight unit text\">\n                        g\n                    </span>\n                </div>\n            </div>\n        </div>\n        <!-- Result card -->\n        <div class=\"mt-4 rounded-2xl bg-[#2b0c4f] p-4 text-white\" data-kid=\"1-3-5\" data-name=\"calculation result summary card\">\n            <div class=\"flex items-start justify-between\" data-kid=\"1-3-5-1\" data-name=\"result value container\">\n                <div data-kid=\"1-3-5-1-1\" data-name=\"rendimiento result group\">\n                    <p class=\"text-[10px] uppercase tracking-wider font-bold text-white/55\" data-kid=\"1-3-5-1-1-1\" data-name=\"rendimiento label\">\n                        Resultado · Rendimiento\n                    </p>\n                    <p class=\"text-[32px] font-extrabold leading-none mt-1.5\" data-dynamic=\"true\" data-kid=\"1-3-5-1-1-2\" data-name=\"rendimiento value text\" data-reason=\"result value updated by calculation script\">\n                        86,4\n                        <span class=\"text-[18px] font-bold text-white/70 ml-0.5\" data-kid=\"1-3-5-1-1-2-1\" data-name=\"percentage symbol text\">\n                            %\n                        </span>\n                    </p>\n                </div>\n                <div class=\"text-right\" data-kid=\"1-3-5-1-2\" data-name=\"merma result group\">\n                    <p class=\"text-[10px] uppercase tracking-wider font-bold text-white/55\" data-kid=\"1-3-5-1-2-1\" data-name=\"merma label\">\n                        Merma\n                    </p>\n                    <p class=\"text-[20px] font-bold leading-tight mt-1 text-[#fca5a5]\" data-dynamic=\"true\" data-kid=\"1-3-5-1-2-2\" data-name=\"merma result value text\" data-reason=\"result value updated by calculation script\">\n                        13,6 %\n                    </p>\n                </div>\n            </div>\n            <div class=\"mt-3.5 pt-3 border-t border-white/15\" data-kid=\"1-3-5-2\" data-name=\"calculation details container\">\n                <p class=\"text-[10px] uppercase tracking-wider font-bold text-white/45 mb-1\" data-kid=\"1-3-5-2-1\" data-name=\"formula label\">\n                    Relación utilizada\n                </p>\n                <p class=\"text-[12.5px] font-medium text-white/85\" data-kid=\"1-3-5-2-2\" data-name=\"formula equation text\">\n                    Rendimiento = peso neto ÷ peso bruto × 100\n                </p>\n                <p class=\"text-[12.5px] font-medium text-white/60 mt-0.5\" data-dynamic=\"true\" data-kid=\"1-3-5-2-3\" data-name=\"calculation steps text\" data-reason=\"values updated dynamically by calculation script\">\n                    190 g ÷ 220 g = 0,864\n                </p>\n            </div>\n        </div>\n        <!-- Practical example -->\n        <div class=\"mt-4 bg-white border border-[#e5e7eb] rounded-2xl p-4\" data-kid=\"1-3-6\" data-name=\"practical example card\">\n            <div class=\"flex items-center gap-2 mb-3\" data-kid=\"1-3-6-1\" data-name=\"example title group\">\n                <i class=\"ti ti-bulb text-[17px] text-[#7c3aed]\" data-kid=\"1-3-6-1-1\" data-name=\"bulb icon\">\n                </i>\n                <h2 class=\"text-[13px] font-bold text-[#2b0c4f]\" data-kid=\"1-3-6-1-2\" data-name=\"example title text\">\n                    Ejemplo rápido\n                </h2>\n            </div>\n            <div class=\"flex items-center justify-between gap-1\" data-kid=\"1-3-6-2\" data-name=\"example calculation steps bar\">\n                <div class=\"flex-1 text-center\" data-kid=\"1-3-6-2-1\" data-name=\"example bruto container\">\n                    <p class=\"text-[10.5px] text-[#6b7280]\" data-kid=\"1-3-6-2-1-1\" data-name=\"example bruto label\">\n                        Bruto\n                    </p>\n                    <p class=\"text-[15px] font-bold mt-0.5\" data-kid=\"1-3-6-2-1-2\" data-name=\"example bruto value\">\n                        220 g\n                    </p>\n                </div>\n                <i class=\"ti ti-arrow-right text-[16px] text-[#c4b5fd]\" data-kid=\"1-3-6-2-2\" data-name=\"arrow icon\">\n                </i>\n                <div class=\"flex-1 text-center\" data-kid=\"1-3-6-2-3\" data-name=\"example neto container\">\n                    <p class=\"text-[10.5px] text-[#6b7280]\" data-kid=\"1-3-6-2-3-1\" data-name=\"example neto label\">\n                        Neto\n                    </p>\n                    <p class=\"text-[15px] font-bold mt-0.5\" data-kid=\"1-3-6-2-3-2\" data-name=\"example neto value\">\n                        190 g\n                    </p>\n                </div>\n                <i class=\"ti ti-arrow-right text-[16px] text-[#c4b5fd]\" data-kid=\"1-3-6-2-4\" data-name=\"arrow icon\">\n                </i>\n                <div class=\"flex-1 text-center\" data-kid=\"1-3-6-2-5\" data-name=\"example rendimiento container\">\n                    <p class=\"text-[10.5px] text-[#6b7280]\" data-kid=\"1-3-6-2-5-1\" data-name=\"example rend label\">\n                        Rend.\n                    </p>\n                    <p class=\"text-[15px] font-bold mt-0.5 text-[#5b21b6]\" data-kid=\"1-3-6-2-5-2\" data-name=\"example rend value\">\n                        86,4 %\n                    </p>\n                </div>\n            </div>\n            <p class=\"mt-3 text-[11.5px] text-[#6b7280] leading-relaxed\" data-kid=\"1-3-6-3\" data-name=\"example explanation text\">\n                Pechuga de pollo sin piel: se descartan 30 g de merma al limpiar y cocinar.\n            </p>\n        </div>\n        <!-- Save to recipe -->\n        <button class=\"mt-3 w-full flex items-center justify-center gap-2 rounded-xl border border-dashed border-[#c4b5fd] bg-[#faf5ff] py-3 text-[12.5px] font-semibold text-[#6d28d9]\" data-kid=\"1-3-7\" data-name=\"save to recipe button\">\n            <i class=\"ti ti-bookmark-plus text-[17px]\" data-kid=\"1-3-7-1\" data-name=\"bookmark icon\">\n            </i>\n            Guardar conversión en el recetario\n        </button>\n    </main>\n    <!-- Sticky footer actions -->\n    <footer class=\"shrink-0 border-t border-[#e5e7eb] bg-white px-4 pt-3 pb-2\" data-kid=\"1-4\" data-name=\"sticky footer action bar\">\n        <div class=\"flex gap-3\" data-kid=\"1-4-1\" data-name=\"action buttons container\">\n            <button class=\"flex-1 h-12 rounded-full border border-[#e5e7eb] text-[14px] font-semibold text-[#4b5563] flex items-center justify-center gap-2\" data-kid=\"1-4-1-1\" data-name=\"clear input button\">\n                <i class=\"ti ti-eraser text-[17px]\" data-kid=\"1-4-1-1-1\" data-name=\"eraser icon\">\n                </i>\n                Limpiar\n            </button>\n            <button class=\"flex-[1.4] h-12 rounded-full bg-[#5b21b6] text-white text-[14px] font-bold flex items-center justify-center gap-2\" data-kid=\"1-4-1-2\" data-name=\"save data button\">\n                <i class=\"ti ti-device-floppy text-[17px]\" data-kid=\"1-4-1-2-1\" data-name=\"save icon\">\n                </i>\n                Guardar\n            </button>\n        </div>\n        <div class=\"mx-auto mt-2.5 w-[120px] h-[5px] rounded-full bg-[#d1d5db]\" data-kid=\"1-4-2\" data-name=\"bottom screen indicator bar\">\n        </div>\n    </footer>\n</div>\n",
