    "var_cd01916ba412": {
      "type": "variant",
      "label": "Splash / Onboarding",
      "parentId": null,
      "themeId": null,
      "rect": {
        "x": 1900,
        "y": 0,
        "w": 375,
        "h": 812
      },
      "html": "<style>\n    @import url('https://fonts.googleapis.com/css2?family=Montserrat:wght@400;500;600;700;800&display=swap');\n  @import url('https://cdn.jsdelivr.net/npm/@tabler/icons-webfont@3.48.0/dist/tabler-icons.min.css');\n\n  @keyframes ngSplashBar {\n    0%   { transform: translateX(-120%); }\n    100% { transform: translateX(340%); }\n  }\n  .ng-splash-bar { animation: ngSplashBar 1.35s cubic-bezier(.45,0,.25,1) infinite; }\n\n  @keyframes ngLogoBreathe {\n    0%, 100% { transform: translateY(0) scale(1); }\n    50%      { transform: translateY(-4px) scale(1.02); }\n  }\n  .ng-logo-breathe { animation: ngLogoBreathe 4.2s ease-in-out infinite; }\n\n  @keyframes ngHalo {\n    0%, 100% { opacity: .55; transform: scale(1); }\n    50%      { opacity: .9;  transform: scale(1.08); }\n  }\n  .ng-halo { animation: ngHalo 4.2s ease-in-out infinite; }\n\n  @keyframes ngFadeUp {\n    0%   { opacity: 0; transform: translateY(10px); }\n    100% { opacity: 1; transform: translateY(0); }\n  }\n  .ng-fade { animation: ngFadeUp .7s cubic-bezier(.2,0,0,1) both; }\n  .ng-d1 { animation-delay: .05s; }\n  .ng-d2 { animation-delay: .18s; }\n  .ng-d3 { animation-delay: .32s; }\n  .ng-d4 { animation-delay: .46s; }\n</style>\n<div class=\"relative flex min-h-[812px] w-full flex-col overflow-hidden\" data-kid=\"1\" data-name=\"splash screen layout container\" style=\"font-family:'Montserrat', system-ui, -apple-system, sans-serif;\">\n    <!-- Brand gradient canvas -->\n    <div class=\"absolute inset-0 bg-[linear-gradient(158deg,#8b5cf6_0%,#7c3aed_26%,#5b21b6_58%,#2b0c4f_100%)]\" data-kid=\"1-1\" data-name=\"brand gradient background canvas\">\n    </div>\n    <!-- Soft atmosphere -->\n    <div class=\"ng-halo pointer-events-none absolute -left-24 -top-28 h-[320px] w-[320px] rounded-full bg-[#a78bfa]/40 blur-[90px]\" data-kid=\"1-2\" data-name=\"top-left soft atmospheric glow\">\n    </div>\n    <div class=\"pointer-events-none absolute -right-28 top-1/4 h-[300px] w-[300px] rounded-full bg-[#0ea5e9]/25 blur-[95px]\" data-kid=\"1-3\" data-name=\"top-right soft atmospheric glow\">\n    </div>\n    <div class=\"pointer-events-none absolute bottom-[-60px] left-1/2 h-[240px] w-[240px] -translate-x-1/2 rounded-full bg-[#0d0ea0]/35 blur-[80px]\" data-kid=\"1-4\" data-name=\"bottom-center soft atmospheric glow\">\n    </div>\n    <!-- Faint dotted texture -->\n    <div class=\"pointer-events-none absolute inset-0 opacity-[0.10]\" data-kid=\"1-5\" data-name=\"faint dotted texture overlay\" style=\"background-image:radial-gradient(#ffffff 1px, transparent 1px); background-size:22px 22px;\">\n    </div>\n    <!-- Content -->\n    <div class=\"relative z-10 flex flex-1 flex-col px-7 pb-11 pt-[104px]\" data-kid=\"1-6\" data-name=\"splash content area\">\n        <!-- Identity -->\n        <div class=\"ng-fade ng-d1 flex flex-col items-center text-center\" data-kid=\"1-6-1\" data-name=\"identity branding section\">\n            <div class=\"ng-logo-breathe relative flex h-[92px] w-[92px] items-center justify-center rounded-[28px] bg-white/12 ring-1 ring-white/25 backdrop-blur-md\" data-kid=\"1-6-1-1\" data-name=\"logo container\">\n                <span class=\"ti ti-leaf text-[46px] leading-none text-white\" data-kid=\"1-6-1-1-1\" data-name=\"leaf icon\">\n                </span>\n                <span class=\"absolute -bottom-1 -right-1 flex h-7 w-7 items-center justify-center rounded-full bg-[#0ea5e9] ring-[3px] ring-[#5b21b6]\" data-kid=\"1-6-1-1-2\" data-name=\"verified badge container\">\n                    <span class=\"ti ti-check text-[15px] leading-none text-white\" data-kid=\"1-6-1-1-2-1\" data-name=\"checkmark icon\">\n                    </span>\n                </span>\n            </div>\n            <h1 class=\"mt-[26px] text-[34px] font-extrabold leading-none tracking-[-0.02em] text-white\" data-kid=\"1-6-1-2\" data-name=\"brand title text\">\n                Nutringest\n            </h1>\n            <p class=\"mt-[10px] text-[10px] font-semibold uppercase tracking-[0.42em] text-white/55\" data-kid=\"1-6-1-3\" data-name=\"subtitle text\">\n                Software clínico\n            </p>\n            <div class=\"mt-[26px] h-px w-12 bg-white/25\" data-kid=\"1-6-1-4\" data-name=\"decorative horizontal line\">\n            </div>\n            <p class=\"mt-[22px] max-w-[236px] text-[15.5px] font-medium leading-[1.55] text-white/90\" data-kid=\"1-6-1-5\" data-name=\"app description text\">\n                Nutrición clínica,\n                <br data-kid=\"1-6-1-5-1\" data-name=\"description line break\"/>\n                en tu consultorio\n            </p>\n        </div>\n        <!-- Flexible space -->\n        <div class=\"flex-1\" data-kid=\"1-6-2\" data-name=\"flexible vertical spacer\">\n        </div>\n        <!-- Session check -->\n        <div class=\"ng-fade ng-d2 flex flex-col items-center\" data-kid=\"1-6-3\" data-name=\"session verification section\">\n            <p class=\"text-[13.5px] font-semibold tracking-[0.01em] text-white\" data-kid=\"1-6-3-1\" data-name=\"session status message\">\n                Comprobando sesión…\n            </p>\n            <div class=\"mt-[14px] h-[3px] w-[188px] overflow-hidden rounded-full bg-white/20\" data-kid=\"1-6-3-2\" data-name=\"loading progress bar background\">\n                <div class=\"ng-splash-bar h-full w-1/3 rounded-full bg-white\" data-kid=\"1-6-3-2-1\" data-name=\"animated loading splash bar\">\n                </div>\n            </div>\n            <p class=\"mt-[14px] flex items-center gap-[7px] text-[11px] font-medium text-white/65\" data-kid=\"1-6-3-3\" data-name=\"security notice section\">\n                <span class=\"ti ti-shield-lock text-[14px] leading-none\" data-kid=\"1-6-3-3-1\" data-name=\"shield lock icon\">\n                </span>\n                Verificando credenciales · sesión segura 30 días\n            </p>\n        </div>\n        <!-- What the app does -->\n        <div class=\"ng-fade ng-d3 mt-[38px] grid grid-cols-3 gap-2\" data-kid=\"1-6-4\" data-name=\"app features grid\">\n            <div class=\"flex flex-col items-center gap-[9px] rounded-2xl bg-white/10 px-2 py-[14px] text-center ring-1 ring-white/15 backdrop-blur-sm\" data-kid=\"1-6-4-1\" data-name=\"feature card 1 container\">\n                <span class=\"ti ti-clipboard-heart text-[20px] leading-none text-white\" data-kid=\"1-6-4-1-1\" data-name=\"clipboard heart icon\">\n                </span>\n                <span class=\"text-[10.5px] font-medium leading-[1.3] text-white/85\" data-kid=\"1-6-4-1-2\" data-name=\"feature card 1 text\">\n                    Fichas de\n                    <br data-kid=\"1-6-4-1-2-1\" data-name=\"feature card 1 line break\"/>\n                    pacientes\n                </span>\n            </div>\n            <div class=\"flex flex-col items-center gap-[9px] rounded-2xl bg-white/10 px-2 py-[14px] text-center ring-1 ring-white/15 backdrop-blur-sm\" data-kid=\"1-6-4-2\" data-name=\"feature card 2 container\">\n                <span class=\"ti ti-ruler-measure text-[20px] leading-none text-white\" data-kid=\"1-6-4-2-1\" data-name=\"ruler measure icon\">\n                </span>\n                <span class=\"text-[10.5px] font-medium leading-[1.3] text-white/85\" data-kid=\"1-6-4-2-2\" data-name=\"feature card 2 text\">\n                    Antropometría\n                    <br data-kid=\"1-6-4-2-2-1\" data-name=\"feature card 2 line break\"/>\n                    ISAK\n                </span>\n            </div>\n            <div class=\"flex flex-col items-center gap-[9px] rounded-2xl bg-white/10 px-2 py-[14px] text-center ring-1 ring-white/15 backdrop-blur-sm\" data-kid=\"1-6-4-3\" data-name=\"feature card 3 container\">\n                <span class=\"ti ti-salad text-[20px] leading-none text-white\" data-kid=\"1-6-4-3-1\" data-name=\"salad icon\">\n                </span>\n                <span class=\"text-[10.5px] font-medium leading-[1.3] text-white/85\" data-kid=\"1-6-4-3-2\" data-name=\"feature card 3 text\">\n                    Planes y\n                    <br data-kid=\"1-6-4-3-2-1\" data-name=\"feature card 3 line break\"/>\n                    dietas\n                </span>\n            </div>\n        </div>\n        <!-- Fine print -->\n        <p class=\"ng-fade ng-d4 mt-[26px] text-center text-[10px] font-medium tracking-[0.02em] text-white/45\" data-kid=\"1-6-5\" data-name=\"version copyright text\">\n            v2.4.0 · Nutringest © 2026\n        </p>\n    </div>\n    <!-- Home indicator -->\n    <div class=\"relative z-10 flex justify-center pb-[9px]\" data-kid=\"1-7\" data-name=\"bottom navigation area\">\n        <div class=\"h-[5px] w-[128px] rounded-full bg-white/40\" data-kid=\"1-7-1\" data-name=\"home indicator bar\">\n        </div>\n    </div>\n</div>\n",
      "comments": [],
      "created": "2026-10-02T18:35:15.638841+00:00",
      "modified": "2026-10-02T18:35:29.465124+00:00",
      "id": "var_cd01916ba412"
    },
    "var_36ee35ed4bbf": {
      "type": "variant",
      "label": "Lista de Pacientes",
      "parentId": null,
      "themeId": null,
      "rect": {
        "x": 2375,
        "y": 0,
        "w": 375,
        "h": 812
      },
      "html": "<div class=\"font-[Montserrat] text-[#111827] antialiased\" data-kid=\"1\" data-name=\"page font and text wrapper\">\n    <style>\n        @import url('https://fonts.googleapis.com/css2?family=Montserrat:wght@400;500;600;700;800&display=swap');\n    @import url('https://cdn.jsdelivr.net/npm/@tabler/icons-webfont@3.48.0/dist/tabler-icons.min.css');\n    input::placeholder { color: #9ca3af; }\n    .no-sb::-webkit-scrollbar { display: none; }\n    .no-sb { -ms-overflow-style: none; scrollbar-width: none; }\n    </style>\n    <div class=\"w-full h-[812px] bg-[#f6f7f9] flex flex-col relative overflow-hidden\" data-kid=\"1-1\" data-name=\"application layout container\">\n        <!-- ===== HEADER ===== -->\n        <header class=\"flex-none bg-white border-b border-[#e5e7eb] px-4 pt-4 pb-3\" data-kid=\"1-1-1\" data-name=\"page header section\">\n            <div class=\"flex items-start justify-between\" data-kid=\"1-1-1-1\" data-name=\"header top row\">\n                <div data-kid=\"1-1-1-1-1\" data-name=\"header title group\">\n                    <h1 class=\"text-[24px] leading-none font-bold tracking-[-0.02em] text-[#2b0c4f]\" data-kid=\"1-1-1-1-1-1\" data-name=\"page title\">\n                        Pacientes\n                    </h1>\n                    <p class=\"text-[12px] text-[#6b7280] mt-1.5\" data-kid=\"1-1-1-1-1-2\" data-name=\"patient summary count\">\n                        128 pacientes · 6 con plan activo\n                    </p>\n                </div>\n                <button class=\"w-10 h-10 rounded-full bg-[#5b21b6] text-white grid place-items-center text-[20px] active:scale-95 transition-transform\" data-kid=\"1-1-1-1-2\" data-name=\"add patient button\">\n                    <i class=\"ti ti-plus\" data-kid=\"1-1-1-1-2-1\" data-name=\"plus icon\">\n                    </i>\n                </button>\n            </div>\n            <!-- Buscador por nombre o DNI (primer control) -->\n            <div class=\"mt-3.5 relative\" data-kid=\"1-1-1-2\" data-name=\"search input container\">\n                <i class=\"ti ti-search absolute left-3.5 top-1/2 -translate-y-1/2 text-[19px] text-[#6b7280]\" data-kid=\"1-1-1-2-1\" data-name=\"search icon\">\n                </i>\n                <input class=\"w-full h-12 pl-11 pr-11 rounded-2xl bg-[#f6f7f9] border border-[#e5e7eb] text-[14px] font-medium text-[#111827] outline-none focus:border-[#7c3aed] focus:bg-white transition-colors\" data-kid=\"1-1-1-2-2\" data-name=\"search input field\" placeholder=\"Buscar por nombre o DNI\" type=\"text\"/>\n                <button class=\"absolute right-2.5 top-1/2 -translate-y-1/2 w-7 h-7 rounded-full bg-[#e5e7eb] text-[#6b7280] grid place-items-center text-[14px]\" data-kid=\"1-1-1-2-3\" data-name=\"clear search button\">\n                    <i class=\"ti ti-x\" data-kid=\"1-1-1-2-3-1\" data-name=\"close icon\">\n                    </i>\n                </button>\n            </div>\n            <!-- Filtros rápidos -->\n            <div class=\"mt-3 flex gap-2 overflow-x-auto no-sb\" data-kid=\"1-1-1-3\" data-name=\"quick filters container\">\n                <button class=\"shrink-0 h-8 px-3.5 rounded-full bg-[#5b21b6] text-white text-[12px] font-semibold\" data-kid=\"1-1-1-3-1\" data-name=\"filter all button\">\n                    Todos\n                </button>\n                <button class=\"shrink-0 h-8 px-3.5 rounded-full bg-white border border-[#e5e7eb] text-[#4b5563] text-[12px] font-semibold\" data-kid=\"1-1-1-3-2\" data-name=\"filter last consultation button\">\n                    Última consulta\n                </button>\n                <button class=\"shrink-0 h-8 px-3.5 rounded-full bg-white border border-[#e5e7eb] text-[#4b5563] text-[12px] font-semibold\" data-kid=\"1-1-1-3-3\" data-name=\"filter active plan button\">\n                    Con plan activo\n                </button>\n            </div>\n        </header>\n        <!-- ===== LISTA ===== -->\n        <main class=\"flex-1 overflow-y-auto no-sb px-4 pb-32\" data-kid=\"1-1-2\" data-name=\"patients list main container\">\n            <div class=\"flex items-center justify-between pt-4 pb-1\" data-kid=\"1-1-2-1\" data-name=\"list header info\">\n                <p class=\"text-[11px] font-bold tracking-[0.08em] text-[#9ca3af] uppercase\" data-kid=\"1-1-2-1-1\" data-name=\"results label\">\n                    Resultados\n                </p>\n                <p class=\"text-[11px] text-[#9ca3af]\" data-kid=\"1-1-2-1-2\" data-name=\"results count indicator\">\n                    7 de 128\n                </p>\n            </div>\n            <!-- Fila 1 -->\n            <div class=\"flex items-center gap-3 py-3.5 border-b border-[#e5e7eb]\" data-kid=\"1-1-2-2\" data-name=\"patient record row 1\">\n                <img alt=\"Foto de María González\" class=\"w-12 h-12 rounded-full object-cover shrink-0 bg-[#e5e7eb]\" data-kid=\"1-1-2-2-1\" data-name=\"patient profile image\" decoding=\"async\" loading=\"lazy\" src=\"https://i.pravatar.cc/96?img=47\"/>\n                <div class=\"min-w-0 flex-1\" data-kid=\"1-1-2-2-2\" data-name=\"patient info group\">\n                    <p class=\"text-[14.5px] font-semibold text-[#111827] truncate\" data-kid=\"1-1-2-2-2-1\" data-name=\"patient name text\">\n                        María González\n                    </p>\n                    <p class=\"text-[12px] text-[#6b7280] mt-0.5\" data-kid=\"1-1-2-2-2-2\" data-name=\"patient metadata\">\n                        DNI 32.145.879 · 34 años\n                    </p>\n                    <p class=\"text-[11.5px] text-[#9ca3af] mt-0.5\" data-kid=\"1-1-2-2-2-3\" data-name=\"last consultation date\">\n                        Última consulta · 12 sep 2026\n                    </p>\n                </div>\n                <div class=\"flex flex-col items-end gap-1.5 shrink-0\" data-kid=\"1-1-2-2-3\" data-name=\"patient actions column\">\n                    <button class=\"h-8 pl-2 pr-2.5 rounded-xl bg-[#10B981] text-white flex items-center gap-1 text-[11px] font-semibold\" data-kid=\"1-1-2-2-3-1\" data-name=\"whatsapp contact button\">\n                        <i class=\"ti ti-brand-whatsapp text-[15px]\" data-kid=\"1-1-2-2-3-1-1\" data-name=\"whatsapp icon\">\n                        </i>\n                        WhatsApp\n                    </button>\n                    <button class=\"h-8 pl-2 pr-2.5 rounded-xl border border-[#e5e7eb] text-[#5b21b6] flex items-center gap-1 text-[11px] font-semibold\" data-kid=\"1-1-2-2-3-2\" data-name=\"open record button\">\n                        <i class=\"ti ti-id text-[14px]\" data-kid=\"1-1-2-2-3-2-1\" data-name=\"id card icon\">\n                        </i>\n                        Abrir ficha\n                    </button>\n                </div>\n            </div>\n            <!-- Fila 2 -->\n            <div class=\"flex items-center gap-3 py-3.5 border-b border-[#e5e7eb]\" data-kid=\"1-1-2-3\" data-name=\"patient record row 2\">\n                <img alt=\"Foto de Joaquín Ferrer\" class=\"w-12 h-12 rounded-full object-cover shrink-0 bg-[#e5e7eb]\" data-kid=\"1-1-2-3-1\" data-name=\"patient profile image\" decoding=\"async\" loading=\"lazy\" src=\"https://i.pravatar.cc/96?img=12\"/>\n                <div class=\"min-w-0 flex-1\" data-kid=\"1-1-2-3-2\" data-name=\"patient info group\">\n                    <p class=\"text-[14.5px] font-semibold text-[#111827] truncate\" data-kid=\"1-1-2-3-2-1\" data-name=\"patient name text\">\n                        Joaquín Ferrer\n                    </p>\n                    <p class=\"text-[12px] text-[#6b7280] mt-0.5\" data-kid=\"1-1-2-3-2-2\" data-name=\"patient metadata\">\n                        DNI 28.907.114 · 41 años\n                    </p>\n                    <p class=\"text-[11.5px] text-[#9ca3af] mt-0.5\" data-kid=\"1-1-2-3-2-3\" data-name=\"last consultation date\">\n                        Última consulta · 28 ago 2026\n                    </p>\n          