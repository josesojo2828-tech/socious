      "html": "<style>\n    @import url('https://fonts.googleapis.com/css2?family=Montserrat:wght@400;500;600;700;800&display=swap');\n  @import url('https://cdn.jsdelivr.net/npm/@tabler/icons-webfont@3.48.0/dist/tabler-icons.min.css');\n  body { font-family: 'Montserrat', system-ui, sans-serif; background: #e9eaee; }\n  .no-sb { scrollbar-width: none; -ms-overflow-style: none; }\n  .no-sb::-webkit-scrollbar { display: none; }\n</style>\n<div class=\"min-h-screen w-full grid place-items-start justify-center pt-6 pb-6\" data-kid=\"1\" data-name=\"phone screen layout\">\n    <!-- Phone frame -->\n    <div class=\"w-[375px] h-[812px] flex flex-col bg-[#f6f7f9] text-[#111827] antialiased rounded-[26px] overflow-hidden border border-[#d9dbe1] shadow-[0_24px_60px_-20px_rgba(17,24,39,0.35)]\" data-kid=\"1-1\" data-name=\"phone frame container\">\n        <!-- Header -->\n        <header class=\"shrink-0 bg-white/90 backdrop-blur border-b border-[#e5e7eb]\" data-kid=\"1-1-1\" data-name=\"header sticky bar\">\n            <div class=\"px-5 pt-4 pb-3 flex items-center justify-between\" data-kid=\"1-1-1-1\" data-name=\"header layout container\">\n                <div data-kid=\"1-1-1-1-1\" data-name=\"header text group\">\n                    <p class=\"text-[11px] font-semibold tracking-[0.14em] uppercase text-[#7c3aed]\" data-kid=\"1-1-1-1-1-1\" data-name=\"header section label\">\n                        Cuenta\n                    </p>\n                    <h1 class=\"text-[19px] font-bold leading-tight text-[#111827]\" data-kid=\"1-1-1-1-1-2\" data-name=\"page title text\">\n                        Perfil del profesional\n                    </h1>\n                </div>\n                <button class=\"h-9 w-9 grid place-items-center rounded-full border border-[#e5e7eb] text-[#6b7280]\" data-kid=\"1-1-1-1-2\" data-name=\"settings menu button\">\n                    <i class=\"ti ti-dots text-[18px]\" data-kid=\"1-1-1-1-2-1\" data-name=\"dots icon\">\n                    </i>\n                </button>\n            </div>\n        </header>\n        <!-- Scrollable content -->\n        <div class=\"flex-1 overflow-y-auto no-sb\" data-kid=\"1-1-2\" data-name=\"scrollable content wrapper\">\n            <!-- Identity hero -->\n            <section class=\"px-5 mt-4\" data-kid=\"1-1-2-1\" data-name=\"identity hero section\">\n                <div class=\"rounded-2xl border border-[#e5e7eb] bg-white p-5\" data-kid=\"1-1-2-1-1\" data-name=\"profile card container\">\n                    <div class=\"flex items-center gap-4\" data-kid=\"1-1-2-1-1-1\" data-name=\"profile summary layout\">\n                        <div class=\"relative shrink-0\" data-kid=\"1-1-2-1-1-1-1\" data-name=\"avatar wrapper\">\n                            <div class=\"h-[68px] w-[68px] rounded-full bg-gradient-to-br from-[#5b21b6] to-[#7c3aed] grid place-items-center text-white text-[22px] font-bold\" data-kid=\"1-1-2-1-1-1-1-1\" data-name=\"profile initials badge\">\n                                MG\n                            </div>\n                            <button class=\"absolute -bottom-1 -right-1 h-7 w-7 grid place-items-center rounded-full bg-white border border-[#e5e7eb] text-[#5b21b6]\" data-kid=\"1-1-2-1-1-1-1-2\" data-name=\"edit avatar button\">\n                                <i class=\"ti ti-camera text-[14px]\" data-kid=\"1-1-2-1-1-1-1-2-1\" data-name=\"camera icon\">\n                                </i>\n                            </button>\n                        </div>\n                        <div class=\"min-w-0\" data-kid=\"1-1-2-1-1-1-2\" data-name=\"profile text info\">\n                            <h2 class=\"text-[17px] font-bold leading-snug truncate\" data-kid=\"1-1-2-1-1-1-2-1\" data-name=\"professional name text\">\n                                Lic. Marina Gutiérrez\n                            </h2>\n                            <p class=\"text-[13px] text-[#6b7280] mt-0.5\" data-kid=\"1-1-2-1-1-1-2-2\" data-name=\"professional title text\">\n                                Nutricionista Clínica\n                            </p>\n                            <div class=\"mt-2 inline-flex items-center gap-1.5 rounded-full bg-[#f3efff] px-2.5 py-1\" data-kid=\"1-1-2-1-1-1-2-3\" data-name=\"verification status badge\">\n                                <i class=\"ti ti-circle-check text-[13px] text-[#5b21b6]\" data-kid=\"1-1-2-1-1-1-2-3-1\" data-name=\"checkmark icon\">\n                                </i>\n                                <span class=\"text-[11px] font-semibold text-[#5b21b6]\" data-kid=\"1-1-2-1-1-1-2-3-2\" data-name=\"verification status text\">\n                                    Matrícula verificada\n                                </span>\n                            </div>\n                        </div>\n                    </div>\n                </div>\n            </section>\n            <!-- Identidad para reportes -->\n            <section class=\"px-5 mt-6\" data-kid=\"1-1-2-2\" data-name=\"identity for reports section\">\n                <div class=\"flex items-baseline justify-between\" data-kid=\"1-1-2-2-1\" data-name=\"section header container\">\n                    <h3 class=\"text-[13px] font-bold uppercase tracking-[0.06em] text-[#111827]\" data-kid=\"1-1-2-2-1-1\" data-name=\"section title\">\n                        Identidad para reportes\n                    </h3>\n                    <span class=\"text-[11px] font-semibold text-[#6b7280]\" data-kid=\"1-1-2-2-1-2\" data-name=\"section usage hint\">\n                        Se usa en cada ficha\n                    </span>\n                </div>\n                <div class=\"mt-3 rounded-2xl border border-[#e5e7eb] bg-white divide-y divide-[#e5e7eb] overflow-hidden\" data-kid=\"1-1-2-2-2\" data-name=\"identity input group\">\n                    <div class=\"px-4 py-3\" data-kid=\"1-1-2-2-2-1\" data-name=\"specialty input field container\">\n                        <label class=\"block text-[11px] font-semibold text-[#6b7280] mb-1\" data-kid=\"1-1-2-2-2-1-1\" data-name=\"specialty label\">\n                            Especialidad\n                        </label>\n                        <div class=\"flex items-center gap-2\" data-kid=\"1-1-2-2-2-1-2\" data-name=\"input field box\">\n                            <input class=\"w-full bg-transparent text-[14px] font-semibold text-[#111827] outline-none\" data-kid=\"1-1-2-2-2-1-2-1\" data-name=\"specialty text input\" type=\"text\" value=\"Nutrición Clínica y Deportiva\"/>\n                            <i class=\"ti ti-pencil text-[15px] text-[#7c3aed]\" data-kid=\"1-1-2-2-2-1-2-2\" data-name=\"edit pencil icon\">\n                            </i>\n                        </div>\n                    </div>\n                    <div class=\"px-4 py-3\" data-kid=\"1-1-2-2-2-2\" data-name=\"license input field container\">\n                        <label class=\"block text-[11px] font-semibold text-[#6b7280] mb-1\" data-kid=\"1-1-2-2-2-2-1\" data-name=\"license label\">\n                            Matrícula profesional\n                        </label>\n                        <div class=\"flex items-center gap-2\" data-kid=\"1-1-2-2-2-2-2\" data-name=\"input field box\">\n                            <input class=\"w-full bg-transparent text-[14px] font-semibold text-[#111827] outline-none\" data-kid=\"1-1-2-2-2-2-2-1\" data-name=\"license text input\" type=\"text\" value=\"MP 4521 · MN 8823\"/>\n                            <i class=\"ti ti-pencil text-[15px] text-[#7c3aed]\" data-kid=\"1-1-2-2-2-2-2-2\" data-name=\"edit pencil icon\">\n                            </i>\n                        </div>\n                    </div>\n                    <div class=\"px-4 py-4\" data-kid=\"1-1-2-2-2-3\" data-name=\"logo upload section\">\n                        <label class=\"block text-[11px] font-semibold text-[#6b7280] mb-2\" data-kid=\"1-1-2-2-2-3-1\" data-name=\"logo label\">\n                            Logo de la clínica\n                        </label>\n                        <div class=\"flex items-center gap-3\" data-kid=\"1-1-2-2-2-3-2\" data-name=\"logo upload area\">\n                            <div class=\"h-[52px] w-[52px] shrink-0 rounded-xl border border-dashed border-[#c4b5fd] bg-[#faf9ff] grid place-items-center text-[#7c3aed]\" data-kid=\"1-1-2-2-2-3-2-1\" data-name=\"placeholder logo icon\">\n                                <i class=\"ti ti-photo-plus text-[20px]\" data-kid=\"1-1-2-2-2-3-2-1-1\" data-name=\"photo plus icon\">\n                                </i>\n                            </div>\n                            <p class=\"min-w-0 flex-1 text-[12px] text-[#6b7280] leading-snug\" data-kid=\"1-1-2-2-2-3-2-2\" data-name=\"logo helper text\">\n                                Sin logo cargado. Aparece arriba de cada reporte.\n                            </p>\n                            <button class=\"shrink-0 rounded-full border border-[#5b21b6] px-3.5 py-2 text-[12px] font-semibold text-[#5b21b6]\" data-kid=\"1-1-2-2-2-3-2-3\" data-name=\"upload logo button\">\n                                Cambiar logo\n                            </button>\n                        </div>\n                    </div>\n                </div>\n                <div class=\"mt-3 flex items-start gap-2.5 rounded-xl border border-[#fde68a] bg-[#fffbeb] px-3.5 py-3\" data-kid=\"1-1-2-2-3\" data-name=\"missing logo alert box\">\n                    <i class=\"ti ti-alert-triangle text-[16px] text-[#d97706] mt-[1px]\" data-kid=\"1-1-2-2-3-1\" data-name=\"warning icon\">\n                    </i>\n                    <p class=\"text-[12.5px] leading-snug text-[#92400e]\" data-kid=\"1-1-2-2-3-2\" data-name=\"warning alert text\">\n                        Falta cargar el logo de la clínica. El encabezado del reporte se genera sin él.\n                    </p>\n                </div>\n            </section>\n            <!-- Preview encabezado -->\n            <section class=\"px-5 mt-6\" data-kid=\"1-1-2-3\" data-name=\"preview section\">\n                <h3 class=\"text-[13px] font-bold uppercase tracking-[0.06em] text-[#111827]\" data-kid=\"1-1-2-3-1\" data-name=\"preview section title\">\n                    Encabezado del reporte\n                </h3>\n                <div class=\"mt-3 rounded-2xl border border-[#e5e7eb] bg-white p-4\" data-kid=\"1-1-2-3-2\" data-name=\"preview container\">\n                    <div class=\"rounded-xl border border-[#e5e7eb] bg-[#fcfcfe] p-4\" data-kid=\"1-1-2-3-2-1\" data-name=\"report header visual\">\n                        <div class=\"flex items-center justify-between gap-3\" data-kid=\"1-1-2-3-2-1-1\" data-name=\"header identity layout\">\n                            <div class=\"flex items-center gap-3 min-w-0\" data-kid=\"1-1-2-3-2-1-1-1\" data-name=\"header identity info\">\n                                <div class=\"h-11 w-11 shrink-0 rounded-lg bg-[#f3efff] border border-[#e9e2ff] grid place-items-center text-[#5b21b6]\" data-kid=\"1-1-2-3-2-1-1-1-1\" data-name=\"hospital icon wrapper\">\n                                    <i class=\"ti ti-building-hospital text-[20px]\" data-kid=\"1-1-2-3-2-1-1-1-1-1\" data-name=\"hospital icon\">\n                                    </i>\n                                </div>\n                                <div class=\"min-w-0\" data-kid=\"1-1-2-3-2-1-1-1-2\" data-name=\"header name info\">\n                                    <p class=\"text-[13.5px] font-bold truncate\" data-kid=\"1-1-2-3-2-1-1-1-2-1\" data-name=\"report professional name\">\n                                        Lic. Marina Gutiérrez\n                                    </p>\n                                    <p class=\"text-[11.5px] text-[#6b7280] truncate\" data-kid=\"1-1-2-3-2-1-1-1-2-2\" data-name=\"report professional title\">\n                                        Nutricionista Clínica\n                                    </p>\n                                </div>\n                            </div>\n                            <div class=\"text-right shrink-0\" data-kid=\"1-1-2-3-2-1-1-2\" data-name=\"header license info\">\n                                <p class=\"text-[10px] uppercase tracking-[0.1em] text-[#9ca3af] font-semibold\" data-kid=\"1-1-2-3-2-1-1-2-1\" data-name=\"license label\">\n                                    Matrícula\n                                </p>\n                                <p class=\"text-[11.5px] font-semibold text-[#111827]\" data-kid=\"1-1-2-3-2-1-1-2-2\" data-name=\"license value\">\n                                    MP 4521 · MN 8823\n                                </p>\n                            </div>\n                        </div>\n                        <div class=\"mt-3 h-px bg-[#e5e7eb]\" data-kid=\"1-1-2-3-2-1-2\" data-name=\"separator line\">\n                        </div>\n                        <p class=\"mt-3 text-[11px] text-[#9ca3af]\" data-kid=\"1-1-2-3-2-1-3\" data-name=\"report footer text\">\n                            Informe nutricional · Generado desde Nutringest\n                        </p>\n                    </div>\n                    <p class=\"mt-2.5 text-[11.5px] text-[#6b7280]\" data-kid=\"1-1-2-3-2-2\" data-name=\"preview helper text\">\n                        Vista previa en vivo de cómo se verá tu identidad en los reportes.\n                    </p>\n                </div>\n            </section>\n            <!-- Datos personales -->\n            <section class=\"px-5 mt-6\" data-kid=\"1-1-2-4\" data-name=\"personal data section\">\n                <h3 class=\"text-[13px] font-bold uppercase tracking-[0.06em] text-[#111827]\" data-kid=\"1-1-2-4-1\" data-name=\"personal data section title\">\n                    Datos personales\n                </h3>\n                <div class=\"mt-3 rounded-2xl border border-[#e5e7eb] bg-white divide-y divide-[#e5e7eb] overflow-hidden\" data-kid=\"1-1-2-4-2\" data-name=\"personal data list\">\n                    <div class=\"flex items-center gap-3 px-4 py-3\" data-kid=\"1-1-2-4-2-1\" data-name=\"email row\">\n                        <i class=\"ti ti-mail text-[18px] text-[#7c3aed]\" data-kid=\"1-1-2-4-2-1-1\" data-name=\"mail icon\">\n                        </i>\n                        <div class=\"min-w-0 flex-1\" data-kid=\"1-1-2-4-2-1-2\" data-name=\"email text group\">\n                            <p class=\"text-[11px] font-semibold text-[#6b7280]\" data-kid=\"1-1-2-4-2-1-2-1\" data-name=\"email label\">\n                                Email\n                            </p>\n                            <p class=\"text-[13.5px] font-semibold truncate\" data-kid=\"1-1-2-4-2-1-2-2\" data-name=\"email address\">\n                                marina.gutierrez@nutringest.app\n                            </p>\n                        </div>\n                    </div>\n                    <div class=\"flex items-center gap-3 px-4 py-3\" data-kid=\"1-1-2-4-2-2\" data-name=\"phone row\">\n                        <i class=\"ti ti-phone text-[18px] text-[#7c3aed]\" data-kid=\"1-1-2-4-2-2-1\" data-name=\"phone icon\">\n                        </i>\n                        <div class=\"min-w-0 flex-1\" data-kid=\"1-1-2-4-2-2-2\" data-name=\"phone text group\">\n                            <p class=\"text-[11px] font-semibold text-[#6b7280]\" data-kid=\"1-1-2-4-2-2-2-1\" data-name=\"phone label\">\n                                Teléfono\n                            </p>\n                            <p class=\"text-[13.5px] font-semibold\" data-kid=\"1-1-2-4-2-2-2-2\" data-name=\"phone number\">\n                                +54 11 5544 8821\n                            </p>\n                        </div>\n                    </div>\n                    <div class=\"flex items-center gap-3 px-4 py-3\" data-kid=\"1-1-2-4-2-3\" data-name=\"location row\">\n                        <i class=\"ti ti-map-pin text-[18px] text-[#7c3aed]\" data-kid=\"1-1-2-4-2-3-1\" data-name=\"location icon\">\n                        </i>\n                        <div class=\"min-w-0 flex-1\" data-kid=\"1-1-2-4-2-3-2\" data-name=\"location text group\">\n                            <p class=\"text-[11px] font-semibold text-[#6b7280]\" data-kid=\"1-1-2-4-2-3-2-1\" data-name=\"location label\">\n                                Ciudad\n                            </p>\n                            <p class=\"text-[13.5px] font-semibold\" data-kid=\"1-1-2-4-2-3-2-2\" data-name=\"location address\">\n                                Buenos Aires, Argentina\n                            </p>\n                        </div>\n                        <i class=\"ti ti-pencil text-[15px] text-[#b6bcc7]\" data-kid=\"1-1-2-4-2-3-3\" data-name=\"edit icon\">\n                        </i>\n                    </div>\n                </div>\n            </section>\n            <!-- Security -->\n            <section class=\"px-5 mt-6 pb-6\" data-kid=\"1-1-2-5\" data-name=\"secondary link section\">\n                <button class=\"w-full rounded-2xl border border-[#e5e7eb] bg-white px-4 py-3.5 flex items-center justify-between\" data-kid=\"1-1-2-5-1\" data-name=\"security button\">\n                    <span class=\"flex items-center gap-3 text-[13.5px] font-semibold text-[#111827]\" data-kid=\"1-1-2-5-1-1\" data-name=\"security button text\">\n                        <i class=\"ti ti-shield-lock text-[18px] text-[#6b7280]\" data-kid=\"1-1-2-5-1-1-1\" data-name=\"shield lock icon\">\n                        </i>\n                        Seguridad y contraseña\n                    </span>\n                    <i class=\"ti ti-chevron-right text-[18px] text-[#9ca3af]\" data-kid=\"1-1-2-5-1-2\" data-name=\"chevron icon\">\n                    </i>\n                </button>\n                <p class=\"mt-3 text-center text-[11px] text-[#9ca3af]\" data-kid=\"1-1-2-5-2\" data-name=\"session info text\">\n                    Sesión activa · renovación automática cada 30 días\n                </p>\n            </section>\n        </div>\n        <!-- Sticky action -->\n        <div class=\"shrink-0 bg-white/95 backdrop-blur border-t border-[#e5e7eb] px-5 py-3\" data-kid=\"1-1-3\" data-name=\"sticky footer container\">\n            <button class=\"w-full rounded-full bg-[#5b21b6] py-3.5 text-[15px] font-semibold text-white active:scale-[0.98] transition-transform\" data-kid=\"1-1-3-1\" data-name=\"save button\">\n                Guardar cambios\n            </button>\n        </div>\n        <!-- Tab bar -->\n        <nav class=\"shrink-0 bg-white border-t border-[#e5e7eb] px-2 pt-2 pb-3\" data-kid=\"1-1-4\" data-name=\"navigation menu bar\">\n            <ul class=\"grid grid-cols-4\" data-kid=\"1-1-4-1\" data-name=\"nav links list\">\n                <li class=\"flex flex-col items-center gap-1 py-1 text-[#9ca3af]\" data-kid=\"1-1-4-1-1\" data-name=\"nav item patients\">\n                    <i class=\"ti ti-users text-[22px]\" data-kid=\"1-1-4-1-1-1\" data-name=\"patients icon\">\n                    </i>\n                    <span class=\"text-[10.5px] font-semibold\" data-kid=\"1-1-4-1-1-2\" data-name=\"patients label\">\n                        Pacientes\n                    </span>\n                </li>\n                <li class=\"flex flex-col items-center gap-1 py-1 text-[#9ca3af]\" data-kid=\"1-1-4-1-2\" data-name=\"nav item plans\">\n                    <i class=\"ti ti-clipboard-list text-[22px]\" data-kid=\"1-1-4-1-2-1\" data-name=\"plans icon\">\n                    </i>\n                    <span class=\"text-[10.5px] font-semibold\" data-kid=\"1-1-4-1-2-2\" data-name=\"plans label\">\n                        Planes\n                    </span>\n                </li>\n                <li class=\"flex flex-col items-center gap-1 py-1 text-[#9ca3af]\" data-kid=\"1-1-4-1-3\" data-name=\"nav item tools\">\n                    <i class=\"ti ti-tools text-[22px]\" data-kid=\"1-1-4-1-3-1\" data-name=\"tools icon\">\n                    </i>\n                    <span class=\"text-[10.5px] font-semibold\" data-kid=\"1-1-4-1-3-2\" data-name=\"tools label\">\n                        Herramientas\n                    </span>\n                </li>\n                <li class=\"flex flex-col items-center gap-1 py-1 text-[#5b21b6]\" data-kid=\"1-1-4-1-4\" data-name=\"nav item profile\">\n                    <i class=\"ti ti-user-circle text-[22px]\" data-kid=\"1-1-4-1-4-1\" data-name=\"profile icon\">\n                    </i>\n                    <span class=\"text-[10.5px] font-bold\" data-kid=\"1-1-4-1-4-2\" data-name=\"profile label\">\n                        Perfil\n                    </span>\n                </li>\n            </ul>\n        </nav>\n    </div>\n</div>\n",
