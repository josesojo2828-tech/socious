      "html": "<style>\n    @import url('https://fonts.googleapis.com/css2?family=Montserrat:wght@300;400;500;600;700;800&display=swap');\n  @import url(\"https://cdn.jsdelivr.net/npm/@tabler/icons-webfont@3.48.0/dist/tabler-icons.min.css\");\n  .ng-input::placeholder { color: #c7cbd3; }\n  .ng-input:focus { outline: none; }\n</style>\n<div class=\"w-[375px] h-[812px] bg-[#f6f7f9] flex flex-col overflow-hidden\" data-kid=\"1\" style=\"font-family:'Montserrat',system-ui,sans-serif; color:#111827;\">\n    <!-- Status bar -->\n    <div class=\"shrink-0 flex items-center justify-between px-5 pt-3 pb-1\" data-kid=\"1-1\">\n        <span class=\"text-[12px] font-bold tracking-wide text-[#111827]\" data-dynamic=\"true\" data-kid=\"1-1-1\" data-name=\"current time text\" data-reason=\"text updated by system clock\">\n            08:42\n        </span>\n        <div class=\"flex items-center gap-1.5 text-[#111827]\" data-kid=\"1-1-2\">\n            <i class=\"ti ti-signal-4g text-[14px]\" data-kid=\"1-1-2-1\">\n            </i>\n            <i class=\"ti ti-wifi text-[14px]\" data-kid=\"1-1-2-2\">\n            </i>\n            <i class=\"ti ti-battery-3 text-[16px]\" data-kid=\"1-1-2-3\">\n            </i>\n        </div>\n    </div>\n    <!-- Scrollable content -->\n    <div class=\"flex-1 overflow-y-auto\" data-kid=\"1-2\">\n        <!-- App bar -->\n        <header class=\"px-4 pb-2.5 flex items-center gap-3\" data-kid=\"1-2-1\">\n            <button class=\"shrink-0 w-9 h-9 rounded-full bg-white border border-[#e5e7eb] flex items-center justify-center text-[#111827]\" data-kid=\"1-2-1-1\">\n                <i class=\"ti ti-arrow-left text-[19px]\" data-kid=\"1-2-1-1-1\">\n                </i>\n            </button>\n            <div class=\"flex-1 min-w-0\" data-kid=\"1-2-1-2\">\n                <h1 class=\"text-[16px] font-bold leading-tight\" data-kid=\"1-2-1-2-1\">\n                    Antropometría ISAK\n                </h1>\n                <p class=\"text-[11.5px] text-[#6b7280] truncate\" data-kid=\"1-2-1-2-2\">\n                    María González · 34 años · F\n                </p>\n            </div>\n            <button class=\"shrink-0 w-9 h-9 rounded-full bg-white border border-[#e5e7eb] flex items-center justify-center text-[#6b7280]\" data-kid=\"1-2-1-3\">\n                <i class=\"ti ti-dots-vertical text-[19px]\" data-kid=\"1-2-1-3-1\">\n                </i>\n            </button>\n        </header>\n        <!-- Session strip -->\n        <div class=\"mx-4 mb-3 rounded-2xl bg-white border border-[#e5e7eb] px-3.5 py-2 flex items-center gap-3\" data-kid=\"1-2-2\">\n            <div class=\"shrink-0 w-8 h-8 rounded-xl bg-[#f3e8ff] text-[#7c3aed] flex items-center justify-center\" data-kid=\"1-2-2-1\">\n                <i class=\"ti ti-calendar-event text-[17px]\" data-kid=\"1-2-2-1-1\">\n                </i>\n            </div>\n            <div class=\"flex-1 min-w-0\" data-kid=\"1-2-2-2\">\n                <p class=\"text-[12.5px] font-semibold leading-tight\" data-kid=\"1-2-2-2-1\">\n                    Sesión · 02 Oct 2026\n                </p>\n                <p class=\"text-[10.5px] text-[#6b7280]\" data-kid=\"1-2-2-2-2\">\n                    08:42 · Consultorio 2\n                </p>\n            </div>\n            <span class=\"text-[10.5px] font-semibold px-2 py-1 rounded-full bg-[#ecfdf5] text-[#047857] border border-[#a7f3d0]\" data-kid=\"1-2-2-3\">\n                ISAK 1\n            </span>\n        </div>\n        <!-- Group switch -->\n        <div class=\"mx-4 mb-3.5 flex gap-1 p-1 rounded-2xl bg-[#eceef2]\" data-kid=\"1-2-3\">\n            <button class=\"flex-1 rounded-xl py-1.5 text-[12.5px] font-bold bg-white text-[#5b21b6] shadow-[0_1px_2px_rgba(17,24,39,0.08)]\" data-kid=\"1-2-3-1\">\n                Pliegues\n            </button>\n            <button class=\"flex-1 rounded-xl py-1.5 text-[12.5px] font-semibold text-[#6b7280]\" data-kid=\"1-2-3-2\">\n                Perímetros\n            </button>\n            <button class=\"flex-1 rounded-xl py-1.5 text-[12.5px] font-semibold text-[#6b7280]\" data-kid=\"1-2-3-3\">\n                Diámetros\n            </button>\n        </div>\n        <!-- Section header -->\n        <div class=\"px-4 mb-2.5 flex items-end justify-between\" data-kid=\"1-2-4\">\n            <div data-kid=\"1-2-4-1\">\n                <h2 class=\"text-[12.5px] font-extrabold uppercase tracking-[0.04em] text-[#2b0c4f]\" data-kid=\"1-2-4-1-1\">\n                    Pliegues cutáneos\n                </h2>\n                <p class=\"text-[10.5px] text-[#6b7280] mt-0.5\" data-kid=\"1-2-4-1-2\">\n                    Milímetros (mm) · toca para editar\n                </p>\n            </div>\n            <span class=\"text-[11px] font-bold text-[#6b7280]\" data-kid=\"1-2-4-2\">\n                6 de 8\n            </span>\n        </div>\n        <!-- Measurement grid -->\n        <div class=\"px-4 grid grid-cols-2 gap-2.5\" data-kid=\"1-2-5\">\n            <div class=\"rounded-2xl bg-white border border-[#e5e7eb] px-3.5 pt-2.5 pb-2.5\" data-kid=\"1-2-5-1\">\n                <div class=\"flex items-center gap-1.5\" data-kid=\"1-2-5-1-1\">\n                    <span class=\"w-1.5 h-1.5 rounded-full bg-[#7c3aed]\" data-kid=\"1-2-5-1-1-1\">\n                    </span>\n                    <span class=\"text-[11.5px] font-semibold text-[#6b7280]\" data-kid=\"1-2-5-1-1-2\">\n                        Tricipital\n                    </span>\n                </div>\n                <div class=\"flex items-baseline gap-1 mt-1\" data-kid=\"1-2-5-1-2\">\n                    <input class=\"ng-input w-full bg-transparent text-[24px] font-bold tabular-nums leading-none text-[#111827] p-0\" data-dynamic=\"true\" data-kid=\"1-2-5-1-2-1\" data-name=\"tricipital skinfold input field\" data-reason=\"value controlled by form state\" inputmode=\"decimal\" value=\"18.5\"/>\n                    <span class=\"text-[11px] font-semibold text-[#9ca3af]\" data-kid=\"1-2-5-1-2-2\">\n                        mm\n                    </span>\n                </div>\n            </div>\n            <div class=\"rounded-2xl bg-white border border-[#e5e7eb] px-3.5 pt-2.5 pb-2.5\" data-kid=\"1-2-5-2\">\n                <div class=\"flex items-center gap-1.5\" data-kid=\"1-2-5-2-1\">\n                    <span class=\"w-1.5 h-1.5 rounded-full bg-[#7c3aed]\" data-kid=\"1-2-5-2-1-1\">\n                    </span>\n                    <span class=\"text-[11.5px] font-semibold text-[#6b7280]\" data-kid=\"1-2-5-2-1-2\">\n                        Subescapular\n                    </span>\n                </div>\n                <div class=\"flex items-baseline gap-1 mt-1\" data-kid=\"1-2-5-2-2\">\n                    <input class=\"ng-input w-full bg-transparent text-[24px] font-bold tabular-nums leading-none text-[#111827] p-0\" data-dynamic=\"true\" data-kid=\"1-2-5-2-2-1\" data-name=\"subescapular skinfold input field\" data-reason=\"value controlled by form state\" inputmode=\"decimal\" value=\"14.2\"/>\n                    <span class=\"text-[11px] font-semibold text-[#9ca3af]\" data-kid=\"1-2-5-2-2-2\">\n                        mm\n                    </span>\n                </div>\n            </div>\n            <div class=\"rounded-2xl bg-white border border-[#e5e7eb] px-3.5 pt-2.5 pb-2.5\" data-kid=\"1-2-5-3\">\n                <div class=\"flex items-center gap-1.5\" data-kid=\"1-2-5-3-1\">\n                    <span class=\"w-1.5 h-1.5 rounded-full bg-[#e5e7eb]\" data-kid=\"1-2-5-3-1-1\">\n                    </span>\n                    <span class=\"text-[11.5px] font-semibold text-[#6b7280]\" data-kid=\"1-2-5-3-1-2\">\n                        Suprailíaco\n                    </span>\n                </div>\n                <div class=\"flex items-baseline gap-1 mt-1\" data-kid=\"1-2-5-3-2\">\n                    <input class=\"ng-input w-full bg-transparent text-[24px] font-bold tabular-nums leading-none text-[#111827] p-0\" data-dynamic=\"true\" data-kid=\"1-2-5-3-2-1\" data-name=\"suprailiaco skinfold input field\" data-reason=\"value controlled by form state\" inputmode=\"decimal\" value=\"16.8\"/>\n                    <span class=\"text-[11px] font-semibold text-[#9ca3af]\" data-kid=\"1-2-5-3-2-2\">\n                        mm\n                    </span>\n                </div>\n            </div>\n            <div class=\"rounded-2xl bg-white border border-[#e5e7eb] px-3.5 pt-2.5 pb-2.5\" data-kid=\"1-2-5-4\">\n                <div class=\"flex items-center gap-1.5\" data-kid=\"1-2-5-4-1\">\n                    <span class=\"w-1.5 h-1.5 rounded-full bg-[#e5e7eb]\" data-kid=\"1-2-5-4-1-1\">\n                    </span>\n                    <span class=\"text-[11.5px] font-semibold text-[#6b7280]\" data-kid=\"1-2-5-4-1-2\">\n                        Bicipital\n                    </span>\n                </div>\n                <div class=\"flex items-baseline gap-1 mt-1\" data-kid=\"1-2-5-4-2\">\n                    <input class=\"ng-input w-full bg-transparent text-[24px] font-bold tabular-nums leading-none text-[#111827] p-0\" data-dynamic=\"true\" data-kid=\"1-2-5-4-2-1\" data-name=\"bicipital skinfold input field\" data-reason=\"value controlled by form state\" inputmode=\"decimal\" value=\"9.4\"/>\n                    <span class=\"text-[11px] font-semibold text-[#9ca3af]\" data-kid=\"1-2-5-4-2-2\">\n                        mm\n                    </span>\n                </div>\n            </div>\n            <div class=\"rounded-2xl bg-white border border-[#e5e7eb] px-3.5 pt-2.5 pb-2.5\" data-kid=\"1-2-5-5\">\n                <div class=\"flex items-center gap-1.5\" data-kid=\"1-2-5-5-1\">\n                    <span class=\"w-1.5 h-1.5 rounded-full bg-[#7c3aed]\" data-kid=\"1-2-5-5-1-1\">\n                    </span>\n                    <span class=\"text-[11.5px] font-semibold text-[#6b7280]\" data-kid=\"1-2-5-5-1-2\">\n                        Supraespinal\n                    </span>\n                </div>\n                <div class=\"flex items-baseline gap-1 mt-1\" data-kid=\"1-2-5-5-2\">\n                    <input class=\"ng-input w-full bg-transparent text-[24px] font-bold tabular-nums leading-none text-[#111827] p-0\" data-dynamic=\"true\" data-kid=\"1-2-5-5-2-1\" data-name=\"supraespinal skinfold input field\" data-reason=\"value controlled by form state\" inputmode=\"decimal\" value=\"12.6\"/>\n                    <span class=\"text-[11px] font-semibold text-[#9ca3af]\" data-kid=\"1-2-5-5-2-2\">\n                        mm\n                    </span>\n                </div>\n            </div>\n            <div class=\"rounded-2xl bg-white border border-[#e5e7eb] px-3.5 pt-2.5 pb-2.5\" data-kid=\"1-2-5-6\">\n                <div class=\"flex items-center gap-1.5\" data-kid=\"1-2-5-6-1\">\n                    <span class=\"w-1.5 h-1.5 rounded-full bg-[#7c3aed]\" data-kid=\"1-2-5-6-1-1\">\n                    </span>\n                    <span class=\"text-[11.5px] font-semibold text-[#6b7280]\" data-kid=\"1-2-5-6-1-2\">\n                        Abdominal\n                    </span>\n                </div>\n                <div class=\"flex items-baseline gap-1 mt-1\" data-kid=\"1-2-5-6-2\">\n                    <input class=\"ng-input w-full bg-transparent text-[24px] font-bold tabular-nums leading-none text-[#111827] p-0\" data-dynamic=\"true\" data-kid=\"1-2-5-6-2-1\" data-name=\"abdominal skinfold input field\" data-reason=\"value controlled by form state\" inputmode=\"decimal\" value=\"22.3\"/>\n                    <span class=\"text-[11px] font-semibold text-[#9ca3af]\" data-kid=\"1-2-5-6-2-2\">\n                        mm\n                    </span>\n                </div>\n            </div>\n            <!-- Active / focused field -->\n            <div class=\"rounded-2xl bg-white border-2 border-[#7c3aed] px-3.5 pt-2.5 pb-2.5\" data-kid=\"1-2-5-7\" style=\"box-shadow:0 0 0 4px rgba(124,58,237,0.14);\">\n                <div class=\"flex items-center gap-1.5\" data-kid=\"1-2-5-7-1\">\n                    <span class=\"w-1.5 h-1.5 rounded-full bg-[#7c3aed]\" data-kid=\"1-2-5-7-1-1\">\n                    </span>\n                    <span class=\"text-[11.5px] font-semibold text-[#7c3aed]\" data-kid=\"1-2-5-7-1-2\">\n                        Muslo\n                    </span>\n                </div>\n                <div class=\"flex items-baseline gap-1 mt-1\" data-kid=\"1-2-5-7-2\">\n                    <span class=\"w-[3px] h-[22px] rounded-full bg-[#7c3aed] animate-pulse\" data-kid=\"1-2-5-7-2-1\">\n                    </span>\n                    <input class=\"ng-input w-full bg-transparent text-[24px] font-bold tabular-nums leading-none text-[#111827] p-0\" data-dynamic=\"true\" data-kid=\"1-2-5-7-2-2\" data-name=\"muslo skinfold input field\" data-reason=\"value controlled by form state\" inputmode=\"decimal\" placeholder=\"0.0\"/>\n                    <span class=\"text-[11px] font-semibold text-[#9ca3af]\" data-kid=\"1-2-5-7-2-3\">\n                        mm\n                    </span>\n                </div>\n            </div>\n            <div class=\"rounded-2xl bg-white border border-[#e5e7eb] px-3.5 pt-2.5 pb-2.5\" data-kid=\"1-2-5-8\">\n                <div class=\"flex items-center gap-1.5\" data-kid=\"1-2-5-8-1\">\n                    <span class=\"w-1.5 h-1.5 rounded-full bg-[#7c3aed]\" data-kid=\"1-2-5-8-1-1\">\n                    </span>\n                    <span class=\"text-[11.5px] font-semibold text-[#6b7280]\" data-kid=\"1-2-5-8-1-2\">\n                        Pantorrilla\n                    </span>\n                </div>\n                <div class=\"flex items-baseline gap-1 mt-1\" data-kid=\"1-2-5-8-2\">\n                    <input class=\"ng-input w-full bg-transparent text-[24px] font-bold tabular-nums leading-none text-[#111827] p-0\" data-dynamic=\"true\" data-kid=\"1-2-5-8-2-1\" data-name=\"pantorrilla skinfold input field\" data-reason=\"value controlled by form state\" inputmode=\"decimal\" placeholder=\"0.0\"/>\n                    <span class=\"text-[11px] font-semibold text-[#9ca3af]\" data-kid=\"1-2-5-8-2-2\">\n                        mm\n                    </span>\n                </div>\n            </div>\n        </div>\n        <div class=\"px-4 mt-3 flex items-center justify-between\" data-kid=\"1-2-6\">\n            <p class=\"text-[10.5px] text-[#9ca3af] flex items-center gap-1.5\" data-kid=\"1-2-6-1\">\n                <span class=\"w-1.5 h-1.5 rounded-full bg-[#7c3aed]\" data-kid=\"1-2-6-1-1\">\n                </span>\n                Incluido en la suma de 6\n            </p>\n            <p class=\"text-[10.5px] text-[#6b7280]\" data-kid=\"1-2-6-2\">\n                Última:\n                <span class=\"font-semibold text-[#111827]\" data-kid=\"1-2-6-2-1\">\n                    118.6 mm\n                </span>\n                · 12 Sep\n            </p>\n        </div>\n    </div>\n    <!-- Sticky action + live results -->\n    <footer class=\"shrink-0 px-4 pt-3 pb-5 bg-[#f6f7f9]/95 border-t border-[#e5e7eb]\" data-kid=\"1-3\">\n        <div class=\"rounded-2xl bg-[#2b0c4f] text-white px-3.5 py-2.5\" data-kid=\"1-3-1\">\n            <div class=\"flex items-center justify-between\" data-kid=\"1-3-1-1\">\n                <div class=\"flex items-center gap-1.5\" data-kid=\"1-3-1-1-1\">\n                    <span class=\"w-2 h-2 rounded-full bg-[#34d399]\" data-kid=\"1-3-1-1-1-1\">\n                    </span>\n                    <span class=\"text-[11px] font-extrabold tracking-wide\" data-kid=\"1-3-1-1-1-2\">\n                        Cálculo en vivo\n                    </span>\n                </div>\n                <span class=\"text-[10px] font-medium text-white/45\" data-kid=\"1-3-1-1-2\">\n                    se actualiza al tipear\n                </span>\n            </div>\n            <div class=\"grid grid-cols-3 gap-2 mt-2\" data-kid=\"1-3-1-2\">\n                <div data-kid=\"1-3-1-2-1\">\n                    <p class=\"text-[10px] uppercase tracking-wide font-bold text-white/55\" data-kid=\"1-3-1-2-1-1\">\n                        Suma 6\n                    </p>\n                    <p class=\"text-[18px] font-bold leading-tight mt-0.5\" data-dynamic=\"true\" data-kid=\"1-3-1-2-1-2\" data-name=\"sum of six skinfolds display\" data-reason=\"text updated by live calculation script\">\n                        —\n                    </p>\n                </div>\n                <div data-kid=\"1-3-1-2-2\">\n                    <p class=\"text-[10px] uppercase tracking-wide font-bold text-white/55\" data-kid=\"1-3-1-2-2-1\">\n                        % Grasa\n                    </p>\n                    <p class=\"text-[18px] font-bold leading-tight mt-0.5\" data-dynamic=\"true\" data-kid=\"1-3-1-2-2-2\" data-name=\"percentage fat calculation\" data-reason=\"text updated by live calculation script\">\n                        —\n                    </p>\n                </div>\n                <div data-kid=\"1-3-1-2-3\">\n                    <p class=\"text-[10px] uppercase tracking-wide font-bold text-white/55\" data-kid=\"1-3-1-2-3-1\">\n                        % Músculo\n                    </p>\n                    <p class=\"text-[18px] font-bold leading-tight mt-0.5\" data-dynamic=\"true\" data-kid=\"1-3-1-2-3-2\" data-name=\"percentage muscle mass calculation\" data-reason=\"text updated by live calculation script\">\n                        —\n                    </p>\n                </div>\n            </div>\n            <div class=\"mt-1.5 flex items-start gap-1.5 text-[10.5px] leading-snug text-[#fbbf24]\" data-kid=\"1-3-1-3\">\n                <i class=\"ti ti-alert-triangle text-[12px] mt-[1px]\" data-kid=\"1-3-1-3-1\">\n                </i>\n                <span data-kid=\"1-3-1-3-2\">\n                    Faltan 2 pliegues para la suma ·\n                    <span class=\"font-semibold\" data-dynamic=\"true\" data-kid=\"1-3-1-3-2-1\" data-name=\"missing skinfolds list\" data-reason=\"text updated by validation logic\">\n                        muslo, pantorrilla\n                    </span>\n                </span>\n            </div>\n        </div>\n        <button class=\"mt-2.5 w-full h-[52px] rounded-full bg-[#5b21b6] text-white text-[15px] font-bold flex items-center justify-center gap-2 active:scale-[0.98]\" data-kid=\"1-3-2\">\n            <i class=\"ti ti-device-floppy text-[18px]\" data-kid=\"1-3-2-1\">\n            </i>\n            Guardar medidas\n        </button>\n        <p class=\"text-center text-[11px] text-[#6b7280] mt-2\" data-kid=\"1-3-3\">\n            Se guardará en la ficha de María González\n        </p>\n        <div class=\"mx-auto mt-2.5 w-[120px] h-[5px] rounded-full bg-[#d1d5db]\" data-kid=\"1-3-4\">\n        </div>\n    </footer>\n</div>\n",
