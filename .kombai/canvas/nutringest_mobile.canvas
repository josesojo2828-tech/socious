      },
      "html": "<div class=\"h-[812px] w-full overflow-hidden bg-[#f6f7f9] text-[#111827] antialiased flex flex-col\" data-kid=\"1\" data-name=\"mobile app layout container\" style=\"font-family:'Montserrat',system-ui,-apple-system,sans-serif;\">\n    <style>\n        @import url('https://fonts.googleapis.com/css2?family=Montserrat:wght@400;500;600;700;800&display=swap');\n    @import url('https://cdn.jsdelivr.net/npm/@tabler/icons-webfont@3.48.0/dist/tabler-icons.min.css');\n    .no-scrollbar::-webkit-scrollbar{display:none}\n    .no-scrollbar{-ms-overflow-style:none;scrollbar-width:none}\n    </style>\n    <!-- STATUS BAR -->\n    <div class=\"flex items-center justify-between px-5 pt-3 pb-1.5 bg-white text-[11.5px] font-semibold text-[#2b0c4f] select-none shrink-0\" data-kid=\"1-1\" data-name=\"status bar\">\n        <span data-dynamic=\"true\" data-kid=\"1-1-1\" data-name=\"current time text\" data-reason=\"text updated by system time\">\n            9:41\n        </span>\n        <div class=\"flex items-center gap-1.5 text-[14px]\" data-kid=\"1-1-2\" data-name=\"connectivity and battery indicator group\">\n            <i class=\"ti ti-wifi\" data-kid=\"1-1-2-1\" data-name=\"wifi signal icon\">\n            </i>\n            <i class=\"ti ti-battery-3\" data-kid=\"1-1-2-2\" data-name=\"battery level icon\">\n            </i>\n        </div>\n    </div>\n    <!-- HEADER -->\n    <header class=\"bg-white px-5 pt-1 pb-3 border-b border-[#e5e7eb] shrink-0\" data-kid=\"1-2\" data-name=\"header section\">\n        <div class=\"flex items-start justify-between gap-3\" data-kid=\"1-2-1\" data-name=\"header title and barcode scan group\">\n            <div data-kid=\"1-2-1-1\" data-name=\"header title and subtitle container\">\n                <h1 class=\"text-[21px] leading-tight font-extrabold tracking-tight text-[#2b0c4f]\" data-kid=\"1-2-1-1-1\" data-name=\"main page headline\">\n                    Alimentos y recetas\n                </h1>\n                <p class=\"text-[12px] text-[#6b7280] mt-0.5\" data-kid=\"1-2-1-1-2\" data-name=\"page subtitle text\">\n                    Tabla de composición nutricional\n                </p>\n            </div>\n            <button class=\"shrink-0 h-10 w-10 rounded-xl border border-[#e5e7eb] grid place-items-center text-[#5b21b6] text-[19px]\" data-kid=\"1-2-1-2\" data-name=\"barcode scanner button\">\n                <i class=\"ti ti-barcode\" data-kid=\"1-2-1-2-1\" data-name=\"barcode icon\">\n                </i>\n            </button>\n        </div>\n        <!-- SEARCH -->\n        <div class=\"mt-3 relative\" data-kid=\"1-2-2\" data-name=\"search input field group\">\n            <i class=\"ti ti-search absolute left-3.5 top-1/2 -translate-y-1/2 text-[17px] text-[#9ca3af]\" data-kid=\"1-2-2-1\" data-name=\"search magnifying glass icon\">\n            </i>\n            <input class=\"w-full h-11 pl-10 pr-11 rounded-2xl bg-[#f3f4f6] border border-[#e5e7eb] text-[14px] text-[#111827] placeholder:text-[#9ca3af] focus:outline-none focus:ring-2 focus:ring-[#7c3aed]/40 focus:border-[#7c3aed]\" data-kid=\"1-2-2-2\" data-name=\"food search input field\" placeholder=\"Buscar alimento o receta…\" type=\"text\"/>\n            <button class=\"absolute right-2.5 top-1/2 -translate-y-1/2 h-7 w-7 grid place-items-center text-[16px] text-[#9ca3af]\" data-kid=\"1-2-2-3\" data-name=\"voice search button\">\n                <i class=\"ti ti-microphone\" data-kid=\"1-2-2-3-1\" data-name=\"microphone icon\">\n                </i>\n            </button>\n        </div>\n        <p class=\"mt-1.5 text-[10.5px] text-[#9ca3af] flex items-center gap-1\" data-kid=\"1-2-3\" data-name=\"search instructional text\">\n            <i class=\"ti ti-bolt text-[12px] text-[#7c3aed]\" data-kid=\"1-2-3-1\" data-name=\"lightning bolt icon\">\n            </i>\n            Filtra en tiempo real mientras escribís\n        </p>\n        <!-- CATEGORY CHIPS -->\n        <div class=\"mt-2.5 -mx-1 flex items-center gap-1.5 overflow-x-auto no-scrollbar pb-0.5\" data-kid=\"1-2-4\" data-name=\"category chips navigation bar\">\n            <button class=\"shrink-0 h-8 px-3 rounded-full bg-[#5b21b6] text-white text-[12px] font-semibold\" data-kid=\"1-2-4-1\" data-name=\"category chip\">\n                Todos\n            </button>\n            <button class=\"shrink-0 h-8 px-3 rounded-full bg-[#f3f4f6] border border-[#e5e7eb] text-[12px] font-medium text-[#4b5563]\" data-kid=\"1-2-4-2\" data-name=\"category chip\">\n                Proteínas\n            </button>\n            <button class=\"shrink-0 h-8 px-3 rounded-full bg-[#f3f4f6] border border-[#e5e7eb] text-[12px] font-medium text-[#4b5563]\" data-kid=\"1-2-4-3\" data-name=\"category chip\">\n                Cereales\n            </button>\n            <button class=\"shrink-0 h-8 px-3 rounded-full bg-[#f3f4f6] border border-[#e5e7eb] text-[12px] font-medium text-[#4b5563]\" data-kid=\"1-2-4-4\" data-name=\"category chip\">\n                Frutas\n            </button>\n            <button class=\"shrink-0 h-8 px-3 rounded-full bg-[#f3f4f6] border border-[#e5e7eb] text-[12px] font-medium text-[#4b5563]\" data-kid=\"1-2-4-5\" data-name=\"category chip\">\n                Lácteos\n            </button>\n            <button class=\"shrink-0 h-8 px-3 rounded-full bg-[#f3f4f6] border border-[#e5e7eb] text-[12px] font-medium text-[#4b5563]\" data-kid=\"1-2-4-6\" data-name=\"category chip\">\n                Frutos secos\n            </button>\n        </div>\n        <!-- TABS -->\n        <div class=\"mt-3 grid grid-cols-2 gap-1 bg-[#eceef2] p-1 rounded-xl\" data-kid=\"1-2-5\" data-name=\"content type tab switcher\" role=\"tablist\">\n            <button aria-selected=\"true\" class=\"h-9 rounded-lg bg-white shadow-sm text-[13px] font-semibold text-[#2b0c4f]\" data-kid=\"1-2-5-1\" data-name=\"foods tab button\" role=\"tab\">\n                Alimentos\n            </button>\n            <button aria-selected=\"false\" class=\"h-9 rounded-lg text-[13px] font-semibold text-[#6b7280]\" data-kid=\"1-2-5-2\" data-name=\"recipes tab button\" role=\"tab\">\n                Recetas\n            </button>\n        </div>\n        <!-- BASE SELECTOR -->\n        <div class=\"mt-3 flex items-center justify-between\" data-kid=\"1-2-6\" data-name=\"portion size and result count group\">\n            <div class=\"inline-flex rounded-xl bg-[#f3f4f6] border border-[#e5e7eb] p-0.5\" data-kid=\"1-2-6-1\" data-name=\"portion type switcher\">\n                <button class=\"h-8 px-3 rounded-[10px] bg-white shadow-sm text-[11.5px] font-bold text-[#2b0c4f]\" data-kid=\"1-2-6-1-1\" data-name=\"per 100g portion option\">\n                    Por 100 g\n                </button>\n                <button class=\"h-8 px-3 rounded-[10px] text-[11.5px] font-semibold text-[#6b7280]\" data-kid=\"1-2-6-1-2\" data-name=\"per serving portion option\">\n                    Por porción\n                </button>\n            </div>\n            <div class=\"text-right leading-tight\" data-kid=\"1-2-6-2\" data-name=\"result statistics container\">\n                <p class=\"text-[11.5px] font-bold text-[#5b21b6]\" data-dynamic=\"true\" data-kid=\"1-2-6-2-1\" data-name=\"results count label\" data-reason=\"number updated dynamically based on search results\">\n                    48 resultados\n                </p>\n                <p class=\"text-[10px] text-[#9ca3af]\" data-kid=\"1-2-6-2-2\" data-name=\"sorting method text\">\n                    por relevancia\n                </p>\n            </div>\n        </div>\n    </header>\n    <!-- RESULTS TABLE -->\n    <div class=\"flex-1 overflow-y-auto no-scrollbar bg-white\" data-kid=\"1-3\" data-name=\"results table container\">\n        <div class=\"grid grid-cols-[minmax(0,1fr)_40px_34px_34px_34px] gap-x-1 px-5 py-2 bg-[#faf5ff] border-b border-[#f0e6ff] sticky top-0 z-10\" data-kid=\"1-3-1\" data-name=\"table header row\">\n            <span class=\"text-[9.5px] uppercase tracking-wide font-bold text-[#7c3aed]\" data-kid=\"1-3-1-1\" data-name=\"food name header label\">\n                Alimento · 100 g\n            </span>\n            <span class=\"text-right text-[9.5px] uppercase tracking-wide font-bold text-[#7c3aed]\" data-kid=\"1-3-1-2\" data-name=\"kcal header label\">\n                Kcal\n            </span>\n            <span class=\"text-right text-[9.5px] uppercase tracking-wide font-bold text-[#7c3aed]\" data-kid=\"1-3-1-3\" data-name=\"protein header label\">\n                Prot\n            </span>\n            <span class=\"text-right text-[9.5px] uppercase tracking-wide font-bold text-[#7c3aed]\" data-kid=\"1-3-1-4\" data-name=\"fat header label\">\n                Gras\n            </span>\n            <span class=\"text-right text-[9.5px] uppercase tracking-wide font-bold text-[#7c3aed]\" data-kid=\"1-3-1-5\" data-name=\"carbohydrates header label\">\n                Carb\n            </span>\n        </div>\n        <!-- ROW 1 -->\n        <div class=\"grid grid-cols-[minmax(0,1fr)_40px_34px_34px_34px] gap-x-1 items-center px-5 py-3 border-b border-[#eceef2]\" data-kid=\"1-3-2\" data-name=\"food item row\">\n            <div class=\"min-w-0\" data-kid=\"1-3-2-1\" data-name=\"food name and info container\">\n                <p class=\"text-[13px] font-semibold text-[#111827] truncate\" data-kid=\"1-3-2-1-1\" data-name=\"food item name\">\n                    Pechuga de pollo cocida\n                </p>\n                <p class=\"text-[10px] text-[#9ca3af] mt-0.5\" data-kid=\"1-3-2-1-2\" data-name=\"portion size info\">\n                    1 porción = 150 g\n                </p>\n            </div>\n            <span class=\"text-right text-[12px] font-bold tabular-nums text-[#2b0c4f]\" data-kid=\"1-3-2-2\" data-name=\"kcal value\">\n                165\n            </span>\n            <span class=\"text-right text-[11.5px] tabular-nums text-[#374151]\" data-kid=\"1-3-2-3\" data-name=\"protein value\">\n                31,0\n            </span>\n            <span class=\"text-right text-[11.5px] tabular-nums text-[#374151]\" data-kid=\"1-3-2-4\" data-name=\"fat value\">\n                3,6\n            </span>\n            <span class=\"text-right text-[11.5px] tabular-nums text-[#374151]\" data-kid=\"1-3-2-5\" data-name=\"carbohydrates value\">\n                0,0\n            </span>\n        </div>\n        <!-- ROW 2 (selected) -->\n        <div class=\"grid grid-cols-[minmax(0,1fr)_40px_34px_34px_34px] gap-x-1 items-center px-5 py-3 border-b border-[#f0e6ff] bg-[#faf5ff]\" data-kid=\"1-3-3\" data-name=\"selected food item row\">\n            <div class=\"min-w-0\" data-kid=\"1-3-3-1\" data-name=\"food name and info container\">\n                <p class=\"text-[13px] font-semibold text-[#2b0c4f] truncate flex items-center gap-1.5\" data-kid=\"1-3-3-1-1\" data-name=\"food item name with icon\">\n                    <i class=\"ti ti-circle-check-filled text-[14px] text-[#7c3aed]\" data-kid=\"1-3-3-1-1-1\" data-name=\"checkmark icon\">\n                    </i>\n                    Avena tradicional\n                </p>\n                <p class=\"text-[10px] text-[#7c3aed] font-semibold mt-0.5 truncate\" data-kid=\"1-3-3-1-2\" data-name=\"plan status and portion info\">\n                    En el plan de hoy · 40 g\n                </p>\n            </div>\n            <span class=\"text-right text-[12px] font-bold tabular-nums text-[#5b21b6]\" data-kid=\"1-3-3-2\" data-name=\"kcal value\">\n                389\n            </span>\n            <span class=\"text-right text-[11.5px] font-semibold tabular-nums text-[#5b21b6]\" data-kid=\"1-3-3-3\" data-name=\"protein value\">\n                16,9\n            </span>\n            <span class=\"text-right text-[11.5px] font-semibold tabular-nums text-[#5b21b6]\" data-kid=\"1-3-3-4\" data-name=\"fat value\">\n                6,9\n            </span>\n            <span class=\"text-right text-[11.5px] font-semibold tabular-nums text-[#5b21b6]\" data-kid=\"1-3-3-5\" data-name=\"carbohydrates value\">\n                66,3\n            </span>\n        </div>\n        <!-- ROW 3 -->\n        <div class=\"grid grid-cols-[minmax(0,1fr)_40px_34px_34px_34px] gap-x-1 items-center px-5 py-3 border-b border-[#eceef2]\" data-kid=\"1-3-4\" data-name=\"food item row\">\n            <div class=\"min-w-0\" data-kid=\"1-3-4-1\" data-name=\"food name and info container\">\n                <p class=\"text-[13px] font-semibold text-[#111827] truncate\" data-kid=\"1-3-4-1-1\" data-name=\"food item name\">\n                    Palta (aguacate)\n                </p>\n                <p class=\"text-[10px] text-[#9ca3af] mt-0.5\" data-kid=\"1-3-4-1-2\" data-name=\"portion size info\">\n                    1 porción = 100 g · ½ unidad\n                </p>\n            </div>\n            <span class=\"text-right text-[12px] font-bold tabular-nums text-[#2b0c4f]\" data-kid=\"1-3-4-2\" data-name=\"kcal value\">\n                160\n            </span>\n            <span class=\"text-right text-[11.5px] tabular-nums text-[#374151]\" data-kid=\"1-3-4-3\" data-name=\"protein value\">\n                2,0\n            </span>\n            <span class=\"text-right text-[11.5px] tabular-nums text-[#374151]\" data-kid=\"1-3-4-4\" data-name=\"fat value\">\n                14,7\n            </span>\n            <span class=\"text-right text-[11.5px] tabular-nums text-[#374151]\" data-kid=\"1-3-4-5\" data-name=\"carbohydrates value\">\n                8,5\n            </span>\n        </div>\n        <!-- ROW 4 -->\n        <div class=\"grid grid-cols-[minmax(0,1fr)_40px_34px_34px_34px] gap-x-1 items-center px-5 py-3 border-b border-[#eceef2]\" data-kid=\"1-3-5\" data-name=\"food item row\">\n            <div class=\"min-w-0\" data-kid=\"1-3-5-1\" data-name=\"food name and info container\">\n                <p class=\"text-[13px] font-semibold text-[#111827] truncate\" data-kid=\"1-3-5-1-1\" data-name=\"food item name\">\n                    Yogur natural entero\n                </p>\n                <p class=\"text-[10px] text-[#9ca3af] mt-0.5\" data-kid=\"1-3-5-1-2\" data-name=\"portion size info\">\n                    1 porción = 200 g · 1 vaso\n                </p>\n            </div>\n            <span class=\"text-right text-[12px] font-bold tabular-nums text-[#2b0c4f]\" data-kid=\"1-3-5-2\" data-name=\"kcal value\">\n                61\n            </span>\n            <span class=\"text-right text-[11.5px] tabular-nums text-[#374151]\" data-kid=\"1-3-5-3\" data-name=\"protein value\">\n                3,5\n            </span>\n            <span class=\"text-right text-[11.5px] tabular-nums text-[#374151]\" data-kid=\"1-3-5-4\" data-name=\"fat value\">\n                3,3\n            </span>\n            <span class=\"text-right text-[11.5px] tabular-nums text-[#374151]\" data-kid=\"1-3-5-5\" data-name=\"carbohydrates value\">\n                4,7\n            </span>\n        </div>\n        <!-- ROW 5 -->\n        <div class=\"grid grid-cols-[minmax(0,1fr)_40px_34px_34px_34px] gap-x-1 items-center px-5 py-3 border-b border-[#eceef2]\" data-kid=\"1-3-6\" data-name=\"food item row\">\n            <div class=\"min-w-0\" data-kid=\"1-3-6-1\" data-name=\"food name and info container\">\n                <p class=\"text-[13px] font-semibold text-[#111827] truncate\" data-kid=\"1-3-6-1-1\" data-name=\"food item name\">\n                    Lentejas cocidas\n                </p>\n                <p class=\"text-[10px] text-[#9ca3af] mt-0.5\" data-kid=\"1-3-6-1-2\" data-name=\"portion size info\">\n                    1 porción = 200 g\n                </p>\n            </div>\n            <span class=\"text-right text-[12px] font-bold tabular-nums text-[#2b0c4f]\" data-kid=\"1-3-6-2\" data-name=\"kcal value\">\n                116\n            </span>\n            <span class=\"text-right text-[11.5px] tabular-nums text-[#374151]\" data-kid=\"1-3-6-3\" data-name=\"protein value\">\n                9,0\n            </span>\n            <span class=\"text-right text-[11.5px] tabular-nums text-[#374151]\" data-kid=\"1-3-6-4\" data-name=\"fat value\">\n                0,4\n            </span>\n            <span class=\"text-right text-[11.5px] tabular-nums text-[#374151]\" data-kid=\"1-3-6-5\" data-name=\"carbohydrates value\">\n                20,1\n            </span>\n        </div>\n        <!-- ROW 6 -->\n        <div class=\"grid grid-cols-[minmax(0,1fr)_40px_34px_34px_34px] gap-x-1 items-center px-5 py-3 border-b border-[#eceef2]\" data-kid=\"1-3-7\" data-name=\"food item row\">\n            <div class=\"min-w-0\" data-kid=\"1-3-7-1\" data-name=\"food name and info container\">\n                <p class=\"text-[13px] font-semibold text-[#111827] truncate\" data-kid=\"1-3-7-1-1\" data-name=\"food item name\">\n                    Almendras\n                </p>\n                <p class=\"text-[10px] text-[#9ca3af] mt-0.5\" data-kid=\"1-3-7-1-2\" data-name=\"portion size info\">\n                    1 porción = 30 g · ~23 unidades\n                </p>\n            </div>\n            <span class=\"text-right text-[12px] font-bold tabular-nums text-[#2b0c4f]\" data-kid=\"1-3-7-2\" data-name=\"kcal value\">\n                579\n            </span>\n            <span class=\"text-right text-[11.5px] tabular-nums text-[#374151]\" data-kid=\"1-3-7-3\" data-name=\"protein value\">\n                21,2\n            </span>\n            <span class=\"text-right text-[11.5px] tabular-nums text-[#374151]\" data-kid=\"1-3-7-4\" data-name=\"fat value\">\n                49,9\n            </span>\n            <span class=\"text-right text-[11.5px] tabular-nums text-[#374151]\" data-kid=\"1-3-7-5\" data-name=\"carbohydrates value\">\n                21,6\n            </span>\n        </div>\n        <!-- ROW 7 -->\n        <div class=\"grid grid-cols-[minmax(0,1fr)_40px_34px_34px_34px] gap-x-1 items-center px-5 py-3 border-b border-[#eceef2]\" data-kid=\"1-3-8\" data-name=\"food item row\">\n            <div class=\"min-w-0\" data-kid=\"1-3-8-1\" data-name=\"food name and info container\">\n                <p class=\"text-[13px] font-semibold text-[#111827] truncate\" data-kid=\"1-3-8-1-1\" data-name=\"food item name\">\n                    Arroz blanco cocido\n                </p>\n                <p class=\"text-[10px] text-[#9ca3af] mt-0.5\" data-kid=\"1-3-8-1-2\" data-name=\"portion size info\">\n                    1 porción = 150 g\n                </p>\n            </div>\n            <span class=\"text-right text-[12px] font-bold tabular-nums text-[#2b0c4f]\" data-kid=\"1-3-8-2\" data-name=\"kcal value\">\n                130\n            </span>\n            <span class=\"text-right text-[11.5px] tabular-nums text-[#374151]\" data-kid=\"1-3-8-3\" data-name=\"protein value\">\n                2,7\n            </span>\n            <span class=\"text-right text-[11.5px] tabular-nums text-[#374151]\" data-kid=\"1-3-8-4\" data-name=\"fat value\">\n                0,3\n            </span>\n            <span class=\"text-right text-[11.5px] tabular-nums text-[#374151]\" data-kid=\"1-3-8-5\" data-name=\"carbohydrates value\">\n                28,2\n            </span>\n        </div>\n        <!-- ROW 8 -->\n        <div class=\"grid grid-cols-[minmax(0,1fr)_40px_34px_34px_34px] gap-x-1 items-center px-5 py-3 border-b border-[#eceef2]\" data-kid=\"1-3-9\" data-name=\"food item row\">\n            <div class=\"min-w-0\" data-kid=\"1-3-9-1\" data-name=\"food name and info container\">\n                <p class=\"text-[13px] font-semibold text-[#111827] truncate\" data-kid=\"1-3-9-1-1\" data-name=\"food item name\">\n                    Huevo entero\n                </p>\n                <p class=\"text-[10px] text-[#9ca3af] mt-0.5\" data-kid=\"1-3-9-1-2\" data-name=\"portion size info\">\n                    1 porción = 50 g · 1 unidad\n                </p>\n            </div>\n            <span class=\"text-right text-[12px] font-bold tabular-nums text-[#2b0c4f]\" data-kid=\"1-3-9-2\" data-name=\"kcal value\">\n                143\n            </span>\n            <span class=\"text-right text-[11.5px] tabular-nums text-[#374151]\" data-kid=\"1-3-9-3\" data-name=\"protein value\">\n                12,6\n            </span>\n            <span class=\"text-right text-[11.5px] tabular-nums text-[#374151]\" data-kid=\"1-3-9-4\" data-name=\"fat value\">\n                9,5\n            </span>\n            <span class=\"text-right text-[11.5px] tabular-nums text-[#374151]\" data-kid=\"1-3-9-5\" data-name=\"carbohydrates value\">\n                0,7\n            </span>\n        </div>\n        <p class=\"px-5 py-4 text-[10px] text-[#9ca3af] flex items-center gap-1.5\" data-kid=\"1-3-10\" data-name=\"footer info notice\">\n            <i class=\"ti ti-info-circle text-[12px]\" data-kid=\"1-3-10-1\" data-name=\"info icon\">\n            </i>\n            Valores de referencia · tabla de composición Nutringest (por 100 g comestible)\n        </p>\n    </div>\n    <!-- BOTTOM TAB BAR -->\n    <nav class=\"shrink-0 bg-white border-t border-[#e5e7eb] px-2 pt-2 pb-3\" data-kid=\"1-4\" data-name=\"bottom navigation bar\">\n        <ul class=\"grid grid-cols-4\" data-kid=\"1-4-1\" data-name=\"navigation items list\">\n            <li class=\"flex flex-col items-center gap-1 text-[#9ca3af]\" data-kid=\"1-4-1-1\" data-name=\"patients tab\">\n                <i class=\"ti ti-users text-[22px]\" data-kid=\"1-4-1-1-1\" data-name=\"users icon\">\n                </i>\n                <span class=\"text-[10.5px] font-medium\" data-kid=\"1-4-1-1-2\" data-name=\"patients label\">\n                    Pacientes\n                </span>\n            </li>\n            <li class=\"flex flex-col items-center gap-1 text-[#9ca3af]\" data-kid=\"1-4-1-2\" data-name=\"plans tab\">\n                <i class=\"ti ti-salad text-[22px]\" data-kid=\"1-4-1-2-1\" data-name=\"salad icon\">\n      