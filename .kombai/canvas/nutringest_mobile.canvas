      },
      "html": "<div class=\"h-[812px] w-full overflow-hidden bg-[#f6f7f9] font-[Montserrat] text-[#111827] antialiased flex flex-col\" data-kid=\"1\" data-name=\"nutritional plan screen container\">\n    <style>\n        @import url('https://fonts.googleapis.com/css2?family=Montserrat:wght@400;500;600;700;800&display=swap');\n    @import url(\"https://cdn.jsdelivr.net/npm/@tabler/icons-webfont@3.48.0/dist/tabler-icons.min.css\");\n    .scroll-hide::-webkit-scrollbar { display: none; }\n    .scroll-hide { -ms-overflow-style: none; scrollbar-width: none; }\n    </style>\n    <!-- Status bar -->\n    <div class=\"flex items-center justify-between px-6 pt-3 pb-1 bg-[#ffffff] shrink-0\" data-kid=\"1-1\" data-name=\"status bar\">\n        <span class=\"text-[13px] font-semibold tracking-tight\" data-dynamic=\"true\" data-kid=\"1-1-1\" data-name=\"current time text\" data-reason=\"updated by system clock\">\n            9:41\n        </span>\n        <div class=\"flex items-center gap-1.5 text-[#111827] text-[13px]\" data-kid=\"1-1-2\" data-name=\"device status icon group\">\n            <i class=\"ti ti-signal-4g\" data-kid=\"1-1-2-1\" data-name=\"4g signal strength icon\">\n            </i>\n            <i class=\"ti ti-wifi\" data-kid=\"1-1-2-2\" data-name=\"wifi connection icon\">\n            </i>\n            <i class=\"ti ti-battery-4\" data-kid=\"1-1-2-3\" data-name=\"battery charge icon\">\n            </i>\n        </div>\n    </div>\n    <!-- App bar -->\n    <header class=\"bg-[#ffffff] px-4 pt-1 pb-3 border-b border-[#e5e7eb] shrink-0\" data-kid=\"1-2\" data-name=\"header area\">\n        <div class=\"flex items-center gap-3\" data-kid=\"1-2-1\" data-name=\"header content row\">\n            <button class=\"w-9 h-9 rounded-full flex items-center justify-center text-[#2b0c4f] text-[20px] active:bg-[#f3f0fa]\" data-kid=\"1-2-1-1\" data-name=\"back navigation button\">\n                <i class=\"ti ti-chevron-left\" data-kid=\"1-2-1-1-1\" data-name=\"back arrow icon\">\n                </i>\n            </button>\n            <div class=\"flex-1 min-w-0\" data-kid=\"1-2-1-2\" data-name=\"header title and subtitle container\">\n                <h1 class=\"text-[17px] font-extrabold tracking-tight leading-tight text-[#2b0c4f]\" data-kid=\"1-2-1-2-1\" data-name=\"page headline\">\n                    Plan nutricional\n                </h1>\n                <p class=\"text-[12px] text-[#6b7280] leading-tight truncate\" data-kid=\"1-2-1-2-2\" data-name=\"patient and plan description\">\n                    Lucía Fernández · Menú hipocalórico 1800 kcal\n                </p>\n            </div>\n            <button class=\"w-9 h-9 rounded-full flex items-center justify-center text-[#6b7280] text-[20px] active:bg-[#f3f0fa]\" data-kid=\"1-2-1-3\" data-name=\"options menu button\">\n                <i class=\"ti ti-dots-vertical\" data-kid=\"1-2-1-3-1\" data-name=\"vertical dots icon\">\n                </i>\n            </button>\n        </div>\n        <!-- Day / Week switch -->\n        <div class=\"mt-3 grid grid-cols-2 gap-1 bg-[#eceef2] p-1 rounded-xl\" data-kid=\"1-2-2\" data-name=\"day or week view tab switcher\" role=\"tablist\">\n            <button aria-selected=\"true\" class=\"h-9 rounded-lg bg-[#5b21b6] text-white text-[13px] font-semibold shadow-sm flex items-center justify-center gap-1.5\" data-kid=\"1-2-2-1\" data-name=\"day tab button\" role=\"tab\">\n                <i class=\"ti ti-calendar-event text-[15px]\" data-kid=\"1-2-2-1-1\" data-name=\"calendar event icon\">\n                </i>\n                Hoy\n            </button>\n            <button aria-selected=\"false\" class=\"h-9 rounded-lg text-[#4b5563] text-[13px] font-semibold flex items-center justify-center gap-1.5\" data-kid=\"1-2-2-2\" data-name=\"week tab button\" role=\"tab\">\n                <i class=\"ti ti-calendar-week text-[15px]\" data-kid=\"1-2-2-2-1\" data-name=\"calendar week icon\">\n                </i>\n                Semana\n            </button>\n        </div>\n    </header>\n    <!-- Scroll area -->\n    <main class=\"scroll-hide flex-1 overflow-y-auto\" data-kid=\"1-3\" data-name=\"main scrollable content area\">\n        <!-- Date strip -->\n        <div class=\"px-5 pt-4 pb-1 flex items-center justify-between\" data-kid=\"1-3-1\" data-name=\"date and progress header\">\n            <p class=\"text-[12px] font-bold uppercase tracking-wide text-[#6b7280]\" data-kid=\"1-3-1-1\" data-name=\"current date text\">\n                Jueves 02 de octubre\n            </p>\n            <span class=\"text-[11px] font-semibold text-[#5b21b6] bg-[#f3f0fa] px-2.5 py-1 rounded-full\" data-kid=\"1-3-1-2\" data-name=\"daily progress badge\">\n                Día 12 de 28\n            </span>\n        </div>\n        <!-- Meals -->\n        <section class=\"px-5\" data-kid=\"1-3-2\" data-name=\"meal plan list\">\n            <!-- Desayuno -->\n            <article class=\"py-3 border-b border-[#e5e7eb]\" data-kid=\"1-3-2-1\" data-name=\"breakfast meal card\">\n                <div class=\"flex items-baseline justify-between\" data-kid=\"1-3-2-1-1\" data-name=\"breakfast header row\">\n                    <div class=\"flex items-center gap-2\" data-kid=\"1-3-2-1-1-1\" data-name=\"breakfast title container\">\n                        <i class=\"ti ti-coffee text-[17px] text-[#7c3aed]\" data-kid=\"1-3-2-1-1-1-1\" data-name=\"coffee icon\">\n                        </i>\n                        <h2 class=\"text-[15px] font-bold tracking-tight\" data-kid=\"1-3-2-1-1-1-2\" data-name=\"breakfast title\">\n                            Desayuno\n                        </h2>\n                        <span class=\"text-[11.5px] text-[#9ca3af] font-medium\" data-kid=\"1-3-2-1-1-1-3\" data-name=\"breakfast time\">\n                            08:00\n                        </span>\n                    </div>\n                    <span class=\"text-[13px] font-bold text-[#2b0c4f]\" data-kid=\"1-3-2-1-1-2\" data-name=\"breakfast calories\">\n                        380\n                        <span class=\"text-[10.5px] font-semibold text-[#9ca3af]\" data-kid=\"1-3-2-1-1-2-1\" data-name=\"breakfast calorie unit\">\n                            kcal\n                        </span>\n                    </span>\n                </div>\n                <p class=\"mt-1.5 text-[13.5px] leading-relaxed text-[#111827]\" data-kid=\"1-3-2-1-2\" data-name=\"breakfast description\">\n                    Avena 40 g · Leche descremada 200 ml · Banana 1\n                </p>\n                <p class=\"mt-1.5 text-[11.5px] font-medium text-[#6b7280] tabular-nums\" data-kid=\"1-3-2-1-3\" data-name=\"breakfast macros\">\n                    P 18 g  ·  G 8 g  ·  C 58 g\n                </p>\n            </article>\n            <!-- Almuerzo -->\n            <article class=\"py-3 border-b border-[#e5e7eb]\" data-kid=\"1-3-2-2\" data-name=\"lunch meal card\">\n                <div class=\"flex items-baseline justify-between\" data-kid=\"1-3-2-2-1\" data-name=\"lunch header row\">\n                    <div class=\"flex items-center gap-2\" data-kid=\"1-3-2-2-1-1\" data-name=\"lunch title container\">\n                        <i class=\"ti ti-tools-kitchen-2 text-[17px] text-[#7c3aed]\" data-kid=\"1-3-2-2-1-1-1\" data-name=\"kitchen utensils icon\">\n                        </i>\n                        <h2 class=\"text-[15px] font-bold tracking-tight\" data-kid=\"1-3-2-2-1-1-2\" data-name=\"lunch title\">\n                            Almuerzo\n                        </h2>\n                        <span class=\"text-[11.5px] text-[#9ca3af] font-medium\" data-kid=\"1-3-2-2-1-1-3\" data-name=\"lunch time\">\n                            13:00\n                        </span>\n                    </div>\n                    <span class=\"text-[13px] font-bold text-[#2b0c4f]\" data-kid=\"1-3-2-2-1-2\" data-name=\"lunch calories\">\n                        520\n                        <span class=\"text-[10.5px] font-semibold text-[#9ca3af]\" data-kid=\"1-3-2-2-1-2-1\" data-name=\"lunch calorie unit\">\n                            kcal\n                        </span>\n                    </span>\n                </div>\n                <p class=\"mt-1.5 text-[13.5px] leading-relaxed text-[#111827]\" data-kid=\"1-3-2-2-2\" data-name=\"lunch description\">\n                    Pechuga de pollo 150 g · Arroz integral 60 g · Ensalada mixta · Aceite de oliva 1 cda\n                </p>\n                <p class=\"mt-1.5 text-[11.5px] font-medium text-[#6b7280] tabular-nums\" data-kid=\"1-3-2-2-3\" data-name=\"lunch macros\">\n                    P 42 g  ·  G 14 g  ·  C 52 g\n                </p>\n            </article>\n            <!-- Merienda -->\n            <article class=\"py-3 border-b border-[#e5e7eb]\" data-kid=\"1-3-2-3\" data-name=\"afternoon snack meal card\">\n                <div class=\"flex items-baseline justify-between\" data-kid=\"1-3-2-3-1\" data-name=\"afternoon snack header row\">\n                    <div class=\"flex items-center gap-2\" data-kid=\"1-3-2-3-1-1\" data-name=\"afternoon snack title container\">\n                        <i class=\"ti ti-apple text-[17px] text-[#7c3aed]\" data-kid=\"1-3-2-3-1-1-1\" data-name=\"apple icon\">\n                        </i>\n                        <h2 class=\"text-[15px] font-bold tracking-tight\" data-kid=\"1-3-2-3-1-1-2\" data-name=\"afternoon snack title\">\n                            Merienda\n                        </h2>\n                        <span class=\"text-[11.5px] text-[#9ca3af] font-medium\" data-kid=\"1-3-2-3-1-1-3\" data-name=\"afternoon snack time\">\n                            17:00\n                        </span>\n                    </div>\n                    <span class=\"text-[13px] font-bold text-[#2b0c4f]\" data-kid=\"1-3-2-3-1-2\" data-name=\"afternoon snack calories\">\n                        260\n                        <span class=\"text-[10.5px] font-semibold text-[#9ca3af]\" data-kid=\"1-3-2-3-1-2-1\" data-name=\"afternoon snack calorie unit\">\n                            kcal\n                        </span>\n                    </span>\n                </div>\n                <p class=\"mt-1.5 text-[13.5px] leading-relaxed text-[#111827]\" data-kid=\"1-3-2-3-2\" data-name=\"afternoon snack description\">\n                    Yogur natural 200 g · Almendras 15 g · Manzana 1\n                </p>\n                <p class=\"mt-1.5 text-[11.5px] font-medium text-[#6b7280] tabular-nums\" data-kid=\"1-3-2-3-3\" data-name=\"afternoon snack macros\">\n                    P 12 g  ·  G 9 g  ·  C 32 g\n                </p>\n            </article>\n            <!-- Cena -->\n            <article class=\"py-3\" data-kid=\"1-3-2-4\" data-name=\"dinner meal card\">\n                <div class=\"flex items-baseline justify-between\" data-kid=\"1-3-2-4-1\" data-name=\"dinner header row\">\n                    <div class=\"flex items-center gap-2\" data-kid=\"1-3-2-4-1-1\" data-name=\"dinner title container\">\n                        <i class=\"ti ti-soup text-[17px] text-[#7c3aed]\" data-kid=\"1-3-2-4-1-1-1\" data-name=\"soup icon\">\n                        </i>\n                        <h2 class=\"text-[15px] font-bold tracking-tight\" data-kid=\"1-3-2-4-1-1-2\" data-name=\"dinner title\">\n                            Cena\n                        </h2>\n                        <span class=\"text-[11.5px] text-[#9ca3af] font-medium\" data-kid=\"1-3-2-4-1-1-3\" data-name=\"dinner time\">\n                            21:00\n                        </span>\n                    </div>\n                    <span class=\"text-[13px] font-bold text-[#2b0c4f]\" data-kid=\"1-3-2-4-1-2\" data-name=\"dinner calories\">\n                        430\n                        <span class=\"text-[10.5px] font-semibold text-[#9ca3af]\" data-kid=\"1-3-2-4-1-2-1\" data-name=\"dinner calorie unit\">\n                            kcal\n                        </span>\n                    </span>\n                </div>\n                <p class=\"mt-1.5 text-[13.5px] leading-relaxed text-[#111827]\" data-kid=\"1-3-2-4-2\" data-name=\"dinner description\">\n                    Merluza 150 g · Puré de calabaza 200 g · Ensalada verde · Aceite de oliva 1 cdta\n                </p>\n                <p class=\"mt-1.5 text-[11.5px] font-medium text-[#6b7280] tabular-nums\" data-kid=\"1-3-2-4-3\" data-name=\"dinner macros\">\n                    P 38 g  ·  G 10 g  ·  C 40 g\n                </p>\n            </article>\n        </section>\n        <!-- Footer note -->\n        <div class=\"px-5 pb-6 flex items-center gap-2\" data-kid=\"1-3-3\" data-name=\"footer note section\">\n            <i class=\"ti ti-info-circle text-[15px] text-[#7c3aed]\" data-kid=\"1-3-3-1\" data-name=\"info icon\">\n            </i>\n            <p class=\"text-[11.5px] text-[#6b7280] leading-snug\" data-kid=\"1-3-3-2\" data-name=\"daily meta reminder text\">\n                Meta diaria 1.800 kcal. Ajustá raciones desde el asignador rápido.\n            </p>\n        </div>\n    </main>\n    <!-- Persistent daily totals summary (single source of truth, typographic row) -->\n    <section class=\"bg-[#2b0c4f] px-5 py-3 shrink-0\" data-kid=\"1-4\" data-name=\"persistent daily totals summary section\">\n        <div class=\"flex items-end justify-between\" data-kid=\"1-4-1\" data-name=\"daily totals content row\">\n            <div data-kid=\"1-4-1-1\" data-name=\"daily total container\">\n                <p class=\"text-[9.5px] font-bold uppercase tracking-[0.12em] text-white/50\" data-kid=\"1-4-1-1-1\" data-name=\"total label text\">\n                    Total del día\n                </p>\n                <p class=\"mt-0.5 text-[23px] font-extrabold leading-none tracking-tight text-white tabular-nums\" data-kid=\"1-4-1-1-2\" data-name=\"total calories text\">\n                    1.590\n                    <span class=\"text-[11px] font-semibold text-white/60\" data-kid=\"1-4-1-1-2-1\" data-name=\"total calorie unit\">\n                        kcal\n                    </span>\n                </p>\n            </div>\n            <div class=\"flex items-end gap-4\" data-kid=\"1-4-1-2\" data-name=\"macros summary group\">\n                <div class=\"text-right\" data-kid=\"1-4-1-2-1\" data-name=\"protein macro container\">\n                    <p class=\"text-[9.5px] font-bold uppercase tracking-wide text-white/50\" data-kid=\"1-4-1-2-1-1\" data-name=\"protein label\">\n                        Prot.\n                    </p>\n                    <p class=\"text-[13px] font-bold text-white tabular-nums leading-tight\" data-kid=\"1-4-1-2-1-2\" data-name=\"protein value\">\n                        110 g\n                    </p>\n                </div>\n                <div class=\"text-right\" data-kid=\"1-4-1-2-2\" data-name=\"fat macro container\">\n                    <p class=\"text-[9.5px] font-bold uppercase tracking-wide text-white/50\" data-kid=\"1-4-1-2-2-1\" data-name=\"fat label\">\n                        Gras.\n                    </p>\n                    <p class=\"text-[13px] font-bold text-white tabular-nums leading-tight\" data-kid=\"1-4-1-2-2-2\" data-name=\"fat value\">\n                        41 g\n                    </p>\n                </div>\n                <div class=\"text-right\" data-kid=\"1-4-1-2-3\" data-name=\"carbs macro container\">\n                    <p class=\"text-[9.5px] font-bold uppercase tracking-wide text-white/50\" data-kid=\"1-4-1-2-3-1\" data-name=\"carbs label\">\n                        Carb.\n                    </p>\n                    <p class=\"text-[13px] font-bold text-white tabular-nums leading-tight\" data-kid=\"1-4-1-2-3-2\" data-name=\"carbs value\">\n                        182 g\n                    </p>\n                </div>\n            </div>\n        </div>\n    </section>\n    <!-- Bottom tab bar -->\n    <nav class=\"bg-[#ffffff] border-t border-[#e5e7eb] px-3 pt-2 pb-4 shrink-0\" data-kid=\"1-5\" data-name=\"bottom navigation bar\">\n        <ul class=\"flex items-stretch justify-between\" data-kid=\"1-5-1\" data-name=\"nav menu list\">\n            <li class=\"flex-1\" data-kid=\"1-5-1-1\" data-name=\"patients nav link\">\n                <div class=\"flex flex-col items-center gap-0.5 text-[#9ca3af]\" data-kid=\"1-5-1-1-1\" data-name=\"patients nav item wrapper\">\n                    <i class=\"ti ti-users text-[22px]\" data-kid=\"1-5-1-1-1-1\" data-name=\"users icon\">\n                    </i>\n                    <span class=\"text-[10.5px] font-medium\" data-kid=\"1-5-1-1-1-2\" data-name=\"patients label\">\n                        Pacientes\n                    </span>\n                </div>\n            </li>\n            <li class=\"flex-1\" data-kid=\"1-5-1-2\" data-name=\"plans nav link\">\n                <div class=\"flex flex-col items-center gap-0.5 text-[#5b21b6]\" data-kid=\"1-5-1-2-1\" data-name=\"plans nav item wrapper\">\n                    <i class=\"ti ti-salad text-[22px]\" data-kid=\"1-5-1-2-1-1\" data-name=\"salad icon\">\n                    </i>\n                    <span class=\"text-[10.5px] font-bold\" data-kid=\"1-5-1-2-1-2\" data-name=\"plans label\">\n                        Planes\n                    </span>\n                </div>\n            </li>\n            <li class=\"flex-1\" data-kid=\"1-5-1-3\" data-name=\"tools nav link\">\n                <div class=\"flex flex-col items-center gap-0.5 text-[#9ca3af]\" data-kid=\"1-5-1-3-1\" data-name=\"tools nav item wrapper\">\n                    <i class=\"ti ti-calculator text-[22px]\" data-kid=\"1-5-1-3-1-1\" data-name=\"calculator icon\">\n                    </i>\n                    <span class=\"text-[10.5px] font-medium\" data-kid=\"1-5-1-3-1-2\" data-name=\"tools label\">\n                        Herramientas\n                    </span>\n                </div>\n            </li>\n            <li class=\"flex-1\" data-kid=\"1-5-1-4\" data-name=\"profile nav link\">\n                <div class=\"flex flex-col items-center gap-0.5 text-[#9ca3af]\" data-kid=\"1-5-1-4-1\" data-name=\"profile nav item wrapper\">\n                    <i class=\"ti ti-user-circle text-[22px]\" data-kid=\"1-5-1-4-1-1\" data-name=\"user circle icon\">\n                    </i>\n                    <span class=\"text-[10.5px] font-medium\" data-kid=\"1-5-1-4-1-2\" data-name=\"profile label\">\n                        Perfil\n                    </span>\n                </div>\n            </li>\n        </ul>\n    </nav>\n</div>\n",
