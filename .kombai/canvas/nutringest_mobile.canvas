      "html": "<div class=\"h-[812px] w-full overflow-hidden bg-[#f6f7f9] font-[Montserrat] text-[#111827] antialiased flex flex-col\" data-kid=\"1\">\n    <style>\n        @import url('https://fonts.googleapis.com/css2?family=Montserrat:wght@400;500;600;700;800&display=swap');\n    @import url('https://cdn.jsdelivr.net/npm/@tabler/icons-webfont@3.48.0/dist/tabler-icons.min.css');\n    .no-bar::-webkit-scrollbar { width: 0; height: 0; }\n    .no-bar { scrollbar-width: none; }\n    </style>\n    <!-- status bar -->\n    <div class=\"flex-none h-[44px] px-5 flex items-center justify-between text-[12px] font-semibold\" data-kid=\"1-1\">\n        <span data-dynamic=\"true\" data-kid=\"1-1-1\" data-name=\"current time text\" data-reason=\"time string updated by system clock\">\n            9:41\n        </span>\n        <span class=\"flex items-center gap-1.5 text-[14px] text-[#111827]\" data-kid=\"1-1-2\">\n            <i class=\"ti ti-wifi\" data-kid=\"1-1-2-1\">\n            </i>\n            <i class=\"ti ti-battery-3\" data-kid=\"1-1-2-2\">\n            </i>\n        </span>\n    </div>\n    <!-- app bar -->\n    <div class=\"flex-none px-5 pt-0.5 pb-3 flex items-center gap-3\" data-kid=\"1-2\">\n        <button class=\"h-9 w-9 shrink-0 rounded-full border border-[#e5e7eb] bg-white flex items-center justify-center text-[#374151]\" data-kid=\"1-2-1\">\n            <i class=\"ti ti-arrow-left text-[18px]\" data-kid=\"1-2-1-1\">\n            </i>\n        </button>\n        <div class=\"min-w-0 flex-1\" data-kid=\"1-2-2\">\n            <p class=\"text-[15px] font-bold truncate leading-tight\" data-kid=\"1-2-2-1\">\n                Ajustar raciones\n            </p>\n            <p class=\"text-[11.5px] text-[#6b7280] truncate\" data-kid=\"1-2-2-2\">\n                María González · Plan hipocalórico\n            </p>\n        </div>\n        <button class=\"h-9 w-9 shrink-0 rounded-full border border-[#e5e7eb] bg-white flex items-center justify-center text-[#374151]\" data-kid=\"1-2-3\">\n            <i class=\"ti ti-dots text-[18px]\" data-kid=\"1-2-3-1\">\n            </i>\n        </button>\n    </div>\n    <!-- provisional / live summary (always visible) -->\n    <div class=\"flex-none px-5 pb-3\" data-kid=\"1-3\">\n        <div class=\"rounded-2xl border border-dashed border-[#e0a94a] bg-white px-4 pt-3.5 pb-4\" data-kid=\"1-3-1\">\n            <div class=\"flex items-center justify-between\" data-kid=\"1-3-1-1\">\n                <p class=\"text-[11px] font-bold uppercase tracking-wide text-[#6b7280]\" data-kid=\"1-3-1-1-1\">\n                    Resumen del plan\n                </p>\n                <span class=\"inline-flex items-center gap-1 rounded-full bg-[#fef3c7] px-2.5 py-1 text-[10.5px] font-bold text-[#92600a]\" data-kid=\"1-3-1-1-2\">\n                    <i class=\"ti ti-clock-exclamation text-[13px]\" data-kid=\"1-3-1-1-2-1\">\n                    </i>\n                    Provisional\n                </span>\n            </div>\n            <div class=\"mt-2.5 flex items-end justify-between\" data-kid=\"1-3-1-2\">\n                <div data-kid=\"1-3-1-2-1\">\n                    <p class=\"text-[30px] font-extrabold leading-none tabular-nums text-[#2b0c4f]\" data-dynamic=\"true\" data-kid=\"1-3-1-2-1-1\" data-name=\"total calorie count\" data-reason=\"value dynamically calculated based on ration adjustments\">\n                        1.605\n                        <span class=\"ml-1 text-[13px] font-bold text-[#6b7280]\" data-kid=\"1-3-1-2-1-1-1\">\n                            kcal\n                        </span>\n                    </p>\n                    <p class=\"mt-1 text-[11px] text-[#6b7280]\" data-dynamic=\"true\" data-kid=\"1-3-1-2-1-2\" data-name=\"calorie comparison text\" data-reason=\"value dynamically calculated based on ration adjustments\">\n                        +60 kcal vs plan actual\n                    </p>\n                </div>\n                <div class=\"flex items-center gap-3\" data-kid=\"1-3-1-2-2\">\n                    <div class=\"text-center\" data-kid=\"1-3-1-2-2-1\">\n                        <p class=\"text-[15px] font-bold tabular-nums text-[#111827]\" data-dynamic=\"true\" data-kid=\"1-3-1-2-2-1-1\" data-name=\"protein gram count\" data-reason=\"value dynamically calculated based on ration adjustments\">\n                            108\n                            <span class=\"text-[10px] font-semibold text-[#9ca3af]\" data-kid=\"1-3-1-2-2-1-1-1\">\n                                g\n                            </span>\n                        </p>\n                        <p class=\"text-[9.5px] font-semibold uppercase tracking-wide text-[#6b7280]\" data-kid=\"1-3-1-2-2-1-2\">\n                            Prot\n                        </p>\n                    </div>\n                    <div class=\"text-center\" data-kid=\"1-3-1-2-2-2\">\n                        <p class=\"text-[15px] font-bold tabular-nums text-[#111827]\" data-dynamic=\"true\" data-kid=\"1-3-1-2-2-2-1\" data-name=\"fat gram count\" data-reason=\"value dynamically calculated based on ration adjustments\">\n                            58\n                            <span class=\"text-[10px] font-semibold text-[#9ca3af]\" data-kid=\"1-3-1-2-2-2-1-1\">\n                                g\n                            </span>\n                        </p>\n                        <p class=\"text-[9.5px] font-semibold uppercase tracking-wide text-[#6b7280]\" data-kid=\"1-3-1-2-2-2-2\">\n                            Gras\n                        </p>\n                    </div>\n                    <div class=\"text-center\" data-kid=\"1-3-1-2-2-3\">\n                        <p class=\"text-[15px] font-bold tabular-nums text-[#111827]\" data-dynamic=\"true\" data-kid=\"1-3-1-2-2-3-1\" data-name=\"carb gram count\" data-reason=\"value dynamically calculated based on ration adjustments\">\n                            160\n                            <span class=\"text-[10px] font-semibold text-[#9ca3af]\" data-kid=\"1-3-1-2-2-3-1-1\">\n                                g\n                            </span>\n                        </p>\n                        <p class=\"text-[9.5px] font-semibold uppercase tracking-wide text-[#6b7280]\" data-kid=\"1-3-1-2-2-3-2\">\n                            Carb\n                        </p>\n                    </div>\n                </div>\n            </div>\n        </div>\n    </div>\n    <!-- scrollable groups -->\n    <div class=\"flex-1 overflow-y-auto no-bar px-5\" data-kid=\"1-4\">\n        <div class=\"flex items-center justify-between pb-1\" data-kid=\"1-4-1\">\n            <p class=\"text-[11px] font-bold uppercase tracking-wide text-[#6b7280]\" data-kid=\"1-4-1-1\">\n                Grupos de intercambio\n            </p>\n            <p class=\"text-[11px] text-[#6b7280]\" data-kid=\"1-4-1-2\">\n                <span class=\"font-bold text-[#5b21b6]\" data-dynamic=\"true\" data-kid=\"1-4-1-2-1\" data-name=\"total rations number\" data-reason=\"value dynamically calculated based on ration adjustments\">\n                    20\n                </span>\n                raciones\n            </p>\n        </div>\n        <div class=\"rounded-2xl border border-[#e5e7eb] bg-white px-4 divide-y divide-[#eef0f3]\" data-kid=\"1-4-2\">\n            <!-- Lácteos -->\n            <div class=\"flex items-center gap-3 py-3.5\" data-kid=\"1-4-2-1\">\n                <span class=\"h-10 w-10 shrink-0 rounded-xl bg-[#f3eafe] text-[#5b21b6] flex items-center justify-center\" data-kid=\"1-4-2-1-1\">\n                    <i class=\"ti ti-milk text-[20px]\" data-kid=\"1-4-2-1-1-1\">\n                    </i>\n                </span>\n                <div class=\"min-w-0 flex-1\" data-kid=\"1-4-2-1-2\">\n                    <p class=\"text-[14px] font-semibold leading-tight\" data-kid=\"1-4-2-1-2-1\">\n                        Lácteos\n                    </p>\n                    <p class=\"text-[10.5px] text-[#6b7280] leading-snug\" data-kid=\"1-4-2-1-2-2\">\n                        1 ración ≈ 200 ml leche · 1 yogur\n                    </p>\n                </div>\n                <div class=\"flex items-center gap-1.5\" data-kid=\"1-4-2-1-3\">\n                    <button class=\"h-8 w-8 rounded-full border border-[#e5e7eb] bg-white text-[#4b5563] flex items-center justify-center\" data-kid=\"1-4-2-1-3-1\">\n                        <i class=\"ti ti-minus text-[16px]\" data-kid=\"1-4-2-1-3-1-1\">\n                        </i>\n                    </button>\n                    <span class=\"w-6 text-center text-[15px] font-bold tabular-nums\" data-dynamic=\"true\" data-kid=\"1-4-2-1-3-2\" data-name=\"dairy ration count\" data-reason=\"value updated by buttons interaction\">\n                        2\n                    </span>\n                    <button class=\"h-8 w-8 rounded-full bg-[#5b21b6] text-white flex items-center justify-center\" data-kid=\"1-4-2-1-3-3\">\n                        <i class=\"ti ti-plus text-[16px]\" data-kid=\"1-4-2-1-3-3-1\">\n                        </i>\n                    </button>\n                </div>\n            </div>\n            <!-- Verduras -->\n            <div class=\"flex items-center gap-3 py-3.5\" data-kid=\"1-4-2-2\">\n                <span class=\"h-10 w-10 shrink-0 rounded-xl bg-[#eef7ee] text-[#3f9142] flex items-center justify-center\" data-kid=\"1-4-2-2-1\">\n                    <i class=\"ti ti-carrot text-[20px]\" data-kid=\"1-4-2-2-1-1\">\n                    </i>\n                </span>\n                <div class=\"min-w-0 flex-1\" data-kid=\"1-4-2-2-2\">\n                    <p class=\"text-[14px] font-semibold leading-tight\" data-kid=\"1-4-2-2-2-1\">\n                        Verduras\n                    </p>\n                    <p class=\"text-[10.5px] text-[#6b7280] leading-snug\" data-kid=\"1-4-2-2-2-2\">\n                        1 ración ≈ 1 taza cruda · ½ cocida\n                    </p>\n                </div>\n                <div class=\"flex items-center gap-1.5\" data-kid=\"1-4-2-2-3\">\n                    <button class=\"h-8 w-8 rounded-full border border-[#e5e7eb] bg-white text-[#4b5563] flex items-center justify-center\" data-kid=\"1-4-2-2-3-1\">\n                        <i class=\"ti ti-minus text-[16px]\" data-kid=\"1-4-2-2-3-1-1\">\n                        </i>\n                    </button>\n                    <span class=\"w-6 text-center text-[15px] font-bold tabular-nums\" data-dynamic=\"true\" data-kid=\"1-4-2-2-3-2\" data-name=\"vegetables ration count\" data-reason=\"value updated by buttons interaction\">\n                        3\n                    </span>\n                    <button class=\"h-8 w-8 rounded-full bg-[#5b21b6] text-white flex items-center justify-center\" data-kid=\"1-4-2-2-3-3\">\n                        <i class=\"ti ti-plus text-[16px]\" data-kid=\"1-4-2-2-3-3-1\">\n                        </i>\n                    </button>\n                </div>\n            </div>\n            <!-- Frutas -->\n            <div class=\"flex items-center gap-3 py-3.5\" data-kid=\"1-4-2-3\">\n                <span class=\"h-10 w-10 shrink-0 rounded-xl bg-[#fdeeea] text-[#e0562f] flex items-center justify-center\" data-kid=\"1-4-2-3-1\">\n                    <i class=\"ti ti-apple text-[20px]\" data-kid=\"1-4-2-3-1-1\">\n                    </i>\n                </span>\n                <div class=\"min-w-0 flex-1\" data-kid=\"1-4-2-3-2\">\n                    <p class=\"text-[14px] font-semibold leading-tight\" data-kid=\"1-4-2-3-2-1\">\n                        Frutas\n                    </p>\n                    <p class=\"text-[10.5px] text-[#6b7280] leading-snug\" data-kid=\"1-4-2-3-2-2\">\n                        1 ración ≈ 1 manzana · 1 banana chica\n                    </p>\n                </div>\n                <div class=\"flex items-center gap-1.5\" data-kid=\"1-4-2-3-3\">\n                    <button class=\"h-8 w-8 rounded-full border border-[#e5e7eb] bg-white text-[#4b5563] flex items-center justify-center\" data-kid=\"1-4-2-3-3-1\">\n                        <i class=\"ti ti-minus text-[16px]\" data-kid=\"1-4-2-3-3-1-1\">\n                        </i>\n                    </button>\n                    <span class=\"w-6 text-center text-[15px] font-bold tabular-nums\" data-dynamic=\"true\" data-kid=\"1-4-2-3-3-2\" data-name=\"fruits ration count\" data-reason=\"value updated by buttons interaction\">\n                        2\n                    </span>\n                    <button class=\"h-8 w-8 rounded-full bg-[#5b21b6] text-white flex items-center justify-center\" data-kid=\"1-4-2-3-3-3\">\n                        <i class=\"ti ti-plus text-[16px]\" data-kid=\"1-4-2-3-3-3-1\">\n                        </i>\n                    </button>\n                </div>\n            </div>\n            <!-- Cereales -->\n            <div class=\"flex items-center gap-3 py-3.5\" data-kid=\"1-4-2-4\">\n                <span class=\"h-10 w-10 shrink-0 rounded-xl bg-[#fdf3e3] text-[#b7791f] flex items-center justify-center\" data-kid=\"1-4-2-4-1\">\n                    <i class=\"ti ti-cookie text-[20px]\" data-kid=\"1-4-2-4-1-1\" data-name=\"cookie icon\">\n                    </i>\n                </span>\n                <div class=\"min-w-0 flex-1\" data-kid=\"1-4-2-4-2\">\n                    <p class=\"text-[14px] font-semibold leading-tight\" data-kid=\"1-4-2-4-2-1\">\n                        Cereales\n                    </p>\n                    <p class=\"text-[10.5px] text-[#6b7280] leading-snug\" data-kid=\"1-4-2-4-2-2\">\n                        1 ración ≈ 30 g pan · ½ taza arroz\n                    </p>\n                </div>\n                <div class=\"flex items-center gap-1.5\" data-kid=\"1-4-2-4-3\">\n                    <button class=\"h-8 w-8 rounded-full border border-[#e5e7eb] bg-white text-[#4b5563] flex items-center justify-center\" data-kid=\"1-4-2-4-3-1\">\n                        <i class=\"ti ti-minus text-[16px]\" data-kid=\"1-4-2-4-3-1-1\">\n                        </i>\n                    </button>\n                    <span class=\"w-6 text-center text-[15px] font-bold tabular-nums\" data-dynamic=\"true\" data-kid=\"1-4-2-4-3-2\" data-name=\"cereals ration count\" data-reason=\"value updated by buttons interaction\">\n                        6\n                    </span>\n                    <button class=\"h-8 w-8 rounded-full bg-[#5b21b6] text-white flex items-center justify-center\" data-kid=\"1-4-2-4-3-3\">\n                        <i class=\"ti ti-plus text-[16px]\" data-kid=\"1-4-2-4-3-3-1\">\n                        </i>\n                    </button>\n                </div>\n            </div>\n            <!-- Carnes -->\n            <div class=\"flex items-center gap-3 py-3.5\" data-kid=\"1-4-2-5\">\n                <span class=\"h-10 w-10 shrink-0 rounded-xl bg-[#fbe9ec] text-[#c0392b] flex items-center justify-center\" data-kid=\"1-4-2-5-1\">\n                    <i class=\"ti ti-meat text-[20px]\" data-kid=\"1-4-2-5-1-1\">\n                    </i>\n                </span>\n                <div class=\"min-w-0 flex-1\" data-kid=\"1-4-2-5-2\">\n                    <p class=\"text-[14px] font-semibold leading-tight\" data-kid=\"1-4-2-5-2-1\">\n                        Carnes y proteínas\n                    </p>\n                    <p class=\"text-[10.5px] text-[#6b7280] leading-snug\" data-kid=\"1-4-2-5-2-2\">\n                        1 ración ≈ 100 g pollo · 120 g pescado\n                    </p>\n                </div>\n                <div class=\"flex items-center gap-1.5\" data-kid=\"1-4-2-5-3\">\n                    <button class=\"h-8 w-8 rounded-full border border-[#e5e7eb] bg-white text-[#4b5563] flex items-center justify-center\" data-kid=\"1-4-2-5-3-1\">\n                        <i class=\"ti ti-minus text-[16px]\" data-kid=\"1-4-2-5-3-1-1\">\n                        </i>\n                    </button>\n                    <span class=\"w-6 text-center text-[15px] font-bold tabular-nums\" data-dynamic=\"true\" data-kid=\"1-4-2-5-3-2\" data-name=\"proteins ration count\" data-reason=\"value updated by buttons interaction\">\n                        4\n                    </span>\n                    <button class=\"h-8 w-8 rounded-full bg-[#5b21b6] text-white flex items-center justify-center\" data-kid=\"1-4-2-5-3-3\">\n                        <i class=\"ti ti-plus text-[16px]\" data-kid=\"1-4-2-5-3-3-1\">\n                        </i>\n                    </button>\n                </div>\n            </div>\n            <!-- Grasas -->\n            <div class=\"flex items-center gap-3 py-3.5\" data-kid=\"1-4-2-6\">\n                <span class=\"h-10 w-10 shrink-0 rounded-xl bg-[#eef6f3] text-[#2f855a] flex items-center justify-center\" data-kid=\"1-4-2-6-1\">\n                    <i class=\"ti ti-droplet text-[20px]\" data-kid=\"1-4-2-6-1-1\">\n                    </i>\n                </span>\n                <div class=\"min-w-0 flex-1\" data-kid=\"1-4-2-6-2\">\n                    <p class=\"text-[14px] font-semibold leading-tight\" data-kid=\"1-4-2-6-2-1\">\n                        Grasas\n                    </p>\n                    <p class=\"text-[10.5px] text-[#6b7280] leading-snug\" data-kid=\"1-4-2-6-2-2\">\n                        1 ración ≈ 1 cda aceite · 10 almendras\n                    </p>\n                </div>\n                <div class=\"flex items-center gap-1.5\" data-kid=\"1-4-2-6-3\">\n                    <button class=\"h-8 w-8 rounded-full border border-[#e5e7eb] bg-white text-[#4b5563] flex items-center justify-center\" data-kid=\"1-4-2-6-3-1\">\n                        <i class=\"ti ti-minus text-[16px]\" data-kid=\"1-4-2-6-3-1-1\">\n                        </i>\n                    </button>\n                    <span class=\"w-6 text-center text-[15px] font-bold tabular-nums\" data-dynamic=\"true\" data-kid=\"1-4-2-6-3-2\" data-name=\"fats ration count\" data-reason=\"value updated by buttons interaction\">\n                        3\n                    </span>\n                    <button class=\"h-8 w-8 rounded-full bg-[#5b21b6] text-white flex items-center justify-center\" data-kid=\"1-4-2-6-3-3\">\n                        <i class=\"ti ti-plus text-[16px]\" data-kid=\"1-4-2-6-3-3-1\">\n                        </i>\n                    </button>\n                </div>\n            </div>\n        </div>\n        <p class=\"mt-3 flex items-center gap-1.5 text-[10.5px] leading-snug text-[#92600a] pb-2\" data-kid=\"1-4-3\">\n            <i class=\"ti ti-info-circle text-[13px]\" data-kid=\"1-4-3-1\">\n            </i>\n            Los ajustes son provisionales hasta que los guardes en el plan.\n        </p>\n    </div>\n    <!-- action bar -->\n    <div class=\"flex-none border-t border-[#e5e7eb] bg-white px-5 pt-3 pb-2\" data-kid=\"1-5\">\n        <div class=\"flex items-center gap-2.5\" data-kid=\"1-5-1\">\n            <button class=\"h-11 flex-1 rounded-full border border-[#d7dbe0] bg-white text-[13.5px] font-semibold text-[#4b5563]\" data-kid=\"1-5-1-1\">\n                Descartar cambios\n            </button>\n            <button class=\"h-11 flex-[1.35] rounded-full bg-[#5b21b6] text-white text-[13.5px] font-bold flex items-center justify-center gap-1.5\" data-kid=\"1-5-1-2\">\n                <i class=\"ti ti-device-floppy text-[17px]\" data-kid=\"1-5-1-2-1\">\n                </i>\n                Guardar en el plan\n            </button>\n        </div>\n    </div>\n    <!-- bottom tab bar -->\n    <nav class=\"flex-none border-t border-[#e5e7eb] bg-white px-2 pt-1.5 pb-1\" data-kid=\"1-6\">\n        <ul class=\"flex items-stretch\" data-kid=\"1-6-1\">\n            <li class=\"flex-1 flex flex-col items-center gap-0.5 py-1 text-[#9ca3af]\" data-kid=\"1-6-1-1\">\n                <i class=\"ti ti-users text-[22px]\" data-kid=\"1-6-1-1-1\">\n                </i>\n                <span class=\"text-[10.5px] font-medium\" data-kid=\"1-6-1-1-2\">\n                    Pacientes\n                </span>\n            </li>\n            <li class=\"flex-1 flex flex-col items-center gap-0.5 py-1 text-[#5b21b6]\" data-kid=\"1-6-1-2\">\n                <i class=\"ti ti-clipboard-list text-[22px]\" data-kid=\"1-6-1-2-1\">\n                </i>\n                <span class=\"text-[10.5px] font-bold\" data-kid=\"1-6-1-2-2\">\n                    Planes\n                </span>\n            </li>\n            <li class=\"flex-1 flex flex-col items-center gap-0.5 py-1 text-[#9ca3af]\" data-kid=\"1-6-1-3\">\n                <i class=\"ti ti-tools text-[22px]\" data-kid=\"1-6-1-3-1\">\n                </i>\n                <span class=\"text-[10.5px] font-medium\" data-kid=\"1-6-1-3-2\">\n                    Herramientas\n                </span>\n            </li>\n            <li class=\"flex-1 flex flex-col items-center gap-0.5 py-1 text-[#9ca3af]\" data-kid=\"1-6-1-4\">\n                <i class=\"ti ti-user-circle text-[22px]\" data-kid=\"1-6-1-4-1\">\n                </i>\n                <span class=\"text-[10.5px] font-medium\" data-kid=\"1-6-1-4-2\">\n                    Perfil\n                </span>\n            </li>\n        </ul>\n    </nav>\n</div>\n",
