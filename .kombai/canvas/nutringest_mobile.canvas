      },
      "html": "<div class=\"h-[812px] w-full overflow-hidden bg-[#f6f7f9] font-sans text-[#111827] antialiased\" data-kid=\"1\" data-name=\"fixed height page layout container\">\n    <style>\n        @import url('https://fonts.googleapis.com/css2?family=Montserrat:wght@400;500;600;700;800&display=swap');\n    @import url(\"https://cdn.jsdelivr.net/npm/@tabler/icons-webfont@3.48.0/dist/tabler-icons.min.css\");\n    .font-sans { font-family: 'Montserrat', ui-sans-serif, system-ui, sans-serif; }\n    .field { transition: border-color .15s ease, box-shadow .15s ease; }\n    .field:focus-within { border-color: #7c3aed; box-shadow: 0 0 0 3px rgba(124,58,237,.16); }\n    .press { transition: transform .12s ease; }\n    .press:active { transform: scale(.97); }\n    .noscroll::-webkit-scrollbar { display: none; }\n    .noscroll { -ms-overflow-style: none; scrollbar-width: none; }\n    </style>\n    <div class=\"flex h-full flex-col\" data-kid=\"1-1\" data-name=\"layout content column\">\n        <!-- Status bar -->\n        <div class=\"flex shrink-0 items-center justify-between px-5 pt-3 pb-1 text-[12px] font-semibold text-[#6b7280]\" data-kid=\"1-1-1\" data-name=\"status bar container\">\n            <span data-dynamic=\"true\" data-kid=\"1-1-1-1\" data-name=\"current time text\" data-reason=\"text updated periodically by system clock\">\n                9:41\n            </span>\n            <div class=\"flex items-center gap-1.5 text-[14px]\" data-kid=\"1-1-1-2\" data-name=\"connectivity status icons container\">\n                <i class=\"ti ti-wifi\" data-kid=\"1-1-1-2-1\" data-name=\"wifi signal icon\">\n                </i>\n                <i class=\"ti ti-battery-2\" data-kid=\"1-1-1-2-2\" data-name=\"battery level icon\">\n                </i>\n            </div>\n        </div>\n        <!-- Top app bar -->\n        <div class=\"shrink-0 border-b border-[#eceef1] bg-white px-4 py-3\" data-kid=\"1-1-2\" data-name=\"top app bar container\">\n            <div class=\"flex items-center gap-3\" data-kid=\"1-1-2-1\" data-name=\"app bar content row\">\n                <button class=\"press grid h-10 w-10 place-items-center rounded-full border border-[#e5e7eb] bg-white text-[#111827]\" data-kid=\"1-1-2-1-1\" data-name=\"back button\">\n                    <i class=\"ti ti-arrow-left text-[20px]\" data-kid=\"1-1-2-1-1-1\" data-name=\"back arrow icon\">\n                    </i>\n                </button>\n                <div class=\"min-w-0 flex-1\" data-kid=\"1-1-2-1-2\" data-name=\"page title container\">\n                    <h1 class=\"truncate text-[17px] font-bold leading-tight tracking-[-0.2px]\" data-kid=\"1-1-2-1-2-1\" data-name=\"page headline text\">\n                        Nuevo paciente\n                    </h1>\n                    <p class=\"truncate text-[12px] font-medium text-[#6b7280]\" data-kid=\"1-1-2-1-2-2\" data-name=\"page subtitle text\">\n                        Alta rápida desde el consultorio\n                    </p>\n                </div>\n                <span class=\"rounded-full bg-[#f3eefe] px-2.5 py-1 text-[11px] font-bold text-[#5b21b6]\" data-dynamic=\"true\" data-kid=\"1-1-2-1-3\" data-name=\"timer tag\" data-reason=\"text updated periodically by countdown script\">\n                    +30 s\n                </span>\n            </div>\n        </div>\n        <!-- Progress -->\n        <div class=\"shrink-0 bg-white px-5 pb-4 pt-4\" data-kid=\"1-1-3\" data-name=\"progress indicator container\">\n            <div class=\"mb-2 flex items-end justify-between\" data-kid=\"1-1-3-1\" data-name=\"step info container\">\n                <div data-kid=\"1-1-3-1-1\" data-name=\"step progress text container\">\n                    <p class=\"text-[11px] font-bold uppercase tracking-[0.14em] text-[#7c3aed]\" data-kid=\"1-1-3-1-1-1\" data-name=\"step identifier text\">\n                        Paso 1 de 2\n                    </p>\n                    <p class=\"text-[15px] font-bold leading-tight\" data-kid=\"1-1-3-1-1-2\" data-name=\"step title text\">\n                        Identificación\n                    </p>\n                </div>\n                <p class=\"text-[12px] font-semibold text-[#6b7280]\" data-kid=\"1-1-3-1-2\" data-name=\"next step label text\">\n                    Luego: Objetivo\n                </p>\n            </div>\n            <div class=\"flex gap-1.5\" data-kid=\"1-1-3-2\" data-name=\"progress bar track\">\n                <span class=\"h-1.5 flex-1 rounded-full bg-[#5b21b6]\" data-kid=\"1-1-3-2-1\" data-name=\"progress segment active\">\n                </span>\n                <span class=\"h-1.5 flex-1 rounded-full bg-[#e5e7eb]\" data-kid=\"1-1-3-2-2\" data-name=\"progress segment inactive\">\n                </span>\n            </div>\n        </div>\n        <!-- Scrollable content -->\n        <main class=\"noscroll flex-1 overflow-y-auto px-4 pb-6 pt-4\" data-kid=\"1-1-4\" data-name=\"scrollable main content area\">\n            <!-- Step 1 -->\n            <section class=\"rounded-2xl border border-[#eceef1] bg-white p-4\" data-kid=\"1-1-4-1\" data-name=\"identification step section\">\n                <header class=\"mb-4 flex items-center gap-2\" data-kid=\"1-1-4-1-1\" data-name=\"section header\">\n                    <span class=\"grid h-7 w-7 place-items-center rounded-full bg-[#f3eefe] text-[15px] text-[#5b21b6]\" data-kid=\"1-1-4-1-1-1\" data-name=\"user icon container\">\n                        <i class=\"ti ti-user\" data-kid=\"1-1-4-1-1-1-1\" data-name=\"user icon\">\n                        </i>\n                    </span>\n                    <h2 class=\"text-[14px] font-bold\" data-kid=\"1-1-4-1-1-2\" data-name=\"section title text\">\n                        Datos para identificar y contactar\n                    </h2>\n                </header>\n                <label class=\"mb-1.5 block text-[13px] font-semibold text-[#374151]\" data-kid=\"1-1-4-1-2\" data-name=\"name label\">\n                    Nombre y apellido\n                    <span class=\"text-[#7c3aed]\" data-kid=\"1-1-4-1-2-1\" data-name=\"required field asterisk\">\n                        *\n                    </span>\n                </label>\n                <input autocomplete=\"name\" class=\"field mb-1 w-full rounded-xl border border-[#e5e7eb] bg-[#fbfbfc] px-4 py-3.5 text-[15px] font-medium text-[#111827]\" data-kid=\"1-1-4-1-3\" data-name=\"name input field\" type=\"text\" value=\"Camila Rodríguez\"/>\n                <p class=\"mb-4 text-[12px] font-medium text-[#9aa1ab]\" data-kid=\"1-1-4-1-4\" data-name=\"name input helper text\">\n                    Como figura en el documento.\n                </p>\n                <label class=\"mb-1.5 block text-[13px] font-semibold text-[#374151]\" data-kid=\"1-1-4-1-5\" data-name=\"dni label\">\n                    DNI\n                    <span class=\"text-[#7c3aed]\" data-kid=\"1-1-4-1-5-1\" data-name=\"required field asterisk\">\n                        *\n                    </span>\n                </label>\n                <div class=\"field mb-1 flex items-center gap-2 rounded-xl border border-[#e5e7eb] bg-[#fbfbfc] px-4 py-3.5\" data-kid=\"1-1-4-1-6\" data-name=\"dni input container\">\n                    <i class=\"ti ti-id-badge-2 text-[18px] text-[#9aa1ab]\" data-kid=\"1-1-4-1-6-1\" data-name=\"dni icon\">\n                    </i>\n                    <input class=\"w-full bg-transparent text-[15px] font-medium tabular-nums text-[#111827]\" data-kid=\"1-1-4-1-6-2\" data-name=\"dni input field\" inputmode=\"numeric\" type=\"text\" value=\"38472910\"/>\n                </div>\n                <p class=\"mb-4 text-[12px] font-medium text-[#9aa1ab]\" data-kid=\"1-1-4-1-7\" data-name=\"dni input helper text\">\n                    Se usa para buscar y desambiguar pacientes.\n                </p>\n                <label class=\"mb-1.5 block text-[13px] font-semibold text-[#374151]\" data-kid=\"1-1-4-1-8\" data-name=\"birth date label\">\n                    Fecha de nacimiento\n                    <span class=\"text-[#7c3aed]\" data-kid=\"1-1-4-1-8-1\" data-name=\"required field asterisk\">\n                        *\n                    </span>\n                </label>\n                <div class=\"field mb-1 flex items-center gap-2 rounded-xl border border-[#e5e7eb] bg-[#fbfbfc] px-4 py-3.5\" data-kid=\"1-1-4-1-9\" data-name=\"birth date input container\">\n                    <i class=\"ti ti-calendar-event text-[18px] text-[#9aa1ab]\" data-kid=\"1-1-4-1-9-1\" data-name=\"birth date icon\">\n                    </i>\n                    <input class=\"w-full bg-transparent text-[15px] font-medium tabular-nums text-[#111827]\" data-kid=\"1-1-4-1-9-2\" data-name=\"birth date input field\" type=\"text\" value=\"14/03/1991\"/>\n                    <span class=\"shrink-0 rounded-full bg-[#eef2f6] px-2 py-0.5 text-[12px] font-semibold text-[#6b7280]\" data-dynamic=\"true\" data-kid=\"1-1-4-1-9-3\" data-name=\"calculated age text\" data-reason=\"text updated based on birthdate input calculation\">\n                        Edad 35\n                    </span>\n                </div>\n                <p class=\"mb-4 text-[12px] font-medium text-[#9aa1ab]\" data-kid=\"1-1-4-1-10\" data-name=\"birth date input helper text\">\n                    La edad se calcula automáticamente.\n                </p>\n                <label class=\"mb-1.5 block text-[13px] font-semibold text-[#374151]\" data-kid=\"1-1-4-1-11\" data-name=\"phone label\">\n                    Teléfono\n                </label>\n                <div class=\"flex items-stretch gap-2\" data-kid=\"1-1-4-1-12\" data-name=\"phone input group\">\n                    <div class=\"field flex flex-1 items-center gap-2 rounded-xl border border-[#e5e7eb] bg-[#fbfbfc] px-4 py-3.5\" data-kid=\"1-1-4-1-12-1\" data-name=\"phone input container\">\n                        <i class=\"ti ti-phone text-[18px] text-[#9aa1ab]\" data-kid=\"1-1-4-1-12-1-1\" data-name=\"phone icon\">\n                        </i>\n                        <input autocomplete=\"tel\" class=\"w-full bg-transparent text-[15px] font-medium tabular-nums text-[#111827]\" data-kid=\"1-1-4-1-12-1-2\" data-name=\"phone input field\" type=\"tel\" value=\"+54 9 11 5521-8890\"/>\n                    </div>\n                    <button class=\"press grid w-12 shrink-0 place-items-center rounded-xl text-white\" data-kid=\"1-1-4-1-12-2\" data-name=\"whatsapp button\" style=\"background:#25D366\">\n                        <i class=\"ti ti-brand-whatsapp text-[22px]\" data-kid=\"1-1-4-1-12-2-1\" data-name=\"whatsapp icon\">\n                        </i>\n                    </button>\n                </div>\n                <p class=\"mt-1 text-[12px] font-medium text-[#9aa1ab]\" data-kid=\"1-1-4-1-13\" data-name=\"phone helper text\">\n                    WhatsApp se registra con consentimiento del paciente.\n                </p>\n            </section>\n            <!-- Step 2 -->\n            <section class=\"mt-4 rounded-2xl border border-[#eceef1] bg-white p-4\" data-kid=\"1-1-4-2\" data-name=\"objective step section\">\n                <header class=\"mb-4 flex items-center gap-2\" data-kid=\"1-1-4-2-1\" data-name=\"section header\">\n                    <span class=\"grid h-7 w-7 place-items-center rounded-full bg-[#e8f4fd] text-[15px] text-[#0ea5e9]\" data-kid=\"1-1-4-2-1-1\" data-name=\"target icon container\">\n                        <i class=\"ti ti-target-arrow\" data-kid=\"1-1-4-2-1-1-1\" data-name=\"target icon\">\n                        </i>\n                    </span>\n                    <h2 class=\"text-[14px] font-bold\" data-kid=\"1-1-4-2-1-2\" data-name=\"section title text\">\n                        Objetivo inicial\n                    </h2>\n                </header>\n                <div class=\"grid grid-cols-2 gap-3\" data-kid=\"1-1-4-2-2\" data-name=\"metrics grid container\">\n                    <div data-kid=\"1-1-4-2-2-1\" data-name=\"weight metric container\">\n                        <label class=\"mb-1.5 block text-[13px] font-semibold text-[#374151]\" data-kid=\"1-1-4-2-2-1-1\" data-name=\"weight label\">\n                            Peso (kg)\n                        </label>\n                        <div class=\"field flex items-center gap-1 rounded-xl border border-[#e5e7eb] bg-[#fbfbfc] px-3 py-3.5\" data-kid=\"1-1-4-2-2-1-2\" data-name=\"weight input container\">\n                            <input class=\"w-full bg-transparent text-[15px] font-semibold tabular-nums text-[#111827]\" data-kid=\"1-1-4-2-2-1-2-1\" data-name=\"weight input field\" inputmode=\"decimal\" type=\"text\" value=\"64,5\"/>\n                            <span class=\"shrink-0 text-[12px] font-semibold text-[#9aa1ab]\" data-kid=\"1-1-4-2-2-1-2-2\" data-name=\"weight unit text\">\n                                kg\n                            </span>\n                        </div>\n                    </div>\n                    <div data-kid=\"1-1-4-2-2-2\" data-name=\"height metric container\">\n                        <label class=\"mb-1.5 block text-[13px] font-semibold text-[#374151]\" data-kid=\"1-1-4-2-2-2-1\" data-name=\"height label\">\n                            Talla (cm)\n                        </label>\n                        <div class=\"field flex items-center gap-1 rounded-xl border border-[#e5e7eb] bg-[#fbfbfc] px-3 py-3.5\" data-kid=\"1-1-4-2-2-2-2\" data-name=\"height input container\">\n                            <input class=\"w-full bg-transparent text-[15px] font-semibold tabular-nums text-[#111827]\" data-kid=\"1-1-4-2-2-2-2-1\" data-name=\"height input field\" inputmode=\"decimal\" type=\"text\" value=\"168\"/>\n                            <span class=\"shrink-0 text-[12px] font-semibold text-[#9aa1ab]\" data-kid=\"1-1-4-2-2-2-2-2\" data-name=\"height unit text\">\n                                cm\n                            </span>\n                        </div>\n                    </div>\n                </div>\n                <label class=\"mb-1.5 mt-4 block text-[13px] font-semibold text-[#374151]\" data-kid=\"1-1-4-2-3\" data-name=\"treatment objective label\">\n                    Objetivo del tratamiento\n                </label>\n                <div class=\"field flex items-center justify-between rounded-xl border border-[#e5e7eb] bg-[#fbfbfc] px-4 py-3.5\" data-kid=\"1-1-4-2-4\" data-name=\"treatment objective selector\">\n                    <span class=\"text-[15px] font-medium text-[#111827]\" data-kid=\"1-1-4-2-4-1\" data-name=\"selected objective text\">\n                        Descenso de grasa corporal\n                    </span>\n                    <i class=\"ti ti-chevron-down text-[18px] text-[#9aa1ab]\" data-kid=\"1-1-4-2-4-2\" data-name=\"chevron icon\">\n                    </i>\n                </div>\n            </section>\n            <!-- Info note -->\n            <div class=\"mt-4 flex gap-3 rounded-2xl border border-[#e3dbfa] bg-[#f7f4fe] p-4\" data-kid=\"1-1-4-3\" data-name=\"info note container\">\n                <i class=\"ti ti-info-circle mt-0.5 text-[20px] text-[#5b21b6]\" data-kid=\"1-1-4-3-1\" data-name=\"info icon\">\n                </i>\n                <div data-kid=\"1-1-4-3-2\" data-name=\"info text container\">\n                    <p class=\"text-[13px] font-bold text-[#4c1d95]\" data-kid=\"1-1-4-3-2-1\" data-name=\"info title text\">\n                        Los datos clínicos se cargan después\n                    </p>\n                    <p class=\"mt-0.5 text-[12px] font-medium leading-relaxed text-[#6b7280]\" data-kid=\"1-1-4-3-2-2\" data-name=\"info body text\">\n                        Anamnesis, medidas ISAK y plan nutricional se completan desde la ficha del paciente cuando tengas tiempo en consulta.\n                    </p>\n                </div>\n            </div>\n        </main>\n        <!-- Footer actions -->\n        <div class=\"shrink-0 border-t border-[#eceef1] bg-white px-4 pb-5 pt-3\" data-kid=\"1-1-5\" data-name=\"footer actions container\">\n            <div class=\"mb-2.5 flex items-center gap-2 text-[12px] font-medium text-[#6b7280]\" data-kid=\"1-1-5-1\" data-name=\"validation status container\">\n                <i class=\"ti ti-alert-circle text-[14px] text-[#7c3aed]\" data-kid=\"1-1-5-1-1\" data-name=\"alert icon\">\n                </i>\n                <span data-kid=\"1-1-5-1-2\" data-name=\"pending fields status text\">\n                    <span class=\"font-semibold text-[#111827]\" data-dynamic=\"true\" data-kid=\"1-1-5-1-2-1\" data-name=\"pending fields count text\" data-reason=\"number updated by form validation script\">\n                        2 campos obligatorios\n                    </span>\n                    pendientes\n                </span>\n            </div>\n            <div class=\"flex gap-3\" data-kid=\"1-1-5-2\" data-name=\"action buttons container\">\n                <button class=\"press h-[52px] w-[118px] shrink-0 rounded-full border border-[#d7dade] bg-white text-[15px] font-semibold text-[#374151]\" data-kid=\"1-1-5-2-1\" data-name=\"cancel button\">\n                    Cancelar\n                </button>\n                <button class=\"press h-[52px] flex-1 rounded-full text-[15px] font-bold text-white shadow-[0_8px_20px_-8px_rgba(91,33,182,.7)]\" data-kid=\"1-1-5-2-2\" data-name=\"save patient button\" style=\"background:#5b21b6\">\n                    <span class=\"flex items-center justify-center gap-2\" data-kid=\"1-1-5-2-2-1\" data-name=\"save button label with icon\">\n                        <i class=\"ti ti-device-floppy text-[19px]\" data-kid=\"1-1-5-2-2-1-1\" data-name=\"floppy disk icon\">\n                        </i>\n                        Guardar paciente\n                    </span>\n                </button>\n            </div>\n        </div>\n    </div>\n</div>\n",
      "comments": [],
      "created": "2026-10-02T18:35:13.348020+00:00",
      "modified": "2026-10-02T18:35:45.217150+00:00",
      "id": "var_019946865df7"
    },
    "var_f6622982b94e": {
      "type": "variant",
      "label": "Login",
      "parentId": null,
      "themeId": null,
      "rect": {
        "x": 1425,
        "y": 0,
        "w": 375,
        "h": 812
      },
      "html": "<style>\n    @import url('https://fonts.googleapis.com/css2?family=Montserrat:wght@400;500;600;700;800&display=swap');\n@import url('https://cdn.jsdelivr.net/npm/@tabler/icons-webfont@3.48.0/dist/tabler-icons.min.css');\n</style>\n<div class=\"min-h-screen bg-white flex flex-col font-[Montserrat,sans-serif] text-[#111827] antialiased\" data-kid=\"1\" data-name=\"page layout container\">\n    <div class=\"px-6 pt-16 pb-8 flex flex-col grow\" data-kid=\"1-1\" data-name=\"login page main content area\">\n        <!-- Logo -->\n        <div class=\"flex items-center gap-2.5\" data-kid=\"1-1-1\" data-name=\"header logo container\">\n            <div class=\"w-10 h-10 rounded-[13px] bg-gradient-to-br from-[#5b21b6] to-[#7c3aed] flex items-center justify-center shadow-[0_6px_16px_-4px_rgba(91,33,182,0.45)]\" data-kid=\"1-1-1-1\" data-name=\"logo leaf icon background container\">\n                <i class=\"ti ti-leaf text-white text-[22px]\" data-kid=\"1-1-1-1-1\" data-name=\"leaf logo icon\">\n                </i>\n            </div>\n            <span class=\"text-[19px] font-extrabold tracking-tight text-[#2b0c4f]\" data-kid=\"1-1-1-2\" data-name=\"brand name text\">\n                Nutri\n                <span class=\"text-[#7c3aed]\" data-kid=\"1-1-1-2-1\" data-name=\"brand name suffix highlight\">\n                    ngest\n                </span>\n            </span>\n        </div>\n        <!-- Heading -->\n        <div class=\"mt-14\" data-kid=\"1-1-2\" data-name=\"page heading container\">\n            <h1 class=\"text-[30px] leading-[1.15] font-extrabold tracking-[-0.02em] text-[#111827]\" data-kid=\"1-1-2-1\" data-name=\"login page title\">\n                Bienvenido\n            </h1>\n            <p class=\"mt-2 text-[14.5px] leading-relaxed text-[#6b7280]\" data-kid=\"1-1-2-2\" data-name=\"login page subtitle\">\n                Iniciá sesión para continuar con tu consultorio.\n            </p>\n        </div>\n        <!-- Form -->\n        <div class=\"mt-9 space-y-5\" data-kid=\"1-1-3\" data-name=\"login form container\">\n            <!-- Email -->\n            <div data-kid=\"1-1-3-1\" data-name=\"email input section container\">\n                <label class=\"block text-[13px] font-semibold text-[#374151] mb-1.5\" data-kid=\"1-1-3-1-1\" data-name=\"email label\" for=\"email\">\n                    Correo electrónico\n                </label>\n                <div class=\"relative\" data-kid=\"1-1-3-1-2\" data-name=\"email input wrapper\">\n                    <i class=\"ti ti-mail absolute left-3.5 top-1/2 -translate-y-1/2 text-[#9ca3af] text-[19px]\" data-kid=\"1-1-3-1-2-1\" data-name=\"email input icon\">\n                    </i>\n                    <input autocomplete=\"email\" class=\"w-full h-12 pl-11 pr-3.5 rounded-[14px] border border-[#fca5a5] bg-[#fffdfd] text-[15px] text-[#111827] placeholder:text-[#9ca3af] outline-none focus:border-[#dc2626] focus:ring-4 focus:ring-[#dc2626]/10\" data-kid=\"1-1-3-1-2-2\" data-name=\"email input field\" id=\"email\" inputmode=\"email\" placeholder=\"nombre@clinica.com\" type=\"email\"/>\n                </div>\n                <p class=\"mt-2 flex items-start gap-1.5 text-[12.5px] font-medium text-[#dc2626]\" data-kid=\"1-1-3-1-3\" data-name=\"error message container\">\n                    <i class=\"ti ti-alert-circle text-[15px] mt-[1px] shrink-0\" data-kid=\"1-1-3-1-3-1\" data-name=\"error alert icon\">\n                    </i>\n                    <span data-kid=\"1-1-3-1-3-2\" data-name=\"error message text\">\n                        No pudimos conectar. Revisá tu conexión.\n                    </span>\n                </p>\n            </div>\n            <!-- Password -->\n            <div data-kid=\"1-1-3-2\" data-name=\"password input section container\">\n                <label class=\"block text-[13px] font-semibold text-[#374151] mb-1.5\" data-kid=\"1-1-3-2-1\" data-name=\"password label\" for=\"password\">\n                    Contraseña\n                </label>\n                <div class=\"relative\" data-kid=\"1-1-3-2-2\" data-name=\"password input wrapper\">\n                    <i class=\"ti ti-lock absolute left-3.5 top-1/2 -translate-y-1/2 text-[#9ca3af] text-[19px]\" data-kid=\"1-1-3-2-2-1\" data-name=\"password input icon\">\n                    </i>\n                    <input autocomplete=\"current-password\" class=\"w-full h-12 pl-11 pr-12 rounded-[14px] border border-[#e5e7eb] bg-white text-[15px] text-[#111827] placeholder:text-[#9ca3af] outline-none focus:border-[#7c3aed] focus:ring-4 focus:ring-[#7c3aed]/10\" data-kid=\"1-1-3-2-2-2\" data-name=\"password input field\" id=\"password\" placeholder=\"••••••••\" type=\"password\"/>\n                    <button aria-label=\"Mostrar contraseña\" class=\"absolute right-3 top-1/2 -translate-y-1/2 text-[#6b7280] hover:text-[#374151] p-1\" data-kid=\"1-1-3-2-2-3\" data-name=\"password visibility toggle button\" type=\"button\">\n                        <i class=\"ti ti-eye text-[19px]\" data-kid=\"1-1-3-2-2-3-1\" data-name=\"eye icon\">\n                        </i>\n                    </button>\n                </div>\n            </div>\n            <!-- Submit -->\n            <button class=\"w-full h-12 mt-2 rounded-full bg-[#5b21b6] text-white text-[15px] font-semibold flex items-center justify-center gap-2 shadow-[0_8px_20px_-6px_rgba(91,33,182,0.5)] active:scale-[0.98] transition-transform\" data-kid=\"1-1-3-3\" data-name=\"submit button\" type=\"submit\">\n                Iniciar sesión\n                <i class=\"ti ti-arrow-right text-[18px]\" data-kid=\"1-1-3-3-1\" data-name=\"arrow right icon\">\n                </i>\n            </button>\n            <a class=\"block text-center text-[13.5px] font-semibold text-[#7c3aed] pt-1\" data-kid=\"1-1-3-4\" data-name=\"forgot password link\" href=\"#\">\n                ¿Olvidaste tu contraseña?\n            </a>\n        </div>\n        <div class=\"grow\" data-kid=\"1-1-4\" data-name=\"vertical spacer\">\n        </div>\n        <!-- Footer -->\n        <div class=\"flex items-center justify-center gap-1.5 text-[12px] text-[#9ca3af] pt-8\" data-kid=\"1-1-5\" data-name=\"footer security information bar\">\n            <i class=\"ti ti-shield-check text-[15px]\" data-kid=\"1-1-5-1\" data-name=\"security shield icon\">\n            </i>\n            <span data-kid=\"1-1-5-2\" data-name=\"security session duration text\">\n                Sesión segura · 30 días\n            </span>\n        </div>\n    </div>\n</div>\n",
