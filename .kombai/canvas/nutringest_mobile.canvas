      "html": "<div class=\"h-[812px] w-full overflow-hidden bg-[#f6f7f9] text-[#111827]\" data-kid=\"1\" style=\"font-family:'Montserrat',system-ui,-apple-system,sans-serif\">\n    <style>\n        @import url('https://fonts.googleapis.com/css2?family=Montserrat:wght@400;500;600;700;800&display=swap');\n    @import url(\"https://cdn.jsdelivr.net/npm/@tabler/icons-webfont@3.48.0/dist/tabler-icons.min.css\");\n    .hide-sb { -ms-overflow-style: none; scrollbar-width: none; }\n    .hide-sb::-webkit-scrollbar { display: none; }\n    </style>\n    <div class=\"flex h-full flex-col\" data-kid=\"1-1\">\n        <!-- Status bar -->\n        <div class=\"flex items-center justify-between px-5 pb-0.5 pt-2.5 text-[12px] font-semibold text-[#111827]\" data-kid=\"1-1-1\">\n            <span data-dynamic=\"true\" data-kid=\"1-1-1-1\" data-name=\"current time text\" data-reason=\"text replaced every minute by clock script\">\n                9:41\n            </span>\n            <div class=\"flex items-center gap-1.5 text-[13px] text-[#111827]\" data-kid=\"1-1-1-2\">\n                <i class=\"ti ti-signal-4\" data-kid=\"1-1-1-2-1\">\n                </i>\n                <i class=\"ti ti-wifi\" data-kid=\"1-1-1-2-2\">\n                </i>\n                <i class=\"ti ti-battery-4\" data-kid=\"1-1-1-2-3\">\n                </i>\n            </div>\n        </div>\n        <!-- App bar -->\n        <div class=\"flex items-center gap-3 px-4 pb-3 pt-1.5\" data-kid=\"1-1-2\">\n            <button class=\"flex h-9 w-9 shrink-0 items-center justify-center rounded-full border border-[#e5e7eb] bg-white text-[#2b0c4f]\" data-kid=\"1-1-2-1\">\n                <i class=\"ti ti-arrow-left text-[18px]\" data-kid=\"1-1-2-1-1\">\n                </i>\n            </button>\n            <div class=\"min-w-0 flex-1\" data-kid=\"1-1-2-2\">\n                <p class=\"text-[15.5px] font-bold leading-tight text-[#2b0c4f]\" data-kid=\"1-1-2-2-1\">\n                    Evolución\n                </p>\n                <p class=\"truncate text-[11px] text-[#6b7280]\" data-kid=\"1-1-2-2-2\">\n                    Lucía Fernández · 34 años · ISAK 1\n                </p>\n            </div>\n            <button class=\"flex h-9 w-9 shrink-0 items-center justify-center rounded-full border border-[#e5e7eb] bg-white text-[#6b7280]\" data-kid=\"1-1-2-3\">\n                <i class=\"ti ti-dots text-[17px]\" data-kid=\"1-1-2-3-1\">\n                </i>\n            </button>\n        </div>\n        <!-- Scroll area -->\n        <div class=\"hide-sb flex-1 overflow-y-auto px-4 pb-5\" data-kid=\"1-1-3\">\n            <!-- Metric selector -->\n            <div class=\"grid grid-cols-3 gap-1 rounded-xl bg-[#eceef2] p-1\" data-kid=\"1-1-3-1\" role=\"tablist\">\n                <button aria-selected=\"true\" class=\"h-9 rounded-lg bg-white text-[12.5px] font-semibold text-[#2b0c4f] shadow-[0_1px_2px_rgba(16,24,40,0.06)]\" data-kid=\"1-1-3-1-1\" role=\"tab\">\n                    Peso\n                </button>\n                <button aria-selected=\"false\" class=\"h-9 rounded-lg text-[12.5px] font-semibold text-[#6b7280]\" data-kid=\"1-1-3-1-2\" role=\"tab\">\n                    % Grasa\n                </button>\n                <button aria-selected=\"false\" class=\"h-9 rounded-lg text-[12.5px] font-semibold text-[#6b7280]\" data-kid=\"1-1-3-1-3\" role=\"tab\">\n                    % Músculo\n                </button>\n            </div>\n            <!-- Chart card -->\n            <section class=\"mt-3 rounded-2xl border border-[#e5e7eb] bg-white p-4\" data-kid=\"1-1-3-2\">\n                <div class=\"flex items-start justify-between\" data-kid=\"1-1-3-2-1\">\n                    <div data-kid=\"1-1-3-2-1-1\">\n                        <h2 class=\"text-[15px] font-bold text-[#2b0c4f]\" data-kid=\"1-1-3-2-1-1-1\">\n                            Evolución de peso\n                        </h2>\n                        <p class=\"mt-0.5 text-[11px] text-[#6b7280]\" data-kid=\"1-1-3-2-1-1-2\">\n                            6 mediciones · Abr – Sep 2026\n                        </p>\n                    </div>\n                    <div class=\"flex gap-1 rounded-full bg-[#f1f2f5] p-0.5\" data-kid=\"1-1-3-2-1-2\">\n                        <button class=\"rounded-full px-2.5 py-1 text-[10.5px] font-semibold text-[#6b7280]\" data-kid=\"1-1-3-2-1-2-1\">\n                            3M\n                        </button>\n                        <button class=\"rounded-full bg-white px-2.5 py-1 text-[10.5px] font-semibold text-[#5b21b6] shadow-[0_1px_2px_rgba(16,24,40,0.08)]\" data-kid=\"1-1-3-2-1-2-2\">\n                            6M\n                        </button>\n                        <button class=\"rounded-full px-2.5 py-1 text-[10.5px] font-semibold text-[#6b7280]\" data-kid=\"1-1-3-2-1-2-3\">\n                            1A\n                        </button>\n                    </div>\n                </div>\n                <div class=\"mt-3 flex items-end gap-2\" data-kid=\"1-1-3-2-2\">\n                    <span class=\"text-[30px] font-extrabold leading-none tracking-tight text-[#2b0c4f]\" data-kid=\"1-1-3-2-2-1\">\n                        68,4\n                    </span>\n                    <span class=\"pb-0.5 text-[13px] font-semibold text-[#6b7280]\" data-kid=\"1-1-3-2-2-2\">\n                        kg\n                    </span>\n                    <span class=\"mb-0.5 ml-auto flex items-center gap-1 rounded-full bg-[#ecfdf5] px-2 py-1 text-[11px] font-bold text-[#059669]\" data-kid=\"1-1-3-2-2-3\">\n                        <i class=\"ti ti-trending-down text-[13px]\" data-kid=\"1-1-3-2-2-3-1\">\n                        </i>\n                        −4,0 kg\n                    </span>\n                </div>\n                <div class=\"relative mt-2.5 h-[144px] w-full\" data-kid=\"1-1-3-2-3\">\n                    <canvas data-dynamic=\"true\" data-kid=\"1-1-3-2-3-1\" data-name=\"evolution line chart\" data-reason=\"rendered by Chart.js library\" id=\"evolChart\">\n                    </canvas>\n                </div>\n                <p class=\"mt-1.5 border-t border-[#f0f1f4] pt-2 text-[10.5px] text-[#9ca3af]\" data-kid=\"1-1-3-2-4\">\n                    Eje X: fecha de medición · Eje Y: peso en kilogramos\n                </p>\n            </section>\n            <!-- Somatocarta card -->\n            <section class=\"mt-3 rounded-2xl border border-[#e5e7eb] bg-white p-4\" data-kid=\"1-1-3-3\">\n                <div class=\"flex items-start justify-between\" data-kid=\"1-1-3-3-1\">\n                    <div data-kid=\"1-1-3-3-1-1\">\n                        <h2 class=\"text-[15px] font-bold text-[#2b0c4f]\" data-kid=\"1-1-3-3-1-1-1\">\n                            Somatocarta\n                        </h2>\n                        <p class=\"mt-0.5 text-[11px] text-[#6b7280]\" data-kid=\"1-1-3-3-1-1-2\">\n                            Componentes Heath-Carter\n                        </p>\n                    </div>\n                    <span class=\"rounded-full border border-[#ede9fe] bg-[#f5f3ff] px-2.5 py-1 text-[10.5px] font-bold text-[#5b21b6]\" data-kid=\"1-1-3-3-1-2\">\n                        ISAK\n                    </span>\n                </div>\n                <div class=\"mt-1 flex justify-center\" data-kid=\"1-1-3-3-2\">\n                    <svg aria-label=\"Somatocarta con los ejes endomorfia, mesomorfia y ectomorfia y la posición actual del paciente\" data-kid=\"1-1-3-3-2-1\" height=\"198\" role=\"img\" viewbox=\"0 0 300 296\" width=\"100%\">\n                        <!-- triangle outline -->\n                        <path d=\"M150,20 L20,262 L280,262 Z\" fill=\"#faf9ff\" stroke=\"#cbd5e1\" stroke-linejoin=\"round\" stroke-width=\"1.4\">\n                        </path>\n                        <!-- mesomorphy gridlines (horizontal) -->\n                        <g stroke=\"#e5e7eb\" stroke-width=\"1\">\n                            <line x1=\"117.5\" x2=\"182.5\" y1=\"80.5\" y2=\"80.5\">\n                            </line>\n                            <line x1=\"85\" x2=\"215\" y1=\"141\" y2=\"141\">\n                            </line>\n                            <line x1=\"52.5\" x2=\"247.5\" y1=\"201.5\" y2=\"201.5\">\n                            </line>\n                        </g>\n                        <!-- endomorphy gridlines (parallel to A-C) -->\n                        <g stroke=\"#e5e7eb\" stroke-width=\"1\">\n                            <line x1=\"85\" x2=\"117.5\" y1=\"262\" y2=\"80.5\">\n                            </line>\n                            <line x1=\"150\" x2=\"85\" y1=\"262\" y2=\"141\">\n                            </line>\n                            <line x1=\"215\" x2=\"52.5\" y1=\"262\" y2=\"201.5\">\n                            </line>\n                        </g>\n                        <!-- ectomorphy gridlines (parallel to A-B) -->\n                        <g stroke=\"#e5e7eb\" stroke-width=\"1\">\n                            <line x1=\"85\" x2=\"182.5\" y1=\"262\" y2=\"80.5\">\n                            </line>\n                            <line x1=\"150\" x2=\"215\" y1=\"262\" y2=\"141\">\n                            </line>\n                            <line x1=\"215\" x2=\"247.5\" y1=\"262\" y2=\"201.5\">\n                            </line>\n                        </g>\n                        <!-- tick marks along base for endomorphy / ectomorphy scale -->\n                        <g stroke=\"#cbd5e1\" stroke-width=\"1.4\">\n                            <line x1=\"85\" x2=\"85\" y1=\"262\" y2=\"266\">\n                            </line>\n                            <line x1=\"150\" x2=\"150\" y1=\"262\" y2=\"266\">\n                            </line>\n                            <line x1=\"215\" x2=\"215\" y1=\"262\" y2=\"266\">\n                            </line>\n                        </g>\n                        <!-- plotted current position -->\n                        <circle cx=\"132\" cy=\"140\" fill=\"#7c3aed\" fill-opacity=\"0.14\" r=\"13\">\n                        </circle>\n                        <circle cx=\"132\" cy=\"140\" fill=\"#5b21b6\" r=\"6\" stroke=\"#ffffff\" stroke-width=\"2.4\">\n                        </circle>\n                        <line stroke=\"#7c3aed\" stroke-dasharray=\"3 3\" stroke-opacity=\"0.55\" stroke-width=\"1\" x1=\"132\" x2=\"132\" y1=\"140\" y2=\"262\">\n                        </line>\n                        <!-- axis labels -->\n                        <text fill=\"#5b21b6\" font-family=\"Montserrat, sans-serif\" font-size=\"10.5\" font-weight=\"700\" text-anchor=\"middle\" x=\"150\" y=\"12\">\n                            Mesomorfia\n                        </text>\n                        <text fill=\"#5b21b6\" font-family=\"Montserrat, sans-serif\" font-size=\"10.5\" font-weight=\"700\" text-anchor=\"start\" x=\"12\" y=\"282\">\n                            Endomorfia\n                        </text>\n                        <text fill=\"#5b21b6\" font-family=\"Montserrat, sans-serif\" font-size=\"10.5\" font-weight=\"700\" text-anchor=\"end\" x=\"288\" y=\"282\">\n                            Ectomorfia\n                        </text>\n                        <text fill=\"#2b0c4f\" font-family=\"Montserrat, sans-serif\" font-size=\"9.5\" font-weight=\"700\" text-anchor=\"middle\" x=\"132\" y=\"128\">\n                            Sep 2026\n                        </text>\n                        <!-- scale caption -->\n                        <text fill=\"#9ca3af\" font-family=\"Montserrat, sans-serif\" font-size=\"8.5\" font-weight=\"500\" text-anchor=\"middle\" x=\"150\" y=\"292\">\n                            Retícula cada 2 unidades · escala 0–7\n                        </text>\n                    </svg>\n                </div>\n                <!-- component values -->\n                <div class=\"mt-1 grid grid-cols-3 gap-2\" data-kid=\"1-1-3-3-3\">\n                    <div class=\"rounded-xl border border-[#e5e7eb] bg-[#fafafa] px-2.5 py-2\" data-kid=\"1-1-3-3-3-1\">\n                        <div class=\"flex items-center gap-1.5\" data-kid=\"1-1-3-3-3-1-1\">\n                            <span class=\"h-2 w-2 rounded-full bg-[#7c3aed]\" data-kid=\"1-1-3-3-3-1-1-1\">\n                            </span>\n                            <span class=\"text-[10px] font-semibold uppercase tracking-wide text-[#6b7280]\" data-kid=\"1-1-3-3-3-1-1-2\">\n                                Endo\n                            </span>\n                        </div>\n                        <p class=\"mt-1 text-[16px] font-bold text-[#2b0c4f]\" data-kid=\"1-1-3-3-3-1-2\">\n                            3,2\n                        </p>\n                    </div>\n                    <div class=\"rounded-xl border border-[#e5e7eb] bg-[#fafafa] px-2.5 py-2\" data-kid=\"1-1-3-3-3-2\">\n                        <div class=\"flex items-center gap-1.5\" data-kid=\"1-1-3-3-3-2-1\">\n                            <span class=\"h-2 w-2 rounded-full bg-[#5b21b6]\" data-kid=\"1-1-3-3-3-2-1-1\">\n                            </span>\n                            <span class=\"text-[10px] font-semibold uppercase tracking-wide text-[#6b7280]\" data-kid=\"1-1-3-3-3-2-1-2\">\n                                Meso\n                            </span>\n                        </div>\n                        <p class=\"mt-1 text-[16px] font-bold text-[#2b0c4f]\" data-kid=\"1-1-3-3-3-2-2\">\n                            5,1\n                        </p>\n                    </div>\n                    <div class=\"rounded-xl border border-[#e5e7eb] bg-[#fafafa] px-2.5 py-2\" data-kid=\"1-1-3-3-3-3\">\n                        <div class=\"flex items-center gap-1.5\" data-kid=\"1-1-3-3-3-3-1\">\n                            <span class=\"h-2 w-2 rounded-full bg-[#0ea5e9]\" data-kid=\"1-1-3-3-3-3-1-1\">\n                            </span>\n                            <span class=\"text-[10px] font-semibold uppercase tracking-wide text-[#6b7280]\" data-kid=\"1-1-3-3-3-3-1-2\">\n                                Ecto\n                            </span>\n                        </div>\n                        <p class=\"mt-1 text-[16px] font-bold text-[#2b0c4f]\" data-kid=\"1-1-3-3-3-3-2\">\n                            1,8\n                        </p>\n                    </div>\n                </div>\n                <div class=\"mt-2.5 flex items-center gap-2 rounded-xl bg-[#f5f3ff] px-3 py-2\" data-kid=\"1-1-3-3-4\">\n                    <i class=\"ti ti-calendar-stats text-[15px] text-[#5b21b6]\" data-kid=\"1-1-3-3-4-1\">\n                    </i>\n                    <p class=\"text-[11px] text-[#4c1d95]\" data-kid=\"1-1-3-3-4-2\">\n                        <span class=\"font-bold\" data-kid=\"1-1-3-3-4-2-1\">\n                            Evaluación:\n                        </span>\n                        12 Sep 2026 · Somatotipo\n                        <span class=\"font-bold\" data-kid=\"1-1-3-3-4-2-2\">\n                            Mesomorfo balanceado (3,2–5,1–1,8)\n                        </span>\n                    </p>\n                </div>\n            </section>\n            <!-- comparison link -->\n            <button class=\"mt-3 flex w-full items-center gap-3 rounded-2xl border border-[#e5e7eb] bg-white px-4 py-3 text-left\" data-kid=\"1-1-3-4\">\n                <span class=\"flex h-9 w-9 items-center justify-center rounded-full bg-[#f1f2f5] text-[#5b21b6]\" data-kid=\"1-1-3-4-1\">\n                    <i class=\"ti ti-arrows-diff text-[17px]\" data-kid=\"1-1-3-4-1-1\">\n                    </i>\n                </span>\n                <span class=\"min-w-0 flex-1\" data-kid=\"1-1-3-4-2\">\n                    <span class=\"block text-[13px] font-bold text-[#2b0c4f]\" data-kid=\"1-1-3-4-2-1\">\n                        Comparar mediciones\n                    </span>\n                    <span class=\"block text-[10.5px] text-[#6b7280]\" data-kid=\"1-1-3-4-2-2\">\n                        Cotejar dos evaluaciones concretas\n                    </span>\n                </span>\n                <i class=\"ti ti-chevron-right text-[18px] text-[#9ca3af]\" data-kid=\"1-1-3-4-3\">\n                </i>\n            </button>\n        </div>\n        <!-- Bottom tab bar -->\n        <nav class=\"border-t border-[#e5e7eb] bg-white px-2 pb-4 pt-2\" data-kid=\"1-1-4\">\n            <div class=\"flex items-start justify-around\" data-kid=\"1-1-4-1\">\n                <a class=\"flex w-[72px] flex-col items-center gap-1 text-[#5b21b6]\" data-kid=\"1-1-4-1-1\">\n                    <i class=\"ti ti-users text-[22px]\" data-kid=\"1-1-4-1-1-1\">\n                    </i>\n                    <span class=\"text-[10.5px] font-bold\" data-kid=\"1-1-4-1-1-2\">\n                        Pacientes\n                    </span>\n                </a>\n                <a class=\"flex w-[72px] flex-col items-center gap-1 text-[#9ca3af]\" data-kid=\"1-1-4-1-2\">\n                    <i class=\"ti ti-clipboard-list text-[22px]\" data-kid=\"1-1-4-1-2-1\">\n                    </i>\n                    <span class=\"text-[10.5px] font-medium\" data-kid=\"1-1-4-1-2-2\">\n                        Planes\n                    </span>\n                </a>\n                <a class=\"flex w-[72px] flex-col items-center gap-1 text-[#9ca3af]\" data-kid=\"1-1-4-1-3\">\n                    <i class=\"ti ti-calculator text-[22px]\" data-kid=\"1-1-4-1-3-1\">\n                    </i>\n                    <span class=\"text-[10.5px] font-medium\" data-kid=\"1-1-4-1-3-2\">\n                        Herramientas\n                    </span>\n                </a>\n                <a class=\"flex w-[72px] flex-col items-center gap-1 text-[#9ca3af]\" data-kid=\"1-1-4-1-4\">\n                    <i class=\"ti ti-user-circle text-[22px]\" data-kid=\"1-1-4-1-4-1\">\n                    </i>\n                    <span class=\"text-[10.5px] font-medium\" data-kid=\"1-1-4-1-4-2\">\n                        Perfil\n                    </span>\n                </a>\n            </div>\n        </nav>\n    </div>\n    <script src=\"https://cdn.jsdelivr.net/npm/chart.js\">\n    </script>\n    <script>\n        (function () {\n      var el = document.getElementById('evolChart');\n      if (!el || typeof Chart === 'undefined') return;\n      var labels = ['Abr', 'May', 'Jun', 'Jul', 'Ago', 'Sep'];\n      var values = [72.4, 71.1, 70.2, 69.5, 68.9, 68.4];\n      var valueLabels = {\n        id: 'valueLabels',\n        afterDatasetsDraw: function (chart) {\n          var c = chart.ctx;\n          var meta = chart.getDatasetMeta(0);\n          c.save();\n          c.font = '700 10px Montserrat, sans-serif';\n          c.fillStyle = '#2b0c4f';\n          c.textAlign = 'center';\n          meta.data.forEach(function (pt, i) {\n            c.fillText(String(values[i]).replace('.', ','), pt.x, pt.y - 10);\n          });\n          c.restore();\n        }\n      };\n      new Chart(el, {\n        type: 'line',\n        data: {\n          labels: labels,\n          datasets: [{\n            label: 'Peso',\n            data: values,\n            borderColor: '#7c3aed',\n            backgroundColor: 'rgba(124,58,237,0.10)',\n            borderWidth: 2.5,\n            tension: 0.35,\n            fill: true,\n            pointBackgroundColor: '#5b21b6',\n            pointBorderColor: '#ffffff',\n            pointBorderWidth: 2,\n            pointRadius: 4,\n            pointHoverRadius: 6\n          }]\n        },\n        options: {\n          responsive: true,\n          maintainAspectRatio: false,\n          animation: false,\n          layout: { padding: { top: 14, right: 8, left: 0, bottom: 0 } },\n          plugins: {\n            legend: { display: false },\n            tooltip: {\n              enabled: true,\n              backgroundColor: '#2b0c4f',\n              titleFont: { family: 'Montserrat', size: 11, weight: '700' },\n              bodyFont: { family: 'Montserrat', size: 11 },\n              padding: 8,\n              displayColors: false,\n              callbacks: { label: function (c) { return String(c.parsed.y).replace('.', ',') + ' kg'; } }\n            }\n          },\n          scales: {\n            x: {\n              offset: true,\n              grid: { display: false },\n              border: { color: '#e5e7eb' },\n              ticks: { color: '#6b7280', font: { family: 'Montserrat', size: 10 } }\n            },\n            y: {\n              suggestedMin: 67.5,\n              suggestedMax: 74,\n              grid: { color: '#f0f1f4' },\n              border: { display: false },\n              ticks: { color: '#6b7280', font: { family: 'Montserrat', size: 10 }, maxTicksLimit: 5, callback: function (v) { return v; } },\n              title: { display: true, text: 'kg', color: '#6b7280', font: { family: 'Montserrat', size: 10, weight: '700' } }\n            }\n          }\n        },\n        plugins: [valueLabels]\n      });\n    })();\n    </script>\n</div>\n",
