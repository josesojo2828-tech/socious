  organizationId            String?
  nutritionist              Nutritionist                           @relation(fields: [nutritionistId], references: [id], onDelete: Cascade)
  organization              Organization?                          @relation(fields: [organizationId], references: [id])
  sportDiscipline           SportDiscipline?                       @relation(fields: [sportDisciplineId], references: [id])
  collaborators             InstitutionalCalculationCollaborator[]
  meals                     InstitutionalMealConfig[]
  menus                     InstitutionalMenu[]

  @@index([organizationId])
}

model InstitutionalCalculationCollaborator {
  id             String                          @id @default(uuid())
  calculationId  String
  nutritionistId String
  role           InstitutionalCollaboratorRole   @default(EDITOR)
  assignedById   String?
  assignedAt     DateTime                        @default(now())
  status         InstitutionalCollaboratorStatus @default(PENDING)
  assignedBy     Nutritionist?                   @relation("AssignedCalculationCollaborator", fields: [assignedById], references: [id])
  calculation    InstitutionalCalculation        @relation(fields: [calculationId], references: [id], onDelete: Cascade)
  nutritionist   Nutritionist                    @relation("CollaboratorOfCalculation", fields: [nutritionistId], references: [id], onDelete: Cascade)

  @@unique([calculationId, nutritionistId])
  @@unique([calculationId, nutritionistId], map: "InstitutionalCalculationCollaborator_calculationId_nutritionist")
  @@index([nutritionistId])
  @@index([calculationId])
}

model SportDiscipline {
  id              String                     @id @default(uuid())
  name            String                     @unique
  code            String?
  metValue        Decimal                    @db.Decimal(5, 2)
  category        String?
  description     String?
  isActive        Boolean                    @default(true)
  createdAt       DateTime                   @default(now())
  updatedAt       DateTime                   @updatedAt
  calculations    InstitutionalCalculation[]
  sportsHistories SportsHistoryDiscipline[]
}

model InstitutionalMealConfig {
  id                String                   @id @default(uuid())
  calculationId     String
  mealType          String
  percentage        Float
  targetKcal        Float
  proteinPercentage Float
  fatPercentage     Float
  carbsPercentage   Float
  proteinGrams      Float
  fatGrams          Float
  carbsGrams        Float
  calculation       InstitutionalCalculation @relation(fields: [calculationId], references: [id], onDelete: Cascade)
}

model InstitutionalMenu {
  id            String                   @id @default(uuid())
  calculationId String
  name          String
  totalCost     Float
  costPerCapita Float
  calculation   InstitutionalCalculation @relation(fields: [calculationId], references: [id], onDelete: Cascade)
  items         InstitutionalMenuItem[]
}

model InstitutionalMenuItem {
  id            String            @id @default(uuid())
  menuId        String
  foodId        String
  mealType      String
  portionGrams  Float
  unitPrice     Float
  perCapitaCost Float
  totalQuantity Float
  totalCost     Float
  food          FoodItem          @relation(fields: [foodId], references: [id])
  menu          InstitutionalMenu @relation(fields: [menuId], references: [id], onDelete: Cascade)
}

model CalculatorUsage {
  id             String   @id @default(uuid())
  userId         String?
  calculatorType String
  inputSnapshot  Json?
  resultSnapshot Json?
  source         String   @default("dashboard")
  createdAt      DateTime @default(now())
  user           User?    @relation(fields: [userId], references: [id])

  @@index([calculatorType, createdAt(sort: Desc)])
  @@index([createdAt(sort: Desc)])
}

model SocialPost {
  id                String             @id @default(uuid())
  authorId          String             @map("author_id")
  postType          PostType           @default(GENERAL) @map("post_type")
  content           String
  sharedPostId      String?            @map("shared_post_id")
  articleId         String?            @unique @map("article_id")
  createdAt         DateTime           @default(now()) @map("created_at")
  updatedAt         DateTime           @updatedAt @map("updated_at")
  bookmarks         PostBookmark[]
  comments          PostComment[]
  likes             PostLike[]
  scientificArticle ScientificArticle? @relation(fields: [articleId], references: [id], onDelete: Cascade)
  author            User               @relation(fields: [authorId], references: [id], onDelete: Cascade)
  sharedPost        SocialPost?        @relation("PostShares", fields: [sharedPostId], references: [id])
  shares            SocialPost[]       @relation("PostShares")

  @@index([authorId])
  @@index([postType])
  @@index([createdAt])
  @@map("social_post")
}

model ScientificArticle {
  id                String      @id @default(uuid())
  title             String
  authors           String
  journal           String
  publicationYear   Int         @map("publication_year")
  doi               String?
  pdfUrl            String?     @map("pdf_url")
  category          String
  tags              String[]
  abstract          String
  clinicalTakeaways String[]    @map("clinical_takeaways")
  createdAt         DateTime    @default(now()) @map("created_at")
  updatedAt         DateTime    @updatedAt @map("updated_at")
  post              SocialPost?

  @@index([category])
  @@map("scientific_article")
}

model PostComment {
  id        String        @id @default(uuid())
  postId    String        @map("post_id")
  authorId  String        @map("author_id")
  content   String
  parentId  String?       @map("parent_id")
  createdAt DateTime      @default(now()) @map("created_at")
  updatedAt DateTime      @updatedAt @map("updated_at")
  author    User          @relation(fields: [authorId], references: [id], onDelete: Cascade)
  parent    PostComment?  @relation("CommentReplies", fields: [parentId], references: [id], onDelete: Cascade)
  replies   PostComment[] @relation("CommentReplies")
  post      SocialPost    @relation(fields: [postId], references: [id], onDelete: Cascade)

  @@index([postId])
  @@index([authorId])
  @@index([parentId])
  @@map("post_comment")
}

model PostLike {
  id        String     @id @default(uuid())
  postId    String     @map("post_id")
  userId    String     @map("user_id")
  createdAt DateTime   @default(now()) @map("created_at")
  post      SocialPost @relation(fields: [postId], references: [id], onDelete: Cascade)
  user      User       @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([postId, userId])
  @@index([postId])
  @@index([userId])
  @@map("post_like")
}

model UserFollow {
  id          String   @id @default(uuid())
  followerId  String   @map("follower_id")
  followingId String   @map("following_id")
  createdAt   DateTime @default(now()) @map("created_at")
  follower    User     @relation("UserFollowers", fields: [followerId], references: [id], onDelete: Cascade)
  following   User     @relation("UserFollowing", fields: [followingId], references: [id], onDelete: Cascade)

  @@unique([followerId, followingId])
  @@index([followerId])
  @@index([followingId])
  @@map("user_follow")
}

model PostBookmark {
  id        String     @id @default(uuid())
  postId    String     @map("post_id")
  userId    String     @map("user_id")
  createdAt DateTime   @default(now()) @map("created_at")
  post      SocialPost @relation(fields: [postId], references: [id], onDelete: Cascade)
  user      User       @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([postId, userId])
  @@index([postId])
  @@index([userId])
  @@map("post_bookmark")
}

model Organization {
