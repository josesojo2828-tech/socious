generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "linux-musl-openssl-3.0.x"]
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model Permit {
  id          String    @id @default(uuid())
  name        String
  description String?
  list        String[]
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  deletedAt   DateTime?
  users       User[]
}

/// ======================================
/// MODELOS FEEDBACK
/// ======================================
model Feedback {
  id        String    @id @default(uuid())
  userId    String?
  message   String
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?
  metadata  Json?
  user      User?     @relation(fields: [userId], references: [id])
}

model User {
  id                            String                 @id @default(uuid())
  firstName                     String?                @default("")
  lastName                      String?                @default("")
  email                         String                 @unique
  username                      String?                @unique
  password                      String?
  fullName                      String?
  avatarUrl                     String?
  status                        UserStatus             @default(ACTIVE)
  createdAt                     DateTime               @default(now())
  updatedAt                     DateTime               @updatedAt
  deletedAt                     DateTime?
  hashedRefreshToken            String?
  token                         String?
  permitId                      String
  profileId                     String?                @unique
  referralCode                  String?                @unique
  referredById                  String?
  emailVerificationToken        String?
  emailVerifiedAt               DateTime?
  resetPasswordExpiresAt        DateTime?
  resetPasswordToken            String?
  failedLoginAttempts           Int                    @default(0)
  lockedUntil                   DateTime?
  emailVerificationExpiresAt    DateTime?
  termsAcceptedAt               DateTime?
  termsVersion                  String?
  termsAcceptedIpHash           String?
  birthDate                     DateTime?
  isDemo                        Boolean                @default(false)
  mustChangePassword            Boolean                @default(false)

  feedback                      Feedback[]
  files                         File[]                 @relation("UploadedFiles")
  File                          File[]
  notifications                 Notification[]
  organizationMembers           OrganizationMember[]
  subscriptions                 Subscription[]
  transactions                  Transaction[]
  permits                       Permit                 @relation(fields: [permitId], references: [id])
  profile                       File?                  @relation("UserProfile", fields: [profileId], references: [id])
  referredBy                    User?                  @relation("UserReferrals", fields: [referredById], references: [id])
  referrals                     User[]                 @relation("UserReferrals")
  activityLogs                  UserActivityLog[]
  addresses                     UserAddress[]
  paymentMethods                UserPaymentMethod[]
  sessions                      UserSession[]
  wallet                        UserWallet?
  userPermissions               UserPermission[]
  entitlements                  Entitlement[]          @relation("UserEntitlements")
  invoices                      Invoice[]              @relation("UserInvoices")
  moduleGrants                  ModuleGrant[]

  // ERP Socius Relations
  createdClients                Client[]               @relation("CreatedClientRecords")
  createdSaleReturns            SaleReturn[]           @relation("CreatedSaleReturnRecords")
  openedCashShifts              CashShift[]            @relation("OpenedCashShifts")
  closedCashShifts              CashShift[]            @relation("ClosedCashShifts")
  createdCashMovements          CashMovement[]         @relation("CreatedCashMovements")
  createdSales                  Sale[]                 @relation("CreatedSaleRecords")
  createdSalePayments           SalePayment[]          @relation("CreatedSalePaymentRecords")
  createdPurchases              Purchase[]             @relation("CreatedPurchaseRecords")
  createdPurchasePayments       PurchasePayment[]      @relation("CreatedPurchasePaymentRecords")
  createdOrders                 Order[]                @relation("CreatedOrderRecords")
  createdStockMovements         StockMovement[]        @relation("CreatedStockMovementRecords")
  createdExchangeRates          ExchangeRate[]         @relation("CreatedExchangeRateRecords")

  @@index([isDemo])
}

model UserAddress {
  id         String      @id @default(uuid())
  userId     String
  label      String?
  address1   String
  address2   String?
  city       String
  state      String?
  country    String
  postalCode String?
  latitude   Float?
  longitude  Float?
  type       AddressType @default(HOME)
  isDefault  Boolean     @default(false)
  createdAt  DateTime    @default(now())
  updatedAt  DateTime    @updatedAt
  deletedAt  DateTime?
  user       User        @relation(fields: [userId], references: [id])

  @@index([userId])
}

model SubscriptionPlan {
  id            String         @id @default(uuid())
  name          String
  description   String?
  price         Decimal
  currency      String         @default("USD")
  selected      Boolean        @default(true)
  content       Json?
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt
  deletedAt     DateTime?
  badge         String?
  colorTheme    Json?
  featured      Boolean        @default(false)
  subscriptions Subscription[]
}

model AddOn {
  id            String        @id @default(uuid())
  key           String        @unique
  name          String
  description   String?
  price         Decimal       @db.Decimal(10, 2)
  currency      String        @default("USD")
  billingPeriod String        @default("MONTHLY")
  grants        String[]      @default([])
  modules       String[]      @default([])
  fieldPolicies Json?
  active        Boolean       @default(true)
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt
  deletedAt     DateTime?
  entitlements  Entitlement[]
  invoiceLines  InvoiceLine[]
  moduleLinks   AddOnModule[]

  @@index([active])
}

model Entitlement {
  id              String            @id @default(uuid())
  organizationId  String?
  userId          String?
  addOnId         String
  status          EntitlementStatus @default(ACTIVE)
  startDate       DateTime          @default(now())
  endDate         DateTime?
  quantity        Int               @default(1)
  priceAtPurchase Decimal           @db.Decimal(10, 2)
  currency        String            @default("USD")
  createdById     String?
  createdAt       DateTime          @default(now())
  updatedAt       DateTime          @updatedAt
  deletedAt       DateTime?
  organization    Organization?     @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  user            User?             @relation("UserEntitlements", fields: [userId], references: [id], onDelete: Cascade)
  addOn           AddOn             @relation(fields: [addOnId], references: [id])

  @@index([organizationId])
  @@index([userId])
}

model Module {
  id             String        @id @default(uuid())
  key            String        @unique
  name           String
  description    String?
  icon           String?
  category       String?
  scopes         ModuleScope[]
  operatorPermit String?
  dashboardKind  String?
  active         Boolean       @default(true)
  sortOrder      Int           @default(0)
  addOnLinks     AddOnModule[]
  grants         ModuleGrant[]

  @@index([active])
}

model AddOnModule {
  addOnId  String
  moduleId String
  addOn    AddOn  @relation(fields: [addOnId], references: [id], onDelete: Cascade)
  module   Module @relation(fields: [moduleId], references: [id], onDelete: Cascade)

  @@id([addOnId, moduleId])
}

model ModuleGrant {
  id             String            @id @default(uuid())
  moduleId       String
  userId         String?
  organizationId String?
  source         ModuleGrantSource
  entitlementId  String?
  status         ModuleGrantStatus @default(ACTIVE)
  grantedAt      DateTime          @default(now())
  expiresAt      DateTime?
  grantedById    String?
  module         Module            @relation(fields: [moduleId], references: [id], onDelete: Cascade)
  user           User?             @relation(fields: [userId], references: [id], onDelete: Cascade)
  organization   Organization?     @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@index([moduleId, status])
  @@index([userId, status])
  @@index([organizationId, status])
}

model Invoice {
  id             String        @id @default(uuid())
  organizationId String?
  userId         String?
  periodStart    DateTime
  periodEnd      DateTime
  status         InvoiceStatus @default(ISSUED)
  subtotal       Decimal       @db.Decimal(10, 2)
  total          Decimal       @db.Decimal(10, 2)
  currency       String        @default("USD")
  dueDate        DateTime
  issuedAt       DateTime?
  paidAt         DateTime?
  payerUserId    String?
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt
  organization   Organization? @relation(fields: [organizationId], references: [id])
  user           User?         @relation("UserInvoices", fields: [userId], references: [id])
  lines          InvoiceLine[]

  @@index([organizationId, status])
  @@index([userId, status])
}

model InvoiceLine {
  id          String          @id @default(uuid())
  invoiceId   String
  type        InvoiceLineType
  refId       String?
  description String
  quantity    Int             @default(1)
  unitPrice   Decimal         @db.Decimal(10, 2)
  amount      Decimal         @db.Decimal(10, 2)
  addOnId     String?
  invoice     Invoice         @relation(fields: [invoiceId], references: [id], onDelete: Cascade)
  addOn       AddOn?          @relation(fields: [addOnId], references: [id])

  @@index([invoiceId])
}

model FieldPolicy {
  id        String           @id @default(uuid())
  moduleKey String
  role      OrganizationRole
  formKey   String
  fieldKey  String
  access    FieldAccess      @default(EDITABLE)
  createdAt DateTime         @default(now())
  updatedAt DateTime         @updatedAt

  @@unique([moduleKey, role, formKey, fieldKey])
  @@index([moduleKey, role])
}

model Subscription {
  id                String             @id @default(uuid())
  userId            String
  planId            String
  startDate         DateTime           @default(now())
  endDate           DateTime?
  status            SubscriptionStatus @default(ACTIVE)
  autoRenew         Boolean            @default(true)
  createdAt         DateTime           @default(now())
  updatedAt         DateTime           @updatedAt
  deletedAt         DateTime?
  organizationId    String?
  gracePeriodEndsAt DateTime?
  readOnlyEndsAt    DateTime?
  canceledAt        DateTime?
  lastPlanChangeAt  DateTime?
  organization      Organization?      @relation(fields: [organizationId], references: [id])
  plan              SubscriptionPlan   @relation(fields: [planId], references: [id])
  user              User               @relation(fields: [userId], references: [id])

  @@unique([userId, organizationId])
  @@index([organizationId])
  @@index([userId])
}

model SubscriptionRenewalJobLog {
  id                 String    @id @default(uuid())
  startedAt          DateTime  @default(now())
  finishedAt         DateTime?
  totalProcessed     Int       @default(0)
  totalRenewed       Int       @default(0)
  totalFailedNoFunds Int       @default(0)
  totalExpired       Int       @default(0)
  status             String    @default("RUNNING")
  details            Json?
  createdAt          DateTime  @default(now())
}

model TelemetryRetentionJobLog {
  id             String    @id @default(uuid())
  startedAt      DateTime  @default(now())
  finishedAt     DateTime?
  dryRun         Boolean   @default(true)
  status         String    @default("RUNNING")
  totalEvaluated Int       @default(0)
  totalPurged    Int       @default(0)
  details        Json?
  createdAt      DateTime  @default(now())
}

model UserWallet {
  id         String    @id @default(uuid())
  userId     String    @unique
  balance    Decimal   @default(0.0)
  currency   String    @default("USD")
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt
  deletedAt  DateTime?
  balanceVES Decimal   @default(0.0)
  user       User      @relation(fields: [userId], references: [id])
}

model PaymentMethod {
  id          String              @id @default(uuid())
  name        String
  code        String              @unique
  description String?
  active      Boolean             @default(true)
  imagePath   String?
  colorStart  String?
  colorEnd    String?
  colorText   String?
  createdAt   DateTime            @default(now())
  updatedAt   DateTime            @updatedAt
  deletedAt   DateTime?
  fields      Json?
  userMethods UserPaymentMethod[]
}

model CorporateContent {
  id          String    @id @default(uuid())
  key         String    @unique
  title       String
  content     String
  description String?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  deletedAt   DateTime?
}

model UserPaymentMethod {
  id              String        @id @default(uuid())
  userId          String
  paymentMethodId String
  details         Json?
  isDefault       Boolean       @default(false)
  active          Boolean       @default(true)
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt
  deletedAt       DateTime?
  transactions    Transaction[]
  paymentMethod   PaymentMethod @relation(fields: [paymentMethodId], references: [id])
  user            User          @relation(fields: [userId], references: [id])

  @@index([userId])
}

model Transaction {
  id               String            @id @default(uuid())
  userId           String
  paymentMethodId  String
  type             TransactionType   @default(PAYMENT)
  amount           Decimal
  description      String?
  status           TransactionStatus @default(PENDING)
  referenceCode    String?           @unique
  createdAt        DateTime          @default(now())
  updatedAt        DateTime          @updatedAt
  deletedAt        DateTime?
  currency         String            @default("USD")
  originalAmount   Decimal?
  originalCurrency String?
  exchangeRateUsed Decimal?
  organizationId   String?
  organization     Organization?     @relation(fields: [organizationId], references: [id])
  paymentMethod    UserPaymentMethod @relation(fields: [paymentMethodId], references: [id])
  user             User              @relation(fields: [userId], references: [id])

  @@index([organizationId])
}

model Notification {
  id         String           @id @default(uuid())
  title      String
  message    String
  type       NotificationType @default(INFO)
  read       Boolean          @default(false)
  entityId   String?
  entityType String?
  createdAt  DateTime         @default(now())
  updatedAt  DateTime         @updatedAt
  deleteddAt DateTime?
  userId     String
  user       User             @relation(fields: [userId], references: [id])

  @@index([userId])
  @@index([read])
}

model UserSession {
  id             String    @id @default(uuid())
  userId         String
  ipAddress      String?
  userAgent      String?
  device         String?
  location       String?
  startedAt      DateTime  @default(now()) @db.Timestamptz(3)
  endedAt        DateTime? @db.Timestamptz(3)
  active         Boolean   @default(true)
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt
  deletedAt      DateTime?
  organizationId String?
  user           User      @relation(fields: [userId], references: [id])

  @@index([organizationId, startedAt])
}

model UserActivityLog {
  id             String    @id @default(uuid())
  userId         String
  action         String
  description    String?
  ipAddress      String?
  userAgent      String?
  createdAt      DateTime  @default(now()) @db.Timestamptz(3)
  updatedAt      DateTime  @updatedAt
  deletedAt      DateTime?
  metadata       Json?     @default("{}")
  eventName      String?
  category       String?
  organizationId String?
  source         String?
  eventVersion   String?
  moduleKey      String?
  user           User      @relation(fields: [userId], references: [id])

  @@index([userId, createdAt(sort: Desc)])
  @@index([createdAt(sort: Desc)])
  @@index([action])
  @@index([organizationId, createdAt(sort: Desc)])
  @@index([organizationId, eventName])
  @@index([moduleKey])
}

model File {
  id            String         @id @default(uuid())
  name          String
  originalName  String?
  type          String?
  mimeType      String?
  size          Int?
  path          String
  storage       FileStorage    @default(LOCAL)
  visibility    FileVisibility @default(PRIVATE)
  description   String?
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt
  deletedAt     DateTime?
  uploadedById  String?
  entityId      String?
  entityType    String?
  userId        String?
  uploadedBy    User?          @relation("UploadedFiles", fields: [uploadedById], references: [id])
  User          User?          @relation(fields: [userId], references: [id])
  userAsProfile User?          @relation("UserProfile")

  @@index([entityType, entityId])
}

model UserPermission {
  id             String        @id @default(uuid())
  userId         String        @map("user_id")
  organizationId String?       @map("organization_id")
  permission     String
  grantedAt      DateTime      @default(now()) @map("granted_at")
  expiresAt      DateTime?     @map("expires_at")
  user           User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  organization   Organization? @relation(fields: [organizationId], references: [id])

  @@unique([userId, organizationId, permission])
  @@index([userId])
  @@index([organizationId])
  @@map("user_permission")
}

// ======================================
// ORGANIZACIONES Y SUCURSALES (SOCIUS ERP)
// ======================================

model Organization {
  id                 String               @id @default(uuid())
  name               String
  slug               String?              @unique // Para la tienda pública: socius.com/shop/[slug]
  taxId              String?              // RIF / Cédula / RUT / NIT
  logoUrl            String?
  maxSeats           Int                  @default(5)
  status             String               @default("ACTIVE")
  defaultCurrency    String               @default("USD") // Moneda base del negocio (USD, VES, COP, etc.)
  currencyVisibility Json?                // { "showUSD": true, "showVES": true, "showUSDT": true, "showBCV": true }
  // Configuración del tenant (S1): caja opcional, monedas visibles, tipos de
  // entrega, agencias habilitadas, delivery y rutas. Se lee siempre a través de
  // `TenantSettingsService`, que lo normaliza contra DEFAULT_TENANT_SETTINGS.
  settings           Json?
  createdAt          DateTime             @default(now())
  updatedAt          DateTime             @updatedAt
  deletedAt          DateTime?

  members            OrganizationMember[]
  subscriptions      Subscription[]
  transactions       Transaction[]
  entitlements       Entitlement[]
  invoices           Invoice[]
  userPermissions    UserPermission[]
  moduleGrants       ModuleGrant[]

  // Socius ERP Relations
  clients            Client[]
  categories         Category[]
  products           Product[]
  suppliers          Supplier[]
  cashRegisters      CashRegister[]
  sales              Sale[]
  purchases          Purchase[]
  orders             Order[]
  stockMovements     StockMovement[]
  exchangeRates      ExchangeRate[]
  saleReturns        SaleReturn[]
}

model OrganizationMember {
  id                  String                   @id @default(uuid())
  organizationId      String
  userId              String
  colorHex            String                   @default("#4F46E5")
  assignedAt          DateTime                 @default(now())
  invitationToken     String?                  @unique
  invitationExpiresAt DateTime?
  role                OrganizationRole         @default(SELLER)
  status              OrganizationMemberStatus @default(ACTIVE)
  organization        Organization             @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  user                User                     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([organizationId, userId])
  @@index([organizationId])
  @@index([userId])
}

// ======================================
// TASAS DE CAMBIO (BCV, USDT, PARALELO)
// ======================================

model ExchangeRate {
  id             String        @id @default(uuid())
  organizationId String?       // null = tasa global de plataforma
  rateBcv        Decimal       @db.Decimal(14, 4) // Tasa oficial BCV
  rateUsdt       Decimal       @db.Decimal(14, 4) // Tasa cripto USDT / Binance P2P
  rateParallel   Decimal?      @db.Decimal(14, 4) // Tasa libre / paralelo opcional
  date           DateTime      @default(now())
  source         String        @default("MANUAL") // BCV_API, BINANCE_P2P, MANUAL
  createdById    String?

  organization   Organization? @relation(fields: [organizationId], references: [id])
  createdBy      User?         @relation("CreatedExchangeRateRecords", fields: [createdById], references: [id])

  @@index([organizationId, date(sort: Desc)])
  @@index([date(sort: Desc)])
}

// ======================================
// SECUENCIAS POR TENANT (numeración atómica)
// ======================================

// Contador de documentos por tenant. `tenantKey` es `organizationId` o
// `"GLOBAL"` para el contexto personal: Postgres trata cada NULL como distinto
// en un índice único, así que una columna nullable no serviría para el upsert
// atómico (`INSERT ... ON CONFLICT DO UPDATE ... RETURNING`).
model Counter {
  id        String   @id @default(uuid())
  tenantKey String   @default("GLOBAL")
  scope     String // SALE | ORDER | PURCHASE
  value     Int      @default(0)
  updatedAt DateTime @updatedAt

  @@unique([tenantKey, scope])
  @@index([scope])
}


// ======================================
// DEVOLUCIONES DE VENTA (S13)
// ======================================

model SaleReturn {
  id             String   @id @default(uuid())
  returnNumber   String   // DEV-00001
  organizationId String?
  saleId         String
  clientId       String?
  issueDate      DateTime @default(now())
  reason         String?
  refundMethod   String? // CASH_USD, USDT_BINANCE, TRANSFER... (métodos de negocio)
  cashShiftId    String? // reintegro entregado desde un turno abierto (opcional)

  // Mismas tasas que la venta que revierte: el reverso de un documento pasado
  // no se recalcula con la tasa de hoy.
  rateBcv        Decimal  @default(1.00) @db.Decimal(14, 4)
  rateUsdt       Decimal  @default(1.00) @db.Decimal(14, 4)

  subtotalUSD    Decimal  @db.Decimal(14, 2)
  taxUSD         Decimal  @default(0.00) @db.Decimal(14, 2)
  totalUSD       Decimal  @db.Decimal(14, 2)
  totalVES       Decimal  @default(0.00) @db.Decimal(14, 2)
  totalUSDT      Decimal  @default(0.00) @db.Decimal(14, 2)

  notes          String?
  createdById    String?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
  deletedAt      DateTime?

  organization   Organization? @relation(fields: [organizationId], references: [id])
  sale           Sale          @relation(fields: [saleId], references: [id])
  client         Client?       @relation(fields: [clientId], references: [id])
  cashShift      CashShift?    @relation(fields: [cashShiftId], references: [id])
  createdBy      User?         @relation("CreatedSaleReturnRecords", fields: [createdById], references: [id])
  items          SaleReturnItem[]

  @@index([organizationId])
  @@index([saleId])
  @@index([returnNumber])
  @@index([issueDate])
}

model SaleReturnItem {
  id           String  @id @default(uuid())
  returnId     String
  saleItemId   String? // traza hasta la línea de venta original
  productId    String?
  productName  String  // denormalizado: el catálogo puede cambiar después
  quantity     Decimal @db.Decimal(12, 2)
  unitPriceUSD Decimal @db.Decimal(14, 2)
  taxRate      Decimal @default(0.00) @db.Decimal(5, 2)
  totalUSD     Decimal @db.Decimal(14, 2)

  return       SaleReturn @relation(fields: [returnId], references: [id], onDelete: Cascade)
  product      Product?   @relation(fields: [productId], references: [id])

  @@index([returnId])
  @@index([productId])
}

// ======================================
// CLIENTES (CRM)
// ======================================

model Client {
  id             String        @id @default(uuid())
  name           String
  taxId          String?       // Cédula, RIF, NIT, RUT, CIF
  email          String?
  phone          String?
  address        String?
  city           String?
  state          String?
  creditLimitUSD Decimal       @default(0.00) @db.Decimal(14, 2)
  currentBalanceUSD Decimal    @default(0.00) @db.Decimal(14, 2) // Saldo pendiente por cobrar
  notes          String?
  isActive       Boolean       @default(true)
  createdById    String?       @map("created_by_id")
  organizationId String?
  createdAt      DateTime      @default(now()) @db.Timestamptz(3)
  updatedAt      DateTime      @updatedAt
  deletedAt      DateTime?

  createdBy      User?         @relation("CreatedClientRecords", fields: [createdById], references: [id])
  organization   Organization? @relation(fields: [organizationId], references: [id])
  sales          Sale[]
  orders         Order[]
  saleReturns    SaleReturn[]

  @@index([organizationId])
  @@index([taxId])
  @@index([name])
}

// ======================================
// PROVEEDORES
// ======================================

model Supplier {
  id             String        @id @default(uuid())
  name           String
  taxId          String?       // RIF / Cédula del proveedor
  contactName    String?
  email          String?
  phone          String?
  address        String?       // Ubicación
  city           String?
  state          String?
  currentBalanceUSD Decimal    @default(0.00) @db.Decimal(14, 2) // Deuda pendiente con el proveedor
  notes          String?
  organizationId String?
  isActive       Boolean       @default(true)
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt
  deletedAt      DateTime?

  organization   Organization? @relation(fields: [organizationId], references: [id])
  products       Product[]
  purchases      Purchase[]

  @@index([organizationId])
  @@index([name])
}

// ======================================
// CATEGORÍAS Y SUBCATEGORÍAS GENERALES
// ======================================

model Category {
  id             String        @id @default(uuid())
  name           String
  slug           String
  icon           String?
  description    String?
  parentId       String?
  isSystem       Boolean       @default(true) // Catálogo estándar de plataforma (no manipulable por clientes comunes)
  organizationId String?       // null = global del sistema

  parent         Category?     @relation("CategoryHierarchy", fields: [parentId], references: [id])
  subCategories  Category[]    @relation("CategoryHierarchy")
  organization   Organization? @relation(fields: [organizationId], references: [id])
  products       Product[]

  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt
  deletedAt      DateTime?

  @@index([parentId])
  @@index([organizationId])
  @@index([slug])
}

// ======================================
// PRODUCTOS Y CATÁLOGO
// ======================================

enum ProductStatus {
  ACTIVE
  INACTIVE
  OUT_OF_STOCK
  ON_SALE
}

model Product {
  id                String          @id @default(uuid())
  sku               String          // Código interno / SKU
  barcode           String?         // Código de barras
  name              String
  description       String?
  costPriceUSD      Decimal         @default(0.00) @db.Decimal(14, 2)
  salePriceUSD      Decimal         @default(0.00) @db.Decimal(14, 2)
  wholesalePriceUSD Decimal?        @db.Decimal(14, 2)
  stock             Decimal         @default(0.00) @db.Decimal(12, 2)
  minStock          Decimal         @default(0.00) @db.Decimal(12, 2)
  unit              String          @default("UND")
  taxRate           Decimal         @default(0.00) @db.Decimal(5, 2)
  isService         Boolean         @default(false)
  isPublic          Boolean         @default(false) // Para mostrar en el carrito público / pedidos online
  status            ProductStatus   @default(ACTIVE)
  imageUrl          String?
  categoryId        String?
  supplierId        String?
  organizationId    String?
  createdAt         DateTime        @default(now())
  updatedAt         DateTime        @updatedAt
  deletedAt         DateTime?

  category          Category?       @relation(fields: [categoryId], references: [id])
  supplier          Supplier?       @relation(fields: [supplierId], references: [id])
  organization      Organization?   @relation(fields: [organizationId], references: [id])
  stockMovements    StockMovement[]
  saleItems         SaleItem[]
  purchaseItems     PurchaseItem[]
  orderItems        OrderItem[]
  saleReturnItems   SaleReturnItem[]

  @@index([organizationId])
  @@index([sku])
  @@index([barcode])
  @@index([categoryId])
  @@index([isPublic, status])
}

// ======================================
// MOVIMIENTOS DE STOCK (KARDEX)
// ======================================

enum StockMovementType {
  IN
  OUT
  ADJUSTMENT
  SALE
  PURCHASE
  RETURN
}

model StockMovement {
  id             String            @id @default(uuid())
  productId      String
  organizationId String?
  createdById    String?
  type           StockMovementType
  quantity       Decimal           @db.Decimal(12, 2)
  unitCostUSD    Decimal?          @db.Decimal(14, 2)
  previousStock  Decimal           @db.Decimal(12, 2)
  newStock       Decimal           @db.Decimal(12, 2)
  reference      String?           // Nro de factura venta, compra o ajuste
  notes          String?
  createdAt      DateTime          @default(now())

  product        Product           @relation(fields: [productId], references: [id])
  organization   Organization?     @relation(fields: [organizationId], references: [id])
  createdBy      User?             @relation("CreatedStockMovementRecords", fields: [createdById], references: [id])

  @@index([organizationId])
  @@index([productId])
  @@index([createdAt])
}

// ======================================
// CAJA & ARQUEOS DE TURNO (POS)
// ======================================

enum CashRegisterStatus {
  OPEN
  CLOSED
}

model CashRegister {
  id             String             @id @default(uuid())
  name           String             // "Caja Principal", "Caja 1"
  status         CashRegisterStatus @default(CLOSED)
  organizationId String?
  createdAt      DateTime           @default(now())
  updatedAt      DateTime           @updatedAt

  organization   Organization?      @relation(fields: [organizationId], references: [id])
  shifts         CashShift[]

  @@index([organizationId])
}

enum CashShiftStatus {
  OPEN
  CLOSED
}

model CashShift {
  id                String            @id @default(uuid())
  cashRegisterId    String
  openedById        String
  closedById        String?
  openedAt          DateTime          @default(now())
  closedAt          DateTime?
  initialAmountUSD  Decimal           @default(0.00) @db.Decimal(14, 2)
  initialAmountVES  Decimal           @default(0.00) @db.Decimal(14, 2)
  expectedAmountUSD Decimal           @default(0.00) @db.Decimal(14, 2)
  actualAmountUSD   Decimal?          @db.Decimal(14, 2)
  differenceUSD     Decimal?          @db.Decimal(14, 2)
  status            CashShiftStatus   @default(OPEN)
  notes             String?

  cashRegister      CashRegister      @relation(fields: [cashRegisterId], references: [id])
  openedBy          User              @relation("OpenedCashShifts", fields: [openedById], references: [id])
  closedBy          User?             @relation("ClosedCashShifts", fields: [closedById], references: [id])
  movements         CashMovement[]
  salePayments      SalePayment[]
  purchasePayments  PurchasePayment[]
  saleReturns       SaleReturn[]

  @@index([cashRegisterId])
  @@index([status])
}

enum CashMovementType {
  INCOME
  EXPENSE
}

model CashMovement {
  id             String           @id @default(uuid())
  cashShiftId    String
  type           CashMovementType // INCOME = Entrada, EXPENSE = Retiro / Gasto
  amount         Decimal          @db.Decimal(14, 2)
  currency       String           @default("USD")
  paymentMethod  String           @default("CASH")
  reason         String
  reference      String?
  createdById    String?
  createdAt      DateTime         @default(now())

  cashShift      CashShift        @relation(fields: [cashShiftId], references: [id])
  createdBy      User?            @relation("CreatedCashMovements", fields: [createdById], references: [id])

  @@index([cashShiftId])
}

// ======================================
// PEDIDOS WEB / CARRITO
// ======================================

// ======================================
// AGENCIAS DE ENVÍO (S4) — catálogo global de la plataforma
// ======================================

model ShippingAgency {
  id        String   @id @default(uuid())
  key       String   @unique // ZOOM, MRW...
  name      String
  active    Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  orders Order[]

  @@index([active])
}

enum FulfillmentType {
  PICKUP
  DELIVERY
  SHIPPING
}

enum OrderStatus {
  PENDING
  CONFIRMED
  PREPARING
  DELIVERED
  CANCELLED
}

model Order {
  id              String        @id @default(uuid())
  orderNumber     String        // PED-00001
  organizationId  String?
  clientId        String?
  customerName    String
  customerPhone   String?
  customerEmail   String?
  customerAddress String?
  rateBcv         Decimal       @default(1.00) @db.Decimal(14, 4)
  rateUsdt        Decimal       @default(1.00) @db.Decimal(14, 4)
  totalUSD        Decimal       @default(0.00) @db.Decimal(14, 2)
  totalVES        Decimal       @default(0.00) @db.Decimal(14, 2)
  totalUSDT       Decimal       @default(0.00) @db.Decimal(14, 2)

  // Fulfillment (S4/S6): how the customer gets it and what the store owes.
  fulfillmentType FulfillmentType @default(PICKUP)
  agencyId        String?
  coordination    String          @default("WHATSAPP") // WHATSAPP | PHONE | EMAIL
  deliveryFeeUSD  Decimal?        @db.Decimal(14, 2)   // congelado al confirmar
  trackingNumber  String?
  shippedAt       DateTime?       // salió por agencia / delivery

  status          OrderStatus   @default(PENDING)
  notes           String?
  saleId          String?       @unique
  createdById     String?
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt

  organization    Organization? @relation(fields: [organizationId], references: [id])
  client          Client?       @relation(fields: [clientId], references: [id])
  createdBy       User?         @relation("CreatedOrderRecords", fields: [createdById], references: [id])
  sale            Sale?         @relation("OrderSale", fields: [saleId], references: [id])
  agency          ShippingAgency? @relation(fields: [agencyId], references: [id])
  items           OrderItem[]

  @@index([organizationId])
  @@index([status])
  @@index([createdAt])
  @@index([organizationId, fulfillmentType])
  @@index([agencyId])
}

model OrderItem {
  id          String   @id @default(uuid())
  orderId     String
  productId   String?
  productName String
  quantity    Decimal  @db.Decimal(12, 2)
  priceUSD    Decimal  @db.Decimal(14, 2)
  totalUSD    Decimal  @db.Decimal(14, 2)

  order       Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  product     Product? @relation(fields: [productId], references: [id])

  @@index([orderId])
  @@index([productId])
}

// ======================================
// COMPRAS A PROVEEDORES
// ======================================

enum PurchaseStatus {
  PENDING
  RECEIVED
  CANCELLED
}

model Purchase {
  id             String            @id @default(uuid())
  purchaseNumber String            // Nro de factura o COM-00001
  organizationId String?
  supplierId     String?
  issueDate      DateTime          @default(now())
  dueDate        DateTime?         // Para compras a crédito
  deliveryDate   DateTime?
  rateBcv        Decimal           @default(1.00) @db.Decimal(14, 4)
  rateUsdt       Decimal           @default(1.00) @db.Decimal(14, 4)
  subtotalUSD    Decimal           @db.Decimal(14, 2)
  taxUSD         Decimal           @default(0.00) @db.Decimal(14, 2)
  totalUSD       Decimal           @db.Decimal(14, 2)
  totalVES       Decimal           @default(0.00) @db.Decimal(14, 2)
  totalUSDT      Decimal           @default(0.00) @db.Decimal(14, 2)
  status         PurchaseStatus    @default(PENDING)
  paymentStatus  PaymentStatus     @default(UNPAID)
  notes          String?
  createdById    String?
  createdAt      DateTime          @default(now())
  updatedAt      DateTime          @updatedAt
  deletedAt      DateTime?

  organization   Organization?     @relation(fields: [organizationId], references: [id])
  supplier       Supplier?         @relation(fields: [supplierId], references: [id])
  createdBy      User?             @relation("CreatedPurchaseRecords", fields: [createdById], references: [id])
  items          PurchaseItem[]
  payments       PurchasePayment[]

  @@index([organizationId])
  @@index([supplierId])
  @@index([purchaseNumber])
  @@index([issueDate])
}

model PurchaseItem {
  id          String    @id @default(uuid())
  purchaseId  String
  productId   String?
  productName String
  quantity    Decimal   @db.Decimal(12, 2)
  unitCostUSD Decimal   @db.Decimal(14, 2)
  totalUSD    Decimal   @db.Decimal(14, 2)

  purchase    Purchase  @relation(fields: [purchaseId], references: [id], onDelete: Cascade)
  product     Product?  @relation(fields: [productId], references: [id])

  @@index([purchaseId])
  @@index([productId])
}

model PurchasePayment {
  id             String        @id @default(uuid())
  purchaseId     String
  cashShiftId    String?
  amountUSD      Decimal       @db.Decimal(14, 2)
  amountVES      Decimal       @default(0.00) @db.Decimal(14, 2)
  amountOriginal Decimal       @db.Decimal(14, 2)
  currency       String        @default("USD")
  paymentMethod  String        // PAGO_MOVIL, CASH_USD, CASH_VES, USDT_BINANCE, TRANSFER, ZELLE
  rateBcv        Decimal       @default(1.00) @db.Decimal(14, 4)
  rateUsdt       Decimal       @default(1.00) @db.Decimal(14, 4)
  reference      String?
  paidAt         DateTime      @default(now()) // Fecha real de cuando se pagó al proveedor
  notes          String?
  createdById    String?

  purchase       Purchase      @relation(fields: [purchaseId], references: [id], onDelete: Cascade)
  cashShift      CashShift?    @relation(fields: [cashShiftId], references: [id])
  createdBy      User?         @relation("CreatedPurchasePaymentRecords", fields: [createdById], references: [id])

  @@index([purchaseId])
  @@index([paidAt])
}

// ======================================
// VENTAS Y FACTURACIÓN (DEVENGO VS COBRO)
// ======================================

enum SaleStatus {
  COMPLETED
  CANCELLED
}

enum PaymentStatus {
  UNPAID
  PARTIAL
  PAID
}

model Sale {
  id             String            @id @default(uuid())
  saleNumber     String            // VTA-00001
  organizationId String?
  clientId       String?           // Opcional: venta genérica o identificada
  orderId        String?           @unique // Vinculado a pedido web si vino del carrito
  issueDate      DateTime          @default(now()) // Fecha de la venta (ej. Enero)
  dueDate        DateTime?         // Fecha límite si fue a crédito

  // Snapshot de tasas al momento de emitir la venta
  rateBcv        Decimal           @default(1.00) @db.Decimal(14, 4)
  rateUsdt       Decimal           @default(1.00) @db.Decimal(14, 4)

  // Totales en múltiples monedas
  subtotalUSD    Decimal           @db.Decimal(14, 2)
  discountUSD    Decimal           @default(0.00) @db.Decimal(14, 2)
  taxUSD         Decimal           @default(0.00) @db.Decimal(14, 2)
  totalUSD       Decimal           @db.Decimal(14, 2)
  totalVES       Decimal           @default(0.00) @db.Decimal(14, 2)
  totalUSDT      Decimal           @default(0.00) @db.Decimal(14, 2)

  status         SaleStatus        @default(COMPLETED)
  paymentStatus  PaymentStatus     @default(PAID) // PAID, PARTIAL, UNPAID (ventas a crédito)
  notes          String?
  createdById    String?
  createdAt      DateTime          @default(now())
  updatedAt      DateTime          @updatedAt
  deletedAt      DateTime?

  organization   Organization?     @relation(fields: [organizationId], references: [id])
  client         Client?           @relation(fields: [clientId], references: [id])
  createdBy      User?             @relation("CreatedSaleRecords", fields: [createdById], references: [id])
  order          Order?            @relation("OrderSale")
  items          SaleItem[]
  payments       SalePayment[]
  returns        SaleReturn[]

  @@index([organizationId])
  @@index([clientId])
  @@index([saleNumber])
  @@index([issueDate])
}

model SaleItem {
  id          String   @id @default(uuid())
  saleId      String
  productId   String?
  productName String
  quantity    Decimal  @db.Decimal(12, 2)
  unitPriceUSD Decimal @db.Decimal(14, 2)
  discountUSD Decimal  @default(0.00) @db.Decimal(14, 2)
  taxRate     Decimal  @default(0.00) @db.Decimal(5, 2)
  totalUSD    Decimal  @db.Decimal(14, 2)

  sale        Sale     @relation(fields: [saleId], references: [id], onDelete: Cascade)
  product     Product? @relation(fields: [productId], references: [id])

  @@index([saleId])
  @@index([productId])
}

model SalePayment {
  id             String     @id @default(uuid())
  saleId         String
  cashShiftId    String?    // Vinculado a turno de caja abierta
  amountUSD      Decimal    @db.Decimal(14, 2)
  amountVES      Decimal    @default(0.00) @db.Decimal(14, 2)
  amountOriginal Decimal    @db.Decimal(14, 2)
  currency       String     @default("USD")
  paymentMethod  String     // PAGO_MOVIL, CASH_USD, CASH_VES, USDT_BINANCE, TRANSFER, ZELLE
  rateBcv        Decimal    @default(1.00) @db.Decimal(14, 4)
  rateUsdt       Decimal    @default(1.00) @db.Decimal(14, 4)
  reference      String?
  paidAt         DateTime   @default(now()) // Fecha real en que se cobró (ej. Mayo, pero vinculado a venta de Enero)
  notes          String?
  createdById    String?
  createdAt      DateTime   @default(now())

  sale           Sale       @relation(fields: [saleId], references: [id], onDelete: Cascade)
  cashShift      CashShift? @relation(fields: [cashShiftId], references: [id])
  createdBy      User?      @relation("CreatedSalePaymentRecords", fields: [createdById], references: [id])

  @@index([saleId])
  @@index([paidAt])
}

