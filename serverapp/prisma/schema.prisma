generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "linux-musl-openssl-3.0.x"]
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model Permit {
  id          String    @id @default(uuid())
  name        String
  description String?
  list        String[]
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  deletedAt   DateTime?
  users       User[]
}

/// ======================================
/// MODELOS FEEDBACK
/// ======================================
model Feedback {
  id        String    @id @default(uuid())
  userId    String?
  message   String
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?
  metadata  Json?
  user      User?     @relation(fields: [userId], references: [id])
}

model User {
  id                            String                 @id @default(uuid())
  firstName                     String?                @default("")
  lastName                      String?                @default("")
  email                         String                 @unique
  username                      String?                @unique
  password                      String?
  fullName                      String?
  avatarUrl                     String?
  status                        UserStatus             @default(ACTIVE)
  createdAt                     DateTime               @default(now())
  updatedAt                     DateTime               @updatedAt
  deletedAt                     DateTime?
  hashedRefreshToken            String?
  token                         String?
  permitId                      String
  profileId                     String?                @unique
  referralCode                  String?                @unique
  referredById                  String?
  emailVerificationToken        String?
  emailVerifiedAt               DateTime?
  resetPasswordExpiresAt        DateTime?
  resetPasswordToken            String?
  failedLoginAttempts           Int                    @default(0)
  lockedUntil                   DateTime?
  emailVerificationExpiresAt    DateTime?
  // S1 (legal-compliance): prueba de aceptación de Términos + Aviso de Privacidad.
  // La IP se guarda SOLO como hash sha256(ip+PII_HASH_SALT) (shared/event/pii.ts).
  termsAcceptedAt               DateTime?
  termsVersion                  String?
  termsAcceptedIpHash           String?
  // S7 (legal-compliance): fecha de nacimiento capturada por el gate de edad del registro.
  birthDate                     DateTime?
  isDemo                        Boolean                @default(false)
  mustChangePassword            Boolean                @default(false)
  createdAnamnesis              Anamnesis[]            @relation("CreatedAnamnesisRecords")
  createdAnthropometries        Anthropometry[]        @relation("CreatedAnthropometryRecords")
  createdAssignedExchangeLists  AssignedExchangeList[] @relation("CreatedAssignedExchangeListRecords")
  createdAssignedMenus          AssignedMenu[]         @relation("CreatedAssignedMenuRecords")
  createdAssignedSupplements    AssignedSupplement[]   @relation("CreatedAssignedSupplementRecords")
  calculatorUsages              CalculatorUsage[]
  campusCoupon                  CampusCoupon?          @relation("UserCoupon")
  createdConsultations          Consultation[]         @relation("CreatedConsultationRecords")
  createdDietPlanTemplates      DietPlanTemplate[]     @relation("CreatedDietPlanTemplateRecords")
  createdExchangeLists          ExchangeList[]         @relation("CreatedExchangeListRecords")
  feedback                      Feedback[]
  files                         File[]                 @relation("UploadedFiles")
  File                          File[]
  customFoods                   FoodItem[]
  createdGoals                  Goal[]                 @relation("CreatedGoalRecords")
  createdInfantFormulaHistories InfantFormulaHistory[] @relation("CreatedInfantFormulaHistoryRecords")
  createdLabResults             LabResult[]            @relation("CreatedLabResultRecords")
  createdMenus                  Menu[]                 @relation("CreatedMenuRecords")
  notifications                 Notification[]
  createdNutritionalPlans       NutritionalPlan[]      @relation("CreatedNutritionalPlanRecords")
  nutritionistProfile           Nutritionist?
  organizationMembers           OrganizationMember[]
  createdPatients               Patient[]              @relation("CreatedPatientRecords")
  patientProfiles               Patient[]
  createdPediatricHistories     PediatricHistory[]     @relation("CreatedPediatricHistoryRecords")
  createdShoppingLists          ShoppingList[]         @relation("CreatedShoppingListRecords")
  createdSportsHistories        SportsHistory[]        @relation("CreatedSportsHistoryRecords")
  subscriptions                 Subscription[]
  transactions                  Transaction[]
  permits                       Permit                 @relation(fields: [permitId], references: [id])
  profile                       File?                  @relation("UserProfile", fields: [profileId], references: [id])
  referredBy                    User?                  @relation("UserReferrals", fields: [referredById], references: [id])
  referrals                     User[]                 @relation("UserReferrals")
  activityLogs                  UserActivityLog[]
  addresses                     UserAddress[]
  paymentMethods                UserPaymentMethod[]
  sessions                      UserSession[]
  wallet                        UserWallet?
  communityMetadata             CommunityMetadata[]
  postBookmarks                 PostBookmark[]
  postComments                  PostComment[]
  postLikes                     PostLike[]
  socialPosts                   SocialPost[]
  following                     UserFollow[]           @relation("UserFollowers")
  followers                     UserFollow[]           @relation("UserFollowing")
  userPermissions               UserPermission[]
  entitlements                  Entitlement[]          @relation("UserEntitlements")
  patientInvitations            PatientInvitation[]   @relation("PatientInvitationUser")
  createdPatientInvitations     PatientInvitation[]   @relation("PatientInvitationCreator")
  invoices                      Invoice[]              @relation("UserInvoices")
  moduleGrants                  ModuleGrant[]

  // Marketplace
  marketProducts  MarketProduct[]
  marketReviews   MarketReview[]
  marketCampaigns MarketCampaign[]
  walletPayments  WalletPayment[]

  @@index([isDemo])
}

model UserAddress {
  id         String      @id @default(uuid())
  userId     String
  label      String?
  address1   String
  address2   String?
  city       String
  state      String?
  country    String
  postalCode String?
  latitude   Float?
  longitude  Float?
  type       AddressType @default(HOME)
  isDefault  Boolean     @default(false)
  createdAt  DateTime    @default(now())
  updatedAt  DateTime    @updatedAt
  deletedAt  DateTime?
  user       User        @relation(fields: [userId], references: [id])

  @@index([userId])
}

model SubscriptionPlan {
  id            String         @id @default(uuid())
  name          String
  description   String?
  price         Decimal
  currency      String         @default("USD")
  selected      Boolean        @default(true)
  content       Json?
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt
  deletedAt     DateTime?
  /// Texto del badge (null = sin badge). Ej: "POPULAR", "RECOMENDADO"
  badge         String?
  /// Colores del plan en formato JSON: { bg, text, accent, badge }
  colorTheme    Json?
  /// Si es true, se muestra como plan destacado (featured card)
  featured      Boolean        @default(false)
  subscriptions Subscription[]
}

model AddOn {
  id            String        @id @default(uuid())
  key           String        @unique // ATTENDANCE_CONTROL (STABLE MACHINE KEY)
  name          String
  description   String?
  price         Decimal       @db.Decimal(10, 2)
  currency      String        @default("USD")
  billingPeriod String        @default("MONTHLY")
  grants        String[]      @default([]) // permission keys unlocked
  modules       String[]      @default([]) // module keys for sidebar/route registry
  fieldPolicies Json? // default role policy for the pilot module
  active        Boolean       @default(true)
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt
  deletedAt     DateTime?
  entitlements  Entitlement[]
  invoiceLines  InvoiceLine[]
  moduleLinks   AddOnModule[]

  @@index([active])
}

model Entitlement {
  id              String            @id @default(uuid())
  organizationId  String? // null = personal (mirrors Subscription)
  userId          String? // owner for personal entitlements
  addOnId         String
  status          EntitlementStatus @default(ACTIVE)
  startDate       DateTime          @default(now())
  endDate         DateTime?
  quantity        Int               @default(1)
  priceAtPurchase Decimal           @db.Decimal(10, 2)
  currency        String            @default("USD")
  createdById     String?
  createdAt       DateTime          @default(now())
  updatedAt       DateTime          @updatedAt
  deletedAt       DateTime?
  organization    Organization?     @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  user            User?             @relation("UserEntitlements", fields: [userId], references: [id], onDelete: Cascade)
  addOn           AddOn             @relation(fields: [addOnId], references: [id])

  /// Polymorphic-owner uniqueness is enforced with PARTIAL UNIQUE INDEXES in the
  /// migration (raw SQL). Prisma cannot model partial indexes, and a composite
  /// @@unique does NOT dedupe rows where a column is NULL (Postgres NULL != NULL).
  /// See migration 20260930_add_module_entitlements.
  @@index([organizationId])
  @@index([userId])
}

model Module {
  id             String        @id @default(uuid())
  key            String        @unique // ATTENDANCE_CONTROL (STABLE MACHINE KEY)
  name           String
  description    String?
  icon           String?
  category       String?
  scopes         ModuleScope[]
  operatorPermit String?
  dashboardKind  String? // ANALYTICS | CONFIG | PROVISIONING
  active         Boolean       @default(true)
  sortOrder      Int           @default(0)
  addOnLinks     AddOnModule[]
  grants         ModuleGrant[]

  @@index([active])
}

model AddOnModule {
  addOnId  String
  moduleId String
  addOn    AddOn  @relation(fields: [addOnId], references: [id], onDelete: Cascade)
  module   Module @relation(fields: [moduleId], references: [id], onDelete: Cascade)

  @@id([addOnId, moduleId])
}

model ModuleGrant {
  id             String            @id @default(uuid())
  moduleId       String
  userId         String?
  organizationId String?
  source         ModuleGrantSource
  entitlementId  String?
  status         ModuleGrantStatus @default(ACTIVE)
  grantedAt      DateTime          @default(now())
  expiresAt      DateTime?
  grantedById    String?
  module         Module            @relation(fields: [moduleId], references: [id], onDelete: Cascade)
  user           User?             @relation(fields: [userId], references: [id], onDelete: Cascade)
  organization   Organization?     @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  /// Polymorphic-owner uniqueness is enforced with PARTIAL UNIQUE INDEXES in the
  /// migration (raw SQL). Prisma cannot model partial indexes, and a composite
  /// @@unique does NOT dedupe rows where a column is NULL (Postgres NULL != NULL).
  /// See migration 20261003_add_module_framework.
  @@index([moduleId, status])
  @@index([userId, status])
  @@index([organizationId, status])
}

model Invoice {
  id             String        @id @default(uuid())
  organizationId String? // null = personal invoice (mirrors Entitlement)
  userId         String? // owner for personal invoices
  periodStart    DateTime
  periodEnd      DateTime
  status         InvoiceStatus @default(ISSUED)
  subtotal       Decimal       @db.Decimal(10, 2)
  total          Decimal       @db.Decimal(10, 2)
  currency       String        @default("USD")
  dueDate        DateTime
  issuedAt       DateTime?
  paidAt         DateTime?
  payerUserId    String? // A1: CLINIC_ADMIN wallet (org) / owner wallet (personal)
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt
  organization   Organization? @relation(fields: [organizationId], references: [id])
  user           User?         @relation("UserInvoices", fields: [userId], references: [id])
  lines          InvoiceLine[]

  /// Polymorphic-owner idempotency is enforced with PARTIAL UNIQUE INDEXES in the
  /// migration (raw SQL), mirroring Entitlement: a composite @@unique does NOT
  /// dedupe rows where a column is NULL (Postgres NULL != NULL).
  /// See migration 20261001_add_personal_invoices.
  @@index([organizationId, status])
  @@index([userId, status])
}

model InvoiceLine {
  id          String          @id @default(uuid())
  invoiceId   String
  type        InvoiceLineType
  refId       String?
  description String
  quantity    Int             @default(1)
  unitPrice   Decimal         @db.Decimal(10, 2)
  amount      Decimal         @db.Decimal(10, 2)
  addOnId     String?
  invoice     Invoice         @relation(fields: [invoiceId], references: [id], onDelete: Cascade)
  addOn       AddOn?          @relation(fields: [addOnId], references: [id])

  @@index([invoiceId])
}

model FieldPolicy {
  id        String           @id @default(uuid())
  moduleKey String // ATTENDANCE_CONTROL
  role      OrganizationRole
  formKey   String // attendance.schedule, attendance.record
  fieldKey  String
  access    FieldAccess      @default(EDITABLE)
  createdAt DateTime         @default(now())
  updatedAt DateTime         @updatedAt

  @@unique([moduleKey, role, formKey, fieldKey])
  @@index([moduleKey, role])
}

model Subscription {
  id                String             @id @default(uuid())
  userId            String
  planId            String
  startDate         DateTime           @default(now())
  endDate           DateTime?
  status            SubscriptionStatus @default(ACTIVE)
  autoRenew         Boolean            @default(true)
  createdAt         DateTime           @default(now())
  updatedAt         DateTime           @updatedAt
  deletedAt         DateTime?
  organizationId    String?
  gracePeriodEndsAt DateTime?
  readOnlyEndsAt    DateTime?
  canceledAt        DateTime?
  lastPlanChangeAt  DateTime?
  organization      Organization?      @relation(fields: [organizationId], references: [id])
  plan              SubscriptionPlan   @relation(fields: [planId], references: [id])
  user              User               @relation(fields: [userId], references: [id])

  @@unique([userId, organizationId])
  @@index([organizationId])
  @@index([userId])
}

model SubscriptionRenewalJobLog {
  id                 String    @id @default(uuid())
  startedAt          DateTime  @default(now())
  finishedAt         DateTime?
  totalProcessed     Int       @default(0)
  totalRenewed       Int       @default(0)
  totalFailedNoFunds Int       @default(0)
  totalExpired       Int       @default(0)
  status             String    @default("RUNNING")
  details            Json?
  createdAt          DateTime  @default(now())
}

/// Observability run-log for the telemetry retention job (Phase 0 dry-run).
/// Mirrors the SubscriptionRenewalJobLog pattern.
model TelemetryRetentionJobLog {
  id             String    @id @default(uuid())
  startedAt      DateTime  @default(now())
  finishedAt     DateTime?
  dryRun         Boolean   @default(true)
  status         String    @default("RUNNING")
  totalEvaluated Int       @default(0)
  totalPurged    Int       @default(0)
  details        Json?
  createdAt      DateTime  @default(now())
}

model UserWallet {
  id         String    @id @default(uuid())
  userId     String    @unique
  balance    Decimal   @default(0.0)
  currency   String    @default("USD")
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt
  deletedAt  DateTime?
  balanceVES Decimal   @default(0.0)
  user       User      @relation(fields: [userId], references: [id])
}

model PaymentMethod {
  id          String              @id @default(uuid())
  name        String
  code        String              @unique
  description String?
  active      Boolean             @default(true)
  imagePath   String?
  colorStart  String?
  colorEnd    String?
  colorText   String?
  createdAt   DateTime            @default(now())
  updatedAt   DateTime            @updatedAt
  deletedAt   DateTime?
  fields      Json?
  userMethods UserPaymentMethod[]
}

model CorporateContent {
  id          String    @id @default(uuid())
  key         String    @unique
  title       String
  content     String
  description String?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  deletedAt   DateTime?
}

model UserPaymentMethod {
  id              String        @id @default(uuid())
  userId          String
  paymentMethodId String
  details         Json?
  isDefault       Boolean       @default(false)
  active          Boolean       @default(true)
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt
  deletedAt       DateTime?
  transactions    Transaction[]
  paymentMethod   PaymentMethod @relation(fields: [paymentMethodId], references: [id])
  user            User          @relation(fields: [userId], references: [id])

  @@index([userId])
}

model Transaction {
  id               String            @id @default(uuid())
  userId           String
  paymentMethodId  String
  type             TransactionType   @default(PAYMENT)
  amount           Decimal
  description      String?
  status           TransactionStatus @default(PENDING)
  referenceCode    String?           @unique
  createdAt        DateTime          @default(now())
  updatedAt        DateTime          @updatedAt
  deletedAt        DateTime?
  currency         String            @default("USD")
  originalAmount   Decimal?
  originalCurrency String?
  exchangeRateUsed Decimal?
  /// Org scope for analytics. Additive + nullable on purpose: a transaction is
  /// linked to a USER, not to an org/subscription, so HISTORICAL rows cannot be
  /// reliably backfilled and stay null (they are excluded from tenant-scoped
  /// analytics). New rows are populated at creation from the related
  /// subscription's organization.
  organizationId   String?
  organization     Organization?     @relation(fields: [organizationId], references: [id])
  paymentMethod    UserPaymentMethod @relation(fields: [paymentMethodId], references: [id])
  user             User              @relation(fields: [userId], references: [id])

  @@index([organizationId])
}

model Notification {
  id         String           @id @default(uuid())
  title      String
  message    String
  type       NotificationType @default(INFO)
  read       Boolean          @default(false)
  entityId   String?
  entityType String?
  createdAt  DateTime         @default(now())
  updatedAt  DateTime         @updatedAt
  deleteddAt DateTime?
  userId     String
  user       User             @relation(fields: [userId], references: [id])

  @@index([userId])
  @@index([read])
}

model UserSession {
  id             String    @id @default(uuid())
  userId         String
  ipAddress      String?
  userAgent      String?
  device         String?
  location       String?
  startedAt      DateTime  @default(now()) @db.Timestamptz(3)
  endedAt        DateTime? @db.Timestamptz(3)
  active         Boolean   @default(true)
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt
  deletedAt      DateTime?
  organizationId String?
  user           User      @relation(fields: [userId], references: [id])

  @@index([organizationId, startedAt])
}

model UserActivityLog {
  id             String    @id @default(uuid())
  userId         String
  action         String
  description    String?
  ipAddress      String?
  userAgent      String?
  createdAt      DateTime  @default(now()) @db.Timestamptz(3)
  updatedAt      DateTime  @updatedAt
  deletedAt      DateTime?
  metadata       Json?     @default("{}")
  eventName      String?
  category       String?
  organizationId String?
  source         String?
  eventVersion   String?
  moduleKey      String?
  user           User      @relation(fields: [userId], references: [id])

  @@index([userId, createdAt(sort: Desc)])
  @@index([createdAt(sort: Desc)])
  @@index([action])
  @@index([organizationId, createdAt(sort: Desc)])
  @@index([organizationId, eventName])
  @@index([moduleKey])
}

model File {
  id            String         @id @default(uuid())
  name          String
  originalName  String?
  type          String?
  mimeType      String?
  size          Int?
  path          String
  storage       FileStorage    @default(LOCAL)
  visibility    FileVisibility @default(PRIVATE)
  description   String?
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt
  deletedAt     DateTime?
  uploadedById  String?
  entityId      String?
  entityType    String?
  userId        String?
  campusRequest CampusRequest?
  uploadedBy    User?          @relation("UploadedFiles", fields: [uploadedById], references: [id])
  User          User?          @relation(fields: [userId], references: [id])
  userAsProfile User?          @relation("UserProfile")

  @@index([entityType, entityId])
}

model FoodExchangeList {
  id       String             @id @default(uuid())
  name     String             @unique
  category String?
  sub      String?
  unity    String?
  // Practical-measure grams (or cc for liquids) per single serving, transcribed from
  // the authoritative exchange-list PDF. Nullable: legacy rows without a transcribed
  // value keep rendering their raw `unity` instead of a fabricated number.
  grams    Decimal?
  calories Decimal?
  // Denormalized name + category + sub with accents folded and lowercased, so the
  // Prisma `contains` search matches a query typed without accents ("Kefir" ->
  // "Kéfir"). Maintained by normalizeSearchText() on every write.
  searchText String?
  exchange ExchangeListItem[]
}

enum FoodSource {
  GLOBAL_BASE
  SMAE_MEXICO
  USDA_FOOD_DATA
  ARGENFOOD
  CUSTOM
}

model FoodAlias {
  id          String   @id @default(uuid())
  foodItemId  String
  foodItem    FoodItem @relation(fields: [foodItemId], references: [id], onDelete: Cascade)
  countryCode String
  name        String
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([countryCode, name])
}

model FoodItem {
  id               String                  @id @default(uuid())
  createdById      String?
  code             Int?                    @unique @default(autoincrement())
  name             String                  @unique
  brand            String?
  countryCode      String?                 @default("GLOBAL")
  source           FoodSource              @default(CUSTOM)
  externalSourceId String?
  baseQuantity     Decimal                 @default(100)
  calories         Decimal                 @default(0)
  proteins         Decimal                 @default(0)
  carbohydrates    Decimal                 @default(0)
  fats             Decimal                 @default(0)
  humidity         Decimal                 @default(0)
  fiberTotal       Decimal                 @default(0)
  fiberInsoluble   Decimal                 @default(0)
  sugar            Decimal                 @default(0)
  calcium          Decimal                 @default(0)
  iron             Decimal                 @default(0)
  magnesium        Decimal                 @default(0)
  zinc             Decimal                 @default(0)
  copper           Decimal                 @default(0)
  sodium           Decimal                 @default(0)
  phosphorus       Decimal                 @default(0)
  potassium        Decimal                 @default(0)
  vitaminA         Decimal                 @default(0)
  thiamin          Decimal                 @default(0)
  riboflavin       Decimal                 @default(0)
  niacin           Decimal                 @default(0)
  vitaminB6        Decimal                 @default(0)
  ascorbicAcid     Decimal                 @default(0)
  isActive         Boolean                 @default(true)
  currentPrice     Decimal?                @db.Decimal(10, 2)
  lastPriceSync    DateTime?
  priceUnit        PriceUnit               @default(KG)
  wasteFactor      Decimal                 @default(1) @db.Decimal(10, 2)
  DietFood         DietFood[]
  createdBy        User?                   @relation(fields: [createdById], references: [id])
  priceHistory     FoodPriceHistory[]
  menuItemCosts    InstitutionalMenuItem[]
  menuItems        MenuItem[]
  aliases          FoodAlias[]

  @@index([createdById])
  @@index([name])
}

model Nutritionist {
  id                                  String                                 @id @default(uuid())
  userId                              String                                 @unique
  licenseCode                         String?
  specialty                           String?
  lat                                 Float?
  lng                                 Float?
  about                               String?
  bio                                 String?
  config                              Json?
  isPublic                            Boolean                                @default(true)
  photoUrl                            String?
  services                            Json?
  socialLinks                         Json?
  template                            String?                                @default("default")
  universityDegree                    String?
  graduationYear                      Int?
  mppsCode                            String?
  cndvCode                            String?
  cndvState                           String?
  identityCard                        String?
  degreeFileUrl                       String?
  licenseFileUrl                      String?
  verificationStatus                  VerificationStatus                     @default(UNVERIFIED)
  verifiedAt                          DateTime?
  rejectionReason                     String?
  consultations                       Consultation[]
  dietTemplates                       DietPlanTemplate[]
  exchangeLists                       ExchangeList[]
  institutionalCalculations           InstitutionalCalculation[]
  assignedInstitutionalCollaborations InstitutionalCalculationCollaborator[] @relation("AssignedCalculationCollaborator")
  institutionalCollaborations         InstitutionalCalculationCollaborator[] @relation("CollaboratorOfCalculation")
  menus                               Menu[]
  user                                User                                   @relation(fields: [userId], references: [id])
  assignedMemberships                 PatientNutritionist[]                  @relation("AssignedMembership")
  patientNutritionists                PatientNutritionist[]                  @relation("MemberOfPatient")
  sentReferrals                       PatientReferral[]                      @relation("SentReferrals")
  respondedReferrals                  PatientReferral[]                      @relation("RespondedReferrals")
  receivedReferrals                   PatientReferral[]                      @relation("ReceivedReferrals")
  portfolioEvents                     PortfolioEvent[]
}

model PortfolioEvent {
  id             String             @id @default(uuid())
  nutritionistId String
  eventType      PortfolioEventType
  referrer       String?
  metadata       Json?
  createdAt      DateTime           @default(now())
  nutritionist   Nutritionist       @relation(fields: [nutritionistId], references: [id], onDelete: Cascade)

  @@index([nutritionistId, eventType])
  @@index([createdAt])
}

model Patient {
  id                 String                @id @default(uuid())
  firstName          String
  lastName           String
  email              String?
  phone              String?
  gender             Gender
  birthDate          DateTime
  occupation         String?
  activityLevel      ActivityLevel         @default(SEDENTARY)
  medicalHistory     Json?
  createdAt          DateTime              @default(now()) @db.Timestamptz(3)
  updatedAt          DateTime              @updatedAt
  deletedAt          DateTime?
  isActive           Boolean               @default(true)
  userId             String?
  address            String?
  maritalStatus      String?
  /// S2 (patient-onboarding): el paciente es un MENOR. Los datos de su
  /// representante se guardan en el `PediatricHistory` que ya existe (no se
  /// crea un modelo nuevo). Este flag marca de forma explícita que el paciente
  /// es menor y lo consume la resolución del destinatario de la invitación
  /// (el correo del representante).
  isPediatric        Boolean               @default(false)
  createdById        String?               @map("created_by_id")
  organizationId     String?
  anamnesis          Anamnesis?
  anthropometrics    Anthropometry[]
  consultations      Consultation[]
  dietPlans          DietPlan[]
  goals              Goal[]
  labResults         LabResult[]
  plans              NutritionalPlan[]
  createdBy          User?                 @relation("CreatedPatientRecords", fields: [createdById], references: [id])
  organization       Organization?         @relation(fields: [organizationId], references: [id])
  user               User?                 @relation(fields: [userId], references: [id])
  nutritionists      PatientNutritionist[]
  referrals          PatientReferral[]
  pediatricHistories PediatricHistory[]
  shoppingLists      ShoppingList[]
  sportsHistories    SportsHistory[]

  privacyNoticeAcceptedAt DateTime? @map("privacy_notice_accepted_at")
  privacyNoticeVersion    String?    @map("privacy_notice_version")
  privacyNoticeAcceptedById String?  @map("privacy_notice_accepted_by_id")

  patientInvitations PatientInvitation[]

  @@index([createdById])
  @@index([organizationId])
}

/// S1 (patient-onboarding): invitación de un solo uso para que el paciente (o
/// el representante de un menor) defina su propia contraseña.
///
/// El token NUNCA se persiste en claro: sólo se guarda su hash sha256, de
/// modo que un volcado de la base de datos no permite completar la
/// invitación. `acceptedAt` y `revokedAt` dan la semántica de un solo uso.
model PatientInvitation {
  id          String    @id @default(uuid())
  patientId   String
  userId      String
  email       String
  tokenHash   String    @unique
  expiresAt   DateTime
  acceptedAt  DateTime?
  revokedAt   DateTime?
  createdById String
  createdAt   DateTime  @default(now())

  patient   Patient @relation(fields: [patientId], references: [id], onDelete: Cascade)
  user      User    @relation("PatientInvitationUser", fields: [userId], references: [id], onDelete: Cascade)
  createdBy User    @relation("PatientInvitationCreator", fields: [createdById], references: [id], onDelete: Cascade)

  @@index([patientId])
  @@index([userId])
  @@index([expiresAt])
}

