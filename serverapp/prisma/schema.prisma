generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "linux-musl-openssl-3.0.x"]
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model Permit {
  id          String    @id @default(uuid())
  name        String
  description String?
  list        String[]
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  deletedAt   DateTime?
  users       User[]
}

/// ======================================
/// MODELOS FEEDBACK
/// ======================================
model Feedback {
  id        String    @id @default(uuid())
  userId    String?
  message   String
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?
  metadata  Json?
  user      User?     @relation(fields: [userId], references: [id])
}

model User {
  id                            String                 @id @default(uuid())
  firstName                     String?                @default("")
  lastName                      String?                @default("")
  email                         String                 @unique
  username                      String?                @unique
  password                      String?
  fullName                      String?
  avatarUrl                     String?
  status                        UserStatus             @default(ACTIVE)
  createdAt                     DateTime               @default(now())
  updatedAt                     DateTime               @updatedAt
  deletedAt                     DateTime?
  hashedRefreshToken            String?
  token                         String?
  permitId                      String
  profileId                     String?                @unique
  referralCode                  String?                @unique
  referredById                  String?
  emailVerificationToken        String?
  emailVerifiedAt               DateTime?
  resetPasswordExpiresAt        DateTime?
  resetPasswordToken            String?
  failedLoginAttempts           Int                    @default(0)
  lockedUntil                   DateTime?
  emailVerificationExpiresAt    DateTime?
  termsAcceptedAt               DateTime?
  termsVersion                  String?
  termsAcceptedIpHash           String?
  birthDate                     DateTime?
  isDemo                        Boolean                @default(false)
  mustChangePassword            Boolean                @default(false)

  feedback                      Feedback[]
  files                         File[]                 @relation("UploadedFiles")
  File                          File[]
  notifications                 Notification[]
  organizationMembers           OrganizationMember[]
  subscriptions                 Subscription[]
  transactions                  Transaction[]
  permits                       Permit                 @relation(fields: [permitId], references: [id])
  profile                       File?                  @relation("UserProfile", fields: [profileId], references: [id])
  referredBy                    User?                  @relation("UserReferrals", fields: [referredById], references: [id])
  referrals                     User[]                 @relation("UserReferrals")
  activityLogs                  UserActivityLog[]
  addresses                     UserAddress[]
  paymentMethods                UserPaymentMethod[]
  sessions                      UserSession[]
  wallet                        UserWallet?
  userPermissions               UserPermission[]
  entitlements                  Entitlement[]          @relation("UserEntitlements")
  invoices                      Invoice[]              @relation("UserInvoices")
  moduleGrants                  ModuleGrant[]

  // ERP Socius Relations
  createdClients                Client[]               @relation("CreatedClientRecords")
  openedCashShifts              CashShift[]            @relation("OpenedCashShifts")
  closedCashShifts              CashShift[]            @relation("ClosedCashShifts")
  createdCashMovements          CashMovement[]         @relation("CreatedCashMovements")
  createdSales                  Sale[]                 @relation("CreatedSaleRecords")
  createdStockMovements         StockMovement[]        @relation("CreatedStockMovementRecords")

  @@index([isDemo])
}

model UserAddress {
  id         String      @id @default(uuid())
  userId     String
  label      String?
  address1   String
  address2   String?
  city       String
  state      String?
  country    String
  postalCode String?
  latitude   Float?
  longitude  Float?
  type       AddressType @default(HOME)
  isDefault  Boolean     @default(false)
  createdAt  DateTime    @default(now())
  updatedAt  DateTime    @updatedAt
  deletedAt  DateTime?
  user       User        @relation(fields: [userId], references: [id])

  @@index([userId])
}

model SubscriptionPlan {
  id            String         @id @default(uuid())
  name          String
  description   String?
  price         Decimal
  currency      String         @default("USD")
  selected      Boolean        @default(true)
  content       Json?
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt
  deletedAt     DateTime?
  badge         String?
  colorTheme    Json?
  featured      Boolean        @default(false)
  subscriptions Subscription[]
}

model AddOn {
  id            String        @id @default(uuid())
  key           String        @unique
  name          String
  description   String?
  price         Decimal       @db.Decimal(10, 2)
  currency      String        @default("USD")
  billingPeriod String        @default("MONTHLY")
  grants        String[]      @default([])
  modules       String[]      @default([])
  fieldPolicies Json?
  active        Boolean       @default(true)
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt
  deletedAt     DateTime?
  entitlements  Entitlement[]
  invoiceLines  InvoiceLine[]
  moduleLinks   AddOnModule[]

  @@index([active])
}

model Entitlement {
  id              String            @id @default(uuid())
  organizationId  String?
  userId          String?
  addOnId         String
  status          EntitlementStatus @default(ACTIVE)
  startDate       DateTime          @default(now())
  endDate         DateTime?
  quantity        Int               @default(1)
  priceAtPurchase Decimal           @db.Decimal(10, 2)
  currency        String            @default("USD")
  createdById     String?
  createdAt       DateTime          @default(now())
  updatedAt       DateTime          @updatedAt
  deletedAt       DateTime?
  organization    Organization?     @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  user            User?             @relation("UserEntitlements", fields: [userId], references: [id], onDelete: Cascade)
  addOn           AddOn             @relation(fields: [addOnId], references: [id])

  @@index([organizationId])
  @@index([userId])
}

model Module {
  id             String        @id @default(uuid())
  key            String        @unique
  name           String
  description    String?
  icon           String?
  category       String?
  scopes         ModuleScope[]
  operatorPermit String?
  dashboardKind  String?
  active         Boolean       @default(true)
  sortOrder      Int           @default(0)
  addOnLinks     AddOnModule[]
  grants         ModuleGrant[]

  @@index([active])
}

model AddOnModule {
  addOnId  String
  moduleId String
  addOn    AddOn  @relation(fields: [addOnId], references: [id], onDelete: Cascade)
  module   Module @relation(fields: [moduleId], references: [id], onDelete: Cascade)

  @@id([addOnId, moduleId])
}

model ModuleGrant {
  id             String            @id @default(uuid())
  moduleId       String
  userId         String?
  organizationId String?
  source         ModuleGrantSource
  entitlementId  String?
  status         ModuleGrantStatus @default(ACTIVE)
  grantedAt      DateTime          @default(now())
  expiresAt      DateTime?
  grantedById    String?
  module         Module            @relation(fields: [moduleId], references: [id], onDelete: Cascade)
  user           User?             @relation(fields: [userId], references: [id], onDelete: Cascade)
  organization   Organization?     @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@index([moduleId, status])
  @@index([userId, status])
  @@index([organizationId, status])
}

model Invoice {
  id             String        @id @default(uuid())
  organizationId String?
  userId         String?
  periodStart    DateTime
  periodEnd      DateTime
  status         InvoiceStatus @default(ISSUED)
  subtotal       Decimal       @db.Decimal(10, 2)
  total          Decimal       @db.Decimal(10, 2)
  currency       String        @default("USD")
  dueDate        DateTime
  issuedAt       DateTime?
  paidAt         DateTime?
  payerUserId    String?
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt
  organization   Organization? @relation(fields: [organizationId], references: [id])
  user           User?         @relation("UserInvoices", fields: [userId], references: [id])
  lines          InvoiceLine[]

  @@index([organizationId, status])
  @@index([userId, status])
}

model InvoiceLine {
  id          String          @id @default(uuid())
  invoiceId   String
  type        InvoiceLineType
  refId       String?
  description String
  quantity    Int             @default(1)
  unitPrice   Decimal         @db.Decimal(10, 2)
  amount      Decimal         @db.Decimal(10, 2)
  addOnId     String?
  invoice     Invoice         @relation(fields: [invoiceId], references: [id], onDelete: Cascade)
  addOn       AddOn?          @relation(fields: [addOnId], references: [id])

  @@index([invoiceId])
}

model FieldPolicy {
  id        String           @id @default(uuid())
  moduleKey String
  role      OrganizationRole
  formKey   String
  fieldKey  String
  access    FieldAccess      @default(EDITABLE)
  createdAt DateTime         @default(now())
  updatedAt DateTime         @updatedAt

  @@unique([moduleKey, role, formKey, fieldKey])
  @@index([moduleKey, role])
}

model Subscription {
  id                String             @id @default(uuid())
  userId            String
  planId            String
  startDate         DateTime           @default(now())
  endDate           DateTime?
  status            SubscriptionStatus @default(ACTIVE)
  autoRenew         Boolean            @default(true)
  createdAt         DateTime           @default(now())
  updatedAt         DateTime           @updatedAt
  deletedAt         DateTime?
  organizationId    String?
  gracePeriodEndsAt DateTime?
  readOnlyEndsAt    DateTime?
  canceledAt        DateTime?
  lastPlanChangeAt  DateTime?
  organization      Organization?      @relation(fields: [organizationId], references: [id])
  plan              SubscriptionPlan   @relation(fields: [planId], references: [id])
  user              User               @relation(fields: [userId], references: [id])

  @@unique([userId, organizationId])
  @@index([organizationId])
  @@index([userId])
}

model SubscriptionRenewalJobLog {
  id                 String    @id @default(uuid())
  startedAt          DateTime  @default(now())
  finishedAt         DateTime?
  totalProcessed     Int       @default(0)
  totalRenewed       Int       @default(0)
  totalFailedNoFunds Int       @default(0)
  totalExpired       Int       @default(0)
  status             String    @default("RUNNING")
  details            Json?
  createdAt          DateTime  @default(now())
}

model TelemetryRetentionJobLog {
  id             String    @id @default(uuid())
  startedAt      DateTime  @default(now())
  finishedAt     DateTime?
  dryRun         Boolean   @default(true)
  status         String    @default("RUNNING")
  totalEvaluated Int       @default(0)
  totalPurged    Int       @default(0)
  details        Json?
  createdAt      DateTime  @default(now())
}

model UserWallet {
  id         String    @id @default(uuid())
  userId     String    @unique
  balance    Decimal   @default(0.0)
  currency   String    @default("USD")
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt
  deletedAt  DateTime?
  balanceVES Decimal   @default(0.0)
  user       User      @relation(fields: [userId], references: [id])
}

model PaymentMethod {
  id          String              @id @default(uuid())
  name        String
  code        String              @unique
  description String?
  active      Boolean             @default(true)
  imagePath   String?
  colorStart  String?
  colorEnd    String?
  colorText   String?
  createdAt   DateTime            @default(now())
  updatedAt   DateTime            @updatedAt
  deletedAt   DateTime?
  fields      Json?
  userMethods UserPaymentMethod[]
}

model CorporateContent {
  id          String    @id @default(uuid())
  key         String    @unique
  title       String
  content     String
  description String?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  deletedAt   DateTime?
}

model UserPaymentMethod {
  id              String        @id @default(uuid())
  userId          String
  paymentMethodId String
  details         Json?
  isDefault       Boolean       @default(false)
  active          Boolean       @default(true)
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt
  deletedAt       DateTime?
  transactions    Transaction[]
  paymentMethod   PaymentMethod @relation(fields: [paymentMethodId], references: [id])
  user            User          @relation(fields: [userId], references: [id])

  @@index([userId])
}

model Transaction {
  id               String            @id @default(uuid())
  userId           String
  paymentMethodId  String
  type             TransactionType   @default(PAYMENT)
  amount           Decimal
  description      String?
  status           TransactionStatus @default(PENDING)
  referenceCode    String?           @unique
  createdAt        DateTime          @default(now())
  updatedAt        DateTime          @updatedAt
  deletedAt        DateTime?
  currency         String            @default("USD")
  originalAmount   Decimal?
  originalCurrency String?
  exchangeRateUsed Decimal?
  organizationId   String?
  organization     Organization?     @relation(fields: [organizationId], references: [id])
  paymentMethod    UserPaymentMethod @relation(fields: [paymentMethodId], references: [id])
  user             User              @relation(fields: [userId], references: [id])

  @@index([organizationId])
}

model Notification {
  id         String           @id @default(uuid())
  title      String
  message    String
  type       NotificationType @default(INFO)
  read       Boolean          @default(false)
  entityId   String?
  entityType String?
  createdAt  DateTime         @default(now())
  updatedAt  DateTime         @updatedAt
  deleteddAt DateTime?
  userId     String
  user       User             @relation(fields: [userId], references: [id])

  @@index([userId])
  @@index([read])
}

model UserSession {
  id             String    @id @default(uuid())
  userId         String
  ipAddress      String?
  userAgent      String?
  device         String?
  location       String?
  startedAt      DateTime  @default(now()) @db.Timestamptz(3)
  endedAt        DateTime? @db.Timestamptz(3)
  active         Boolean   @default(true)
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt
  deletedAt      DateTime?
  organizationId String?
  user           User      @relation(fields: [userId], references: [id])

  @@index([organizationId, startedAt])
}

model UserActivityLog {
  id             String    @id @default(uuid())
  userId         String
  action         String
  description    String?
  ipAddress      String?
  userAgent      String?
  createdAt      DateTime  @default(now()) @db.Timestamptz(3)
  updatedAt      DateTime  @updatedAt
  deletedAt      DateTime?
  metadata       Json?     @default("{}")
  eventName      String?
  category       String?
  organizationId String?
  source         String?
  eventVersion   String?
  moduleKey      String?
  user           User      @relation(fields: [userId], references: [id])

  @@index([userId, createdAt(sort: Desc)])
  @@index([createdAt(sort: Desc)])
  @@index([action])
  @@index([organizationId, createdAt(sort: Desc)])
  @@index([organizationId, eventName])
  @@index([moduleKey])
}

model File {
  id            String         @id @default(uuid())
  name          String
  originalName  String?
  type          String?
  mimeType      String?
  size          Int?
  path          String
  storage       FileStorage    @default(LOCAL)
  visibility    FileVisibility @default(PRIVATE)
  description   String?
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt
  deletedAt     DateTime?
  uploadedById  String?
  entityId      String?
  entityType    String?
  userId        String?
  uploadedBy    User?          @relation("UploadedFiles", fields: [uploadedById], references: [id])
  User          User?          @relation(fields: [userId], references: [id])
  userAsProfile User?          @relation("UserProfile")

  @@index([entityType, entityId])
}

model UserPermission {
  id             String        @id @default(uuid())
  userId         String        @map("user_id")
  organizationId String?       @map("organization_id")
  permission     String
  grantedAt      DateTime      @default(now()) @map("granted_at")
  expiresAt      DateTime?     @map("expires_at")
  user           User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  organization   Organization? @relation(fields: [organizationId], references: [id])

  @@unique([userId, organizationId, permission])
  @@index([userId])
  @@index([organizationId])
  @@map("user_permission")
}

// ======================================
// ORGANIZACIONES Y SUCURSALES
// ======================================

model Organization {
  id                        String              @id @default(uuid())
  name                      String
  taxId                     String?
  logoUrl                   String?
  maxSeats                  Int                 @default(5)
  status                    String              @default("ACTIVE")
  createdAt                 DateTime            @default(now())
  updatedAt                 DateTime            @updatedAt
  deletedAt                 DateTime?

  members                   OrganizationMember[]
  subscriptions             Subscription[]
  transactions              Transaction[]
  entitlements              Entitlement[]
  invoices                  Invoice[]
  userPermissions           UserPermission[]
  moduleGrants              ModuleGrant[]

  // Socius ERP Relations
  clients                   Client[]
  productCategories         ProductCategory[]
  products                  Product[]
  suppliers                 Supplier[]
  cashRegisters             CashRegister[]
  sales                     Sale[]
  stockMovements            StockMovement[]
}

model OrganizationMember {
  id                  String                   @id @default(uuid())
  organizationId      String
  userId              String
  colorHex            String                   @default("#4F46E5")
  assignedAt          DateTime                 @default(now())
  invitationToken     String?                  @unique
  invitationExpiresAt DateTime?
  role                OrganizationRole         @default(SELLER)
  status              OrganizationMemberStatus @default(ACTIVE)
  organization        Organization             @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  user                User                     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([organizationId, userId])
  @@index([organizationId])
  @@index([userId])
}

// ======================================
// MODELOS ERP: CLIENTES (CRM)
// ======================================

model Client {
  id             String        @id @default(uuid())
  name           String
  businessName   String?
  taxId          String?       // Cédula, RIF, NIT, RUT, CIF
  email          String?
  phone          String?
  address        String?
  city           String?
  state          String?
  creditLimit    Decimal       @default(0.00) @db.Decimal(12, 2)
  currentBalance Decimal       @default(0.00) @db.Decimal(12, 2)
  notes          String?
  isActive       Boolean       @default(true)
  createdById    String?       @map("created_by_id")
  organizationId String?
  createdAt      DateTime      @default(now()) @db.Timestamptz(3)
  updatedAt      DateTime      @updatedAt
  deletedAt      DateTime?

  createdBy      User?         @relation("CreatedClientRecords", fields: [createdById], references: [id])
  organization   Organization? @relation(fields: [organizationId], references: [id])
  sales          Sale[]

  @@index([organizationId])
  @@index([taxId])
  @@index([name])
}

// ======================================
// MODELOS ERP: INVENTARIO & PRODUCTOS
// ======================================

model ProductCategory {
  id             String        @id @default(uuid())
  name           String
  code           String?
  description    String?
  organizationId String?
  isActive       Boolean       @default(true)
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt
  deletedAt      DateTime?

  organization   Organization? @relation(fields: [organizationId], references: [id])
  products       Product[]

  @@index([organizationId])
}

model Supplier {
  id             String        @id @default(uuid())
  name           String
  taxId          String?
  contactName    String?
  email          String?
  phone          String?
  address        String?
  notes          String?
  organizationId String?
  isActive       Boolean       @default(true)
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt
  deletedAt      DateTime?

  organization   Organization? @relation(fields: [organizationId], references: [id])
  products       Product[]

  @@index([organizationId])
}

model Product {
  id             String           @id @default(uuid())
  sku            String           // Código de referencia interna
  barcode        String?          // Código de barras
  name           String
  description    String?
  costPrice      Decimal          @default(0.00) @db.Decimal(12, 2)
  salePrice      Decimal          @default(0.00) @db.Decimal(12, 2)
  wholesalePrice Decimal?         @db.Decimal(12, 2)
  stock          Decimal          @default(0.00) @db.Decimal(12, 2)
  minStock       Decimal          @default(0.00) @db.Decimal(12, 2)
  unit           String           @default("UND")
  taxRate        Decimal          @default(16.00) @db.Decimal(5, 2)
  isService      Boolean          @default(false)
  isActive       Boolean          @default(true)
  imageUrl       String?
  categoryId     String?
  supplierId     String?
  organizationId String?
  createdAt      DateTime         @default(now())
  updatedAt      DateTime         @updatedAt
  deletedAt      DateTime?

  category       ProductCategory? @relation(fields: [categoryId], references: [id])
  supplier       Supplier?        @relation(fields: [supplierId], references: [id])
  organization   Organization?    @relation(fields: [organizationId], references: [id])
  stockMovements StockMovement[]
  saleItems      SaleItem[]

  @@index([organizationId])
  @@index([sku])
  @@index([barcode])
  @@index([categoryId])
}

enum StockMovementType {
  IN
  OUT
  ADJUSTMENT
  SALE
  RETURN
}

model StockMovement {
  id             String            @id @default(uuid())
  productId      String
  organizationId String?
  createdById    String?
  type           StockMovementType
  quantity       Decimal           @db.Decimal(12, 2)
  unitCost       Decimal?          @db.Decimal(12, 2)
  previousStock  Decimal           @db.Decimal(12, 2)
  newStock       Decimal           @db.Decimal(12, 2)
  reference      String?
  notes          String?
  createdAt      DateTime          @default(now())

  product        Product           @relation(fields: [productId], references: [id])
  organization   Organization?     @relation(fields: [organizationId], references: [id])
  createdBy      User?             @relation("CreatedStockMovementRecords", fields: [createdById], references: [id])

  @@index([organizationId])
  @@index([productId])
  @@index([createdAt])
}

// ======================================
// MODELOS ERP: CAJA & TURNOS (POS)
// ======================================

enum CashRegisterStatus {
  OPEN
  CLOSED
}

model CashRegister {
  id             String             @id @default(uuid())
  name           String
  status         CashRegisterStatus @default(CLOSED)
  organizationId String?
  createdAt      DateTime           @default(now())
  updatedAt      DateTime           @updatedAt

  organization   Organization?      @relation(fields: [organizationId], references: [id])
  shifts         CashShift[]

  @@index([organizationId])
}

enum CashShiftStatus {
  OPEN
  CLOSED
}

model CashShift {
  id             String          @id @default(uuid())
  cashRegisterId String
  openedById     String
  closedById     String?
  openedAt       DateTime        @default(now())
  closedAt       DateTime?
  initialAmount  Decimal         @default(0.00) @db.Decimal(12, 2)
  expectedAmount Decimal         @default(0.00) @db.Decimal(12, 2)
  actualAmount   Decimal?        @db.Decimal(12, 2)
  difference     Decimal?        @db.Decimal(12, 2)
  status         CashShiftStatus @default(OPEN)
  notes          String?

  cashRegister   CashRegister    @relation(fields: [cashRegisterId], references: [id])
  openedBy       User            @relation("OpenedCashShifts", fields: [openedById], references: [id])
  closedBy       User?           @relation("ClosedCashShifts", fields: [closedById], references: [id])
  movements      CashMovement[]
  sales          Sale[]

  @@index([cashRegisterId])
  @@index([status])
}

enum CashMovementType {
  INCOME
  EXPENSE
}

model CashMovement {
  id             String           @id @default(uuid())
  cashShiftId    String
  type           CashMovementType
  amount         Decimal          @db.Decimal(12, 2)
  paymentMethod  String           @default("CASH")
  reason         String
  reference      String?
  createdById    String?
  createdAt      DateTime         @default(now())

  cashShift      CashShift        @relation(fields: [cashShiftId], references: [id])
  createdBy      User?            @relation("CreatedCashMovements", fields: [createdById], references: [id])

  @@index([cashShiftId])
}

// ======================================
// MODELOS ERP: VENTAS & FACTURACIÓN
// ======================================

enum SaleStatus {
  COMPLETED
  PENDING
  CANCELLED
}

enum SalePaymentStatus {
  PAID
  PARTIAL
  UNPAID
}

model Sale {
  id             String            @id @default(uuid())
  saleNumber     String            // Correlativo e.g. VTA-00001
  organizationId String?
  clientId       String?
  cashShiftId    String?
  createdById    String?
  subtotal       Decimal           @db.Decimal(12, 2)
  discountTotal  Decimal           @default(0.00) @db.Decimal(12, 2)
  taxTotal       Decimal           @default(0.00) @db.Decimal(12, 2)
  total          Decimal           @db.Decimal(12, 2)
  currency       String            @default("USD")
  exchangeRate   Decimal           @default(1.00) @db.Decimal(12, 4)
  status         SaleStatus        @default(COMPLETED)
  paymentStatus  SalePaymentStatus @default(PAID)
  notes          String?
  createdAt      DateTime          @default(now())
  updatedAt      DateTime          @updatedAt
  deletedAt      DateTime?

  organization   Organization?     @relation(fields: [organizationId], references: [id])
  client         Client?           @relation(fields: [clientId], references: [id])
  cashShift      CashShift?        @relation(fields: [cashShiftId], references: [id])
  createdBy      User?             @relation("CreatedSaleRecords", fields: [createdById], references: [id])
  items          SaleItem[]
  payments       SalePayment[]

  @@index([organizationId])
  @@index([clientId])
  @@index([saleNumber])
  @@index([createdAt])
}

model SaleItem {
  id             String            @id @default(uuid())
  saleId         String
  productId      String?
  productName    String
  quantity       Decimal           @db.Decimal(12, 2)
  unitPrice      Decimal           @db.Decimal(12, 2)
  discount       Decimal           @default(0.00) @db.Decimal(12, 2)
  taxRate        Decimal           @default(0.00) @db.Decimal(5, 2)
  taxAmount      Decimal           @default(0.00) @db.Decimal(12, 2)
  total          Decimal           @db.Decimal(12, 2)

  sale           Sale              @relation(fields: [saleId], references: [id], onDelete: Cascade)
  product        Product?          @relation(fields: [productId], references: [id])

  @@index([saleId])
  @@index([productId])
}

model SalePayment {
  id             String            @id @default(uuid())
  saleId         String
  method         String
  amount         Decimal           @db.Decimal(12, 2)
  currency       String            @default("USD")
  exchangeRate   Decimal           @default(1.00) @db.Decimal(12, 4)
  reference      String?
  createdAt      DateTime          @default(now())

  sale           Sale              @relation(fields: [saleId], references: [id], onDelete: Cascade)

  @@index([saleId])
}

