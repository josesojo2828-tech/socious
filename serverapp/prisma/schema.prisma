// ======================================
// AUDITORÍA Y CONFIGURACIÓN DEL SISTEMA
// ======================================

model FinancialAuditLog {
  id         String   @id @default(uuid())
  action     String
  entityType String
  entityId   String
  actorId    String?
  amount     Decimal?
  metadata   Json?
  createdAt  DateTime @default(now())

  @@index([entityType, entityId])
  @@index([actorId])
  @@index([createdAt])
}

model SystemSetting {
  id          String   @id @default(uuid())
  key         String   @unique
  value       String
  description String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model EnabledCountry {
  id           String   @id @default(uuid())
  code         String   @unique
  name         String
  phoneCode    String
  flagEmoji    String
  currency     String
  isActive     Boolean  @default(true)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
}
