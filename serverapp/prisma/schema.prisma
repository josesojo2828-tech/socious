// ======================================
// MODELOS MARKETPLACE
// ======================================

model MarketCategory {
  id          String   @id @default(uuid())
  name        String   @unique
  description String?
  icon        String?
  sortOrder   Int      @default(0)
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  products MarketProduct[]
}

model MarketProduct {
  id          String        @id @default(uuid())
  title       String
  description String        @db.Text
  type        ProductType
  price       Decimal       @db.Decimal(10, 2)
  currency    String        @default("USD")
  status      ProductStatus @default(DRAFT)
  isFeatured  Boolean       @default(false)

  sellerId   String
  seller     User            @relation(fields: [sellerId], references: [id])
  categoryId String?
  category   MarketCategory? @relation(fields: [categoryId], references: [id])

  coverUrl   String?
  previewUrl String?

  salesCount  Int     @default(0)
  ratingAvg   Decimal @default(0) @db.Decimal(3, 2)
  ratingCount Int     @default(0)

  tags String[]

  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  publishedAt DateTime?

  reviews   MarketReview[]
  campaigns MarketCampaign[]

  @@index([sellerId])
  @@index([categoryId])
  @@index([status])
}

// ======================================
// MODELOS MARKETPLACE — CAMPAÑAS PUBLICITARIAS
// ======================================

model CampaignPlan {
  id          String   @id @default(uuid())
  name        String   @unique
  description String?
  price       Decimal  @db.Decimal(10, 2)
  currency    String   @default("USD")
  duration    Int // días de duración
  designs     Int      @default(0) // cantidad de diseños incluidos
  videos      Int      @default(0) // cantidad de videos incluidos
  posts       Int      @default(0) // publicaciones en redes incluidas
  socialMedia Boolean  @default(false) // publicidad en redes sociales
  features    Json? // features adicionales en JSON
  isActive    Boolean  @default(true)
  sortOrder   Int      @default(0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  campaigns MarketCampaign[]
}

model MarketCampaign {
  id          String         @id @default(uuid())
  sellerId    String
  seller      User           @relation(fields: [sellerId], references: [id])
  productId   String
  product     MarketProduct  @relation(fields: [productId], references: [id])
  planId      String
  plan        CampaignPlan   @relation(fields: [planId], references: [id])
  amount      Decimal        @db.Decimal(10, 2) // monto descontado del wallet
  status      CampaignStatus @default(ACTIVE)
  startDate   DateTime       @default(now())
  endDate     DateTime
  impressions Int            @default(0)
  clicks      Int            @default(0)
  conversions Int            @default(0)
  createdAt   DateTime       @default(now())
  updatedAt   DateTime       @updatedAt

  @@index([sellerId])
  @@index([productId])
  @@index([status])
}

model WalletPayment {
  id            String        @id @default(uuid())
  userId        String
  user          User          @relation(fields: [userId], references: [id])
  amount        Decimal       @db.Decimal(10, 2)
  currency      String        @default("USD")
  paymentMethod String // "transferencia", "pago_movil", "zelle", etc.
  reference     String? // referencia del pago
  proofUrl      String? // URL del comprobante
  note          String? // nota adicional del usuario
  status        PaymentStatus @default(PENDING)
  reviewedBy    String? // ID del admin que revisó
  reviewedAt    DateTime?
  reviewNote    String? // nota del admin al aprobar/rechazar
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt

  @@index([userId])
  @@index([status])
}

model MarketReview {
  id        String        @id @default(uuid())
  productId String
  product   MarketProduct @relation(fields: [productId], references: [id], onDelete: Cascade)
  buyerId   String
  buyer     User          @relation(fields: [buyerId], references: [id])
  rating    Int
  comment   String?       @db.Text
  response  String?       @db.Text
  createdAt DateTime      @default(now())
  updatedAt DateTime      @updatedAt

  @@unique([productId, buyerId])
  @@index([productId])
}

enum ProductType {
  COURSE
  EBOOK
  TEMPLATE
  WEBINAR
}

enum ProductStatus {
  DRAFT
  PENDING_APPROVAL
  APPROVED
  REJECTED
  PUBLISHED
  ARCHIVED
}

enum CampaignStatus {
  ACTIVE
  EXPIRED
  CANCELLED
  PAUSED
}

enum PaymentStatus {
  PENDING
  APPROVED
  REJECTED
}

model FinancialAuditLog {
