# ────────────────────────────────────────────────────────────
# NUTRINGEST BACKEND — VARIABLES DE ENTORNO (referencia)
# Usá las plantillas listas:  .env.dev  (docker local)  |  .env.prd  (Render)
# Copiá la que necesites a .env  (cp .env.dev .env)
# ────────────────────────────────────────────────────────────

# ── APP ──
NODE_ENV=development
PORT=3001
APP_URL=http://localhost:3001
SESSION_SECRET=un_secret_largo_de_al_menos_32_caracteres
AT_SECRET=cambiame_access_token_secret
RT_SECRET=cambiame_refresh_token_secret

# ── DATABASE ──
# Dev (local docker): postgresql://USER:PASS@localhost:11003/NUTRI_DB?schema=public
# Prd (Supabase): pooler transaccional 6543?pgbouncer=true (runtime)
DATABASE_URL="postgresql://user:password@host:port/db_name?schema=public"
# Prd (Supabase): pooler de sesión 5432 (migraciones). Dev: misma BD local.
DIRECT_URL="postgresql://user:password@host:port/db_name"
PRISMA_LOG_LEVEL=warn

# ── STORAGE (S3 compatible / MinIO) ──
MINIO_ENDPOINT=200.44.171.179
MINIO_PORT=4065
MINIO_ENDPOINT_URL=
MINIO_ACCESS_KEY=root
MINIO_SECRET_KEY=GPzG9Qe2JJkMpyPvwUswgAhslvAjn97w
MINIO_BUCKET=nutringest-uploads
MINIO_USE_SSL=false
MINIO_REGION=us-east-1
MINIO_PUBLIC_URL=https://nutringest-cloud.onrender.com/api/file/public

# ── EMAIL (SMTP) ──
SMTP_USER=
SMTP_PASS=

# ── PRISMA MIGRATIONS ──
SESSION_TOKEN="MASTER"
DEFAULT_TRIAL_DAYS=120
DEFAULT_PLAN_ID="Premium"

# ── TELEMETRÍA / PII ──
# Emisión de eventos de telemetría (auth.session.*, actividad). Default: false
TELEMETRY_ENABLED=false
# Job diario de retención de telemetría. Fase 0 = DRY-RUN: reporta qué se
# purgaría y NO elimina filas. Default: false (el job se omite).
TELEMETRY_RETENTION_ENABLED=false
# Salt para hashear IPs: sha256(ip + PII_HASH_SALT). Usá un secreto largo.
# Si falta, el hash se calcula igual pero con salt vacío (débil) — configuralo en prd.
PII_HASH_SALT=cambiame_por_un_salt_largo_para_hash_de_ip

# ── ADOPCIÓN / DASHBOARD ──
# Zona horaria de negocio para el bucketing de métricas de adopción
# (DAU/WAU/MAU, cohortes, embudo). Los timestamps se guardan en UTC
# (`timestamptz`); los buckets se calculan TZ-aware con
# `date_trunc(unit, ts AT TIME ZONE :tz)`. Default: America/Caracas.
# Los endpoints aceptan además un override opcional por request vía el query
# param `?tz=` (ej. `?tz=UTC`), que gana sobre este default.
ADOPTION_TZ=America/Caracas

# ── FEATURE FLAGS (entitlements / module framework) ──
# Motor de entitlements (resolución de permisos + guard global). Default: false.
# Debe estar en true para que el sidebar dirigido por entitlements esté activo.
ENTITLEMENTS_ENABLED=false
# Framework de módulos (catálogo, grants MANUAL, dashboards multi-scope, rutas
# /api/modules/*). Default: false. Debe habilitarse JUNTO con ENTITLEMENTS_ENABLED
# para que el sidebar de módulos esté vivo. Gatea: grants MANUAL en la
# resolución, la sección agrupada "Módulos" del sidebar admin y las rutas.
MODULE_FRAMEWORK_ENABLED=false

# ── REFERENCE DATA SEEDS (bootstrap automático) ──
# Al arrancar la app se siembran automáticamente SportDiscipline y
# FoodItem.wasteFactor (idempotentes). "false" desactiva el seeding en boot.
# Default: true
RUN_REFERENCE_SEEDS=true